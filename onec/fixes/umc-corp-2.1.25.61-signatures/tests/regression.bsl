// Только изолированная база 2.1.25.61. Все тестовые записи откатываются.
// Генератор дописывает точную private-процедуру из поставляемого расширения.
Функция ВыполнитьРегрессию() Экспорт

	НачатьТранзакцию();
	Попытка
		УИДОрганизации = Новый УникальныйИдентификатор;
		УИДВрача = Новый УникальныйИдентификатор;
		УИДНедействительной = Новый УникальныйИдентификатор;
		УИДУдаленной = Новый УникальныйИдентификатор;
		УИДНеизвестной = Новый УникальныйИдентификатор;
		Сообщение = СоздатьСообщение();
		ДобавитьПодпись(Сообщение, УИДОрганизации, Истина);
		ДобавитьПодпись(Сообщение, УИДВрача, Ложь);
		ДобавитьПодпись(Сообщение, УИДНедействительной, Истина);
		Сообщение.Записать();
		Удаленное = СоздатьСообщение();
		Удаленное.ПометкаУдаления = Истина;
		ДобавитьПодпись(Удаленное, УИДУдаленной, Истина);
		Удаленное.Записать();

		Таблица = НоваяТаблица();
		ДобавитьСтроку(Таблица, УИДОрганизации, Истина);
		ДобавитьСтроку(Таблица, УИДВрача, Истина);
		ДобавитьСтроку(Таблица, УИДНедействительной, Ложь);
		ДобавитьСтроку(Таблица, УИДУдаленной, Истина);
		ДобавитьСтроку(Таблица, УИДНеизвестной, Истина);
		Отбор = Новый Структура("ЭтоПодписьМО, ПодписьВерна", Истина, Истина);
		ОшибкаДоИсправления = Ложь;
		Попытка
			Таблица.НайтиСтроки(Отбор);
		Исключение
			ОшибкаДоИсправления = СтрНайти(ОписаниеОшибки(), "Неверное имя колонки") > 0;
		КонецПопытки;
		Проверить(ОшибкаДоИсправления, "baseline must reproduce missing column");

		ДополнитьПризнакПодписиМедицинскойОрганизации(Таблица);
		СтрокиМО = Таблица.НайтиСтроки(Отбор);
		Проверить(СтрокиМО.Количество() = 1, "only valid organization signature");
		Проверить(СтрокиМО[0].УникальныйИдентификатор = УИДОрганизации, "organization identity");
		Проверить(Не Таблица[1].ЭтоПодписьМО, "doctor must stay doctor");
		Проверить(Таблица[2].ЭтоПодписьМО И Не Таблица[2].ПодписьВерна, "invalid must stay invalid");
		Проверить(Не Таблица[3].ЭтоПодписьМО, "deleted message excluded");
		Проверить(Не Таблица[4].ЭтоПодписьМО, "unknown signature not promoted");

		Таблица[0].ЭтоПодписьМО = Ложь;
		ДополнитьПризнакПодписиМедицинскойОрганизации(Таблица);
		Проверить(Не Таблица[0].ЭтоПодписьМО, "existing caller flag preserved");
		ПустаяТаблица = НоваяТаблица();
		ДополнитьПризнакПодписиМедицинскойОрганизации(ПустаяТаблица);
		Проверить(ПустаяТаблица.НайтиСтроки(Отбор).Количество() = 0, "empty table supported");
		ДругаяКоллекция = Новый Массив;
		ДополнитьПризнакПодписиМедицинскойОрганизации(ДругаяКоллекция);
		Проверить(ДругаяКоллекция.Количество() = 0, "other collection untouched");
		ОтменитьТранзакцию();
	Исключение
		Описание = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОтменитьТранзакцию();
		ВызватьИсключение Описание;
	КонецПопытки;
	Возврат "PASS: baseline, organization, doctor, invalid, deleted, unknown, existing, empty, collection; rollback";

КонецФункции

Функция СоздатьСообщение()

	Сообщение = Справочники.СообщенияРЭМД.СоздатьЭлемент();
	Сообщение.ОбменДанными.Загрузка = Истина;
	Сообщение.Документ = Документы.Прием.ПустаяСсылка();
	Сообщение.Наименование = "Signature patch regression";
	Возврат Сообщение;

КонецФункции

Процедура ДобавитьПодпись(Сообщение, УИД, ЭтоПодписьМО)

	Подпись = Сообщение.ЭлектронныеПодписиЭМД.Добавить();
	Подпись.УИД_ЭЦП = УИД;
	Подпись.ЭтоПодписьМО = ЭтоПодписьМО;

КонецПроцедуры

Функция НоваяТаблица()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("УникальныйИдентификатор", Новый ОписаниеТипов("УникальныйИдентификатор"));
	Таблица.Колонки.Добавить("ПодписьВерна", Новый ОписаниеТипов("Булево"));
	Возврат Таблица;

КонецФункции

Процедура ДобавитьСтроку(Таблица, УИД, Верна)

	СтрокаПодписи = Таблица.Добавить();
	СтрокаПодписи.УникальныйИдентификатор = УИД;
	СтрокаПодписи.ПодписьВерна = Верна;

КонецПроцедуры

Процедура Проверить(Условие, Описание)

	Если Не Условие Тогда
		ВызватьИсключение "TEST: " + Описание;
	КонецЕсли;

КонецПроцедуры
