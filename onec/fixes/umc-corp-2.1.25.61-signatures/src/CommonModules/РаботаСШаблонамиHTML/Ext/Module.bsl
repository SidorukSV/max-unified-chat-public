#Область СлужебныеПроцедурыИФункции

&Вместо("ПолучитьСтруктурыПодписейПоСтрокеШаблона")
Функция ИсправлениеПодписей_ПолучитьСтруктурыПодписейПоСтрокеШаблона(
		ВидДокумента, УИДШаблона, ТаблицаПодписей, ЭМД, тчРолиИПодписиЭМД,
		ПриемСсылка, ТребуютсяРолиПоШаблонамПриёма, УИД_ЭМД)

	ДополнитьПризнакПодписиМедицинскойОрганизации(ТаблицаПодписей);
	Возврат ПродолжитьВызов(ВидДокумента, УИДШаблона, ТаблицаПодписей, ЭМД,
		тчРолиИПодписиЭМД, ПриемСсылка, ТребуютсяРолиПоШаблонамПриёма, УИД_ЭМД);

КонецФункции

// В 2.1.25.61 почтовый сценарий создает таблицу без ЭтоПодписьМО.
// Источник признака и выбор сообщения совпадают с ДанныеСообщенийРЭМДПоЭП
// общего модуля бит_СертификатыЭЦП. Проверку действительности подписи не меняем.
//
// Параметры:
//  ТаблицаПодписей - ТаблицаЗначений, ДанныеФормыКоллекция - подписи приема.
Процедура ДополнитьПризнакПодписиМедицинскойОрганизации(ТаблицаПодписей)

	Если ТипЗнч(ТаблицаПодписей) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	Если ТаблицаПодписей.Колонки.Найти("ЭтоПодписьМО") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТаблицаПодписей.Колонки.Добавить("ЭтоПодписьМО", Новый ОписаниеТипов("Булево"));
	Если ТаблицаПодписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	УИДыЭЦП = ТаблицаПодписей.ВыгрузитьКолонку("УникальныйИдентификатор");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| СообщенияРЭМДЭП.УИД_ЭЦП КАК УИД_ЭЦП,
		| МАКСИМУМ(СообщенияРЭМДЭП.Ссылка) КАК СообщениеРЭМД
		|ПОМЕСТИТЬ СообщенияЭП
		|ИЗ
		| Справочник.СообщенияРЭМД.ЭлектронныеПодписиЭМД КАК СообщенияРЭМДЭП
		|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СообщенияРЭМД КАК СообщенияРЭМД
		|  ПО СообщенияРЭМДЭП.Ссылка = СообщенияРЭМД.Ссылка
		|ГДЕ
		| НЕ СообщенияРЭМД.ПометкаУдаления
		| И СообщенияРЭМДЭП.УИД_ЭЦП В(&УИДыЭЦП)
		|СГРУППИРОВАТЬ ПО
		| СообщенияРЭМДЭП.УИД_ЭЦП
		|;
		|
		|ВЫБРАТЬ
		| СообщенияЭП.УИД_ЭЦП КАК УИД_ЭЦП,
		| МАКСИМУМ(СообщенияРЭМДЭП.ЭтоПодписьМО) КАК ЭтоПодписьМО
		|ИЗ
		| СообщенияЭП КАК СообщенияЭП
		|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СообщенияРЭМД.ЭлектронныеПодписиЭМД КАК СообщенияРЭМДЭП
		|  ПО СообщенияЭП.СообщениеРЭМД = СообщенияРЭМДЭП.Ссылка
		|   И СообщенияЭП.УИД_ЭЦП = СообщенияРЭМДЭП.УИД_ЭЦП
		|СГРУППИРОВАТЬ ПО
		| СообщенияЭП.УИД_ЭЦП";
	Запрос.УстановитьПараметр("УИДыЭЦП", УИДыЭЦП);
	ПодписиМО = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПодписиМО.Вставить(Выборка.УИД_ЭЦП, Выборка.ЭтоПодписьМО);
	КонецЦикла;

	Для Каждого СтрокаПодписи Из ТаблицаПодписей Цикл
		ПризнакПодписиМО = ПодписиМО.Получить(СтрокаПодписи.УникальныйИдентификатор);
		Если ПризнакПодписиМО <> Неопределено Тогда
			СтрокаПодписи.ЭтоПодписьМО = ПризнакПодписиМО;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
