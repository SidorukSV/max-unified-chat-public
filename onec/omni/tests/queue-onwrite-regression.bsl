// Изолированная тестовая база, исполнение через execute_code.
// Проверяются реальные экспортные Before/On-подписки, штатные before/after СКД,
// рендер шаблонов и постановка в очередь. Само бизнес-Записать здесь выполняется
// только с Загрузка=true, чтобы проверка обмена не зависела от расписания врачей.
// Все записи откатываются. После команды настройки бот выключен. Sender/HTTP нет.
НачатьТранзакцию();
Попытка
	БотОбъект = Справочники.бит_омни_Боты.СоздатьЭлемент();
	БотОбъект.Наименование = "QUEUE_ONWRITE_TEST_" + Строка(Новый УникальныйИдентификатор);
	БотОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	БотОбъект.Токен = "queue-test-invalid-token";
	БотОбъект.Использовать = Истина;
	БотОбъект.ОбменДанными.Загрузка = Истина;
	БотОбъект.Записать();
	Бот = БотОбъект.Ссылка;
	Активация = Справочники.бит_омни_Рассылки.СоздатьСтандартныеНапоминанияЗаписейMAX(Бот);
	ПовторнаяАктивация = Справочники.бит_омни_Рассылки.СоздатьСтандартныеНапоминанияЗаписейMAX(Бот);
	Если Активация.Активировано <> 2 Или ПовторнаяАктивация.Активировано <> 0 Тогда
		ВызватьИсключение "FAIL: standard activation not idempotent";
	КонецЕсли;
	БотОбъект.Использовать = Ложь;
	БотОбъект.Записать();

	ЗапросАктивных = Новый Запрос("ВЫБРАТЬ Рассылка ИЗ РегистрСведений.бит_омни_АктивныеРассылки ГДЕ Бот = &Бот");
	ЗапросАктивных.УстановитьПараметр("Бот", Бот);
	Активные = ЗапросАктивных.Выполнить().Выгрузить();
	Если Активные.Количество() <> 2 Тогда ВызватьИсключение "FAIL: expected exactly two standard mailings"; КонецЕсли;
	Для Каждого СтрокаАктивной Из Активные Цикл
		РассылкаОбъект = СтрокаАктивной.Рассылка.ПолучитьОбъект();
		Если РассылкаОбъект.РежимРассылки <> Перечисления.бит_омни_РежимыРассылки.ПриЗаписиОбъекта
			Или РассылкаОбъект.ДатыСобытия.Количество() <> 1
			Или РассылкаОбъект.Принадлежность.Найти("Документ.Заявка", "Объект") = Неопределено Тогда
			ВызватьИсключение "SETUP_REQUIRED: standard mailing must have one on-write appointment date";
		КонецЕсли;
	КонецЦикла;

	ПациентОбъект = Справочники.Клиенты.СоздатьЭлемент();
	ПациентОбъект.Наименование = "QUEUE_ONWRITE_ROLLBACK_PATIENT";
	ПациентОбъект.ОбменДанными.Загрузка = Истина;
	ПациентОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	ПациентОбъект.Записать();
	Пациент = ПациентОбъект.Ссылка;
	КонтактОбъект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	КонтактОбъект.Наименование = "QUEUE_ONWRITE_ROLLBACK_CONTACT";
	КонтактОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	КонтактОбъект.Бот = Бот;
	КонтактОбъект.Идентификатор = 999999999997;
	КонтактОбъект.Получатель = Пациент;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	КонтактОбъект.Записать();

	ДатаПриема = НачалоДня(ТекущаяДатаСеанса()) + 10 * 86400 + 12 * 3600;
	ЗаявкаОбъект = Документы.Заявка.СоздатьДокумент();
	ЗаявкаОбъект.Дата = ТекущаяДатаСеанса();
	ЗаявкаОбъект.Клиент = Пациент;
	ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована;
	ЗаявкаОбъект.ДатаНачала = ДатаПриема;
	ЗаявкаОбъект.ДатаОкончания = ДатаПриема + 1800;
	ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
	ЗаявкаОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	ЗаявкаОбъект.Записать();

	ЗапросОчереди = Новый Запрос("ВЫБРАТЬ Группа, Ключ, Рассылка, Контакт, Источник, Правило,
	|ДатаОтправки, Состояние, ТелоJSON, АдресатJSON, Попыток
	|ИЗ РегистрСведений.бит_омни_ОчередьСообщенийMAX
	|ГДЕ Бот = &Бот УПОРЯДОЧИТЬ ПО ДатаОтправки, Ключ");
	ЗапросОчереди.УстановитьПараметр("Бот", Бот);
	Отказ = Ложь;
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	РежимПроведения = РежимПроведенияДокумента.Неоперативный;
	ЗаявкаОбъект.ОбменДанными.Загрузка = Ложь;
	бит_омни_ПодпискиНаСобытия.ДокументыПередЗаписью(ЗаявкаОбъект, Отказ, РежимЗаписи, РежимПроведения);
	бит_омни_ПодпискиНаСобытия.СправочникиПриЗаписи(ЗаявкаОбъект, Отказ);
	Очередь = ЗапросОчереди.Выполнить().Выгрузить();
	Если Очередь.Количество() <> 2 Или Отказ Тогда ВызватьИсключение "FAIL: on-write must enqueue two reminders"; КонецЕсли;
	Если Очередь[0].ДатаОтправки <> ДатаПриема - 86400 Или Очередь[1].ДатаОтправки <> ДатаПриема - 7200 Тогда
		ВызватьИсключение "FAIL: on-write 24h/2h timestamps";
	КонецЕсли;
	ИсходныеКлючи = Новый Соответствие;
	Для Каждого СтрокаОчереди Из Очередь Цикл
		Если СтрокаОчереди.Состояние <> "Ожидает" Или СтрокаОчереди.Попыток <> 0
			Или СтрокаОчереди.Контакт <> КонтактОбъект.Ссылка Тогда
			ВызватьИсключение "FAIL: pending message state/contact";
		КонецЕсли;
		Если СтрНайти(СтрокаОчереди.ТелоJSON, "<ДатаЗаписи>") > 0
			Или СтрНайти(СтрокаОчереди.ТелоJSON, Формат(ДатаПриема, "ДФ=dd.MM.yyyy")) = 0
			Или СтрНайти(СтрокаОчереди.ТелоJSON, "appointment_" + Строка(ЗаявкаОбъект.Ссылка.УникальныйИдентификатор())
				+ "_" + Формат(ДатаПриема, "ДФ=yyyyMMddHHmmss") + "_confirm") = 0 Тогда
			ВызватьИсключение "FAIL: snapshot date/versioned callback was not rendered";
		КонецЕсли;
		Если СтрНайти(СтрокаОчереди.ТелоJSON + СтрокаОчереди.АдресатJSON, "queue-test-invalid-token") > 0 Тогда
			ВызватьИсключение "FAIL: secret in durable snapshot";
		КонецЕсли;
		ИсходныеКлючи.Вставить(СтрокаОчереди.Ключ, Истина);
	КонецЦикла;

	// Повторный вызов Before/On не должен накапливать строки before/after в кэше.
	бит_омни_ПодпискиНаСобытия.ДокументыПередЗаписью(ЗаявкаОбъект, Отказ, РежимЗаписи, РежимПроведения);
	бит_омни_ПодпискиНаСобытия.СправочникиПриЗаписи(ЗаявкаОбъект, Отказ);
	Очередь = ЗапросОчереди.Выполнить().Выгрузить();
	Если Очередь.Количество() <> 2 Тогда ВызватьИсключение "FAIL: duplicate save created queue rows"; КонецЕсли;
	Для Каждого СтрокаОчереди Из Очередь Цикл
		Если ИсходныеКлючи.Получить(СтрокаОчереди.Ключ) = Неопределено Тогда
			ВызватьИсключение "FAIL: duplicate save changed identity";
		КонецЕсли;
	КонецЦикла;

	// Before читает старую сохранённую ссылку, On — изменённый объект.
	ДатаПереноса = ДатаПриема + 86400;
	ЗаявкаОбъект.ДатаНачала = ДатаПереноса;
	ЗаявкаОбъект.ДатаОкончания = ДатаПереноса + 1800;
	бит_омни_ПодпискиНаСобытия.ДокументыПередЗаписью(ЗаявкаОбъект, Отказ, РежимЗаписи, РежимПроведения);
	бит_омни_ПодпискиНаСобытия.СправочникиПриЗаписи(ЗаявкаОбъект, Отказ);
	Очередь = ЗапросОчереди.Выполнить().Выгрузить();
	Если Очередь.Количество() <> 4 Тогда ВызватьИсключение "FAIL: move did not keep canceled and new messages"; КонецЕсли;
	КоличествоОжидающих = 0;
	Для Каждого СтрокаОчереди Из Очередь Цикл
		Если ИсходныеКлючи.Получить(СтрокаОчереди.Ключ) <> Неопределено Тогда
			Если СтрокаОчереди.Состояние <> "Отменено" Тогда ВызватьИсключение "FAIL: old reminder not canceled on move"; КонецЕсли;
		Иначе
			Если СтрокаОчереди.Состояние <> "Ожидает" Тогда ВызватьИсключение "FAIL: moved reminder not pending"; КонецЕсли;
			Если СтрокаОчереди.ДатаОтправки <> ДатаПереноса - 86400
				И СтрокаОчереди.ДатаОтправки <> ДатаПереноса - 7200 Тогда
				ВызватьИсключение "FAIL: moved reminder timestamp";
			КонецЕсли;
			КоличествоОжидающих = КоличествоОжидающих + 1;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоОжидающих <> 2 Тогда ВызватьИсключение "FAIL: moved pending count"; КонецЕсли;

	// Сохраняем новое before-состояние безопасным setup-путём, не запускающим обмен.
	ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
	ЗаявкаОбъект.Записать();
	ЗаявкаОбъект.ОбменДанными.Загрузка = Ложь;
	ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена;
	бит_омни_ПодпискиНаСобытия.ДокументыПередЗаписью(ЗаявкаОбъект, Отказ, РежимЗаписи, РежимПроведения);
	бит_омни_ПодпискиНаСобытия.СправочникиПриЗаписи(ЗаявкаОбъект, Отказ);
	Очередь = ЗапросОчереди.Выполнить().Выгрузить();
	Если Очередь.Количество() <> 4 Тогда ВызватьИсключение "FAIL: cancellation created extra message"; КонецЕсли;
	Для Каждого СтрокаОчереди Из Очередь Цикл
		Если СтрокаОчереди.Состояние <> "Отменено" Тогда ВызватьИсключение "FAIL: cancellation left pending reminders"; КонецЕсли;
	КонецЦикла;

	// Пустая таблица дат: тот же путь подготовки создаёт один немедленный снимок.
	НемедленнаяРассылка = Активные[0].Рассылка.ПолучитьОбъект().Скопировать();
	НемедленнаяРассылка.Наименование = "QUEUE_ONWRITE_ROLLBACK_IMMEDIATE";
	НемедленнаяРассылка.ДатыСобытия.Очистить();
	НемедленнаяРассылка.Записать();
	Активность = РегистрыСведений.бит_омни_АктивныеРассылки.СоздатьМенеджерЗаписи();
	Активность.Бот = Бот;
	Активность.Рассылка = НемедленнаяРассылка.Ссылка;
	Активность.Записать();
	ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована;
	ДоНемедленной = ТекущаяДатаСеанса();
	Для НомерПовтора = 1 По 2 Цикл
		бит_омни_ПодпискиНаСобытия.ДокументыПередЗаписью(ЗаявкаОбъект, Отказ, РежимЗаписи, РежимПроведения);
		бит_омни_ПодпискиНаСобытия.СправочникиПриЗаписи(ЗаявкаОбъект, Отказ);
	КонецЦикла;
	Очередь = ЗапросОчереди.Выполнить().Выгрузить();
	Немедленные = Очередь.НайтиСтроки(Новый Структура("Правило", "IMMEDIATE"));
	Если Немедленные.Количество() <> 1 Или Немедленные[0].Состояние <> "Ожидает"
		Или Немедленные[0].ДатаОтправки < ДоНемедленной
		Или Немедленные[0].ДатаОтправки > ТекущаяДатаСеанса() Тогда
		ВызватьИсключение "FAIL: immediate queue identity/timestamp";
	КонецЕсли;
	Если БотОбъект.Ссылка.ПолучитьОбъект().Использовать Тогда ВызватьИсключение "FAIL: test bot enabled"; КонецЕсли;
	ОтменитьТранзакцию();
	Результат = "PASS: real Before/On handlers and standard SKD; two 24h/2h dated snapshots; callback Date version formatted; duplicate-save deduplication; move cancels old and creates new; canceled appointment cancels pending; empty dates enqueue one immediate snapshot. All fixtures rolled back; bot disabled; no sender/HTTP. Normal business Document.Write not tested.";
Исключение
	Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
	ВызватьИсключение;
КонецПопытки;

