// Только изолированная тестовая база. Все записи откатываются, HTTP не выполняется.
Ссылки = Новый Структура("Яндекс,ДваГИС,AppleMaps",
	"https://yandex.ru/maps/?rtext=~55.70,37.64&rtt=auto",
	"https://2gis.ru/directions/tab/car/points/%7C37.64,55.70",
	"https://maps.apple.com/directions?destination=55.70,37.64&mode=driving");
Для Маска = 0 По 7 Цикл
	Заполненные = Новый Структура;
	Ожидается = 0;
	Делитель = 1;
	Для Каждого Сервис Из бит_омни_МаршрутыMAX.СервисыМаршрутов() Цикл
		Если Цел(Маска / Делитель) % 2 = 1 Тогда
			Заполненные.Вставить(Сервис.Ключ, Ссылки[Сервис.Ключ]);
			Ожидается = Ожидается + 1;
		КонецЕсли;
		Делитель = Делитель * 2;
	КонецЦикла;
	Кнопки = бит_омни_МаршрутыMAX.КнопкиМаршрутов(Заполненные);
	Если Кнопки.Количество() <> Ожидается Тогда
		ВызватьИсключение "Неверное число кнопок для комбинации заполненных ссылок.";
	КонецЕсли;
	Для Каждого Ряд Из Кнопки Цикл
		Если Ряд.Количество() <> 1 Или Ряд[0].type <> "link" Тогда
			ВызватьИсключение "Неверный формат кнопки маршрута.";
		КонецЕсли;
	КонецЦикла;
КонецЦикла;

Для Каждого Адрес Из СтрРазделить("yandexnavi://route,javascript:alert(1),https://,https:///path,http://?query,https://user@host", ",") Цикл
	Если Не ПустаяСтрока(бит_омни_МаршрутыMAX.ДопустимаяСсылкаМаршрута(Адрес)) Тогда
		ВызватьИсключение "Некорректная ссылка не отклонена: " + Адрес;
	КонецЕсли;
КонецЦикла;
Если бит_омни_МаршрутыMAX.ДопустимаяСсылкаМаршрута(" " + Ссылки.Яндекс + " ") <> Ссылки.Яндекс Тогда
	ВызватьИсключение "Пробелы вокруг корректной ссылки не удалены.";
КонецЕсли;
Если Не ПустаяСтрока(бит_омни_МаршрутыMAX.ДопустимаяСсылкаМаршрута("https://host/" + Символы.ПС + "path")) Тогда
	ВызватьИсключение "Перевод строки внутри ссылки принят.";
КонецЕсли;
Если бит_омни_МаршрутыMAX.АдресДляФормата("А & Б <1>", "html") <> "А &amp; Б &lt;1&gt;" Тогда
	ВызватьИсключение "Адрес не экранирован для HTML.";
КонецЕсли;

НачатьТранзакцию();
Попытка
	Филиалы = Новый Массив;
	Для Номер = 1 По 2 Цикл
		Филиал = Справочники.Филиалы.СоздатьЭлемент();
		Филиал.Наименование = "MAX routes rollback " + Строка(Номер);
		Филиал.ОбменДанными.Загрузка = Истина;
		Филиал.Записать();
		Филиалы.Добавить(Филиал.Ссылка);
	КонецЦикла;
	ВидыКИ = Новый Массив;
	Для Каждого Сервис Из бит_омни_МаршрутыMAX.СервисыМаршрутов() Цикл
		Вид = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
		Вид.Наименование = "MAX routes rollback " + Сервис.Заголовок;
		Вид.Тип = Перечисления.ТипыКонтактнойИнформации.ВебСтраница;
		Вид.ОбменДанными.Загрузка = Истина;
		Вид.Записать();
		ВидыКИ.Добавить(Вид.Ссылка);
		Настройка = Справочники.бит_омни_Настройки.НайтиСоздатьКонстанту(Сервис.Настройка);
		РегистрыСведений.бит_омни_ЗначенияНастроек.УстановитьЗначениеКонстантыБезРазреза(Настройка, Вид.Ссылка);
		ЗаписьКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		ЗаписьКИ.Объект = Филиалы[0];
		ЗаписьКИ.Тип = Вид.Тип;
		ЗаписьКИ.Вид = Вид.Ссылка;
		ЗаписьКИ.Представление = Ссылки[Сервис.Ключ];
		ЗаписьКИ.Записать();
	КонецЦикла;
	ЗаписьАдреса = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	ЗаписьАдреса.Объект = Филиалы[0];
	ЗаписьАдреса.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	ЗаписьАдреса.Вид = Справочники.ВидыКонтактнойИнформации.АдресФактический;
	ЗаписьАдреса.Представление = "Тестовая улица, дом 123";
	ЗаписьАдреса.Записать();
	Шаблон = Справочники.бит_омни_ШаблоныСообщений.СоздатьЭлемент();
	Шаблон.ШаблонСообщения = "Ваша запись. <Адрес>";
	Шаблон.КнопкиMAX = "[[{""type"":""callback"",""text"":""Подтвердить"",""payload"":""test""}]]";
	Для Каждого Имя Из СтрРазделить("MAX_APPOINTMENT_CREATED,MAX_APPOINTMENT_REMINDER_24H,MAX_APPOINTMENT_REMINDER_2H", ",") Цикл
		Шаблон.ИдентификаторСтандартногоШаблона = Имя;
		Контекст = Новый Структура("ФилиалПосле", Филиалы[0]);
		Сообщение = Справочники.бит_омни_ШаблоныСообщений.СформироватьСообщениеПоШаблону(Шаблон, Неопределено, Контекст);
		Если Сообщение.Кнопки.Количество() <> 4 Или Сообщение.Кнопки[0][0].payload <> "test"
			Или СтрНайти(Сообщение.Текст, ЗаписьАдреса.Представление) = 0 Тогда
			ВызватьИсключение "Маршрут не добавлен либо исходные кнопки потеряны: " + Имя;
		КонецЕсли;
	КонецЦикла;
	Контекст.ФилиалПосле = Филиалы[1];
	Сообщение = Справочники.бит_омни_ШаблоныСообщений.СформироватьСообщениеПоШаблону(Шаблон, Неопределено, Контекст);
	Если Сообщение.Кнопки.Количество() <> 1 Или СтрНайти(Сообщение.Текст, ЗаписьАдреса.Представление) > 0 Тогда
		ВызватьИсключение "Другому филиалу передан адрес или ссылки первого филиала.";
	КонецЕсли;
	Контекст.ФилиалПосле = Филиалы[0];
	ЗаписьКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	ЗаписьКИ.Тип = Перечисления.ТипыКонтактнойИнформации.ВебСтраница;
	ЗаписьКИ.Объект = Филиалы[0];
	ЗаписьКИ.Вид = ВидыКИ[0];
	ЗаписьКИ.Прочитать();
	ЗаписьКИ.Представление = "https://yandex.ru/maps/?rtext=~55.71,37.65&rtt=auto";
	ЗаписьКИ.Записать();
	Сообщение = Справочники.бит_омни_ШаблоныСообщений.СформироватьСообщениеПоШаблону(Шаблон, Неопределено, Контекст);
	Если Сообщение.Кнопки[1][0].url <> ЗаписьКИ.Представление Тогда
		ВызватьИсключение "Новое сообщение использует устаревшую ссылку.";
	КонецЕсли;
	ЗаписьКИ.Удалить();
	Сообщение = Справочники.бит_омни_ШаблоныСообщений.СформироватьСообщениеПоШаблону(Шаблон, Неопределено, Контекст);
	Если Сообщение.Кнопки.Количество() <> 3 Или Сообщение.Кнопки[1][0].text <> "2ГИС" Тогда
		ВызватьИсключение "Удалённая ссылка осталась в новом сообщении.";
	КонецЕсли;
	Шаблон.ИдентификаторСтандартногоШаблона = "MAX_APPOINTMENT_CANCELLED";
	Сообщение = Справочники.бит_омни_ШаблоныСообщений.СформироватьСообщениеПоШаблону(Шаблон, Неопределено, Контекст);
	Если Сообщение.Кнопки.Количество() <> 1 Тогда
		ВызватьИсключение "Маршрут ошибочно добавлен к сообщению об отмене.";
	КонецЕсли;
	ОтменитьТранзакцию();
Исключение
	Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
	ВызватьИсключение;
КонецПопытки;
Результат = Новый Структура("ok", Истина);
