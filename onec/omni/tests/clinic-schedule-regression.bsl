Функция ВыполнитьРегрессиюГрафиковКлиники(Филиал) Экспорт

	Пусто = Дата(1, 1, 1);
	ДатаРедакции = Дата(2026, 1, 1);
	ПроверитьГрафик(Не бит_омни_ГрафикиКлиникиСервер.ПериодыКонфликтуют(
		Пусто, Пусто, ДатаРедакции, Дата(2027, 1, 1), Дата(2027, 1, 15), ДатаРедакции), "Основной и временный");
	ПроверитьГрафик(Не бит_омни_ГрафикиКлиникиСервер.ПериодыКонфликтуют(
		Дата(2027, 1, 1), Дата(2027, 1, 15), ДатаРедакции,
		Дата(2027, 1, 1), Дата(2027, 1, 3), ДатаРедакции), "Вложенные выходные");
	ПроверитьГрафик(бит_омни_ГрафикиКлиникиСервер.ПериодыКонфликтуют(
		Дата(2027, 1, 1), Дата(2027, 1, 15), ДатаРедакции,
		Дата(2027, 1, 10), Дата(2027, 1, 20), ДатаРедакции), "Частичное пересечение");
	ПроверитьГрафик(бит_омни_ГрафикиКлиникиСервер.ПериодыКонфликтуют(
		Пусто, Дата(2027, 1, 15), ДатаРедакции,
		Дата(2027, 1, 10), Пусто, ДатаРедакции), "Пересечение открытых границ");
	ПроверитьГрафик(бит_омни_ГрафикиКлиникиСервер.ПериодыКонфликтуют(
		Пусто, Пусто, ДатаРедакции, Пусто, Пусто, ДатаРедакции), "Совпадение редакций");
	ПроверитьГрафик(Не бит_омни_ГрафикиКлиникиСервер.ПериодыКонфликтуют(
		Пусто, Пусто, ДатаРедакции, Пусто, Пусто, ДатаРедакции + 1), "Поздняя редакция допустима");
	ПроверитьГрафик(бит_омни_ГрафикиКлиникиСервер.ДеньВПериоде(
		Дата(2027, 1, 15, 23, 59, 59), Дата(2027, 1, 1), Дата(2027, 1, 15)), "Последний день включительно");
	ПроверитьГрафик(Не бит_омни_ГрафикиКлиникиСервер.ДеньВПериоде(
		Дата(2027, 1, 16), Дата(2027, 1, 1), Дата(2027, 1, 15)), "Окончание периода");
	ПроверитьГрафик(бит_омни_ГрафикиКлиникиСервер.ВРабочееВремя(
		Дата(2027, 1, 4, 8, 0, 0), Дата(1, 1, 1, 8, 0, 0), Дата(1, 1, 1, 20, 0, 0)), "Открытие включительно");
	ПроверитьГрафик(Не бит_омни_ГрафикиКлиникиСервер.ВРабочееВремя(
		Дата(2027, 1, 4, 20, 0, 0), Дата(1, 1, 1, 8, 0, 0), Дата(1, 1, 1, 20, 0, 0)), "Закрытие не включено");
	ПроверитьГрафик(Не бит_омни_ГрафикиКлиникиСервер.ВРабочееВремя(
		Дата(2027, 1, 4, 12, 0, 0), Пусто, Пусто), "Выходной");

	НачатьТранзакцию();
	Попытка
		Основной = СоздатьТестовыйГрафик(Филиал, ДатаРедакции, Пусто, Пусто, 8, 20);
		Праздничный = СоздатьТестовыйГрафик(Филиал, ДатаРедакции + 1, Дата(2027, 1, 1), Дата(2027, 1, 15), 10, 19);
		Выходные = СоздатьТестовыйГрафик(Филиал, ДатаРедакции + 2, Дата(2027, 1, 1), Дата(2027, 1, 3), 0, 0);
		Действующий = бит_омни_ГрафикиКлиникиСервер.ДействующийГрафик(Филиал, Дата(2027, 1, 2, 12, 0, 0));
		ПроверитьГрафик(Действующий.Количество() = 7 И Действующий[0].Регистратор = Выходные.Ссылка, "Выбор самого узкого периода");
		Действующий = бит_омни_ГрафикиКлиникиСервер.ДействующийГрафик(Филиал, Дата(2027, 1, 4, 12, 0, 0));
		ПроверитьГрафик(Действующий[0].Регистратор = Праздничный.Ссылка, "Возврат к праздничному");
		Действующий = бит_омни_ГрафикиКлиникиСервер.ДействующийГрафик(Филиал, Дата(2027, 1, 18, 12, 0, 0));
		ПроверитьГрафик(Действующий[0].Регистратор = Основной.Ссылка, "Возврат к основному");
		НоваяРедакция = СоздатьТестовыйГрафик(Филиал, ДатаРедакции + 3, Пусто, Пусто, 9, 18);
		Действующий = бит_омни_ГрафикиКлиникиСервер.ДействующийГрафик(Филиал, Дата(2027, 1, 18, 12, 0, 0));
		ПроверитьГрафик(Действующий[0].Регистратор = НоваяРедакция.Ссылка, "Более поздняя редакция");
		НоваяРедакция.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Действующий = бит_омни_ГрафикиКлиникиСервер.ДействующийГрафик(Филиал, Дата(2027, 1, 18, 12, 0, 0));
		ПроверитьГрафик(Действующий[0].Регистратор = Основной.Ссылка, "Отмена проведения восстанавливает предыдущую редакцию");
		Ошибка = бит_омни_ГрафикиКлиникиСервер.ОшибкаГрафика(Пусто, Пусто, Основной.График);
		ПроверитьГрафик(ПустаяСтрока(Ошибка), "Валидный недельный график");
		Основной.График[0].ВремяОкончания = Пусто;
		ПроверитьГрафик(Не ПустаяСтрока(бит_омни_ГрафикиКлиникиСервер.ОшибкаГрафика(Пусто, Пусто, Основной.График)), "Нельзя заполнить одно время");
		Основной.График.Удалить(0);
		ПроверитьГрафик(Не ПустаяСтрока(бит_омни_ГрафикиКлиникиСервер.ОшибкаГрафика(Пусто, Пусто, Основной.График)), "Нельзя удалить день");
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат "PASS: 19 проверок графиков, документы и движения откатились; HTTP отсутствует.";

КонецФункции

Функция СоздатьТестовыйГрафик(Филиал, ДатаДокумента, ДатаНачала, ДатаОкончания, ЧасНачала, ЧасОкончания)

	Документ = Документы.бит_омни_УстановкаГрафиковРаботыКлиники.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	Документ.Филиал = Филиал;
	Документ.Дата = ДатаДокумента;
	Документ.ДатаНачала = ДатаНачала;
	Документ.ДатаОкончания = ДатаОкончания;
	Для Каждого День Из Документ.График Цикл
		Если ЧасНачала > 0 И День.ДеньНедели <= 5 Тогда
			День.ВремяНачала = Дата(1, 1, 1, ЧасНачала, 0, 0);
			День.ВремяОкончания = Дата(1, 1, 1, ЧасОкончания, 0, 0);
		КонецЕсли;
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Документ;

КонецФункции

Процедура ПроверитьГрафик(Условие, Описание)

	Если Не Условие Тогда ВызватьИсключение "FAIL: " + Описание; КонецЕсли;

КонецПроцедуры

Функция ВыполнитьРегрессиюАвтоответаКлиники(Филиал) Экспорт

	НачатьТранзакцию();
	Попытка
		Переключатель = Справочники.бит_омни_Настройки.НайтиСоздатьКонстанту("АвтоответВнеРабочегоВремени");
		Шаблон = Справочники.бит_омни_Настройки.НайтиСоздатьКонстанту("ШаблонАвтоответаВнеРабочегоВремени");
		РезервныйФилиал = Справочники.бит_омни_Настройки.НайтиСоздатьКонстанту("ФилиалАвтоответаMAX");
		РегистрыСведений.бит_омни_ЗначенияНастроек.УстановитьЗначениеКонстантыБезРазреза(Переключатель, Истина);
		РегистрыСведений.бит_омни_ЗначенияНастроек.УстановитьЗначениеКонстантыБезРазреза(Шаблон, "TEST AUTO: {ГрафикРаботы}");
		РегистрыСведений.бит_омни_ЗначенияНастроек.УстановитьЗначениеКонстантыБезРазреза(РезервныйФилиал, Филиал);
		ОбъектБота = Справочники.бит_омни_Боты.СоздатьЭлемент();
		ОбъектБота.Наименование = "TEST clinic schedule rollback";
		ОбъектБота.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
		ОбъектБота.Использовать = Ложь;
		ОбъектБота.Токен = "fixture-token-not-real";
		ОбъектБота.ОбменДанными.Загрузка = Истина;
		ОбъектБота.Записать();
		Бот = ОбъектБота.Ссылка;
		Контакт = бит_омни_НадежныйОбменMAX.ПолучитьИлиСоздатьКонтакт(990000001057, Бот, "TEST clinic schedule");
		График = СоздатьТестовыйГрафик(Филиал, ТекущаяДата() - 1, Дата(1, 1, 1), Дата(1, 1, 1), 0, 0);
		ПроверитьГрафик(бит_омни_ГрафикиКлиникиСервер.ФилиалДляАвтоответа(Контакт) = Филиал, "Филиал нераспределенного обращения");
		бит_омни_ГрафикиКлиникиСервер.АвтоответНаВходящее(Контакт, Бот);
		бит_омни_ГрафикиКлиникиСервер.АвтоответНаВходящее(Контакт, Бот);
		ПроверитьГрафик(КоличествоАвтоответовГрафика(Бот) = 2, "Отдельный автоответ на каждое сообщение");
		РегистрыСведений.бит_омни_ЗначенияНастроек.УстановитьЗначениеКонстантыБезРазреза(Переключатель, Ложь);
		бит_омни_ГрафикиКлиникиСервер.АвтоответНаВходящее(Контакт, Бот);
		ПроверитьГрафик(КоличествоАвтоответовГрафика(Бот) = 2, "Отключение автоответа");
		РегистрыСведений.бит_омни_ЗначенияНастроек.УстановитьЗначениеКонстантыБезРазреза(Переключатель, Истина);
		РегистрыСведений.бит_омни_ЗначенияНастроек.УстановитьЗначениеКонстантыБезРазреза(РезервныйФилиал, Справочники.Филиалы.ПустаяСсылка());
		бит_омни_ГрафикиКлиникиСервер.АвтоответНаВходящее(Контакт, Бот);
		ПроверитьГрафик(КоличествоАвтоответовГрафика(Бот) = 2, "Без филиала график не угадывается");
		Отделение = Справочники.бит_омни_ОтделенияMAX.СоздатьЭлемент();
		Отделение.Наименование = "TEST clinic branch";
		Отделение.Филиал = Филиал;
		Отделение.ОбменДанными.Загрузка = Истина;
		Отделение.Записать();
		ОбъектКонтакта = Контакт.ПолучитьОбъект();
		ОбъектКонтакта.ОтделениеMAX = Отделение.Ссылка;
		ОбъектКонтакта.ОбменДанными.Загрузка = Истина;
		ОбъектКонтакта.Записать();
		бит_омни_ГрафикиКлиникиСервер.АвтоответНаВходящее(Контакт, Бот);
		ПроверитьГрафик(КоличествоАвтоответовГрафика(Бот) = 3, "Филиал выбранного отделения");
		График.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		бит_омни_ГрафикиКлиникиСервер.АвтоответНаВходящее(Контакт, Бот);
		ПроверитьГрафик(КоличествоАвтоответовГрафика(Бот) = 3, "Нет действующего графика");
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат "PASS: 6 проверок автоответа, настройки/бот/контакты/документы/outbox откатились; HTTP отсутствует.";

КонецФункции

Функция КоличествоАвтоответовГрафика(Бот)

	Запрос = Новый Запрос("ВЫБРАТЬ ТелоJSON ИЗ РегистрСведений.бит_омни_ИсходящиеНамеренияMAX ГДЕ Бот = &Бот И Вид = &Вид");
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Вид", "message");
	Строки = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаИзОчереди Из Строки Цикл
		ПроверитьГрафик(СтрНайти(СтрокаИзОчереди.ТелоJSON, "TEST AUTO:") > 0, "Текст автоответа в outbox");
		ПроверитьГрафик(СтрНайти(СтрокаИзОчереди.ТелоJSON, "{ГрафикРаботы}") = 0, "Подстановка действующего графика");
		ПроверитьГрафик(СтрНайти(СтрокаИзОчереди.ТелоJSON, "выходной") > 0, "Представление выходного");
	КонецЦикла;
	Возврат Строки.Количество();

КонецФункции
