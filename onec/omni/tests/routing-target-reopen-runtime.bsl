// Модуль объекта доверенной EPF; запускать ТОЛЬКО в изолированной копии базы.
// Вызов: Обработка.ВыполнитьПроверкиМаршрутизацииMAX(ПациентДо, ПациентПосле).
// Нужны две существующие карточки клиентов. Все новые данные откатываются.
// HTTP, inbox dispatch, исходящие сообщения и фоновые задания не вызываются.
// Private routing helper в конце извлечен из production-модуля; source test
// проверяет его совпадение. Остальные проверки вызывают реальные exported API.
// Это fixture полного доступа; обычный оператор проверяется отдельно вторым export.

Функция ВыполнитьПроверкиМаршрутизацииMAX(ПациентДо = Неопределено, ПациентПосле = Неопределено) Экспорт

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "FIXTURE_REQUIRES_OWN_TRANSACTION"; КонецЕсли;
	Если ПациентДо = Неопределено Или ПациентПосле = Неопределено Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.Клиенты
			|ГДЕ НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Ссылка");
		Клиенты = Запрос.Выполнить().Выгрузить();
		Если Клиенты.Количество() <> 2 Тогда ВызватьИсключение "SETUP_REQUIRED: two patients"; КонецЕсли;
		ПациентДо = Клиенты[0].Ссылка;
		ПациентПосле = Клиенты[1].Ссылка;
	КонецЕсли;
	Если ТипЗнч(ПациентДо) <> Тип("СправочникСсылка.Клиенты") Или Не ЗначениеЗаполнено(ПациентДо)
		Или ТипЗнч(ПациентПосле) <> Тип("СправочникСсылка.Клиенты") Или Не ЗначениеЗаполнено(ПациентПосле)
		Или ПациентДо = ПациентПосле Тогда ВызватьИсключение "SETUP_REQUIRED: two distinct patient references"; КонецЕсли;
	Пациент1 = ПациентДо;
	Пациент2 = ПациентПосле;
	Проверки = Новый Массив;
	НачатьТранзакцию();
	Попытка
		БотОбъект = Справочники.бит_омни_Боты.СоздатьЭлемент();
		БотОбъект.Наименование = "ROUTING_ROLLBACK_" + Строка(Новый УникальныйИдентификатор);
		БотОбъект.Использовать = Истина;
		БотОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
		БотОбъект.ОбменДанными.Загрузка = Истина;
		БотОбъект.Записать();
		Бот = БотОбъект.Ссылка;
		Отделение1 = ТестСоздатьОтделениеMAX("ROUTING_ROLLBACK_A");
		Отделение2 = ТестСоздатьОтделениеMAX("ROUTING_ROLLBACK_B");
		Контакт = ТестСоздатьКонтактMAX(Бот, Пациент1, Отделение1, 990000014001);
		Период = ТекущаяДатаСеанса();
		ТестЗаписатьВходящееMAX(Контакт, Бот, "fixture:previous-same-second", Период);
		ТестЗаписатьВходящееMAX(Контакт, Бот, "fixture:first", Период);

		// У нового диалога нет строки состояния. Обычный incoming тоже актуален.
		Контекст = бит_омни_ИнтеграцияСMAX.ФиксироватьОткрытиеДиалогаПриПриемеMAX(Контакт, Бот);
		ТестПроверитьMAX(Не Контекст.ПовторноеОбращение, "fresh ordinary event repeat flag");
		ТестПроверитьMAX(бит_омни_ИнтеграцияСMAX.ПовторноеОбращениеАктуальноMAX(
			Контакт, Бот, Контекст, "fixture:first", Период), "fresh ordinary event guard");
		Проверки.Добавить("fresh_nonclosed_context_with_previous_same_second_mid");

		ТестУстановитьСостояниеMAX(Пациент1, Бот, Отделение1, Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт);
		Контекст = бит_омни_ИнтеграцияСMAX.ФиксироватьОткрытиеДиалогаПриПриемеMAX(Контакт, Бот);
		ТестПроверитьMAX(Контекст.ПовторноеОбращение, "closed repeat flag");
		ТестПроверитьНовыйMAX(Пациент1, Бот, Отделение1, "durable reopen");
		ТестПроверитьMAX(бит_омни_ИнтеграцияСMAX.ПовторноеОбращениеАктуальноMAX(
			Контакт, Бот, Контекст, "fixture:first", Период), "repeat without newer input");
		Проверки.Добавить("durable_reopen_and_guard");

		// Другое входящее в ту же секунду делает прежний контекст устаревшим.
		ТестЗаписатьВходящееMAX(Контакт, Бот, "fixture:newer", Период);
		ТестПроверитьMAX(Не бит_омни_ИнтеграцияСMAX.ПовторноеОбращениеАктуальноMAX(
			Контакт, Бот, Контекст, "fixture:first", Период), "same-second newer MID guard");
		ТестУдалитьВходящееMAX(Контакт, Бот, "fixture:newer", Период);
		ТестПроверитьMAX(бит_омни_ИнтеграцияСMAX.ПовторноеОбращениеАктуальноMAX(
			Контакт, Бот, Контекст, "fixture:first", Период), "same-second own MID guard");
		Проверки.Добавить("same_second_different_and_same_mid");
		// Архивирование сохраняет логический набор MID+period, включая момент,
		// когда строка уже скопирована в архив, а из истории еще не удалена.
		ТестЗаписатьВходящееMAX(Контакт, Бот, "fixture:first", Период, Истина);
		ТестПроверитьMAX(бит_омни_ИнтеграцияСMAX.ПовторноеОбращениеАктуальноMAX(
			Контакт, Бот, Контекст, "fixture:first", Период), "archive copy unchanged context");
		ТестУдалитьВходящееMAX(Контакт, Бот, "fixture:first", Период);
		ТестПроверитьMAX(бит_омни_ИнтеграцияСMAX.ПовторноеОбращениеАктуальноMAX(
			Контакт, Бот, Контекст, "fixture:first", Период), "archive migration unchanged context");
		Проверки.Добавить("archive_migration_preserves_context");

		ТестЗаписатьВходящееMAX(Контакт, Бот, "fixture:archive-newer", Период, Истина);
		ТестПроверитьMAX(Не бит_омни_ИнтеграцияСMAX.ПовторноеОбращениеАктуальноMAX(
			Контакт, Бот, Контекст, "fixture:first", Период), "archived newer input guard");
		Проверки.Добавить("archive_newer_guard");

		// Проверяем именно TARGET patient+bot+dept, ранее закрытый другим обращением.
		ТестУстановитьСостояниеMAX(Пациент2, Бот, Отделение1, Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт);
		ТестИзменитьМаршрутизациюКонтактаВТранзакцииMAX(Контакт, Бот, Пациент2, Ложь, Ложь);
		ТестПроверитьНовыйMAX(Пациент2, Бот, Отделение1, "patient target closed");
		ТестПроверитьMAX(Не бит_омни_ИнтеграцияСMAX.ПовторноеОбращениеАктуальноMAX(
			Контакт, Бот, Контекст, "fixture:first", Период), "rerouted context guard");
		Проверки.Добавить("closed_patient_target_and_reroute_guard");

		ТестИзменитьМаршрутизациюКонтактаВТранзакцииMAX(Контакт, Бот, , Ложь, Истина);
		ТестУстановитьСостояниеMAX(Пациент2, Бот, Отделение2, Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт);
		Назначение = бит_омни_ОтделенияMAXСервер.ЗакрепитьОтделение(Контакт, Бот, Отделение2, "fixture-dept-a");
		ТестПроверитьMAX(Назначение.Изменено, "first department assignment");
		ТестПроверитьНовыйMAX(Пациент2, Бот, Отделение2, "department target closed");
		ТестПроверитьMAX(ТестКоличествоСобытийMAX(Контакт, Бот, "department:fixture-dept-a") = 1, "first department history");
		Назначение = бит_омни_ОтделенияMAXСервер.ЗакрепитьОтделение(Контакт, Бот, Отделение1, "fixture-dept-b");
		ТестПроверитьMAX(Не Назначение.Изменено И Назначение.Отделение = Отделение2, "old department button preserves assignment");
		ТестПроверитьMAX(ТестКоличествоСобытийMAX(Контакт, Бот, "department:fixture-dept-b") = 0, "repeated assignment no new history");
		ТестИзменитьМаршрутизациюКонтактаВТранзакцииMAX(Контакт, Бот, , Ложь, Истина);
		Назначение = бит_омни_ОтделенияMAXСервер.ЗакрепитьОтделение(Контакт, Бот, Отделение2, "fixture-dept-c");
		ТестПроверитьMAX(Назначение.Изменено, "new department cycle");
		ТестПроверитьMAX(ТестКоличествоСобытийMAX(Контакт, Бот, "department:fixture-dept-c") = 1, "new callback cycle has new history");
		Проверки.Добавить("closed_department_target_and_event_history");

		// Второй контакт с тем же пациентом/ботом/отделением использует общий state.
		Контакт2 = ТестСоздатьКонтактMAX(Бот, Пациент2, Отделение2, 990000014002);
		ТестУстановитьСостояниеMAX(Пациент2, Бот, Отделение2, Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт);
		Контекст2 = бит_омни_ИнтеграцияСMAX.ФиксироватьОткрытиеДиалогаПриПриемеMAX(Контакт2, Бот);
		ТестПроверитьMAX(Контекст2.ПовторноеОбращение, "shared patient state repeat flag");
		ТестПроверитьНовыйMAX(Пациент2, Бот, Отделение2, "shared patient state reopened");
		Проверки.Добавить("shared_patient_bot_department_state");
		ОтменитьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Новый Структура("Успех,Проверки,Откат", Истина, Проверки, Истина);

КонецФункции

// Отдельный вызов в сессии ОБЫЧНОГО оператора, без привилегированного режима.
// Контакты подготавливает runner в изолированной базе с назначениями разных отделений.
// Только чтение; не доказывается запуском первого export от администратора.
Функция ПроверитьДоступОператораМаршрутизацииMAX(СвойКонтакт, ЧужойКонтакт, Бот) Экспорт

	Если ПривилегированныйРежим() Или РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение "ORDINARY_OPERATOR_SESSION_REQUIRED";
	КонецЕсли;
	бит_омни_ОтделенияMAXСервер.ПроверитьДоступККонтакту(СвойКонтакт, Бот);
	Отклонено = Ложь;
	Попытка
		бит_омни_ОтделенияMAXСервер.ПроверитьДоступККонтакту(ЧужойКонтакт, Бот);
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	ТестПроверитьMAX(Отклонено, "foreign department denied to ordinary operator");
	Возврат Новый Структура("Успех,Проверки", Истина, "own_allowed_foreign_denied");

КонецФункции

Процедура ТестПроверитьMAX(Условие, Сценарий)
	Если Не Условие Тогда ВызватьИсключение "ROUTING_FAIL: " + Сценарий; КонецЕсли;
КонецПроцедуры

Функция ТестСоздатьОтделениеMAX(Имя)
	Объект = Справочники.бит_омни_ОтделенияMAX.СоздатьЭлемент();
	Объект.Наименование = Имя;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция ТестСоздатьКонтактMAX(Бот, Пациент, Отделение, Идентификатор)
	Объект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	Объект.Наименование = "ROUTING_ROLLBACK_" + Строка(Новый УникальныйИдентификатор);
	Объект.Бот = Бот;
	Объект.Получатель = Пациент;
	Объект.ОтделениеMAX = Отделение;
	Объект.Идентификатор = Идентификатор;
	Объект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Процедура ТестУстановитьСостояниеMAX(Пациент, Бот, Отделение, Состояние)
	Запись = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
	Запись.Пациент = Пациент;
	Запись.Бот = Бот;
	Запись.Отделение = Отделение;
	Запись.Состояние = Состояние;
	Запись.ДатаИзменения = ТекущаяДатаСеанса() - 60;
	Запись.Ответственный = Справочники.Пользователи.ПустаяСсылка();
	Запись.Записать();
КонецПроцедуры

Процедура ТестПроверитьНовыйMAX(Пациент, Бот, Отделение, Сценарий)
	Запись = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
	Запись.Пациент = Пациент;
	Запись.Бот = Бот;
	Запись.Отделение = Отделение;
	Запись.Прочитать();
	ТестПроверитьMAX(Запись.Выбран()
		И Запись.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Новый
		И Не ЗначениеЗаполнено(Запись.Ответственный), Сценарий);
КонецПроцедуры

Процедура ТестЗаписатьВходящееMAX(Контакт, Бот, Идентификатор, Период, Архив = Ложь)
	Если Архив Тогда
		Запись = РегистрыСведений.бит_омни_АрхивЧатовMAX.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторАрхива = Строка(Новый УникальныйИдентификатор);
		Запись.Отделение = Контакт.ОтделениеMAX;
		Запись.Пациент = Контакт.Получатель;
		Запись.ДатаАрхивации = ТекущаяДатаСеанса();
	Иначе
		Запись = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	КонецЕсли;
	Запись.Период = Период;
	Запись.ИдентификаторСообщения = Идентификатор;
	Запись.Контакт = Контакт;
	Запись.Бот = Бот;
	Запись.Входящее = Истина;
	Запись.Текст = "ROUTING_ROLLBACK";
	Запись.ВидСообщения = "text";
	Запись.Записать();
КонецПроцедуры

Процедура ТестУдалитьВходящееMAX(Контакт, Бот, Идентификатор, Период)
	Запись = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.ИдентификаторСообщения = Идентификатор;
	Запись.Контакт = Контакт;
	Запись.Бот = Бот;
	Запись.Входящее = Истина;
	Запись.Удалить();
КонецПроцедуры

Функция ТестКоличествоСобытийMAX(Контакт, Бот, Идентификатор)
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX
		|ГДЕ Контакт = &Контакт И Бот = &Бот И Входящее И ИдентификаторСообщения = &Идентификатор");
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Возврат Запрос.Выполнить().Выгрузить()[0].Количество;
КонецФункции

// BEGIN EXTRACTED ROUTING HELPER: keep in sync with production (source test).
Функция ТестИзменитьМаршрутизациюКонтактаВТранзакцииMAX(
		Контакт, Бот, Пациент = Неопределено, СброситьПациента = Ложь, СброситьОтделение = Ложь)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_омни_Контакты");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Контакт);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	КонтактОбъект = Контакт.ПолучитьОбъект();
	Если КонтактОбъект.ПометкаУдаления Или КонтактОбъект.Заблокирован Или КонтактОбъект.Бот <> Бот
		Или КонтактОбъект.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ВызватьИсключение "Контакт MAX изменился во время маршрутизации.";
	КонецЕсли;
	Если СброситьПациента Тогда
		КонтактОбъект.Получатель = Справочники.Клиенты.ПустаяСсылка();
	ИначеЕсли Пациент <> Неопределено Тогда
		КонтактОбъект.Получатель = Пациент;
	КонецЕсли;
	Если СброситьОтделение Тогда
		КонтактОбъект.ОтделениеMAX = Справочники.бит_омни_ОтделенияMAX.ПустаяСсылка();
	КонецЕсли;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();
	бит_омни_ИнтеграцияСMAX.ПеревестиЗакрытыйДиалогВНовыйMAX(КонтактОбъект.Ссылка, Бот);
	Возврат КонтактОбъект.Ссылка;

КонецФункции
// END EXTRACTED ROUTING HELPER
