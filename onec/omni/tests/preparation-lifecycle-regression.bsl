// Встраивается в ObjectModule фиксированной тестовой EPF. Это не сетевой тест.
// Все ссылки передаёт изолированный harness: только его fixture, не рабочие данные.
// Источник должен быть валидной копией штатной заявки, а бот — fixture с пустым токеном.
// Создание/очистка fixture вне этих функций принадлежит harness.

// Вызывать в обычном сеансе регистратора с базовой ролью. Принадлежность активной
// намеренно повреждённой рассылки уже должна содержать Документ.Заявка.
Функция бит_ПроверитьОбычнуюЗаписьСОшибочнойРассылкой(Заявка) Экспорт
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "TEST: требуется обычная самостоятельная запись."; КонецЕсли;
	Объект = Заявка.ПолучитьОбъект();
	Если Объект.ОбменДанными.Загрузка
		Или Объект.ДополнительныеСвойства.Свойство("бит_омни_НеПроверять") Тогда
		ВызватьИсключение "TEST: нельзя обходить обычные подписки записи.";
	КонецЕсли;
	// Это именно Document.Write, не ручной вызов экспортных подписок.
	Объект.Записать();
	Возврат "PASS_NORMAL_DOCUMENT_WRITE_COMMITTED";
КонецФункции

// Выполняется под служебным/полным пользователем после предыдущего вызова.
// Поломанная СКД/алгоритм должна привести к durable error намерения, не откату заявки.
Функция бит_ПроверитьИзолированнуюОшибкуПодготовки(Заявка, Рассылка, Бот) Экспорт
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "TEST: подготовка вне медицинской транзакции."; КонецЕсли;
	Ключ = "Документ.Заявка:" + Строка(Заявка.УникальныйИдентификатор());
	Запись = РегистрыСведений.бит_ПодготовкаРассылокMAX.СоздатьМенеджерЗаписи();
	Запись.Источник = Ключ;
	Запись.Рассылка = Рассылка;
	Запись.Бот = Бот;
	Запись.Прочитать();
	Если Не Запись.Выбран() Или Запись.Состояние <> "Ожидает" Тогда ВызватьИсключение "FAIL: ordinary write did not commit intent"; КонецЕсли;
	Версия = Запись.Версия;
	бит_ПодготовкаУведомленийMAX.ВыполнитьПодготовку(Ключ, Бот);
	Запись.Прочитать();
	Если Не Запись.Выбран() Или Запись.Версия <> Версия Или Запись.Попыток <> 1
		Или ПустаяСтрока(Запись.Ошибка) Или Запись.Снимок.Получить() = Неопределено Тогда
		ВызватьИсключение "FAIL: preparation failure was not retained for recovery";
	КонецЕсли;
	Если СтрНайти(Запись.Ошибка, "PREPARATION_EXPECTED_FIXTURE_FAILURE") = 0 Тогда
		ВызватьИсключение "FAIL: unexpected preparation failure instead of deliberate renderer error: " + Запись.Ошибка;
	КонецЕсли;
	Если Заявка.ПолучитьОбъект() = Неопределено Тогда ВызватьИсключение "FAIL: appointment rolled back"; КонецЕсли;
	Возврат "PASS_DURABLE_PREPARATION_FAILURE_MEDICAL_WRITE_PRESERVED";
КонецФункции

// Fixture обязан содержать pending IMMEDIATE, привязанного пациента и стандартную
// рассылку MAX_APPOINTMENT_CREATED. Проверяется перенос до сетевого worker.
Функция бит_ПроверитьОбновлениеОжидающегоСоздания(Заявка, Бот, НоваяДата) Экспорт
	Объект = Заявка.ПолучитьОбъект();
	Объект.ДатаНачала = НоваяДата;
	Объект.ДатаОкончания = НоваяДата + 1800;
	Объект.Записать();
	Ключ = "Документ.Заявка:" + Строка(Заявка.УникальныйИдентификатор());
	бит_ПодготовкаУведомленийMAX.ВыполнитьПодготовку(Ключ, Бот);
	Запрос = Новый Запрос("ВЫБРАТЬ Очередь.ТелоJSON КАК ТелоJSON, Очередь.АдресатJSON КАК АдресатJSON
	|ИЗ РегистрСведений.бит_омни_ОчередьСообщенийMAX КАК Очередь
	|ГДЕ Очередь.Источник = &Источник И Очередь.Бот = &Бот
	| И Очередь.Правило = ""IMMEDIATE"" И Очередь.Состояние = ""Ожидает""");
	Запрос.УстановитьПараметр("Источник", Ключ);
	Запрос.УстановитьПараметр("Бот", Бот);
	Строки = Запрос.Выполнить().Выгрузить();
	Если Строки.Количество() <> 1 Тогда ВызватьИсключение "FAIL: expected one refreshed immediate event"; КонецЕсли;
	Если СтрНайти(Строки[0].АдресатJSON, Формат(НоваяДата, "ДФ=yyyyMMddHHmmss")) = 0 Тогда
		ВызватьИсключение "FAIL: stale immediate source version";
	КонецЕсли;
	Возврат "PASS_IMMEDIATE_REFRESHED_NO_HTTP";
КонецФункции

// Проверить после настоящего callback cancelYes (harness получает cancel nonce
// через cancel, затем вызывает тот же менеджер callback с существующей связью).
Функция бит_ПроверитьОчередьПослеОтменыCallback(Заявка, Бот) Экспорт
	Если Заявка.Состояние <> Справочники.ВидыСостоянийЗаявок.Отменена Тогда
		ВызватьИсключение "FAIL: callback did not cancel appointment";
	КонецЕсли;
	Ключ = "Документ.Заявка:" + Строка(Заявка.УникальныйИдентификатор());
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Очередь.Ключ КАК Ключ
	|ИЗ РегистрСведений.бит_омни_ОчередьСообщенийMAX КАК Очередь
	|ГДЕ Очередь.Источник = &Источник И Очередь.Бот = &Бот И Очередь.Состояние = ""Ожидает""");
	Запрос.УстановитьПараметр("Источник", Ключ);
	Запрос.УстановитьПараметр("Бот", Бот);
	Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "FAIL: callback left pending reminders"; КонецЕсли;
	бит_ПодготовкаУведомленийMAX.ВыполнитьПодготовку(Ключ, Бот);
	Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "FAIL: preparation resurrected canceled reminder"; КонецЕсли;
	Возврат "PASS_CANCEL_CALLBACK_NO_PENDING_NO_RESURRECTION";
КонецФункции

// Передать две fixture-рассылки одного fixture-бота: первая без СКД контекста,
// вторая с валидной СКД, возвращающей ноль строк. У обеих наступил срок расписания,
// есть один получатель, фиксированный текст, очередь этого запуска ещё отсутствует.
Функция бит_ПроверитьПустойКонтекстРасписания(Бот, БезКонтекста, ПустойФильтр) Экспорт
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "TEST: schedule producer outside transaction"; КонецЕсли;
	бит_омни_НапоминанияMAX.ВыполнитьНапоминания(Бот);
	Запрос = Новый Запрос("ВЫБРАТЬ Очередь.Рассылка КАК Рассылка, КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ РегистрСведений.бит_омни_ОчередьСообщенийMAX КАК Очередь
	|ГДЕ Очередь.Бот = &Бот И Очередь.Правило = ""SCHEDULE""
	|СГРУППИРОВАТЬ ПО Очередь.Рассылка");
	Запрос.УстановитьПараметр("Бот", Бот);
	Результат = Запрос.Выполнить().Выгрузить();
	Статическая = Результат.Найти(БезКонтекста, "Рассылка");
	Отфильтрованная = Результат.Найти(ПустойФильтр, "Рассылка");
	Если Статическая = Неопределено Или Статическая.Количество <> 1 Тогда
		ВызватьИсключение "FAIL: no-SKD fixed message not prepared";
	КонецЕсли;
	Если Отфильтрованная <> Неопределено Тогда ВызватьИсключение "FAIL: explicit empty filter was ignored"; КонецЕсли;
	Возврат "PASS_NO_CONTEXT_STATIC_MESSAGE_AND_EXPLICIT_EMPTY_FILTER";
КонецФункции
