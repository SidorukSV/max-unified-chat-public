// Только изолированная тестовая база. execute_code: все фикстуры внутри откатываемой
// транзакции. Бот выключен, нет активных рассылок, HTTP и отправка не вызываются.
// Проверяет реальные экспортные методы установленного расширения.
НачатьТранзакцию();
Попытка
	Момент = Дата(2042, 1, 15, 12, 0, 0);
	Для Каждого Смещение Из СтрРазделить("-900,-899,0,1", ",") Цикл
		Секунды = Число(Смещение);
		Ожидается = Секунды >= -899 И Секунды <= 0;
		Если бит_омни_НапоминанияMAX.ВОкнеСобытия(Момент + Секунды, Момент) <> Ожидается Тогда
			ВызватьИсключение "FAIL: pure event window " + Смещение;
		КонецЕсли;
	КонецЦикла;
	Если бит_омни_НапоминанияMAX.ВОкнеСобытия(Неопределено, Момент)
		Или бит_омни_НапоминанияMAX.ВОкнеСобытия(Дата(1, 1, 1), Момент) Тогда
		ВызватьИсключение "FAIL: empty event date accepted";
	КонецЕсли;

	ПациентОбъект = Справочники.Клиенты.СоздатьЭлемент();
	ПациентОбъект.Наименование = "EVENT_DATES_ROLLBACK_" + Строка(Новый УникальныйИдентификатор);
	ПациентОбъект.ОбменДанными.Загрузка = Истина;
	ПациентОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	ПациентОбъект.Записать();
	Пациент = ПациентОбъект.Ссылка;

	БотОбъект = Справочники.бит_омни_Боты.СоздатьЭлемент();
	БотОбъект.Наименование = "EVENT_DATES_ROLLBACK_BOT";
	БотОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	БотОбъект.Использовать = Ложь;
	БотОбъект.ОбменДанными.Загрузка = Истина;
	БотОбъект.Записать();
	Бот = БотОбъект.Ссылка;

	КонтактОбъект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	КонтактОбъект.Наименование = "EVENT_DATES_ROLLBACK_CONTACT";
	КонтактОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	КонтактОбъект.Бот = Бот;
	КонтактОбъект.Идентификатор = 999999999998;
	КонтактОбъект.Получатель = Пациент;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();

	ШаблонОбъект = Справочники.бит_омни_ШаблоныСообщений.СоздатьЭлемент();
	ШаблонОбъект.Наименование = "EVENT_DATES_ROLLBACK_TEMPLATE";
	ШаблонОбъект.ОбменДанными.Загрузка = Истина;
	ШаблонОбъект.Записать();

	РассылкаОбъект = Справочники.бит_омни_Рассылки.СоздатьЭлемент();
	РассылкаОбъект.Наименование = "EVENT_DATES_ROLLBACK_MAILING";
	РассылкаОбъект.РежимРассылки = Перечисления.бит_омни_РежимыРассылки.ПоРасписанию;
	РассылкаОбъект.Шаблон = ШаблонОбъект.Ссылка;
	РассылкаОбъект.СКДКонтекст = Новый ХранилищеЗначения(Неопределено);
	РассылкаОбъект.ОбменДанными.Загрузка = Истина;
	Правило = РассылкаОбъект.ДатыСобытия.Добавить();
	Правило.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	Правило.Использовать = Истина;
	Правило.Шаблон = "ДоДаты";
	Правило.РеквизитКонтекста = "ДатаНачала";
	Правило.КоличествоЧасов = 24;
	РассылкаОбъект.Записать();
	ИдПравила = Правило.ИдентификаторСтроки;
	Рассылка = РассылкаОбъект.Ссылка;

	ЗаявкаОбъект = Документы.Заявка.СоздатьДокумент();
	ЗаявкаОбъект.Дата = Момент;
	ЗаявкаОбъект.Клиент = Пациент;
	ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована;
	ЗаявкаОбъект.ДатаНачала = Момент + 86400;
	ЗаявкаОбъект.ДатаОкончания = ЗаявкаОбъект.ДатаНачала + 1800;
	ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
	ЗаявкаОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	ЗаявкаОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	ЗаявкаОбъект.Записать();
	Заявка = ЗаявкаОбъект.Ссылка;

	// Реальный SQL-отбор, а не только чистая формула. Четыре границы для каждого шаблона.
	Для Каждого ВидШаблона Из СтрРазделить("ДоДаты,ПослеДаты,ДатаОбъекта", ",") Цикл
		Правило.Шаблон = ВидШаблона;
		Правило.РеквизитКонтекста = ?(ВидШаблона = "ДатаОбъекта", "Дата", "ДатаНачала");
		Правило.КоличествоЧасов = ?(ВидШаблона = "ДатаОбъекта", 0, 1.5);
		РассылкаОбъект.Записать();
		Для Каждого Смещение Из СтрРазделить("-900,-899,0,1", ",") Цикл
			Секунды = Число(Смещение);
			ДатаСобытия = Момент + Секунды;
			ДатаИсточника = ДатаСобытия + ?(ВидШаблона = "ДоДаты", 5400,
				?(ВидШаблона = "ПослеДаты", -5400, 0));
			Если ВидШаблона = "ДатаОбъекта" Тогда
				ЗаявкаОбъект.Дата = ДатаИсточника;
			Иначе
				ЗаявкаОбъект.ДатаНачала = ДатаИсточника;
				ЗаявкаОбъект.ДатаОкончания = ДатаИсточника + 1800;
			КонецЕсли;
			ЗаявкаОбъект.Записать();
			Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(
				Бот, Рассылка, ИдПравила, Момент, Заявка);
			Ожидается = ?(Секунды >= -899 И Секунды <= 0, 1, 0);
			Если Кандидаты.Количество() <> Ожидается Тогда
				ВызватьИсключение "FAIL: query window " + ВидШаблона + " " + Смещение;
			КонецЕсли;
			Если Ожидается = 1 Тогда
				Если Кандидаты[0].ДатаОтправки <> ДатаСобытия
					Или Кандидаты[0].Заявка <> Заявка
					Или Кандидаты[0].Контакт <> КонтактОбъект.Ссылка Тогда
					ВызватьИсключение "FAIL: candidate context " + ВидШаблона;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Правило.Шаблон = "ДоДаты";
	Правило.РеквизитКонтекста = "ДатаНачала";
	Правило.КоличествоЧасов = 24;
	РассылкаОбъект.Записать();
	ЗаявкаОбъект.ДатаНачала = Момент + 86400;
	ЗаявкаОбъект.ДатаОкончания = ЗаявкаОбъект.ДатаНачала + 1800;
	ЗаявкаОбъект.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Тогда ВызватьИсключение "FAIL: baseline"; КонецЕсли;
	КлючДо = Кандидаты[0].Этап;

	// Номер строки не должен участвовать в ключе доставки.
	ВтораяСтрока = РассылкаОбъект.ДатыСобытия.Добавить();
	ВтораяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	ВтораяСтрока.Использовать = Истина;
	ВтораяСтрока.Шаблон = "ДоДаты";
	ВтораяСтрока.РеквизитКонтекста = "ДатаНачала";
	ВтораяСтрока.КоличествоЧасов = 24;
	ВторойИд = ВтораяСтрока.ИдентификаторСтроки;
	РассылкаОбъект.ДатыСобытия.Сдвинуть(Правило, 1);
	РассылкаОбъект.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Или Кандидаты[0].Этап <> КлючДо Тогда
		ВызватьИсключение "FAIL: row reorder changed delivery identity";
	КонецЕсли;
	Кандидат = Кандидаты[0];
	КандидатыВторой = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ВторойИд, Момент, Заявка);
	Если КандидатыВторой.Количество() <> 1 Или КандидатыВторой[0].Этап = КлючДо Тогда
		ВызватьИсключение "FAIL: independent rows share delivery identity";
	КонецЕсли;

	// Только запись отметки доставки; никакого захвата/HTTP.
	Доставка = РегистрыСведений.бит_омни_ДоставкаНапоминанийMAX.СоздатьМенеджерЗаписи();
	Доставка.Бот = Бот;
	Доставка.Заявка = Заявка;
	Доставка.ДатаНачала = Кандидат.ДатаНачала;
	Доставка.Этап = Кандидат.Этап;
	Доставка.Контакт = КонтактОбъект.Ссылка;
	Доставка.Состояние = "Отправлено";
	Доставка.Обновлено = Момент;
	Доставка.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 0 Тогда ВызватьИсключение "FAIL: sent event not deduplicated"; КонецЕсли;
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ВторойИд, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Тогда ВызватьИсключение "FAIL: one row suppresses another"; КонецЕсли;
	ЗаявкаОбъект.ДатаНачала = ЗаявкаОбъект.ДатаНачала - 60;
	ЗаявкаОбъект.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Или Кандидаты[0].Этап = КлючДо Тогда
		ВызватьИсключение "FAIL: appointment move reused old event";
	КонецЕсли;

	ПоддерживаетсяГрупповая = Метаданные.Документы.Заявка.Реквизиты.Найти("Групповая") <> Неопределено;
	Для Каждого Сценарий Из СтрРазделить("canceled,deleted,unlinked,blocked,contact_deleted,patient_deleted,zero_id,group,disabled_row,write_mode", ",") Цикл
		Если Сценарий = "group" И Не ПоддерживаетсяГрупповая Тогда Продолжить; КонецЕсли;
		ЗаявкаОбъект.Состояние = ?(Сценарий = "canceled", Справочники.ВидыСостоянийЗаявок.Отменена,
			Справочники.ВидыСостоянийЗаявок.Запланирована);
		ЗаявкаОбъект.ПометкаУдаления = Сценарий = "deleted";
		ЗаявкаОбъект.Клиент = ?(Сценарий = "unlinked", Справочники.Клиенты.ПустаяСсылка(), Пациент);
		Если ПоддерживаетсяГрупповая Тогда ЗаявкаОбъект.Групповая = Сценарий = "group"; КонецЕсли;
		ЗаявкаОбъект.Записать();
		КонтактОбъект.Заблокирован = Сценарий = "blocked";
		КонтактОбъект.ПометкаУдаления = Сценарий = "contact_deleted";
		КонтактОбъект.Идентификатор = ?(Сценарий = "zero_id", 0, 999999999998);
		КонтактОбъект.Записать();
		ПациентОбъект.ПометкаУдаления = Сценарий = "patient_deleted";
		ПациентОбъект.Записать();
		Правило.Использовать = Сценарий <> "disabled_row";
		РассылкаОбъект.РежимРассылки = ?(Сценарий = "write_mode",
			Перечисления.бит_омни_РежимыРассылки.ПриЗаписиОбъекта,
			Перечисления.бит_омни_РежимыРассылки.ПоРасписанию);
		РассылкаОбъект.Записать();
		Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
		Если Кандидаты.Количество() <> 0 Тогда ВызватьИсключение "FAIL: exclusion " + Сценарий; КонецЕсли;
	КонецЦикла;

	// Стандартная мигрированная строка сохраняет уже существующую отметку 24H,
	// даже если оператор позже добавил ещё одно правило.
	ШаблонОбъект.ИдентификаторСтандартногоШаблона = "MAX_APPOINTMENT_REMINDER_24H";
	ШаблонОбъект.Записать();
	РассылкаОбъект.ДатыСобытия.Удалить(ВтораяСтрока);
	Правило.ИдентификаторСтроки = "00000000-0000-0000-0000-000000000024";
	ИдПравила = Правило.ИдентификаторСтроки;
	Правило.Использовать = Истина;
	РассылкаОбъект.РежимРассылки = Перечисления.бит_омни_РежимыРассылки.ПоРасписанию;
	РассылкаОбъект.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Или Кандидаты[0].Этап <> "24H" Тогда
		ВызватьИсключение "FAIL: legacy stage migration identity";
	КонецЕсли;
	Доставка = РегистрыСведений.бит_омни_ДоставкаНапоминанийMAX.СоздатьМенеджерЗаписи();
	Доставка.Бот = Бот;
	Доставка.Заявка = Заявка;
	Доставка.ДатаНачала = Кандидаты[0].ДатаНачала;
	Доставка.Этап = "24H";
	Доставка.Контакт = КонтактОбъект.Ссылка;
	Доставка.Состояние = "Отправлено";
	Доставка.Записать();
	ВтораяСтрока = РассылкаОбъект.ДатыСобытия.Добавить();
	ВтораяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
	ВтораяСтрока.Использовать = Истина;
	ВтораяСтрока.Шаблон = "ДоДаты";
	ВтораяСтрока.РеквизитКонтекста = "ДатаНачала";
	ВтораяСтрока.КоличествоЧасов = 24;
	ВторойИд = ВтораяСтрока.ИдентификаторСтроки;
	РассылкаОбъект.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 0 Тогда
		ВызватьИсключение "FAIL: adding row caused duplicate legacy reminder";
	КонецЕсли;
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ВторойИд, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Или Кандидаты[0].Этап = "24H" Тогда
		ВызватьИсключение "FAIL: independent row acquired legacy alias";
	КонецЕсли;

	Результат = "PASS: pure and real-query event windows for before/after/object date including fractional hours; row reorder; row isolation; durable deduplication; changed appointment time; canceled/deleted/unlinked/blocked/deleted contact/deleted patient/zero id/group(if present)/disabled row/write mode exclusions; legacy delivery preserved after adding row. Rolled back, bot inactive, no HTTP.";
	ОтменитьТранзакцию();
Исключение
	Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
	ВызватьИсключение;
КонецПопытки;
