// Для изолированной базы и тестовой EPF; НЕ добавлять в расширение.
// test_callback_identity_source.py --emit-runtime-module добавляет точные тела
// production helpers к этому модулю. Вызов: ВыполнитьРегрессиюCallbackMAX(ПациентДо, ПациентПосле).
// Пациенты должны быть существующими разными Клиентами. Все фикстуры откатываются.
// HTTP, запуск заданий, изменение ролей и привилегированного режима отсутствуют.
Функция ВыполнитьРегрессиюCallbackMAX(ПациентДо, ПациентПосле) Экспорт
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Запускать вне транзакции."; КонецЕсли;
	Если Не ЗначениеЗаполнено(ПациентДо) Или Не ЗначениеЗаполнено(ПациентПосле)
		Или ПациентДо = ПациентПосле Тогда ВызватьИсключение "Нужны два разных пациента."; КонецЕсли;
	НачатьТранзакцию();
	Попытка
		БотОбъект = Справочники.бит_омни_Боты.СоздатьЭлемент();
		БотОбъект.Наименование = "CALLBACK_ROLLBACK";
		БотОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
		БотОбъект.Использовать = Истина;
		БотОбъект.ОбменДанными.Загрузка = Истина;
		БотОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
		БотОбъект.Записать();
		Бот = БотОбъект.Ссылка;
		Идентификатор = 990000009913;
		ПервыйОбъект = CallbackТестСоздатьКонтакт(Бот, Идентификатор, ПациентДо);
		Первый = ПервыйОбъект.Ссылка;
		Если НайтиКонтактMAX(Идентификатор, Бот) <> Первый Тогда ВызватьИсключение "FAIL unique fallback"; КонецЕсли;
		ВторойОбъект = CallbackТестСоздатьКонтакт(Бот, Идентификатор, ПациентДо);
		Второй = ВторойОбъект.Ссылка;
		Если ЗначениеЗаполнено(НайтиКонтактMAX(Идентификатор, Бот)) Тогда ВызватьИсключение "FAIL duplicate without mapping"; КонецЕсли;
		Запись = РегистрыСведений.бит_омни_ИдентичностиКонтактовMAX.СоздатьМенеджерЗаписи();
		Запись.Бот = Бот;
		Запись.Идентификатор = Идентификатор;
		Запись.Контакт = Второй;
		Запись.Записать();
		Если НайтиКонтактMAX(Идентификатор, Бот) <> Второй Тогда ВызватьИсключение "FAIL canonical duplicate"; КонецЕсли;

		// Оставляем единственный допустимый fallback: invalid mapping не должен его выбрать.
		ПервыйОбъект.ПометкаУдаления = Истина;
		ПервыйОбъект.Записать();
		Для Каждого Сценарий Из СтрРазделить("empty,deleted,wrongbot,wrongid,blocked", ",") Цикл
			Запись.Контакт = Второй;
			ВторойОбъект.ПометкаУдаления = Ложь;
			ВторойОбъект.Заблокирован = Ложь;
			ВторойОбъект.Бот = Бот;
			ВторойОбъект.Идентификатор = Идентификатор;
			Если Сценарий = "empty" Тогда
				Запись.Контакт = Справочники.бит_омни_Контакты.ПустаяСсылка();
			ИначеЕсли Сценарий = "deleted" Тогда
				Запись.Контакт = Первый;
			ИначеЕсли Сценарий = "wrongbot" Тогда
				Запись.Контакт = Первый;
				ПервыйОбъект.ПометкаУдаления = Ложь;
				ПервыйОбъект.Бот = Справочники.бит_омни_Боты.ПустаяСсылка();
				ПервыйОбъект.Записать();
			ИначеЕсли Сценарий = "wrongid" Тогда
				Запись.Контакт = Первый;
				ПервыйОбъект.Бот = Бот;
				ПервыйОбъект.Идентификатор = Идентификатор + 1;
				ПервыйОбъект.Записать();
			ИначеЕсли Сценарий = "blocked" Тогда
				ВторойОбъект.Заблокирован = Истина;
			КонецЕсли;
			ВторойОбъект.Записать();
			Запись.Записать();
			Если ЗначениеЗаполнено(НайтиКонтактMAX(Идентификатор, Бот)) Тогда
				ВызватьИсключение "FAIL invalid mapping fallback: " + Сценарий;
			КонецЕсли;
		КонецЦикла;
		ВторойОбъект.Заблокирован = Ложь;
		ВторойОбъект.Записать();
		Запись.Контакт = Второй;
		Запись.Записать();
		Тело = Новый Структура("callback_id,message", "fixture-callback-id", Новый Структура("text", "OK"));
		Адресат = Новый Структура("Параметр,Значение,ИдентификаторCallback", "user_id", СтрокаИдентификатора(Идентификатор), Тело.callback_id);
		ПроверитьСнимокCallbackMAX(Бот, Второй, Тело, Адресат);
		ЛичныйАдресат = Новый Структура("Параметр,Значение,ИдентификаторСообщенияКлиента,ОтпечатокПолучателя",
			"user_id", СтрокаИдентификатора(Идентификатор), "fixture-message-id", ОтпечатокПолучателяКонтактаMAX(Второй));
		ЛичноеТело = Новый Структура("text", "fixture personal message");
		ПроверитьСнимокОчередиMAX(Бот, Второй, ЛичноеТело, ЛичныйАдресат);
		ВторойОбъект.Получатель = ПациентПосле;
		ВторойОбъект.Записать();
		ПроверитьСнимокCallbackMAX(Бот, Второй, Тело, Адресат);
		Отклонено = Ложь;
		Попытка
			ПроверитьСнимокОчередиMAX(Бот, Второй, ЛичноеТело, ЛичныйАдресат);
		Исключение
			Отклонено = Истина;
		КонецПопытки;
		Если Не Отклонено Тогда ВызватьИсключение "FAIL personal patient fingerprint"; КонецЕсли;
		Для Каждого Сценарий Из СтрРазделить("legacy,callback_id,sender,canonical,blocked", ",") Цикл
			ПлохойАдресат = Новый Структура("Параметр,Значение,ИдентификаторCallback", "user_id", Адресат.Значение, Тело.callback_id);
			Если Сценарий = "legacy" Тогда
				ПлохойАдресат.Удалить("ИдентификаторCallback");
			ИначеЕсли Сценарий = "callback_id" Тогда
				ПлохойАдресат.ИдентификаторCallback = "other-callback-id";
			ИначеЕсли Сценарий = "sender" Тогда
				ПлохойАдресат.Значение = СтрокаИдентификатора(Идентификатор + 1);
			ИначеЕсли Сценарий = "canonical" Тогда
				Запись.Контакт = Первый;
				Запись.Записать();
			ИначеЕсли Сценарий = "blocked" Тогда
				ВторойОбъект.Заблокирован = Истина;
				ВторойОбъект.Записать();
			КонецЕсли;
			Отклонено = Ложь;
			Попытка
				ПроверитьСнимокCallbackMAX(Бот, Второй, Тело, ПлохойАдресат);
			Исключение
				Отклонено = Истина;
			КонецПопытки;
			Если Не Отклонено Тогда ВызватьИсключение "FAIL callback snapshot: " + Сценарий; КонецЕсли;
			Запись.Контакт = Второй;
			Запись.Записать();
		КонецЦикла;
		ОтменитьТранзакцию();
		Возврат "PASS duplicate/canonical; invalid/deleted/wrongbot/wrongid/blocked mapping; patient-independent callback; protected personal message; legacy/tampered snapshot; rollback";
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция CallbackТестСоздатьКонтакт(Бот, Идентификатор, Пациент)
	Объект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	Объект.Наименование = "CALLBACK_ROLLBACK";
	Объект.Бот = Бот;
	Объект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	Объект.Идентификатор = Идентификатор;
	Объект.Получатель = Пациент;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	Объект.Записать();
	Возврат Объект;
КонецФункции
