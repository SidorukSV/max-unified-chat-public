// Проверка в серверном контексте тестовой базы. Данные базы не изменяются, HTTP не вызывается.
ИсходныйJSON = "[[{""type"":""callback"",""text"":""Перенести"",""payload"":""appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_reschedule""}]]";
Таблица = бит_омни_КнопкиMAX.ТаблицаИзJSON(ИсходныйJSON);
Если Таблица.Количество() <> 1 Или Таблица[0].Действие <> "reschedule" Тогда
	ВызватьИсключение "Кнопка переноса не распознана при чтении JSON.";
КонецЕсли;
РезультирующийJSON = бит_омни_КнопкиMAX.JSONИзТаблицы(Таблица);
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку(РезультирующийJSON);
Кнопки = ПрочитатьJSON(Чтение);
Чтение.Закрыть();
Если Кнопки.Количество() <> 1 Или Кнопки[0].Количество() <> 1 Тогда
	ВызватьИсключение "Изменилось количество рядов или кнопок при записи JSON.";
КонецЕсли;
Кнопка = Кнопки[0][0];
Если Кнопка.type <> "callback" Или Кнопка.text <> "Перенести"
	Или Кнопка.payload <> "appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_reschedule" Тогда
	ВызватьИсключение "Изменилось действие, текст или payload кнопки переноса.";
КонецЕсли;
ПовторнаяТаблица = бит_омни_КнопкиMAX.ТаблицаИзJSON(РезультирующийJSON);
Если ПовторнаяТаблица.Количество() <> 1 Или ПовторнаяТаблица[0].Действие <> "reschedule" Тогда
	ВызватьИсключение "Кнопка переноса не распознана после полного цикла чтения/записи.";
КонецЕсли;
Результат = Новый Структура("ok,action,rows", Истина, ПовторнаяТаблица[0].Действие, ПовторнаяТаблица.Количество());
