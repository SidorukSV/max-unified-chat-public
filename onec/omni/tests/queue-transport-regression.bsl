// Чистая классификация ответов и подготовка снимков. HTTP не вызывается:
// единственный вызов отправителя использует заведомо выключенного тестового бота.
Для Каждого Описание Из СтрРазделить(
	"200|{""message"":{""body"":{""mid"":""test-mid""}}}|Отправлено"
	+ Символы.ПС + "200|{""body"":{""mid"":""test-mid""}}|Отправлено"
	+ Символы.ПС + "200|{""mid"":""test-mid""}|Отправлено"
	+ Символы.ПС + "200|{""ok"":true,""sent"":1,""failed"":0,""results"":[{""ok"":true,""max_response"":{""message"":{""body"":{""mid"":""test-mid""}}}}]}|Отправлено"
	+ Символы.ПС + "207|{""ok"":false,""sent"":0,""failed"":1,""results"":[{""ok"":false,""error"":""max_api_request_failed:403:denied""}]}|Ошибка"
	+ Символы.ПС + "207|{""ok"":false,""sent"":0,""failed"":1,""results"":[{""ok"":false,""error"":""max_api_request_failed:500:upstream""}]}|Неопределено"
	+ Символы.ПС + "207|{""ok"":false,""sent"":0,""failed"":1,""results"":[{""ok"":false,""error"":""network timeout""}]}|Неопределено"
	+ Символы.ПС + "200|{}|Неопределено"
	+ Символы.ПС + "200|{""mid"":42}|Неопределено"
	+ Символы.ПС + "200|{""mid"":""""}|Неопределено"
	+ Символы.ПС + "200|{""ok"":false,""mid"":""test-mid""}|Неопределено"
	+ Символы.ПС + "200|{""ok"":true,""sent"":1,""failed"":0,""results"":[]}|Неопределено"
	+ Символы.ПС + "200|{""raw"":""invalid json""}|Неопределено"
	+ Символы.ПС + "400|{}|Ошибка" + Символы.ПС + "401|{}|Ошибка"
	+ Символы.ПС + "403|{}|Ошибка" + Символы.ПС + "404|{}|Ошибка"
	+ Символы.ПС + "422|{}|Ошибка" + Символы.ПС + "429|{}|Ошибка"
	+ Символы.ПС + "500|{""mid"":""test-mid""}|Неопределено"
	+ Символы.ПС + "502|{}|Неопределено" + Символы.ПС + "0|{}|Неопределено", Символы.ПС) Цикл
	Части = СтрРазделить(Описание, "|", Истина);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Части[1]);
	Ответ = бит_омни_ИнтеграцияСMAX.КлассифицироватьОтветОчередиMAX(Число(Части[0]), ПрочитатьJSON(Чтение));
	Если Ответ.Состояние <> Части[2] Или Ответ.КодHTTP <> Число(Части[0]) Тогда
		ВызватьИсключение "FAIL: classifier " + Описание;
	КонецЕсли;
	Если Ответ.Состояние = "Отправлено" И Ответ.ИдентификаторСообщения <> "test-mid" Тогда
		ВызватьИсключение "FAIL: proven MID not retained";
	КонецЕсли;
КонецЦикла;

НачатьТранзакцию();
Попытка
	БотОбъект = Справочники.бит_омни_Боты.СоздатьЭлемент();
	БотОбъект.Наименование = "QUEUE_TRANSPORT_ROLLBACK";
	БотОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	БотОбъект.Использовать = Ложь;
	БотОбъект.Токен = "DO_NOT_PERSIST_TEST_TOKEN";
	БотОбъект.ОбменДанными.Загрузка = Истина;
	БотОбъект.Записать();
	КонтактОбъект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	КонтактОбъект.Наименование = "QUEUE_TRANSPORT_CONTACT";
	КонтактОбъект.Бот = БотОбъект.Ссылка;
	КонтактОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	КонтактОбъект.Идентификатор = 999999999996;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();
	Получатели = Новый Массив;
	Получатели.Добавить(КонтактОбъект.Ссылка);
	Получатели.Добавить(КонтактОбъект.Ссылка);
	Тело = Новый Структура("text,token", "Снимок ""до"" изменения", "DO_NOT_PERSIST_TEST_TOKEN");
	Подготовленные = бит_омни_ИнтеграцияСMAX.ПодготовитьСообщенияДляОчереди(Тело, Получатели, БотОбъект.Ссылка, Новый Структура);
	Если Подготовленные.Количество() <> 1 Тогда ВызватьИсключение "FAIL: contact deduplication"; КонецЕсли;
	Снимок = Подготовленные[0];
	Тело.text = "После изменения";
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Снимок.ТелоJSON);
	СохраненноеТело = ПрочитатьJSON(Чтение);
	Если СохраненноеТело.text <> "Снимок ""до"" изменения"
		Или СтрНайти(Снимок.ТелоJSON + Снимок.АдресатJSON, "DO_NOT_PERSIST_TEST_TOKEN") > 0 Тогда
		ВызватьИсключение "FAIL: immutable snapshot or secret exclusion";
	КонецЕсли;
	Отказ = бит_омни_ИнтеграцияСMAX.ОтправитьПодготовленноеСообщение(
		БотОбъект.Ссылка, КонтактОбъект.Ссылка, Снимок.ТелоJSON, Снимок.АдресатJSON);
	Если Отказ.Состояние <> "Ошибка" Или Отказ.КодHTTP <> 0 Тогда
		ВызватьИсключение "FAIL: inactive bot must fail before HTTP";
	КонецЕсли;
	ПациентБезMAX = Справочники.Клиенты.СоздатьЭлемент();
	ПациентБезMAX.Наименование = "QUEUE_TRANSPORT_NO_MAX";
	ПациентБезMAX.ОбменДанными.Загрузка = Истина;
	ПациентБезMAX.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	ПациентБезMAX.Записать();
	ПустаяОчередь = бит_омни_ИнтеграцияСMAX.ПодготовитьСообщенияДляОчереди(
		Тело, ПациентБезMAX.Ссылка, БотОбъект.Ссылка, Новый Структура);
	Если ПустаяОчередь.Количество() <> 0 Тогда ВызватьИсключение "FAIL: patient without MAX not skipped"; КонецЕсли;
	КонтактОбъект.Получатель = ПациентБезMAX.Ссылка;
	КонтактОбъект.Записать();
	СоСвязью = бит_омни_ИнтеграцияСMAX.ПодготовитьСообщенияДляОчереди(
		Тело, КонтактОбъект.Ссылка, БотОбъект.Ссылка, Новый Структура);
	Чтение.УстановитьСтроку(СоСвязью[0].АдресатJSON);
	СохраненныйАдресат = ПрочитатьJSON(Чтение);
	Если СохраненныйАдресат.ОтпечатокПолучателя <> Строка(ТипЗнч(ПациентБезMAX.Ссылка))
		+ ":" + Строка(ПациентБезMAX.Ссылка.УникальныйИдентификатор()) Тогда
		ВызватьИсключение "FAIL: patient binding fingerprint missing";
	КонецЕсли;
	КонтактОбъект.Получатель = Справочники.Клиенты.ПустаяСсылка();
	КонтактОбъект.Записать();
	БезСвязи = бит_омни_ИнтеграцияСMAX.ПодготовитьСообщенияДляОчереди(
		Тело, КонтактОбъект.Ссылка, БотОбъект.Ссылка, Новый Структура);
	Чтение.УстановитьСтроку(БезСвязи[0].АдресатJSON);
	АдресатБезСвязи = ПрочитатьJSON(Чтение);
	Если АдресатБезСвязи.ОтпечатокПолучателя <> "" Тогда
		ВызватьИсключение "FAIL: unlinked contact fingerprint not empty";
	КонецЕсли;
	Отказ = бит_омни_ИнтеграцияСMAX.ОтправитьПодготовленноеСообщение(
		БотОбъект.Ссылка, КонтактОбъект.Ссылка, СоСвязью[0].ТелоJSON, СоСвязью[0].АдресатJSON);
	Если Отказ.Состояние <> "Ошибка" Или Отказ.КодHTTP <> 0 Тогда
		ВызватьИсключение "FAIL: changed binding preflight must not send";
	КонецЕсли;
	КонтактОбъект.Заблокирован = Истина;
	КонтактОбъект.Записать();
	ПустаяОчередь = бит_омни_ИнтеграцияСMAX.ПодготовитьСообщенияДляОчереди(
		Тело, КонтактОбъект.Ссылка, БотОбъект.Ссылка, Новый Структура);
	Если ПустаяОчередь.Количество() <> 0 Тогда ВызватьИсключение "FAIL: blocked contact not skipped"; КонецЕсли;
	Результат = "PASS: response classification, strict MID, VDS207, known rejects/uncertain outcomes, HTTP code retained; frozen snapshot, contact dedup, no token; inactive preflight. Rolled back, no HTTP.";
	ОтменитьТранзакцию();
Исключение
	Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
	ВызватьИсключение;
КонецПопытки;
