// Чистые проверки вычислений: без записи объектов, HTTP и отправки сообщений.
Правило = Новый Структура("Использовать,Шаблон,РеквизитКонтекста,КоличествоЧасов,АлгоритмРасчета",
	Истина, "ДоДаты", "ДатаНачала", 2, "");
Контекст = Новый Структура("ДатаНачала", Дата(2030, 1, 1, 1, 0, 0));
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст) <> Дата(2029, 12, 31, 23, 0, 0) Тогда
	ВызватьИсключение "Before date / year boundary failed";
КонецЕсли;
Правило.Шаблон = "ПослеДаты";
Правило.КоличествоЧасов = 0.5;
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст) <> Дата(2030, 1, 1, 1, 30, 0) Тогда
	ВызватьИсключение "After date / fractional hour failed";
КонецЕсли;
Контекст.ДатаНачала = Дата(2032, 2, 28, 23, 30, 0);
Правило.КоличествоЧасов = 1;
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст) <> Дата(2032, 2, 29, 0, 30, 0) Тогда
	ВызватьИсключение "Leap day failed";
КонецЕсли;
Правило.Шаблон = "ДатаОбъекта";
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст) <> Контекст.ДатаНачала Тогда
	ВызватьИсключение "Object date must ignore offset";
КонецЕсли;
Правило.Использовать = Ложь;
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст) <> Неопределено Тогда
	ВызватьИсключение "Disabled rule was evaluated";
КонецЕсли;
Правило.Использовать = Истина;
ПлохиеКонтексты = Новый Массив;
ПлохиеКонтексты.Добавить(Новый Структура);
ПлохиеКонтексты.Добавить(Новый Структура("ДатаНачала", Дата(1, 1, 1)));
ПлохиеКонтексты.Добавить(Новый Структура("ДатаНачала", "2030-01-01"));
Для Каждого ПлохойКонтекст Из ПлохиеКонтексты Цикл
	ОшибкаПолучена = Ложь;
	Попытка
		бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, ПлохойКонтекст);
	Исключение
		ОшибкаПолучена = Истина;
	КонецПопытки;
	Если НЕ ОшибкаПолучена Тогда
		ВызватьИсключение "Missing, empty or wrong-type date accepted";
	КонецЕсли;
КонецЦикла;
Правило.Шаблон = "Алгоритм";

ТаблицаКонтекста = Новый ТаблицаЗначений;
ТаблицаКонтекста.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
СтрокаКонтекста = ТаблицаКонтекста.Добавить();
СтрокаКонтекста.ДатаНачала = Контекст.ДатаНачала;
Правило.АлгоритмРасчета = "Результат = Контекст.ДатаНачала;";
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, СтрокаКонтекста) <> Контекст.ДатаНачала Тогда
	ВызватьИсключение "Value table scalar copy failed";
КонецЕсли;
ЗаявкаКонтекста = Документы.Заявка.СоздатьДокумент();
ЗаявкаКонтекста.ДатаНачала = Контекст.ДатаНачала;
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, ЗаявкаКонтекста) <> Контекст.ДатаНачала Тогда
	ВызватьИсключение "Document scalar copy failed";
КонецЕсли;
Контекст.Вставить("Объект", Документы.Заявка.СоздатьДокумент());
Контекст.Вставить("ВложеннаяСтруктура", Новый Структура("Значение", 1));
Правило.АлгоритмРасчета = "Если Контекст.Свойство(""Объект"") Или Контекст.Свойство(""ВложеннаяСтруктура"") Тогда
| ВызватьИсключение ""Live object leaked into algorithm"";
|КонецЕсли;
|Если НЕ БезопасныйРежим() Тогда ВызватьИсключение ""Safe mode not enabled""; КонецЕсли;
|Результат = Контекст.ДатаНачала + 60;";
РежимДо = БезопасныйРежим();
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст) <> Контекст.ДатаНачала + 60 Тогда
	ВызватьИсключение "Manual algorithm failed";
КонецЕсли;
Если БезопасныйРежим() <> РежимДо Тогда
	ВызватьИсключение "Safe mode leaked after success";
КонецЕсли;
Правило.АлгоритмРасчета = "Результат = Неопределено;";
Если бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст) <> Неопределено Тогда
	ВызватьИсключение "Manual skip failed";
КонецЕсли;
Правило.АлгоритмРасчета = "ВызватьИсключение ""Controlled error"";";
ОшибкаПолучена = Ложь;
Попытка
	бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст);
Исключение
	ОшибкаПолучена = Истина;
КонецПопытки;
Если НЕ ОшибкаПолучена Или БезопасныйРежим() <> РежимДо Тогда
	ВызватьИсключение "Manual exception / safe mode restoration failed";
КонецЕсли;
Правило.АлгоритмРасчета = "Результат = 42;";
ОшибкаПолучена = Ложь;
Попытка
	бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст);
Исключение
	ОшибкаПолучена = Истина;
КонецПопытки;
Если НЕ ОшибкаПолучена Тогда
	ВызватьИсключение "Wrong manual result type accepted";
КонецЕсли;
Результат = "PASS: event date before/after/exact, fractional hours, year/leap edges, disabled, missing/empty/type validation, manual Date/Undefined/error, scalar-only context, safe mode restoration. No writes/HTTP.";
