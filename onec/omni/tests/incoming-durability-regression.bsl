// Сначала prepare_incoming_durability_regression.py --output WIP/incoming-regression.bsl.
// Загрузить результат в доверенную EPF и вызвать ВыполнитьРегрессиюНадежногоПриемаMAX().
// Только изолированная база с отключенными заданиями, ПолныеПрава, без активных ботов.
// Нет HTTP, polling, отправки outbox или чтения токенов. Собственные фикстуры удаляются.
// Выполнять ПОСЛЕ объединения inbox и routing/state helpers из соседнего участка.
Функция ВыполнитьРегрессиюНадежногоПриемаMAX() Экспорт

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Тест требует самостоятельных транзакций."; КонецЕсли;
	Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Тест требует ПолныеПрава."; КонецЕсли;
	ПроверитьОграждениеРегрессииПриемаMAX();
	Проверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.бит_омни_Боты
	|ГДЕ Использовать И НЕ ПометкаУдаления И Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)");
	Если Не Проверка.Выполнить().Пустой() Тогда ВызватьИсключение "Отключите ботов тестовой копии до теста."; КонецЕсли;
	Бот = Неопределено;
	Контакт = Неопределено;
	Действие = Неопределено;
	Команда = "inboxtest" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Попытка
		ОбъектБота = Справочники.бит_омни_Боты.СоздатьЭлемент();
		ОбъектБота.Наименование = "TEST inbox durability";
		ОбъектБота.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
		ОбъектБота.Идентификатор = Команда;
		ОбъектБота.Использовать = Истина;
		ОбъектБота.ОбменДанными.Загрузка = Истина;
		ОбъектБота.Записать();
		Бот = ОбъектБота.Ссылка;
		Контакт = бит_омни_НадежныйОбменMAX.ПолучитьИлиСоздатьКонтакт(900000000000001, Бот, "TEST inbox contact");
		ОбъектДействия = Справочники.бит_омни_Действия.СоздатьЭлемент();
		ОбъектДействия.Наименование = Команда;
		АлгоритмНамерения = "бит_омни_НадежныйОбменMAX.ПоставитьИсходящее(Бот, Контакт, ""message"", Новый Структура(""text"", ""TEST queued only""));";
		ОбъектДействия.Алгоритм = АлгоритмНамерения + Символы.ПС + "ВызватьИсключение ""TEST_SCENARIO_FAILURE"";";
		ОбъектДействия.ОбменДанными.Загрузка = Истина;
		ОбъектДействия.Записать();
		Действие = ОбъектДействия.Ссылка;
		ЗаписьКоманды = РегистрыСведений.бит_омни_Команды.СоздатьМенеджерЗаписи();
		ЗаписьКоманды.Команда = Команда;
		ЗаписьКоманды.Действие = Действие;
		ЗаписьКоманды.Записать();
		Обновление = НовоеСобытиеРегрессииПриемаMAX("/" + Команда, "durable-mid");
		Если бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот) Тогда
			ВызватьИсключение "Ошибка сценария была подтверждена как успех.";
		КонецЕсли;
		ЗапросInbox = Новый Запрос("ВЫБРАТЬ КлючСобытия ИЗ РегистрСведений.бит_омни_ВходящиеСобытияMAX ГДЕ Бот = &Бот");
		ЗапросInbox.УстановитьПараметр("Бот", Бот);
		ДанныеInbox = ЗапросInbox.Выполнить().Выгрузить();
		Если ДанныеInbox.Количество() <> 1 Тогда ВызватьИсключение "Нет единственного inbox события."; КонецЕсли;
		Ключ = ДанныеInbox[0].КлючСобытия;
		Inbox = РегистрыСведений.бит_омни_ВходящиеСобытияMAX.СоздатьМенеджерЗаписи();
		Inbox.Бот = Бот;
		Inbox.КлючСобытия = Ключ;
		Inbox.Прочитать();
		Если Inbox.Состояние <> "Ошибка" Или СтрНайти(Inbox.ОписаниеОшибки, "TEST_SCENARIO_FAILURE") = 0 Тогда
			ВызватьИсключение "Потеряна настоящая ошибка сценария.";
		КонецЕсли;
		СохраненныйКонтекст = Inbox.ДанныеJSON;
		Оболочка = бит_омни_НадежныйОбменMAX.ИзJSON(СохраненныйКонтекст);
		UUIDПервойПопытки = Оболочка.claim_id;
		ИсходныйPayload = бит_омни_НадежныйОбменMAX.ВJSON(Оболочка.update);
		ИсходныйКонтекст = бит_омни_НадежныйОбменMAX.ВJSON(Оболочка.context);
		Если Оболочка.inbox_version <> 1 Или Оболочка.update.message.body.text <> "/" + Команда Тогда
			ВызватьИсключение "Не сохранен исходный текст/контекст.";
		КонецЕсли;
		ПроверитьКоличествоРегрессииПриемаMAX("ИсторияЧатов", Бот, 1);
		ПроверитьКоличествоРегрессииПриемаMAX("ИсходящиеНамерения", Бот, 0);
		// Повторная доставка не обходит backoff; действующая lease не захватывается.
		бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот);
		Inbox.Прочитать();
		Если Inbox.Попыток <> 1 Тогда ВызватьИсключение "VDS обошел backoff."; КонецЕсли;
		Inbox.Состояние = "Обрабатывается";
		Inbox.АрендаДо = ТекущаяДатаСеанса() + 300;
		Inbox.Записать();
		бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот);
		Inbox.Прочитать();
		Если Inbox.Попыток <> 1 Тогда ВызватьИсключение "Захвачена активная lease."; КонецЕсли;
		Inbox.АрендаДо = ТекущаяДатаСеанса() - 1;
		Inbox.Записать();
		Для НомерПопытки = 2 По 5 Цикл
			бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот);
			Inbox.Прочитать();
			Оболочка = бит_омни_НадежныйОбменMAX.ИзJSON(Inbox.ДанныеJSON);
			Если Inbox.Попыток <> НомерПопытки
				Или бит_омни_НадежныйОбменMAX.ВJSON(Оболочка.update) <> ИсходныйPayload
				Или бит_омни_НадежныйОбменMAX.ВJSON(Оболочка.context) <> ИсходныйКонтекст
				Или Оболочка.claim_id = UUIDПервойПопытки Тогда
				ВызватьИсключение "Повтор изменил payload/context или счетчик попыток.";
			КонецЕсли;
			Если НомерПопытки < 5 Тогда
				Inbox.ДатаИзменения = ТекущаяДатаСеанса() - 121;
				Inbox.Записать();
			КонецЕсли;
		КонецЦикла;
		Если Inbox.Состояние <> "Карантин" Тогда ВызватьИсключение "Нет ограниченного карантина."; КонецЕсли;
		Если Не бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот) Тогда
			ВызватьИсключение "Сохраненный карантин не разрешает ACK.";
		КонецЕсли;
		ПроверитьКоличествоРегрессииПриемаMAX("ИсторияЧатов", Бот, 1);
		ПроверитьКоличествоРегрессииПриемаMAX("ИсходящиеНамерения", Бот, 0);
		// Администратор исправляет только тестовый сценарий и выбранный ключ.
		ОбъектДействия.Алгоритм = АлгоритмНамерения;
		ОбъектДействия.Записать();
		Если Не бит_омни_НадежныйОбменMAX.ПовторитьКарантин(Бот, Ключ, "TEST исправлен сценарий") Тогда
			ВызватьИсключение "Выбранное событие не восстановлено.";
		КонецЕсли;
		бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот);
		ПроверитьКоличествоРегрессииПриемаMAX("ИсторияЧатов", Бот, 1);
		ПроверитьКоличествоРегрессииПриемаMAX("ИсходящиеНамерения", Бот, 1);
		// Дубликат в архиве не воскрешает историю и не запускает исходящий сценарий.
		История = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX ГДЕ Бот = &Бот");
		История.УстановитьПараметр("Бот", Бот);
		СтрокаИстории = История.Выполнить().Выгрузить()[0];
		Архив = РегистрыСведений.бит_омни_АрхивЧатовMAX.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Архив, СтрокаИстории);
		Архив.ИдентификаторАрхива = Строка(Новый УникальныйИдентификатор);
		Архив.Записать();
		НаборИстории = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьНаборЗаписей();
		НаборИстории.Отбор.Бот.Установить(Бот);
		НаборИстории.Записать();
		Inbox.Удалить();
		Если Не бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот) Тогда
			ВызватьИсключение "Архивный дубль не завершен.";
		КонецЕсли;
		ПроверитьКоличествоРегрессииПриемаMAX("ИсторияЧатов", Бот, 0);
		ПроверитьКоличествоРегрессииПриемаMAX("АрхивЧатов", Бот, 1);
		ПроверитьКоличествоРегрессииПриемаMAX("ИсходящиеНамерения", Бот, 1);
		// Без MID история остается единственной при повторе; guard может отклонить
		// same-second устаревший сценарий, но сохраненный текст это не откатывает.
		БезMID = НовоеСобытиеРегрессииПриемаMAX("TEST without MID", "");
		бит_омни_НадежныйОбменMAX.ОбработатьВходящее(БезMID, Бот);
		бит_омни_НадежныйОбменMAX.ОбработатьВходящее(БезMID, Бот);
		ПроверитьКоличествоРегрессииПриемаMAX("ИсторияЧатов", Бот, 1);
		УдалитьФикстурыРегрессииПриемаMAX(Бот, Контакт, Действие, Команда);
	Исключение
		// Сохраняем исходную диагностику ДО любых действий аварийной очистки.
		ИсходнаяОшибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			// API владеют своими транзакциями; аварийная уборка проверяет их остаток.
			// BSLLS:WrongUseOfRollbackTransactionMethod-off
			// BSLLS:PairingBrokenTransaction-off
			Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
			// BSLLS:PairingBrokenTransaction-on
			// BSLLS:WrongUseOfRollbackTransactionMethod-on
			УдалитьФикстурыРегрессииПриемаMAX(Бот, Контакт, Действие, Команда);
		Исключение
			ИсходнаяОшибка = ИсходнаяОшибка + Символы.ПС + "Дополнительная ошибка очистки фикстур: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;
	Возврат "PASS: durable text, rollback scenario/outbox, immutable retry context, backoff/lease, 5-attempt quarantine, selected recovery, archive and missing-MID dedup. No HTTP. Fixtures removed.";

КонецФункции

Процедура ПроверитьОграждениеРегрессииПриемаMAX()
	// Тот же счетчик 1 после ручного reset: старый worker не должен пройти UUID fence.
	СтарыйUUID = Строка(Новый УникальныйИдентификатор);
	НовыйUUID = Строка(Новый УникальныйИдентификатор);
	Оболочка = Новый Структура("inbox_version,update,context,claim_id", 1,
		Новый Структура, Новый Структура, НовыйUUID);
	Запись = Новый Структура("Состояние,Попыток,ДанныеJSON", "Обрабатывается", 1,
		бит_омни_НадежныйОбменMAX.ВJSON(Оболочка));
	// Производственная функция и ее зависимости добавлены генератором без изменения тела.
	Если ПопыткаВходящегоАктуальна(Запись, 1, СтарыйUUID) Тогда
		ВызватьИсключение "ABA: старый worker совпал с новой попыткой после ручного восстановления.";
	КонецЕсли;
	Если Не ПопыткаВходящегоАктуальна(Запись, 1, НовыйUUID) Тогда
		ВызватьИсключение "Новая попытка не прошла собственный UUID fence.";
	КонецЕсли;
	Если ПопыткаВходящегоАктуальна(Запись, 1, "") Тогда ВызватьИсключение "Пустой UUID принят."; КонецЕсли;
	Запись.Состояние = "Карантин";
	Если ПопыткаВходящегоАктуальна(Запись, 1, НовыйUUID) Тогда ВызватьИсключение "Карантин принял старую попытку."; КонецЕсли;
КонецПроцедуры

Функция НовоеСобытиеРегрессииПриемаMAX(Текст, MID)
	Возврат Новый Структура("update_type,message", "message_created",
		Новый Структура("sender,body", Новый Структура("user_id,name", 900000000000001, "TEST inbox"),
		Новый Структура("text,mid", Текст, MID)));
КонецФункции

Процедура ПроверитьКоличествоРегрессииПриемаMAX(ИмяРегистра, Бот, Ожидается)
	// Имя передается только литералами доверенной фикстуры.
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.бит_омни_"
		+ ИмяРегистра + "MAX ГДЕ Бот = &Бот");
	Запрос.УстановитьПараметр("Бот", Бот);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.Количество <> Ожидается Тогда
		ВызватьИсключение "Неверное количество записей " + ИмяРегистра + ": " + Строка(Выборка.Количество);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьФикстурыРегрессииПриемаMAX(Бот, Контакт, Действие, Команда)
	Если ЗначениеЗаполнено(Бот) Тогда
		УдалитьИсходящиеФикстурыРегрессииПриемаMAX(Бот);
		Для Каждого ИмяРегистра Из СтрРазделить("ВходящиеСобытия,ИдентичностиКонтактов,ИсторияЧатов,АрхивЧатов,СостоянияДиалогов", ",") Цикл
			Набор = РегистрыСведений["бит_омни_" + ИмяРегистра + "MAX"].СоздатьНаборЗаписей();
			Набор.Отбор.Бот.Установить(Бот);
			Набор.Записать();
		КонецЦикла;
	КонецЕсли;
	ЗаписьКоманды = РегистрыСведений.бит_омни_Команды.СоздатьМенеджерЗаписи();
	ЗаписьКоманды.Команда = Команда;
	ЗаписьКоманды.Удалить();
	Если ЗначениеЗаполнено(Контакт) Тогда Контакт.ПолучитьОбъект().Удалить(); КонецЕсли;
	Если ЗначениеЗаполнено(Действие) Тогда Действие.ПолучитьОбъект().Удалить(); КонецЕсли;
	Если ЗначениеЗаполнено(Бот) Тогда Бот.ПолучитьОбъект().Удалить(); КонецЕсли;
КонецПроцедуры

Процедура УдалитьИсходящиеФикстурыРегрессииПриемаMAX(Бот)
	// Бот - ресурс outbox, а единственное измерение - Ключ. Пустой набор без
	// отбора по измерению удалил бы чужие намерения, поэтому удаляем точные ключи.
	Если Не ЗначениеЗаполнено(Бот) Тогда ВызватьИсключение "Не указан бот тестовых намерений."; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Ключ ИЗ РегистрСведений.бит_омни_ИсходящиеНамеренияMAX ГДЕ Бот = &Бот");
	Запрос.УстановитьПараметр("Бот", Бот);
	Ключи = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаКлюча Из Ключи Цикл
		Запись = РегистрыСведений.бит_омни_ИсходящиеНамеренияMAX.СоздатьМенеджерЗаписи();
		Запись.Ключ = СтрокаКлюча.Ключ;
		Запись.Прочитать();
		Если Запись.Выбран() И Запись.Бот = Бот Тогда Запись.Удалить(); КонецЕсли;
	КонецЦикла;
КонецПроцедуры
