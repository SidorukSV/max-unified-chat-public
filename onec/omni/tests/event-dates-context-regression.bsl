// Изолированная тестовая база: все объекты откатываются, бот неактивен, HTTP нет.
// Проверяет реальное выполнение сохраненной СКД, а не подмененную таблицу результата.
НачатьТранзакцию();
Попытка
	Момент = Дата(2042, 1, 15, 12, 0, 0);
	ПациентОбъект = Справочники.Клиенты.СоздатьЭлемент();
	ПациентОбъект.Наименование = "EVENT_CONTEXT_ROLLBACK_" + Строка(Новый УникальныйИдентификатор);
	ПациентОбъект.ОбменДанными.Загрузка = Истина;
	ПациентОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	ПациентОбъект.Записать();
	БотОбъект = Справочники.бит_омни_Боты.СоздатьЭлемент();
	БотОбъект.Наименование = "EVENT_CONTEXT_ROLLBACK_BOT";
	БотОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	БотОбъект.Использовать = Ложь;
	БотОбъект.ОбменДанными.Загрузка = Истина;
	БотОбъект.Записать();
	Бот = БотОбъект.Ссылка;
	КонтактОбъект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	КонтактОбъект.Наименование = "EVENT_CONTEXT_ROLLBACK_CONTACT";
	КонтактОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	КонтактОбъект.Бот = Бот;
	КонтактОбъект.Идентификатор = 999999999997;
	КонтактОбъект.Получатель = ПациентОбъект.Ссылка;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();
	ЗаявкаОбъект = Документы.Заявка.СоздатьДокумент();
	ЗаявкаОбъект.Дата = Момент;
	ЗаявкаОбъект.Клиент = ПациентОбъект.Ссылка;
	ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована;
	ЗаявкаОбъект.ДатаНачала = Момент - 7200;
	ЗаявкаОбъект.ДатаОкончания = Момент - 5400;
	ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
	ЗаявкаОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	ЗаявкаОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	ЗаявкаОбъект.Записать();
	Заявка = ЗаявкаОбъект.Ссылка;
	ШаблонОбъект = Справочники.бит_омни_ШаблоныСообщений.СоздатьЭлемент();
	ШаблонОбъект.Наименование = "EVENT_CONTEXT_ROLLBACK_TEMPLATE";
	ШаблонОбъект.ОбменДанными.Загрузка = Истина;
	ШаблонОбъект.Записать();
	РассылкаОбъект = Справочники.бит_омни_Рассылки.СоздатьЭлемент();
	РассылкаОбъект.Наименование = "EVENT_CONTEXT_ROLLBACK_MAILING";
	РассылкаОбъект.РежимРассылки = Перечисления.бит_омни_РежимыРассылки.ПоРасписанию;
	РассылкаОбъект.Шаблон = ШаблонОбъект.Ссылка;
	РассылкаОбъект.ОбменДанными.Загрузка = Истина;
	Правило = РассылкаОбъект.ДатыСобытия.Добавить();
	Правило.Использовать = Истина;
	Правило.Шаблон = "ПослеДаты";
	Правило.РеквизитКонтекста = "МояДатаОкончания";
	Правило.КоличествоЧасов = 1.5;

	Схема = Новый СхемаКомпоновкиДанных;
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "ИсточникДанных1";
	Источник.ТипИсточникаДанных = "Local";
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	Набор.Имя = "ИсточникСобытий";
	Набор.ИсточникДанных = Источник.Имя;
	Набор.АвтоЗаполнениеДоступныхПолей = Истина;
	Набор.Запрос = "ВЫБРАТЬ Заявки.Ссылка КАК Заявка,
	|Заявки.ДатаОкончания КАК МояДатаОкончания, 42 КАК НеправильнаяДата
	|ИЗ Документ.Заявка КАК Заявки";
	Для Каждого ИмяПоля Из СтрРазделить("Заявка,МояДатаОкончания,НеправильнаяДата", ",") Цикл
		Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Поле = ИмяПоля;
		Поле.ПутьКДанным = ИмяПоля;
		Поле.Заголовок = ИмяПоля;
		Поле.ТипЗначения = Новый ОписаниеТипов(?(ИмяПоля = "Заявка", "ДокументСсылка.Заявка",
			?(ИмяПоля = "МояДатаОкончания", "Дата", "Число")));
		ВыбранноеПоле = Схема.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
	ДетальныеЗаписи = Схема.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	ОтборЗаявки = Схема.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЗаявки.Использование = Истина;
	ОтборЗаявки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Заявка");
	ОтборЗаявки.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЗаявки.ПравоеЗначение = Заявка;
	РассылкаОбъект.СКДКонтекст = Новый ХранилищеЗначения(Схема);
	РассылкаОбъект.Записать();
	Рассылка = РассылкаОбъект.Ссылка;
	ИдПравила = Правило.ИдентификаторСтроки;
	СписокДат = бит_омни_ДатыСобытияРассылок.РеквизитыКонтекста(Схема);
	Если СписокДат.НайтиПоЗначению("МояДатаОкончания") = Неопределено
		Или СписокДат.НайтиПоЗначению("НеправильнаяДата") <> Неопределено Тогда
		ВызватьИсключение "FAIL: configured date alias choices";
	КонецЕсли;
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Тогда ВызватьИсключение "FAIL: SKD date alias candidate"; КонецЕсли;
	Если Кандидаты[0].ДатаОтправки <> Момент Или Кандидаты[0].Заявка <> Заявка
		Или Кандидаты[0].Контекст.МояДатаОкончания <> ЗаявкаОбъект.ДатаОкончания Тогда
		ВызватьИсключение "FAIL: SKD alias date / appointment mapping";
	КонецЕсли;
	Для Каждого ИмяДаты Из СтрРазделить("НеправильнаяДата,ОтсутствующаяДата", ",") Цикл
		Правило.РеквизитКонтекста = ИмяДаты;
		РассылкаОбъект.Записать();
		Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
		Если Кандидаты.Количество() <> 0 Тогда ВызватьИсключение "FAIL: invalid alias generated candidate"; КонецЕсли;
	КонецЦикла;
	Правило.Шаблон = "Алгоритм";
	Правило.РеквизитКонтекста = "";
	Правило.АлгоритмРасчета = "Результат = Контекст.МояДатаОкончания + 5400;";
	РассылкаОбъект.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Или Кандидаты[0].ДатаОтправки <> Момент Тогда
		ВызватьИсключение "FAIL: manual date from actual SKD context";
	КонецЕсли;
	Правило.АлгоритмРасчета = "Результат = Неопределено;";
	РассылкаОбъект.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 0 Тогда ВызватьИсключение "FAIL: manual skip generated candidate"; КонецЕсли;
	Правило.Шаблон = "ПослеДаты";
	Правило.АлгоритмРасчета = "";
	Правило.РеквизитКонтекста = "ДатаОкончания";
	РассылкаОбъект.СКДКонтекст = Новый ХранилищеЗначения(Неопределено);
	РассылкаОбъект.Записать();
	Кандидаты = бит_омни_НапоминанияMAX.КандидатыПоДатеСобытия(Бот, Рассылка, ИдПравила, Момент, Заявка);
	Если Кандидаты.Количество() <> 1 Или Кандидаты[0].ДатаОтправки <> Момент Тогда
		ВызватьИсключение "FAIL: native end-date post-event selection";
	КонецЕсли;
	Результат = "PASS: actual stored SKD query -> alias choices -> candidate, missing/wrong date suppression, manual alias date and skip, native post-end-date. Rolled back, inactive bot, no HTTP.";
	ОтменитьТранзакцию();
Исключение
	Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
	ВызватьИсключение;
КонецПопытки;
