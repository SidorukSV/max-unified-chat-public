// Выполняется на сервере после установки CFE. Базу и внешние сервисы не изменяет.
ИсходныйJSON = "[[{""type"":""open_app"",""text"":""Legacy"",""payload"":""appointment_<ИдентификаторЗаписи>_confirm"",""extra"":{""keep"":true}}],[{""type"":""link"",""text"":""Сайт"",""url"":""https://example.org""},{""type"":""request_contact"",""text"":""Телефон""}]]";
Таблица = бит_омни_КнопкиMAX.ТаблицаИзJSON(ИсходныйJSON);
Если Таблица.Количество() <> 3 Или Таблица[2].Ряд <> 2 Тогда
	ВызватьИсключение "FAIL: rows";
КонецЕсли;
Если Таблица[0].Действие <> "open_app" Тогда
	ВызватьИсключение "FAIL: legacy action changed";
КонецЕсли;
РезультатJSON = бит_омни_КнопкиMAX.JSONИзТаблицы(Таблица);
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку(РезультатJSON);
Кнопки = ПрочитатьJSON(Чтение);
Если Не Кнопки[0][0].extra.keep
	Или Кнопки[0][0].payload <> "appointment_<ИдентификаторЗаписи>_confirm"
	Или Кнопки[1][0].url <> "https://example.org" Тогда
	ВызватьИсключение "FAIL: roundtrip";
КонецЕсли;

Для Каждого Действие Из СтрРазделить("confirm,cancel", ",") Цикл
	Таблица[0].Действие = Действие;
	РезультатJSON = бит_омни_КнопкиMAX.JSONИзТаблицы(Таблица);
	Чтение.УстановитьСтроку(РезультатJSON);
	Кнопки = ПрочитатьJSON(Чтение);
	Если Кнопки[0][0].type <> "callback"
		Или Кнопки[0][0].payload <> "appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_" + Действие
		Или Не Кнопки[0][0].extra.keep Тогда
		ВызватьИсключение "FAIL: appointment action";
	КонецЕсли;
	ПовторнаяТаблица = бит_омни_КнопкиMAX.ТаблицаИзJSON(РезультатJSON);
	Если ПовторнаяТаблица[0].Действие <> Действие Тогда
		ВызватьИсключение "FAIL: action decode";
	КонецЕсли;
КонецЦикла;

НеизвестныйJSON = "[[{""type"":""future"",""text"":""Future"",""unknown"":{""nested"":[1,2,3]},""payload"":""abc""}]]";
Таблица = бит_омни_КнопкиMAX.ТаблицаИзJSON(НеизвестныйJSON);
Таблица[0].Текст = "Изменён";
РезультатJSON = бит_омни_КнопкиMAX.JSONИзТаблицы(Таблица);
Чтение.УстановитьСтроку(РезультатJSON);
Кнопки = ПрочитатьJSON(Чтение);
Если Кнопки[0][0].unknown.nested[2] <> 3 Или Кнопки[0][0].type <> "future" Тогда
	ВызватьИсключение "FAIL: unknown fields lost";
КонецЕсли;

Для Каждого НевалидныйJSON Из СтрРазделить("{|{}|[1]|[[1]]|[[{""type"":""callback"",""payload"":{}}]]", "|") Цикл
	Отклонён = Ложь;
	Попытка
		бит_омни_КнопкиMAX.ТаблицаИзJSON(НевалидныйJSON);
	Исключение
		Отклонён = Истина;
	КонецПопытки;
	Если Не Отклонён Тогда
		ВызватьИсключение "FAIL: unsupported JSON accepted";
	КонецЕсли;
КонецЦикла;

Таблица = бит_омни_КнопкиMAX.ТаблицаИзJSON("");
Если Таблица.Количество() <> 0 Или бит_омни_КнопкиMAX.JSONИзТаблицы(Таблица) <> "[]" Тогда
	ВызватьИсключение "FAIL: empty";
КонецЕсли;
Результат = Новый Структура("Успех, Проверки", Истина, "grouping, legacy, extras, confirm/cancel, future, invalid, empty");
