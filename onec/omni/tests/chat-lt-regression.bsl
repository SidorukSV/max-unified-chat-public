// Только отдельная тестовая база, пользователь с полными правами.
// Внешняя транзакция запрещает транспорт редактирования и откатывает все фикстуры.
Функция ВыполнитьРегрессиюЧатаЛТ() Экспорт

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Требуется отдельный тестовый вызов."; КонецЕсли;
	Пользователь = Пользователи.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда ВызватьИсключение "Нужен именованный пользователь 1С."; КонецЕсли;
	Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Этот тест не заменяет проверку RLS под оператором."; КонецЕсли;
	НачатьТранзакцию();
	Попытка
		БотОбъект = Справочники.бит_омни_Боты.СоздатьЭлемент();
		БотОбъект.Наименование = "TEST LT chat rollback";
		БотОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
		БотОбъект.Использовать = Ложь;
		БотОбъект.Токен = "fixture-token-not-real";
		БотОбъект.ОбменДанными.Загрузка = Истина;
		БотОбъект.Записать();
		Бот = БотОбъект.Ссылка;
		КонтактОбъект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
		КонтактОбъект.Наименование = "TEST LT own contact";
		КонтактОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
		КонтактОбъект.Бот = Бот;
		КонтактОбъект.Идентификатор = 990000001057;
		КонтактОбъект.ОбменДанными.Загрузка = Истина;
		КонтактОбъект.Записать();
		Контакт = КонтактОбъект.Ссылка;
		ДругойПользователь = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор);
		СтараяДата = ТекущаяДатаСеанса() - 30 * 24 * 60 * 60;
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-own-old", СтараяДата, Ложь, Пользователь, "text");
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-other-author", СтараяДата, Ложь, ДругойПользователь, "text");
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-own-file", СтараяДата, Ложь, Пользователь, "file");
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-unknown-author", СтараяДата, Ложь,
			Справочники.Пользователи.ПустаяСсылка(), "text");
		Действия = Новый Массив;
		Действия.Добавить(Ложь);
		Действия.Добавить(Истина);
		Для Каждого Удалить Из Действия Цикл
			ТестПроверитьОтказПравкиЛТ(Бот, Контакт, "test-other-author", Удалить, "только собственные");
			ТестПроверитьОтказПравкиЛТ(Бот, Контакт, "test-unknown-author", Удалить, "только собственные");
			ТестПроверитьОтказПравкиЛТ(Бот, Контакт, "test-own-file", Удалить, "только текстовые");
			// Старый собственный текст прошёл проверки прав и возраста, но сеть запрещена транзакцией.
			ТестПроверитьОтказПравкиЛТ(Бот, Контакт, "test-own-old", Удалить, "внутри транзакции запрещено");
		КонецЦикла;

		ГраницаОповещений = '00010101';
		КлючиОповещенийГраницы = "";
		Состояния = Новый Соответствие;
		КлючДиалога = СформироватьКлючДиалога(Справочники.Клиенты.ПустаяСсылка(), Бот,
			Контакт, Справочники.бит_омни_ОтделенияMAX.ПустаяСсылка());
		Состояния.Вставить(КлючДиалога, Новый Структура("Ответственный", Пользователь));
		Первое = ПолучитьНовыеОповещенияНаСервере(Состояния);
		Если Первое.Количество() <> 0 Тогда ВызватьИсключение "Начальная история вызвала оповещение."; КонецЕсли;
		Период = ГраницаОповещений + 1;
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-in-one", Период, Истина, Пользователь, "text");
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-in-two", Период, Истина, Пользователь, "text");
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-operator-answer", Период + 1, Ложь, Пользователь, "text");
		Новые = ПолучитьНовыеОповещенияНаСервере(Состояния);
		Если Новые.Количество() <> 2 Тогда ВызватьИсключение "Ожидались два входящих после ответа и прочтения."; КонецЕсли;
		Если Новые[0].Ключ = Новые[1].Ключ Тогда ВызватьИсключение "У оповещений совпал ключ."; КонецЕсли;
		Повтор = ПолучитьНовыеОповещенияНаСервере(Состояния);
		Если Повтор.Количество() <> 0 Тогда ВызватьИсключение "Оповещения повторяются."; КонецЕсли;
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-in-same-second", Период, Истина, Пользователь, "text");
		Новые = ПолучитьНовыеОповещенияНаСервере(Состояния);
		Если Новые.Количество() <> 1 Тогда ВызватьИсключение "Потеряно сообщение на границе секунды."; КонецЕсли;
		Состояния.Вставить(КлючДиалога, Новый Структура("Ответственный", ДругойПользователь));
		ТестСоздатьСообщениеЛТ(Бот, Контакт, "test-in-other-owner", Период + 2, Истина, Пользователь, "text");
		Новые = ПолучитьНовыеОповещенияНаСервере(Состояния);
		Если Новые.Количество() <> 0 Тогда ВызватьИсключение "Пришло оповещение чужого ответственного."; КонецЕсли;
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат "PASS: own text edit/delete, no local age limit, per-message notifications, same-second dedup, responsibility; rollback, no HTTP";

КонецФункции

Процедура ТестСоздатьСообщениеЛТ(Бот, Контакт, Идентификатор, Период, Входящее, Пользователь, Вид)

	Запись = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.Бот = Бот;
	Запись.Контакт = Контакт;
	Запись.ИдентификаторСообщения = Идентификатор;
	Запись.Входящее = Входящее;
	Запись.ВидСообщения = Вид;
	Запись.Пользователь = Пользователь;
	Запись.ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Оператор;
	Запись.Статус = "Отправлено";
	Запись.Прочитано = Истина;
	Запись.Текст = Идентификатор;
	Запись.Записать();

КонецПроцедуры

Процедура ТестПроверитьОтказПравкиЛТ(Бот, Контакт, Идентификатор, Удалить, ОжидаемаяОшибка)

	ТекстОшибки = "";
	Попытка
		бит_омни_ОтделенияMAXСервер.бит_ИзменитьСообщениеОператора(
			Контакт, Бот, Идентификатор, "Новый текст", Удалить);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	Если СтрНайти(ТекстОшибки, ОжидаемаяОшибка) = 0 Тогда
		ВызватьИсключение "Неверный отказ " + Идентификатор + ": " + ТекстОшибки;
	КонецЕсли;

КонецПроцедуры
