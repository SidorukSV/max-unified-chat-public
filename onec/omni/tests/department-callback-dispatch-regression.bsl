// Выполнять через серверный execute_code только в изолированной базе.
// Реальный dispatcher и callback, собственный подписанный фиктивный контакт.
// Внешняя транзакция удерживает транспорт в outbox; всегда rollback, без HTTP.
Если ТранзакцияАктивна() Тогда ВызватьИсключение "Требуется отдельный тестовый вызов"; КонецЕсли;
НачатьТранзакцию();
Попытка
	ОбъектБота = Справочники.бит_омни_Боты.СоздатьЭлемент();
	ОбъектБота.Наименование = "TEST department dispatcher rollback";
	ОбъектБота.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	ОбъектБота.Использовать = Истина;
	ОбъектБота.Токен = "fixture-token-not-real";
	ОбъектБота.ОбменДанными.Загрузка = Истина;
	ОбъектБота.Записать();
	Бот = ОбъектБота.Ссылка;
	Отделение = Справочники.бит_омни_ОтделенияMAX.СоздатьЭлемент();
	Отделение.Наименование = "TEST department dispatcher";
	Отделение.ОбменДанными.Загрузка = Истина;
	Отделение.Записать();
	Sender = 990000001054;
	Контакт = бит_омни_НадежныйОбменMAX.ПолучитьИлиСоздатьКонтакт(Sender, Бот, "TEST signed contact");
	VCF = "BEGIN:VCARD" + Символы.ПС + "VERSION:3.0" + Символы.ПС
		+ "FN:Fixture" + Символы.ПС + "TEL:+79990000000" + Символы.ПС + "END:VCARD";
	Payload = Новый Структура("max_info,vcf_info,hash", Новый Структура("user_id", Sender), VCF,
		"e14f4942477962fae2be02af0e64fa82ecdc95f56ce51207eafbe35c42405eca");
	Вложения = Новый Массив;
	Вложения.Добавить(Новый Структура("type,payload", "contact", Payload));
	История = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	История.Период = ТекущаяДатаСеанса();
	История.ИдентификаторСообщения = "test-signed-phone";
	История.Контакт = Контакт;
	История.Бот = Бот;
	История.Входящее = Истина;
	История.ВидСообщения = "contact";
	История.ДанныеВложений = бит_омни_НадежныйОбменMAX.ВJSON(Вложения);
	История.Записать();
	Если ПустаяСтрока(бит_омни_ИнтеграцияСMAX.ПодтвержденныйТелефонКонтактаMAX(Контакт)) Тогда
		ВызватьИсключение "TEST signature rejected";
	КонецЕсли;
	Callback = Новый Структура("callback_id,payload,user", "test-department-callback",
		"department:" + Строка(Отделение.Ссылка.УникальныйИдентификатор()), Новый Структура("user_id", Sender));
	Событие = Новый Структура("update_type,callback", "message_callback", Callback);
	бит_омни_ИнтеграцияСMAX.ОбработатьОбновление(Событие, Бот);
	Если Контакт.ПолучитьОбъект().ОтделениеMAX <> Отделение.Ссылка Тогда ВызватьИсключение "TEST department not assigned"; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Вид, ТелоJSON ИЗ РегистрСведений.бит_омни_ИсходящиеНамеренияMAX ГДЕ Бот = &Бот");
	Запрос.УстановитьПараметр("Бот", Бот);
	Исходящие = Запрос.Выполнить().Выгрузить();
	ЕстьПодтверждение = Ложь;
	ЕстьОтветКнопки = Ложь;
	Сообщений = 0;
	Для Каждого Строка Из Исходящие Цикл
		Если Строка.Вид = "message" Тогда Сообщений = Сообщений + 1; КонецЕсли;
		Если СтрНайти(Строка.ТелоJSON, "Ваше обращение направлено в отделение") > 0 Тогда ЕстьПодтверждение = Истина; КонецЕсли;
		Если Строка.Вид = "callback" Тогда ЕстьОтветКнопки = Истина; КонецЕсли;
