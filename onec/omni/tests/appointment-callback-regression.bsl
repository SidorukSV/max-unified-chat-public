// Только изолированная тестовая база. Все записи откатываются.
// Setup использует загрузку, проверяемые confirm/cancel выполняют обычную Записать().
// Нужны: бот, заполненная заявка и настроенный ПризнакПодтвержденнойЗаявки.
НачатьТранзакцию();
Попытка
	Признак = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ПризнакПодтвержденнойЗаявки");
	Если Не ЗначениеЗаполнено(Признак) Тогда
		ВызватьИсключение "SETUP_REQUIRED: ПризнакПодтвержденнойЗаявки";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.бит_омни_Боты ГДЕ НЕ ПометкаУдаления");
	Боты = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Заявка
	|ГДЕ НЕ ПометкаУдаления И Клиент <> ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО Дата УБЫВ";
	ИсходныеЗаявки = Запрос.Выполнить().Выгрузить();
	Если Боты.Количество() = 0 Или ИсходныеЗаявки.Количество() = 0 Тогда
		ВызватьИсключение "SETUP_REQUIRED: bot and populated appointment";
	КонецЕсли;
	ТестБот = Справочники.бит_омни_Боты.СоздатьЭлемент();
	ТестБот.Наименование = "CALLBACK_TEST_BOT";
	ТестБот.Использовать = Истина;
	ТестБот.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	ТестБот.ОбменДанными.Загрузка = Истина;
	ТестБот.Записать();
	Бот = ТестБот.Ссылка;
	ЗаявкаОбъект = ИсходныеЗаявки[0].Ссылка.ПолучитьОбъект().Скопировать();
	ЗаявкаОбъект.Дата = ТекущаяДатаСеанса();
	Сдвиг = НачалоДня(ТекущаяДатаСеанса()) + 45 * 86400 + 11 * 3600 - ЗаявкаОбъект.ДатаНачала;
	ЗаявкаОбъект.ДатаНачала = ЗаявкаОбъект.ДатаНачала + Сдвиг;
	ЗаявкаОбъект.ДатаОкончания = ЗаявкаОбъект.ДатаОкончания + Сдвиг;
	ЗаявкаОбъект.ВремяНачала = ЗаявкаОбъект.ДатаНачала;
	ЗаявкаОбъект.ВремяОкончания = ЗаявкаОбъект.ДатаОкончания;
	Для Каждого Работа Из ЗаявкаОбъект.Работы Цикл
		Работа.ДатаНачала = Работа.ДатаНачала + Сдвиг;
		Работа.ДатаОкончания = Работа.ДатаОкончания + Сдвиг;
	КонецЦикла;
	ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована;
	ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
	ЗаявкаОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	ЗаявкаОбъект.Записать();
	Заявка = ЗаявкаОбъект.Ссылка;
	Пациент = ЗаявкаОбъект.Клиент;
	ВерсияЗаписи = Формат(ЗаявкаОбъект.ДатаНачала, "ДФ=yyyyMMddHHmmss");

	КонтактОбъект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	КонтактОбъект.Наименование = "CALLBACK_ROLLBACK_" + Строка(Новый УникальныйИдентификатор);
	КонтактОбъект.Бот = Бот;
	КонтактОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	КонтактОбъект.Идентификатор = "990000009901";
	КонтактОбъект.Получатель = Пациент;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();
	Контакт = КонтактОбъект.Ссылка;
	ЗапросВерсии = Новый Запрос("ВЫБРАТЬ ВерсияДанных ИЗ Документ.Заявка ГДЕ Ссылка = &Ссылка");
	ЗапросВерсии.УстановитьПараметр("Ссылка", Заявка);
	ИсходнаяВерсия = ЗначениеВСтрокуВнутр(ЗапросВерсии.Выполнить().Выгрузить()[0].ВерсияДанных);

	Для Каждого Сценарий Из СтрРазделить("wrong_user,stale,blocked,unlinked,wrong_patient", ",") Цикл
		КонтактОбъект.Заблокирован = (Сценарий = "blocked");
		Если Сценарий = "unlinked" Тогда
			КонтактОбъект.Получатель = Справочники.Клиенты.ПустаяСсылка();
		ИначеЕсли Сценарий = "wrong_patient" Тогда
			КонтактОбъект.Получатель = Справочники.Клиенты.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Иначе
			КонтактОбъект.Получатель = Пациент;
		КонецЕсли;
		КонтактОбъект.Записать();
		Ответ = Документы.Заявка.бит_омни_ОбработатьCallbackMAX(Заявка, Контакт, Бот,
			?(Сценарий = "wrong_user", "990000009902", "990000009901"),
			?(Сценарий = "stale", "20000101000000", ВерсияЗаписи), "confirm");
		Если Ответ.Успех Тогда
			ВызватьИсключение "FAIL: accepted " + Сценарий;
		КонецЕсли;
		Если ЗначениеВСтрокуВнутр(ЗапросВерсии.Выполнить().Выгрузить()[0].ВерсияДанных) <> ИсходнаяВерсия Тогда
			ВызватьИсключение "FAIL: unauthorized write " + Сценарий;
		КонецЕсли;
	КонецЦикла;
	КонтактОбъект.Заблокирован = Ложь;
	КонтактОбъект.Получатель = Пациент;
	КонтактОбъект.Записать();

	Для Каждого Действие Из СтрРазделить("confirm,cancel", ",") Цикл
		Ответ = Документы.Заявка.бит_омни_ОбработатьCallbackMAX(Заявка, Контакт, Бот,
			"990000009901", ВерсияЗаписи, Действие);
		Если Не Ответ.Успех Тогда
			ВызватьИсключение "FAIL: normal write " + Действие + ": " + Ответ.Текст;
		КонецЕсли;
		Если Действие = "cancel" Тогда
			Если Заявка.ПолучитьОбъект().Состояние <> Справочники.ВидыСостоянийЗаявок.Отменена Тогда
				ВызватьИсключение "FAIL: cancel state";
			КонецЕсли;
		ИначеЕсли ТипЗнч(Признак) = Тип("СправочникСсылка.ВидыСостоянийЗаявок") Тогда
			Если Заявка.ПолучитьОбъект().Состояние <> Признак Тогда
				ВызватьИсключение "FAIL: confirm state";
			КонецЕсли;
		Иначе
			Свойство = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
			Свойство.Объект = Заявка;
			Свойство.Свойство = Признак;
			Свойство.Прочитать();
			Если Свойство.Значение <> Истина Тогда
				ВызватьИсключение "FAIL: confirm property";
			КонецЕсли;
		КонецЕсли;
		ВерсияПосле = ЗначениеВСтрокуВнутр(ЗапросВерсии.Выполнить().Выгрузить()[0].ВерсияДанных);
		Ответ = Документы.Заявка.бит_омни_ОбработатьCallbackMAX(Заявка, Контакт, Бот,
			"990000009901", ВерсияЗаписи, Действие);
		Если Не Ответ.Успех
			Или ЗначениеВСтрокуВнутр(ЗапросВерсии.Выполнить().Выгрузить()[0].ВерсияДанных) <> ВерсияПосле Тогда
			ВызватьИсключение "FAIL: replay wrote document " + Действие;
		КонецЕсли;
	КонецЦикла;
	Ответ = Документы.Заявка.бит_омни_ОбработатьCallbackMAX(Заявка, Контакт, Бот,
		"990000009901", ВерсияЗаписи, "confirm");
	Если Ответ.Успех Тогда
		ВызватьИсключение "FAIL: cancelled appointment confirmed again";
	КонецЕсли;
	Результат = "PASS: normal confirm/cancel, replay no document write, cancelled confirm denied, wrong user/stale/blocked/unlinked/wrong patient; rollback";
	ОтменитьТранзакцию();
Исключение
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	ВызватьИсключение;
КонецПопытки;
