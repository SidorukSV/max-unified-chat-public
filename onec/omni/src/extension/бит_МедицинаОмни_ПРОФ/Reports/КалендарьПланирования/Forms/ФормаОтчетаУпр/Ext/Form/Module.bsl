&НаСервере
Процедура бит_омни_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	// Переносимую заявку некуда положить в типовые реквизиты: ТекущийДокументЗаписи
	// типизирован ОпределяемымТипом.ОснованиеЗаписиВРасписание, куда Заявка не входит.
	// Поэтому расширение добавляет собственный реквизит программно, не меняя состав формы.
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("бит_омни_ПереносимаяЗаявка",
		Новый ОписаниеТипов("ДокументСсылка.Заявка")));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

// Намерение переноса приходит тем же оповещением, что и намерение записи:
// единый чат кладет заявку в структуру параметров дополнительным ключом.
&НаКлиенте
Процедура бит_омни_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия <> "НамерениеЗаписиПоДокументу" Или ТипЗнч(Параметр) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ПереносимаяЗаявка = Неопределено;
	Если Не Параметр.Свойство("бит_омни_ПереносимаяЗаявка", ПереносимаяЗаявка)
		Или ТипЗнч(ПереносимаяЗаявка) <> Тип("ДокументСсылка.Заявка") Тогда
		ПереносимаяЗаявка = ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка");
	КонецЕсли;
	
	ЭтотОбъект["бит_омни_ПереносимаяЗаявка"] = ПереносимаяЗаявка;
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("ДобавитьЗаявкуПоЯчейкеЗаписи")
Процедура бит_омни_ДобавитьЗаявкуПоЯчейкеЗаписи(РасшифровкаОбластиЯчеек)
	
#Вставка
	// Перенос записи: вместо создания новой заявки существующая переставляется
	// в выбранную ячейку тем же алгоритмом, что вставка вырезанной заявки.
	Если бит_омни_ПеренестиЗаявкуВЯчейку(РасшифровкаОбластиЯчеек) Тогда
		Возврат;
	КонецЕсли;
	
#КонецВставки
	ОбъектРасписания = ПолучитьОбъектТекущейКолонки();
	Если ТипЗнч(РасшифровкаОбластиЯчеек) = Тип("Структура") Тогда
		ЗначенияЗаполнения = ПолучитьСтруктуруПараметровПустойЯчейки(РасшифровкаОбластиЯчеек, ОбъектРасписания);
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначенияЗаполнения.Сотрудник)
		И Отчет.Сотрудники.Количество() = 1
		И ТипЗнч(Отчет.Сотрудники[0].Значение) = Тип("СправочникСсылка.Сотрудники")
	Тогда
		ЗначенияЗаполнения.Сотрудник = Отчет.Сотрудники[0].Значение;
	КонецЕсли;
	
	Если ТипЗнч(РасшифровкаОбластиЯчеек) = Тип("Структура") Тогда
		ЗначенияЗаполнения.Вставить("ДатаОкончания", ЗначенияЗаполнения.ДатаНачала + (РасшифровкаОбластиЯчеек.ВремяОкончания - РасшифровкаОбластиЯчеек.Время));
		ЗначенияЗаполнения.Вставить("ВремяОкончания", РасшифровкаОбластиЯчеек.ВремяОкончания);
		ЗначенияЗаполнения.Вставить("КоличествоВыбранныхЯчеек", РасшифровкаОбластиЯчеек.КоличествоВыбранныхЯчеек);
	Иначе
		ЗначенияЗаполнения.Вставить("КоличествоВыбранныхЯчеек", 1);
	КонецЕсли;
	
	ЗначенияЗаполнения.Вставить("Клиент", Клиент);
	ИмяФилиал = ПроцедурыСпециализацииПоставки.ИмяРеквизитаФилиалДокументов();
	Если ЗначениеЗаполнено(ЗначенияЗаполнения.Филиал) Тогда
		ЗначенияЗаполнения.Вставить(ИмяФилиал, ЗначенияЗаполнения.Филиал);
	ИначеЕсли ЗначениеЗаполнено(Отчет.Филиал) Тогда
		ЗначенияЗаполнения.Вставить(ИмяФилиал, Отчет.Филиал);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущийДокументЗаписи) Тогда 
		ЗначенияЗаполнения.Вставить("Основание", ТекущийДокументЗаписи);
		Если ЗначениеЗаполнено(ТекущийКлиентДокументаЗаписи) Тогда 
			ЗначенияЗаполнения.Вставить("Клиент", ТекущийКлиентДокументаЗаписи);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущаяНоменклатураДокументаЗаписи) Тогда 
			ЗначенияЗаполнения.Вставить("Работы", ТекущаяНоменклатураДокументаЗаписи.ВыгрузитьЗначения());
		КонецЕсли;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ЗначенияЗаполнения.Сотрудник) Тогда
		РежимДлительностиЗаявкиИПродолжительность = ПолучитьРежимДлительностиЗаявкиИПродолжительностьПоСотруднику(ЗначенияЗаполнения.Сотрудник);
		ЗначенияЗаполнения.Вставить("РежимДлительностиЗаявки", РежимДлительностиЗаявкиИПродолжительность["РежимДлительностиЗаявки"]);
		ЗначенияЗаполнения.Вставить("СредняяПродолжительность", РежимДлительностиЗаявкиИПродолжительность["СредняяПродолжительность"]);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения, Оборудование",ЗначенияЗаполнения, ЗначенияЗаполнения.Оборудование);
	
	Если ТекущиеПараметрыЗаписи <> Неопределено Тогда
		ПараметрыФормы.Вставить("ПараметрыЗаписиПоДокументу", ТекущиеПараметрыЗаписи);
	КонецЕсли;
	
	ОткрытьФорму("Документ.Заявка.ФормаОбъекта", ПараметрыФормы);

КонецПроцедуры

// Переставляет заявку в выбранную ячейку журнала.
//
// Возвращаемое значение:
//   Булево - Истина, если ячейка обработана как перенос и типовое создание заявки не нужно.
&НаКлиенте
Функция бит_омни_ПеренестиЗаявкуВЯчейку(РасшифровкаОбластиЯчеек)

	ПереносимаяЗаявка = ЭтотОбъект["бит_омни_ПереносимаяЗаявка"];
	Если Не ЗначениеЗаполнено(ПереносимаяЗаявка)
		Или ТипЗнч(РасшифровкаОбластиЯчеек) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	// Состав значений ячейки и переименование оборудования в кабинет повторяют
	// вставку вырезанной заявки, см. КонтекстноеМенюВставить.
	ЗначенияЗаполнения = ПолучитьСтруктуруПараметровПустойЯчейки(РасшифровкаОбластиЯчеек,
		ПолучитьОбъектТекущейКолонки());
	Если ЗначенияЗаполнения.Свойство("Оборудование") И ЗначениеЗаполнено(ЗначенияЗаполнения.Оборудование) Тогда
		ЗначенияЗаполнения.Вставить("Кабинет", ЗначенияЗаполнения.Оборудование);
		ЗначенияЗаполнения.Удалить("Оборудование");
	КонецЕсли;

	Результат = бит_омни_ПереставитьЗаявкуНаСервере(ПереносимаяЗаявка, ЗначенияЗаполнения);
	ЭтотОбъект["бит_омни_ПереносимаяЗаявка"] = ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка");

	Если Не Результат.Успех Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.ОписаниеОшибки);
		Возврат Истина;
	КонецЕсли;

	ОбновитьОтчет();
	ПоказатьОповещениеПользователя(НСтр("ru='Запись перенесена'"), , Результат.ПредставлениеСлота);

	// Оператор проверяет перенесенную запись вручную: длительность и состав работ
	// после смены слота может потребовать правки.
	ОткрытьФорму("Документ.Заявка.ФормаОбъекта", Новый Структура("Ключ", ПереносимаяЗаявка));

	Возврат Истина;

КонецФункции

// Записывает заявку в новую ячейку.
//
// Расчет повторяет ДополнитьИЗаписатьЗаявкуПриВставке журнала записи: сдвигается
// только шапка, длительность сохраняется, а даты строк работ пересчитывает
// ПередЗаписью самого документа. Отличие одно - ошибка записи не подавляется.
//
// Параметры:
//   Заявка - ДокументСсылка.Заявка - переносимая запись.
//   ЗначенияЗаполнения - Структура - параметры выбранной ячейки журнала.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), ПредставлениеСлота (Строка), ОписаниеОшибки (Строка).
&НаСервереБезКонтекста
Функция бит_омни_ПереставитьЗаявкуНаСервере(Знач Заявка, Знач ЗначенияЗаполнения)

	Результат = Новый Структура("Успех, ПредставлениеСлота, ОписаниеОшибки", Ложь, "", "");

	Попытка
		ЗаявкаОбъект = Заявка.ПолучитьОбъект();
		Если ЗаявкаОбъект = Неопределено Тогда
			Результат.ОписаниеОшибки = НСтр("ru='Переносимая запись уже удалена.'");
			Возврат Результат;
		КонецЕсли;

		ЗначенияЗаполнения.Вставить("ДатаОкончания",
			ЗаявкаОбъект.ДатаОкончания + (ЗначенияЗаполнения.ДатаНачала - ЗаявкаОбъект.ДатаНачала));
		ЗначенияЗаполнения.Вставить("ВремяОкончания", ЗначенияЗаполнения.ДатаОкончания);

		// Пустые сотрудник, кабинет и филиал ячейки не затирают заполненные в заявке.
		// Журнал защищает так только сотрудника и кабинет, но при переносе записи
		// потерять филиал нельзя: время меняется, клиника - нет.
		ПоляИсключения = Новый Массив;
		Для Каждого ИмяПоля Из СтрРазделить("Сотрудник,Кабинет,Филиал", ",") Цикл
			Если ЗначениеЗаполнено(ЗаявкаОбъект[ИмяПоля])
				И ЗначенияЗаполнения.Свойство(ИмяПоля)
				И Не ЗначениеЗаполнено(ЗначенияЗаполнения[ИмяПоля]) Тогда
				ПоляИсключения.Добавить(ИмяПоля);
			КонецЕсли;
		КонецЦикла;

		ЗаполнитьЗначенияСвойств(ЗаявкаОбъект, ЗначенияЗаполнения, ,
			СтрСоединить(ПоляИсключения, ","));
		ЗаявкаОбъект.Перенесенная = Истина;
		ЗаявкаОбъект.Записать();

		Результат.ПредставлениеСлота = бит_омни_ПредставлениеСлота(ЗаявкаОбъект);
		Результат.Успех = Истина;
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru='Перенести запись не удалось: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция бит_омни_ПредставлениеСлота(ЗаявкаОбъект)

	Части = Новый Массив;
	Части.Добавить(Формат(ЗаявкаОбъект.ДатаНачала, "ДФ='d MMMM, HH:mm'"));
	Если ЗначениеЗаполнено(ЗаявкаОбъект.Сотрудник) Тогда
		Части.Добавить(Строка(ЗаявкаОбъект.Сотрудник));
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаявкаОбъект.Кабинет) Тогда
		Части.Добавить(Строка(ЗаявкаОбъект.Кабинет));
	КонецЕсли;

	Возврат СтрСоединить(Части, " · ");

КонецФункции
