#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() И Объект.График.Количество() = 0 Тогда
		Для НомерДня = 1 По 7 Цикл
			День = Объект.График.Добавить();
			День.ДеньНедели = НомерДня;
		КонецЦикла;
	КонецЕсли;
	Для НомерДня = 1 По 7 Цикл
		Элементы.ГрафикДеньНедели.СписокВыбора.Добавить(НомерДня,
			бит_омни_ГрафикиКлиникиСервер.ИмяДняНедели(НомерДня));
	КонецЦикла;
	Элементы.ГрафикДеньНедели.РежимВыбораИзСписка = Истина;
	ОбновитьЗаголовокКлиники(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьЗаголовокКлиники(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовокКлиники(Форма)

	Форма.Элементы.Клиника.Заголовок = ?(ЗначениеЗаполнено(Форма.Объект.Филиал), "Клиника: " + Строка(Форма.Объект.Филиал), "Клиника");

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКлинику(Команда)

	ПараметрыВыбора = Новый Структура("РежимВыбора,МножественныйВыбор", Истина, Ложь);
	Оповещение = Новый ОписаниеОповещения("КлиникаВыбрана", ЭтотОбъект);
	ОткрытьФорму("Справочник.Филиалы.ФормаВыбора", ПараметрыВыбора, ЭтаФорма, , , , Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура КлиникаВыбрана(ЗначениеВыбора, ДополнительныеПараметры) Экспорт

	Если ЗначениеВыбора = Неопределено Тогда Возврат; КонецЕсли;
	Объект.Филиал = ЗначениеВыбора;
	Модифицированность = Истина;
	ОбновитьЗаголовокКлиники(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ГрафикПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ГрафикПередУдалением(Элемент, Отказ)

	Отказ = Истина;

КонецПроцедуры
