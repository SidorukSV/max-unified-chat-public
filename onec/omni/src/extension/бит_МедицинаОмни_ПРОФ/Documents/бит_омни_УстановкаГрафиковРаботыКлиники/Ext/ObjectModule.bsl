
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если График.Количество() = 0 Тогда
		Для НомерДня = 1 По 7 Цикл
			СтрокаГрафика = График.Добавить();
			СтрокаГрафика.ДеньНедели = НомерДня;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Не ЗначениеЗаполнено(Филиал) Тогда
		ВызватьИсключение "Укажите клинику.";
	КонецЕсли;
	Ошибка = бит_омни_ГрафикиКлиникиСервер.ОшибкаГрафика(ДатаНачала, ДатаОкончания, График);
	Если Не ПустаяСтрока(Ошибка) Тогда ВызватьИсключение Ошибка; КонецЕсли;
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		бит_омни_ГрафикиКлиникиСервер.ПроверитьПересечения(Ссылка, Филиал, ДатаНачала, ДатаОкончания, Дата);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	бит_омни_ГрафикиКлиникиСервер.ПроверитьПересечения(Ссылка, Филиал, ДатаНачала, ДатаОкончания, Дата);
	Движения.бит_омни_ГрафикиРаботыКлиники.Записывать = Истина;
	Для Каждого СтрокаГрафика Из График Цикл
		Движение = Движения.бит_омни_ГрафикиРаботыКлиники.Добавить();
		Движение.Период = Дата;
		Движение.Филиал = Филиал;
		Движение.ДатаНачала = ДатаНачала;
		Движение.ДатаОкончания = ДатаОкончания;
		Движение.ДеньНедели = СтрокаГрафика.ДеньНедели;
		Движение.ВремяНачала = СтрокаГрафика.ВремяНачала;
		Движение.ВремяОкончания = СтрокаГрафика.ВремяОкончания;
	КонецЦикла;

КонецПроцедуры
