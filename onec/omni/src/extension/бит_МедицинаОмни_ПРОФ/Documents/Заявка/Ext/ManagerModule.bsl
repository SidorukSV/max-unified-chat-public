#Область ПрограммныйИнтерфейс

// Возвращает Структуру (Успех, Текст). Техническая ошибка записи пробрасывается для повтора очереди.
Функция бит_омни_ОбработатьCallbackMAX(Заявка, Контакт, Бот, ИдентификаторMAX,
	ВерсияЗаписи, Действие, КлючОтмены = "") Экспорт

	Недоступно = Новый Структура("Успех, Текст", Ложь,
		"Не удалось изменить запись. Возможно, она уже изменена. Обратитесь в клинику.");
	Если СтрРазделить("confirm,cancel,reschedule,cancelYes,cancelNo", ",").Найти(Действие) = Неопределено Тогда
		Возврат Недоступно;
	КонецЕсли;
	Если ТипЗнч(Заявка) <> Тип("ДокументСсылка.Заявка") Или Не ЗначениеЗаполнено(Заявка)
		Или ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или Не ЗначениеЗаполнено(Контакт)
		Или ТипЗнч(Бот) <> Тип("СправочникСсылка.бит_омни_Боты") Или Не ЗначениеЗаполнено(Бот)
		Или ТипЗнч(ИдентификаторMAX) <> Тип("Строка") Или ПустаяСтрока(ИдентификаторMAX)
		Или ТипЗнч(ВерсияЗаписи) <> Тип("Строка") Или СтрДлина(ВерсияЗаписи) <> 14 Тогда
		Возврат Недоступно;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Ответ = бит_омни_CallbackMAXВТранзакции(Заявка, Контакт, Бот,
			ИдентификаторMAX, ВерсияЗаписи, Действие, КлючОтмены, Недоступно);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Ответ;

КонецФункции

Функция бит_омни_CallbackMAXВТранзакции(Заявка, Контакт, Бот,
	ИдентификаторMAX, ВерсияЗаписи, Действие, КлючОтмены, Недоступно)

	// Порядок блокировок: контакт, документ, свойство подтверждения.
	БлокировкаКонтакта = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаКонтакта.Добавить("Справочник.бит_омни_Контакты");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Контакт);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаКонтакта.Заблокировать();
	ОбъектКонтакта = Контакт.ПолучитьОбъект();
	Если ОбъектКонтакта = Неопределено Тогда
		Возврат Недоступно;
	КонецЕсли;
	Если ОбъектКонтакта.ПометкаУдаления Или ОбъектКонтакта.Заблокирован
		Или Бот.ПометкаУдаления Или Не Бот.Использовать
		Или Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX
		Или ОбъектКонтакта.Бот <> Бот
		Или ОбъектКонтакта.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX
		Или Формат(ОбъектКонтакта.Идентификатор, "ЧГ=0; ЧДЦ=0") <> ИдентификаторMAX
		Или ТипЗнч(ОбъектКонтакта.Получатель) <> Тип("СправочникСсылка.Клиенты")
		Или Не ЗначениеЗаполнено(ОбъектКонтакта.Получатель) Тогда
		Возврат Недоступно;
	КонецЕсли;

	БлокировкаЗаявки = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаЗаявки.Добавить("Документ.Заявка");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Заявка);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаЗаявки.Заблокировать();
	ОбъектЗаявки = Заявка.ПолучитьОбъект();
	Если ОбъектЗаявки = Неопределено Тогда
		Возврат Недоступно;
	КонецЕсли;
	Если ОбъектЗаявки.Метаданные().Реквизиты.Найти("Групповая") <> Неопределено Тогда
		Если ОбъектЗаявки.Групповая Тогда
			Возврат Недоступно;
		КонецЕсли;
	КонецЕсли;
	Если ОбъектЗаявки.ПометкаУдаления
		Или ОбъектЗаявки.Клиент <> ОбъектКонтакта.Получатель
		Или ОбъектЗаявки.Клиент.ПометкаУдаления
		Или ОбъектЗаявки.ДатаНачала <= ТекущаяДатаСеанса()
		Или Формат(ОбъектЗаявки.ДатаНачала, "ДФ=yyyyMMddHHmmss") <> ВерсияЗаписи Тогда
		Возврат Недоступно;
	КонецЕсли;

	СостояниеДействий = бит_омни_ПрочитатьДействияMAX(Заявка, Контакт, Бот, ВерсияЗаписи);
	Если ОбъектЗаявки.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена
		Или ОбъектЗаявки.Состояние.ТипСостояния = Перечисления.ТипыСостоянийЗаявок.Отменена Тогда
		Если Действие = "cancelYes" И СостояниеДействий.Отменена
			И Не ПустаяСтрока(КлючОтмены) И КлючОтмены = СостояниеДействий.КлючОтмены Тогда
			Возврат Новый Структура("Успех, Текст", Истина, "Запись отменена.");
		КонецЕсли;
		Возврат Недоступно;
	КонецЕсли;
	РабочиеСостояния = УправлениеЗаявками.СостоянияЗаявкиДоПриходаКлиента();
	ПризнакПереноса = РегистрыСведений.бит_омни_ЗначенияНастроек.ЗначениеКонстанты("ПризнакПереносаЗаявкиMAX");
	Если РабочиеСостояния.Найти(ОбъектЗаявки.Состояние) = Неопределено
		И ОбъектЗаявки.Состояние <> ПризнакПереноса Тогда
		Возврат Недоступно;
	КонецЕсли;

	Если Действие = "cancel" Тогда
		// Повтор первоначальной кнопки не продлевает действующее подтверждение.
		Если Не СостояниеДействий.ОжидаетОтмены
			Или СостояниеДействий.СрокПодтверждения <= ТекущаяДатаСеанса() Тогда
			СостояниеДействий.ОжидаетОтмены = Истина;
			СостояниеДействий.КлючОтмены = НРег(Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 12));
			СостояниеДействий.СрокПодтверждения = ТекущаяДатаСеанса() + 15 * 60;
			СостояниеДействий.ДатаИзменения = ТекущаяДатаСеанса();
		КонецЕсли;
		Ответ = бит_омни_ОтветСКнопкамиMAX(ОбъектЗаявки, Контакт, СостояниеДействий,
			"MAX_APPOINTMENT_CANCEL_CONFIRMATION");
		Если Ответ.Успех Тогда
			СостояниеДействий.Записать();
		КонецЕсли;
		Возврат Ответ;
	КонецЕсли;
	Если Действие = "cancelYes" Или Действие = "cancelNo" Тогда
		Если ПустаяСтрока(КлючОтмены) Или КлючОтмены <> СостояниеДействий.КлючОтмены
			Или СостояниеДействий.СрокПодтверждения <= ТекущаяДатаСеанса() Тогда
			Возврат Недоступно;
		КонецЕсли;
		Если Не СостояниеДействий.ОжидаетОтмены Тогда
			Возврат Недоступно;
		КонецЕсли;
		Если Действие = "cancelNo" Тогда
			Ответ = бит_омни_ОтветСКнопкамиMAX(ОбъектЗаявки, Контакт, СостояниеДействий,
				"MAX_APPOINTMENT_REMINDER");
			Если Не Ответ.Успех Тогда
				Возврат Ответ;
			КонецЕсли;
			СостояниеДействий.ОжидаетОтмены = Ложь;
			СостояниеДействий.ДатаИзменения = ТекущаяДатаСеанса();
			СостояниеДействий.Записать();
			Возврат Ответ;
		КонецЕсли;
	КонецЕсли;

	// Только подписки рассылок ОМНИ: ответ отправляется после commit.
	// Типовые проверки и обработчики записи продолжают выполняться.
	ОбъектЗаявки.ДополнительныеСвойства.Вставить("бит_омни_НеПроверять", Истина);
	Если Действие = "cancelYes" Тогда
		ОбъектЗаявки.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена;
		ОбъектЗаявки.Записать();
		СостояниеДействий.Отменена = Истина;
		СостояниеДействий.ПереносЗапрошен = Ложь;
		бит_омни_ЗаписатьОтбивкуMAX(ОбъектЗаявки, ОбъектКонтакта, Бот, "cancel", "Пациент отменил запись.");
		Ответ = Новый Структура("Успех, Текст", Истина, "Запись отменена.");
	ИначеЕсли Действие = "reschedule" Тогда
		Если Не СостояниеДействий.ПереносЗапрошен Тогда
			Если Не бит_омни_ОтметитьПереносMAX(ОбъектЗаявки, ПризнакПереноса) Тогда
				Возврат Новый Структура("Успех, Текст", Ложь,
					"Не удалось передать запрос переноса. Пожалуйста, напишите оператору.");
			КонецЕсли;
			СостояниеДействий.ПереносЗапрошен = Истина;
			бит_омни_ОтметитьДиалогПереносаMAX(ОбъектКонтакта, Бот);
			бит_омни_ЗаписатьОтбивкуMAX(ОбъектЗаявки, ОбъектКонтакта, Бот,
				"reschedule", "Пациент просит перенести запись. Свяжитесь с пациентом для выбора другого времени.");
		КонецЕсли;
		Ответ = Новый Структура("Успех, Текст", Истина,
			"Запрос переноса передан оператору. Он свяжется с вами. Текущее время приёма пока не изменено.");
	Иначе
		Если СостояниеДействий.ПереносЗапрошен Тогда
			Возврат Новый Структура("Успех, Текст", Ложь,
				"Вы уже запросили перенос. Пожалуйста, согласуйте время с оператором.");
		КонецЕсли;
		Если Не бит_омни_ПодтвердитьCallbackMAX(ОбъектЗаявки, РабочиеСостояния) Тогда
			Возврат Недоступно;
		КонецЕсли;
		Если Не СостояниеДействий.Подтверждена Тогда
			СостояниеДействий.Подтверждена = Истина;
			бит_омни_ЗаписатьОтбивкуMAX(ОбъектЗаявки, ОбъектКонтакта, Бот, "confirm", "Пациент подтвердил запись.");
		КонецЕсли;
		Ответ = Новый Структура("Успех, Текст", Истина, "Приём подтверждён. Ждём вас!");
	КонецЕсли;
	СостояниеДействий.ОжидаетОтмены = Ложь;
	СостояниеДействий.ДатаИзменения = ТекущаяДатаСеанса();
	СостояниеДействий.Записать();
	Возврат Ответ;

КонецФункции

// Контакт и заявка уже заблокированы. Отдельный ключ состояния защищает повтор callbacks.
Функция бит_омни_ПрочитатьДействияMAX(Заявка, Контакт, Бот, Версия)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ДействияЗаписейMAX");
	Элемент.УстановитьЗначение("Заявка", Заявка);
	Элемент.УстановитьЗначение("Контакт", Контакт);
	Элемент.УстановитьЗначение("Бот", Бот);
	Элемент.УстановитьЗначение("Версия", Версия);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запись = РегистрыСведений.бит_омни_ДействияЗаписейMAX.СоздатьМенеджерЗаписи();
	Запись.Заявка = Заявка;
	Запись.Контакт = Контакт;
	Запись.Бот = Бот;
	Запись.Версия = Версия;
	Запись.Прочитать();
	Запись.Заявка = Заявка;
	Запись.Контакт = Контакт;
	Запись.Бот = Бот;
	Запись.Версия = Версия;
	Возврат Запись;

КонецФункции

Функция бит_омни_ОтметитьПереносMAX(ОбъектЗаявки, Признак)

	Если Не ЗначениеЗаполнено(Признак) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Признак) = Тип("СправочникСсылка.ВидыСостоянийЗаявок") Тогда
		Если Признак.ПометкаУдаления
			Или УправлениеЗаявками.СостоянияЗаявкиДоПриходаКлиента().Найти(Признак) = Неопределено Тогда
			// Перенос - запрос оператору, не отмена или завершение приёма.
			Возврат Ложь;
		КонецЕсли;
		ОбъектЗаявки.Состояние = Признак;
		ОбъектЗаявки.Записать();
	Иначе
		Если Не Метаданные.РегистрыСведений.ЗначенияСвойствОбъектов.Измерения.Свойство.Тип.СодержитТип(ТипЗнч(Признак))
			Или Признак.ПометкаУдаления Или Не Признак.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			Возврат Ложь;
		КонецЕсли;
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		Элемент.УстановитьЗначение("Объект", ОбъектЗаявки.Ссылка);
		Элемент.УстановитьЗначение("Свойство", Признак);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Запись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		Запись.Объект = ОбъектЗаявки.Ссылка;
		Запись.Свойство = Признак;
		Запись.Значение = Истина;
		Запись.Записать();
	КонецЕсли;
	Возврат Истина;

КонецФункции

Процедура бит_омни_ОтметитьДиалогПереносаMAX(ОбъектКонтакта, Бот)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_СостоянияДиалоговMAX");
	Элемент.УстановитьЗначение("Пациент", ОбъектКонтакта.Получатель);
	Элемент.УстановитьЗначение("Бот", Бот);
	Элемент.УстановитьЗначение("Отделение", ОбъектКонтакта.ОтделениеMAX);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запись = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
	Запись.Пациент = ОбъектКонтакта.Получатель;
	Запись.Бот = Бот;
	Запись.Отделение = ОбъектКонтакта.ОтделениеMAX;
	Запись.Прочитать();
	Запись.Пациент = ОбъектКонтакта.Получатель;
	Запись.Бот = Бот;
	Запись.Отделение = ОбъектКонтакта.ОтделениеMAX;
	Запись.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.ПереносЗаписи;
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

Процедура бит_омни_ЗаписатьОтбивкуMAX(ОбъектЗаявки, ОбъектКонтакта, Бот, Действие, Текст)

	// Тот же commit, что и изменение заявки: при ошибке истории действие откатывается.
	Запись = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ИдентификаторСообщения = "appointment:" + Строка(ОбъектЗаявки.Ссылка.УникальныйИдентификатор())
		+ ":" + Формат(ОбъектЗаявки.ДатаНачала, "ДФ=yyyyMMddHHmmss") + ":" + Действие;
	Запись.Контакт = ОбъектКонтакта.Ссылка;
	Запись.Бот = Бот;
	Запись.Входящее = Истина;
	Запись.Текст = Текст + " Приём: " + Формат(ОбъектЗаявки.ДатаНачала, "ДФ=dd.MM.yyyy HH:mm")
		+ ", заявка № " + СокрЛП(ОбъектЗаявки.Номер) + ".";
	Запись.ВидСообщения = "appointment_action";
	Запись.Автор = "Действие пациента";
	Запись.Прочитано = Ложь;
	Запись.Статус = "received";
	Запись.ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Бот;
	Запись.Записать();

КонецПроцедуры

Функция бит_омни_ОтветСКнопкамиMAX(ОбъектЗаявки, Контакт, СостояниеДействий, ИдентификаторШаблона)

	ОшибкаНастройки = Новый Структура("Успех,Текст", Ложь,
		"Сейчас не удалось показать кнопки записи. Пожалуйста, напишите оператору. Запись не изменена.");
	Контекст = Новый Структура;
	Контекст.Вставить("appointment_id", Строка(ОбъектЗаявки.Ссылка.УникальныйИдентификатор()));
	Контекст.Вставить("appointment_version", СостояниеДействий.Версия);
	Контекст.Вставить("appointment_date", ОбъектЗаявки.ДатаНачала);
	Контекст.Вставить("appointment_time", ОбъектЗаявки.ДатаНачала);
	Контекст.Вставить("doctor", Строка(ОбъектЗаявки.Сотрудник));
	Контекст.Вставить("address", Строка(ОбъектЗаявки.Филиал));
	Контекст.Вставить("cancel_token", СостояниеДействий.КлючОтмены);
	Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(ИдентификаторШаблона);
	Если Не ЗначениеЗаполнено(Шаблон) Или Шаблон.ПометкаУдаления Тогда
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Callback.Template", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не загружен стандартный шаблон: " + ИдентификаторШаблона);
		Возврат ОшибкаНастройки;
	КонецЕсли;
	Попытка
		Текст = Справочники.бит_омни_ШаблоныСообщений.СформироватьТекстСообщенияПоШаблону(
			Шаблон, Контакт, Контекст);
		Кнопки = Справочники.бит_омни_ШаблоныСообщений.СформироватьКнопкиПоШаблону(
			Шаблон, Контакт, Контекст);
	Исключение
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Callback.Template", УровеньЖурналаРегистрации.Ошибка, , Шаблон,
			"Ошибка формирования стандартного шаблона: " + ИдентификаторШаблона);
		Возврат ОшибкаНастройки;
	КонецПопытки;
	Если ПустаяСтрока(Текст)
		Или Не бит_омни_КнопкиОтветаКорректныMAX(Кнопки, ОбъектЗаявки.Ссылка, СостояниеДействий, ИдентификаторШаблона) Тогда
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Callback.Template", УровеньЖурналаРегистрации.Ошибка, , Шаблон,
			"Не заполнены текст или кнопки стандартного шаблона: " + ИдентификаторШаблона);
		Возврат ОшибкаНастройки;
	КонецЕсли;
	Вложения = Новый Массив;
	Вложения.Добавить(Новый Структура("type,payload", "inline_keyboard", Новый Структура("buttons", Кнопки)));
	Возврат Новый Структура("Успех,Текст,Вложения", Истина, Текст, Вложения);

КонецФункции

Функция бит_омни_КнопкиОтветаКорректныMAX(Кнопки, Заявка, СостояниеДействий, ИдентификаторШаблона)

	Ожидаемые = СтрРазделить(?(ИдентификаторШаблона = "MAX_APPOINTMENT_CANCEL_CONFIRMATION",
		"cancelYes,reschedule,cancelNo", "confirm,reschedule,cancel"), ",");
	Для Каждого Ряд Из Кнопки Цикл
		Если ТипЗнч(Ряд) <> Тип("Массив") Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Кнопка Из Ряд Цикл
			Если ТипЗнч(Кнопка) <> Тип("Структура") Тогда
				Возврат Ложь;
			КонецЕсли;
			ТипКнопки = "";
			Команда = "";
			Если Не Кнопка.Свойство("type", ТипКнопки) Или ТипКнопки <> "callback"
				Или Не Кнопка.Свойство("payload", Команда) Тогда
				Возврат Ложь;
			КонецЕсли;
			Данные = бит_омни_ИнтеграцияСMAX.РазобратьКомандуЗаписиMAX(Команда);
			Если Данные = Неопределено Или Данные.Заявка <> Заявка Или Данные.Версия <> СостояниеДействий.Версия
				Или Ожидаемые.Найти(Данные.Действие) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			Если (Данные.Действие = "cancelYes" Или Данные.Действие = "cancelNo")
				И Данные.КлючОтмены <> СостояниеДействий.КлючОтмены Тогда
				Возврат Ложь;
			КонецЕсли;
			Ожидаемые.Удалить(Ожидаемые.Найти(Данные.Действие));
		КонецЦикла;
	КонецЦикла;
	Возврат Ожидаемые.Количество() = 0;

КонецФункции

Функция бит_омни_ПодтвердитьCallbackMAX(ОбъектЗаявки, РабочиеСостояния)

	Признак = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики("ПризнакПодтвержденнойЗаявки");
	Если Не ЗначениеЗаполнено(Признак) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Признак) = Тип("СправочникСсылка.ВидыСостоянийЗаявок") Тогда
		Если РабочиеСостояния.Найти(Признак) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ОбъектЗаявки.Состояние <> Признак Тогда
			ОбъектЗаявки.Состояние = Признак;
			ОбъектЗаявки.Записать();
		КонецЕсли;
	Иначе
		БлокировкаСвойства = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаСвойства.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
		ЭлементБлокировки.УстановитьЗначение("Объект", ОбъектЗаявки.Ссылка);
		ЭлементБлокировки.УстановитьЗначение("Свойство", Признак);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаСвойства.Заблокировать();
		Запись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		Запись.Объект = ОбъектЗаявки.Ссылка;
		Запись.Свойство = Признак;
		Запись.Прочитать();
		Если Не Запись.Выбран() Тогда
			Запись.Объект = ОбъектЗаявки.Ссылка;
			Запись.Свойство = Признак;
		КонецЕсли;
		Если Запись.Значение <> Истина Тогда
			Запись.Значение = Истина;
			Запись.Записать();
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;

КонецФункции

Функция бит_омни_ДанныеДокументов(HTTPЗапрос) Экспорт
	
	ТипПоиска = HTTPЗапрос.ПараметрыЗапроса.Получить("search_type");
	
	Если ТипПоиска = Неопределено Тогда
		Возврат бит_омни_ИнтеграцияСерверСлужебный.НеопределенТипПоиска();	
	ИначеЕсли ТипПоиска = "ByPatient" Тогда                                     
		ИдентификаторПациента = HTTPЗапрос.ПараметрыЗапроса.Получить("patient_id");
		Возврат бит_омни_ЗаявкиПоПациенту(ИдентификаторПациента);
	ИначеЕсли ТипПоиска = "ByID" Тогда
		ИдентификаторПациента = HTTPЗапрос.ПараметрыЗапроса.Получить("appointmentId");
		Возврат бит_омни_ЗаявкаПоUUID(ИдентификаторПациента);
	Иначе	
		Возврат бит_омни_ИнтеграцияСерверСлужебный.НеверныйТипПоиска();	
	КонецЕсли;

КонецФункции

Функция бит_омни_ОбновитьДокумент(HTTPЗапрос) Экспорт

	ТелоЗапроса = бит_омни_ИнтеграцияСервер.ТелоЗапросаВСтруктуру(HTTPЗапрос);
	ИдентификаторДокумента = Неопределено;
	ТелоЗапроса.Свойство("appointmentId", ИдентификаторДокумента);
	
	Заявка = бит_омни_ЗаявкаПоUUID(ИдентификаторДокумента, Истина);
	
	Если ТипЗнч(Заявка) <> Тип("ДокументСсылка.Заявка") Тогда
		Возврат Заявка; // функция может вернуть только HTTPСервисОтвет или ДокументСсылка.Заявка
	КонецЕсли;
	
	Если ТелоЗапроса.Свойство("isApproved") Тогда
		Возврат бит_омни_ПодтвердитьЗаявку(Заявка, ИдентификаторДокумента);	
	КонецЕсли;
	
	Если ТелоЗапроса.Свойство("isCanceled") Тогда
		Возврат бит_омни_ОтменитьЗаявку(Заявка, ИдентификаторДокумента);	
	КонецЕсли;
	
	Возврат бит_омни_СоздатьОбновитьДокумент(HTTPЗапрос, Истина); 

КонецФункции

Функция бит_омни_СоздатьДокумент(HTTPЗапрос) Экспорт
	
	Возврат бит_омни_СоздатьОбновитьДокумент(HTTPЗапрос);  
	
КонецФункции // бит_омни_СоздатьДокумент()


#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция бит_омни_СоздатьОбновитьДокумент(HTTPЗапрос, Обновление = Ложь)

	ТелоЗапроса = бит_омни_ИнтеграцияСервер.ТелоЗапросаВСтруктуру(HTTPЗапрос);
	
	Клиент = Справочники.Клиенты.бит_омни_ПациентПоUUID(ТелоЗапроса.patient_id, Истина);
	
	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.Клиенты") Тогда
		Возврат Клиент; // если тип другой, то это HTTPСервисОтвет	
	КонецЕсли;
	
	Сотрудник = Справочники.Сотрудники.бит_омни_СотрудникПоUUID(ТелоЗапроса.doctorId, Истина);
	
	Если ТипЗнч(Сотрудник) <> Тип("СправочникСсылка.Сотрудники") Тогда
		Возврат Сотрудник; // если тип другой, то это HTTPСервисОтвет	
	КонецЕсли;
	
	Филиал = Справочники.Филиалы.бит_омни_ФилиалПоUUID(ТелоЗапроса.branchId, Истина);
	
	Если ТипЗнч(Филиал) <> Тип("СправочникСсылка.Филиалы") Тогда
		Возврат Филиал; // если тип другой, то это HTTPСервисОтвет	
	КонецЕсли;
	
	Специализация = Справочники.КатегорииВыработки.бит_омни_СпециализацияПоUUID(ТелоЗапроса.specializationId, Истина);
	
	Если ТипЗнч(Специализация) <> Тип("СправочникСсылка.КатегорииВыработки") Тогда
		Возврат Специализация; // если тип другой, то это HTTPСервисОтвет	
	КонецЕсли;
	
	Кабинет = Справочники.Оборудование.бит_омни_ОборудованиеПоUUID(ТелоЗапроса.cabinetId, Истина);
	
	Если ТипЗнч(Кабинет) <> Тип("СправочникСсылка.Оборудование") Тогда
		Кабинет = Справочники.Оборудование.ПустаяСсылка(); // необязательное поле	
	КонецЕсли;

	ДатаНачала = ТелоЗапроса.datetimeBegin;
	РезультатПроверки = бит_омни_ИнтеграцияСервер.ВалидироватьДату(ДатаНачала, "datetimeBegin", Истина);
	
	Если РезультатПроверки <> Неопределено Тогда
		Возврат РезультатПроверки;	
	КонецЕсли;
	
	ДлительностьПриема = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "ДлительностьПриема");
	ДлительностьПриемааВСекундах = ОбщегоНазначения.ВремяВСекунды(ДлительностьПриема);
	
	Если Обновление Тогда
		ЗаявкаСсылка = бит_омни_ЗаявкаПоUUID(ТелоЗапроса.appointmentId, Истина);
		
		Если ТипЗнч(ЗаявкаСсылка) <> Тип("ДокументСсылка.Заявка") Тогда
			Возврат ЗаявкаСсылка; // если тип другой, то это HTTPСервисОтвет	
		КонецЕсли;
		
		Заявка = ЗаявкаСсылка.ПолучитьОбъект(); 
		Заявка.Работы.Очистить();
	Иначе
		Заявка = Документы.Заявка.СоздатьДокумент();
		Заявка.Дата = ТекущаяДатаСеанса();
		Заявка.Клиент = Клиент;
		Заявка.Кабинет = Кабинет;
		Заявка.бит_омни_Специализация = Специализация;
		Заявка.бит_омни_ЗаписьИзБота = Истина;
		Заявка.Ответственный = Пользователи.ТекущийПользователь();
		Заявка.Состояние = Справочники.ВидыСостоянийЗаявок.Запланирована;
	КонецЕсли;
	
	Заявка.Сотрудник = Сотрудник;
	Заявка.Филиал = Филиал;
	Заявка.ДатаНачала = ДатаНачала;
	Заявка.ВремяНачала = ДатаНачала;
	Заявка.ДатаОкончания = ДатаНачала + ДлительностьПриемааВСекундах;
	Заявка.ВремяОкончания = Заявка.ДатаОкончания;
	ЗаявкаРаботы = Заявка.Работы.Добавить();
	ЗаявкаРаботы.ДатаНачала = Заявка.ДатаНачала;
	ЗаявкаРаботы.ДатаОкончания = Заявка.ДатаОкончания;
	ЗаявкаРаботы.Продолжительность = Дата(1,1,1) + (Заявка.ДатаОкончания - Заявка.ДатаНачала);
	
	Попытка
		Заявка.Записать();
		
		Если НЕ Обновление Тогда
			бит_омни_ЗаписатьПодтверждениеЗаявки(Заявка.Ссылка);
		КонецЕсли;
		
		Возврат бит_омни_ЗаявкаПоUUID(Строка(Заявка.Ссылка.УникальныйИдентификатор()));
	Исключение
		Ошибки = Новый Массив;
		Ошибки.Добавить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Для Каждого Сообщение Из Сообщения Цикл
			Ошибки.Добавить(Сообщение.Текст);
		КонецЦикла;
		
		Возврат бит_омни_ИнтеграцияСервер.ОтветСОшибкой("couldnt_appointment", 400, СтрСоединить(Ошибки, Символы.ПС));
	КонецПопытки;

КонецФункции // бит_омни_СоздатьОбновитьДокумент()


Функция бит_омни_ЗаявкиПоПациенту(ИдентификаторПациента) Экспорт
	
	Если ИдентификаторПациента = Неопределено Тогда
		Возврат Справочники.Клиенты.бит_омни_НеопределенИдентификатор();
	КонецЕсли;	                                                        
	
	Клиент = Справочники.Клиенты.бит_омни_ПациентПоUUID(ИдентификаторПациента, Истина);
	
	Если ТипЗнч(Клиент) <> Тип("СправочникСсылка.Клиенты") Тогда
		Возврат Клиент; // функция может вернуть только HTTPСервисОтвет или СправочникСсылка.Клиенты
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("Клиент", Клиент);
	ПараметрыПоиска.Вставить("ТекущаяДата", ТекущаяДатаСеанса());
	ПараметрыПоиска.Вставить("СостояниеОтмена", Справочники.ВидыСостоянийЗаявок.Отменена);
	
	УсловиеПоиска = "
	|	НЕ ЗаявкаРаботы.Ссылка.ПометкаУдаления
	|	И ЗаявкаРаботы.Ссылка.Состояние <> &СостояниеОтмена
	|	И ЗаявкаРаботы.Ссылка.Состояние.ТипСостояния <> ЗНАЧЕНИЕ(Перечисление.ТипыСостоянийЗаявок.Отменена)
	|	И ЗаявкаРаботы.Ссылка.Клиент = &Клиент
	|	И ЗаявкаРаботы.Ссылка.ДатаНачала >= НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ)";
	ДанныеИзЗапроса = бит_омни_ПолучитьДанныеЗаявок(ПараметрыПоиска, УсловиеПоиска, 100);
	
	ТелоЗапроса = ОбщегоНазначения.ТаблицаЗначенийВМассив(ДанныеИзЗапроса);
	Возврат бит_омни_ИнтеграцияСервер.УспешныйОтвет(ТелоЗапроса);

КонецФункции

Функция бит_омни_ЗаявкаПоUUID(Знач ИдентификаторДокумента, ВернутьСсылку = Ложь) Экспорт
	
	РезультатПроверки = бит_омни_ИнтеграцияСервер.ВалидироватьИдентификатор(ИдентификаторДокумента, "appointmentId");
	
	Если РезультатПроверки <> Неопределено Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Заявка = ПолучитьСсылку(ИдентификаторДокумента);
	Если НЕ ОбщегоНазначения.СсылкаСуществует(Заявка) Тогда
		Возврат бит_омни_НеНайденаЗаявка();
	КонецЕсли;
	
	Если ВернутьСсылку Тогда
		Возврат Заявка;
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("Ссылка", Заявка);
	
	УсловиеПоиска = "
	|	ЗаявкаРаботы.Ссылка = &Ссылка";
	ДанныеИзЗапроса = бит_омни_ПолучитьДанныеЗаявок(ПараметрыПоиска, УсловиеПоиска, 1);
	
	ТелоЗапроса = ОбщегоНазначения.ТаблицаЗначенийВМассив(ДанныеИзЗапроса);	
	Возврат бит_омни_ИнтеграцияСервер.УспешныйОтвет(ТелоЗапроса.Получить(0));

КонецФункции

