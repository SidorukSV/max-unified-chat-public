// Идентичность адресата изменяется только доверенными серверными сценариями.
// ОбменДанными.Загрузка не является разрешением обходить проверку прав.
Процедура ПередЗаписью(Отказ)

	Если ПривилегированныйРежим() Или РольДоступна("ПолныеПрава") Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоНовый() Тогда
		ВызватьИсключение "Создание контакта MAX доступно только служебному обработчику.";
	КонецЕсли;
	бит_омни_ОтделенияMAXСервер.ПроверитьДоступККонтакту(Ссылка);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Контакт.Бот КАК Бот, Контакт.Идентификатор КАК Идентификатор,
		| Контакт.Канал КАК Канал, Контакт.ОтделениеMAX КАК ОтделениеMAX,
		| Контакт.Получатель КАК Получатель
		|ИЗ Справочник.бит_омни_Контакты КАК Контакт
		|ГДЕ Контакт.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	СохраненныйКонтакт = Запрос.Выполнить().Выбрать();
	Если Не СохраненныйКонтакт.Следующий() Тогда
		ВызватьИсключение "Контакт MAX недоступен.";
	КонецЕсли;
	Если Бот <> СохраненныйКонтакт.Бот
		Или Идентификатор <> СохраненныйКонтакт.Идентификатор
		Или Канал <> СохраненныйКонтакт.Канал
		Или ОтделениеMAX <> СохраненныйКонтакт.ОтделениеMAX
		Или Получатель <> СохраненныйКонтакт.Получатель Тогда
		ВызватьИсключение "Изменение адресата, пациента или отделения выполняется только командами Единого чата.";
	КонецЕсли;

КонецПроцедуры
