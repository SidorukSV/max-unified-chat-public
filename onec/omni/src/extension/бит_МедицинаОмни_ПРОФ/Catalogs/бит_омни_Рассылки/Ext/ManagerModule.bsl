#Область ПрограммныйИнтерфейс

// Явная команда пользователя. При установке расширения напоминания не включаются.
Функция СоздатьСтандартныеНапоминанияЗаписейMAX(Бот) Экспорт

	ПроверитьБотаДляСтандартныхРассылок(Бот);
	Идентификаторы = СтрРазделить("MAX_APPOINTMENT_REMINDER_24H,MAX_APPOINTMENT_REMINDER_2H", ",");
	Результат = Новый Структура("Создано, УжеСуществовало, Активировано", 0, 0, 0);
	НачатьТранзакцию();
	Попытка
		Справочники.бит_омни_ШаблоныСообщений.СоздатьСтандартныеШаблоныЕслиОтсутствуют(Идентификаторы);
		Для Каждого Идентификатор Из Идентификаторы Цикл
			Наименование = ?(Идентификатор = "MAX_APPOINTMENT_REMINDER_24H",
				"MAX: напоминание за сутки", "MAX: напоминание за два часа");
			Рассылка = НайтиПоНаименованию(Наименование, Истина);
			Если Рассылка.Пустая() Тогда
				ОбъектРассылки = СоздатьЭлемент();
				ОбъектРассылки.Наименование = Наименование;
				ОбъектРассылки.Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(Идентификатор);
				Если ОбъектРассылки.Шаблон.Пустая() Тогда
					ВызватьИсключение СтрШаблон("Не найден шаблон напоминания %1", Идентификатор);
				КонецЕсли;
				ДобавитьДатуСтандартногоНапоминания(ОбъектРассылки, Идентификатор);
				ПодготовитьНапоминаниеПриЗаписи(ОбъектРассылки);
				ОбъектРассылки.Записать();
				Рассылка = ОбъектРассылки.Ссылка;
				Результат.Создано = Результат.Создано + 1;
			Иначе
				Если Рассылка.ПометкаУдаления Тогда
					ВызватьИсключение СтрШаблон("Рассылка «%1» помечена на удаление. Снимите пометку вручную.", Наименование);
				КонецЕсли;
				Результат.УжеСуществовало = Результат.УжеСуществовало + 1;
				// Только явная команда, пользовательские строки не заменяем.
				ОбъектРассылки = Рассылка.ПолучитьОбъект();
				Если ОбъектРассылки.ДатыСобытия.Количество() = 0 Тогда
					ДобавитьДатуСтандартногоНапоминания(ОбъектРассылки, Идентификатор);
				КонецЕсли;
				// Явная миграция стандартной рассылки, не обновление всех данных базы.
				// Пользовательские строки дат сохраняем; для прежнего режима меняем источник события.
				ПодготовитьНапоминаниеПриЗаписи(ОбъектРассылки);
				ОбъектРассылки.Записать();
			КонецЕсли;
			Если АктивироватьРассылкуЕслиНужно(Рассылка, Бот) Тогда
				Результат.Активировано = Результат.Активировано + 1;
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

Процедура ПодготовитьНапоминаниеПриЗаписи(ОбъектРассылки)

	ПереводНаСобытие = ОбъектРассылки.РежимРассылки <>
		Перечисления.бит_омни_РежимыРассылки.ПриЗаписиОбъекта;
	ОбъектРассылки.РежимРассылки = Перечисления.бит_омни_РежимыРассылки.ПриЗаписиОбъекта;
	Если ПереводНаСобытие Или Не ЗначениеЗаполнено(ОбъектРассылки.СКДКонтекст.Получить()) Тогда
		ОбъектРассылки.СКДКонтекст = Новый ХранилищеЗначения(ПолучитьИлиСоздатьСКДСобытияЗаписи(Ложь));
	КонецЕсли;
	Если ПереводНаСобытие Или Не ЗначениеЗаполнено(ОбъектРассылки.СКДПолучатели.Получить()) Тогда
		ОбъектРассылки.СКДПолучатели = Новый ХранилищеЗначения(ПолучитьИлиСоздатьСКДСобытияЗаписи(Истина));
	КонецЕсли;
	Если ОбъектРассылки.Принадлежность.Найти("Документ.Заявка", "Объект") = Неопределено Тогда
		ОбъектРассылки.Принадлежность.Добавить().Объект = "Документ.Заявка";
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьДатуСтандартногоНапоминания(ОбъектРассылки, Идентификатор)

	СтрокаДаты = ОбъектРассылки.ДатыСобытия.Добавить();
	// Стабильные идентификаторы только мигрированных стандартных этапов.
	СтрокаДаты.ИдентификаторСтроки = ?(Идентификатор = "MAX_APPOINTMENT_REMINDER_24H",
		"00000000-0000-0000-0000-000000000024", "00000000-0000-0000-0000-000000000002");
	СтрокаДаты.Использовать = Истина;
	СтрокаДаты.Шаблон = "ДоДаты";
	СтрокаДаты.РеквизитКонтекста = "ДатаНачала";
	СтрокаДаты.КоличествоЧасов = ?(Идентификатор = "MAX_APPOINTMENT_REMINDER_24H", 24, 2);

КонецПроцедуры

Функция СоздатьСтандартныеРассылкиЗаписейMAX(Бот) Экспорт

	ПроверитьБотаДляСтандартныхРассылок(Бот);

	НаименованиеОповещения = "MAX: уведомление о новой записи";

	РассылкаОповещения = НайтиПоНаименованию(НаименованиеОповещения, Истина);

	Результат = Новый Структура("Создано, УжеСуществовало, Активировано", 0, 0, 0);
	Если Не РассылкаОповещения.Пустая() Тогда
		Результат.УжеСуществовало = Результат.УжеСуществовало + 1;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ИдентификаторыШаблонов = Новый Массив;
		Если РассылкаОповещения.Пустая() Тогда
			ИдентификаторыШаблонов.Добавить("MAX_APPOINTMENT_CREATED");
		КонецЕсли;
		Если ИдентификаторыШаблонов.Количество() > 0 Тогда
			Справочники.бит_омни_ШаблоныСообщений.СоздатьСтандартныеШаблоныЕслиОтсутствуют(
				ИдентификаторыШаблонов);
			СКДКонтекст = ПолучитьИлиСоздатьСКДКонтекстаЗаписи();
		КонецЕсли;

		Если РассылкаОповещения.Пустая() Тогда
			СКДПолучатели = ПолучитьИлиСоздатьСКДПолучателейЗаписи();
			РассылкаОповещения = СоздатьСтандартнуюРассылку(
				НаименованиеОповещения,
				"MAX_APPOINTMENT_CREATED",
				СКДПолучатели,
				СКДКонтекст);
			Результат.Создано = Результат.Создано + 1;
		КонецЕсли;

		Если АктивироватьРассылкуЕслиНужно(РассылкаОповещения, Бот) Тогда
			Результат.Активировано = Результат.Активировано + 1;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьБотаДляСтандартныхРассылок(Бот)

	Если Не ЗначениеЗаполнено(Бот) Тогда
		ВызватьИсключение НСтр("ru='Сначала запишите карточку бота.'");
	КонецЕсли;

	ДанныеБота = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Бот, "Канал, Использовать, Токен");
	Если ДанныеБота.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ВызватьИсключение НСтр("ru='Стандартные рассылки записей можно создать только для бота MAX.'");
	КонецЕсли;

	Если Не ДанныеБота.Использовать Тогда
		ВызватьИсключение НСтр("ru='Включите флаг Использовать и запишите бота.'");
	КонецЕсли;

	Если ПустаяСтрока(ДанныеБота.Токен) Тогда
		ВызватьИсключение НСтр("ru='Укажите токен MAX и запишите бота.'");
	КонецЕсли;

КонецПроцедуры

Функция СоздатьСтандартнуюРассылку(
	НаименованиеРассылки, ИдентификаторШаблона, СКДПолучатели, СКДКонтекст)

	Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(ИдентификаторШаблона);
	Если Шаблон.Пустая() Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Не удалось создать стандартный шаблон %1.'"),
			ИдентификаторШаблона);
	КонецЕсли;

	ОбъектРассылки = СоздатьЭлемент();
	ОбъектРассылки.Наименование = НаименованиеРассылки;
	ОбъектРассылки.Шаблон = Шаблон;
	ОбъектРассылки.РежимРассылки = Перечисления.бит_омни_РежимыРассылки.ПриЗаписиОбъекта;
	ОбъектРассылки.СКДПолучатели = Новый ХранилищеЗначения(СКДПолучатели);
	ОбъектРассылки.СКДКонтекст = Новый ХранилищеЗначения(СКДКонтекст);
	СтрокаПринадлежности = ОбъектРассылки.Принадлежность.Добавить();
	СтрокаПринадлежности.Объект = "Документ.Заявка";
	ОбъектРассылки.Записать();

	Возврат ОбъектРассылки.Ссылка;

КонецФункции

Функция АктивироватьРассылкуЕслиНужно(Рассылка, Бот)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_омни_АктивныеРассылки.Рассылка КАК Рассылка
	|ИЗ
	|	РегистрСведений.бит_омни_АктивныеРассылки КАК бит_омни_АктивныеРассылки
	|ГДЕ
	|	бит_омни_АктивныеРассылки.Рассылка = &Рассылка
	|	И бит_омни_АктивныеРассылки.Бот = &Бот";
	Запрос.УстановитьПараметр("Рассылка", Рассылка);
	Запрос.УстановитьПараметр("Бот", Бот);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;

	АктивнаяРассылка = РегистрыСведений.бит_омни_АктивныеРассылки.СоздатьМенеджерЗаписи();
	АктивнаяРассылка.Рассылка = Рассылка;
	АктивнаяРассылка.Бот = Бот;
	АктивнаяРассылка.Записать();

	Возврат Истина;

КонецФункции

Функция ПолучитьИлиСоздатьСКДСобытияЗаписи(ДляПолучателей)

	Наименование = ?(ДляПолучателей, "MAX: получатели события записи", "MAX: контекст события записи");
	СсылкаСКД = Справочники.бит_омни_СхемыКомпоновкиДанных.НайтиПоНаименованию(Наименование, Истина);
	Если Не СсылкаСКД.Пустая() Тогда
		// Исправляем только отсутствующее служебное описание источника, не настройки пользователя.
		ОбъектСКД = СсылкаСКД.ПолучитьОбъект();
		Схема = ОбъектСКД.ХранилищеСКД.Получить();
		Если ОбеспечитьИсточникДанныхОбъединения(Схема) Тогда
			ОбъектСКД.ХранилищеСКД = Новый ХранилищеЗначения(Схема, Новый СжатиеДанных(9));
			ОбъектСКД.Записать();
		КонецЕсли;
		Возврат СсылкаСКД;
	КонецЕсли;
	Схема = ?(ДляПолучателей, СоздатьСКДПолучателейСобытияЗаписи(), СоздатьСКДКонтекстаСобытияЗаписи());
	ОбъектСКД = Справочники.бит_омни_СхемыКомпоновкиДанных.СоздатьЭлемент();
	ОбъектСКД.Наименование = Наименование;
	ОбъектСКД.ХранилищеСКД = Новый ХранилищеЗначения(Схема, Новый СжатиеДанных(9));
	ОбъектСКД.Записать();
	Возврат ОбъектСКД.Ссылка;

КонецФункции

Функция СоздатьСКДКонтекстаСобытияЗаписи()

	РеквизитыМетаданных = бит_омни_СхемыКомпоновки.ТаблицаРеквизитовМетаданных("Документ.Заявка");
	РеквизитыПередЗаписью = РеквизитыМетаданных.Скопировать();
	РеквизитыПриЗаписи = РеквизитыМетаданных.Скопировать();
	ИменаРеквизитов = СтрРазделить("Ссылка,Дата,Клиент,ДатаНачала,ДатаОкончания,Состояние,ПометкаУдаления,Сотрудник,Филиал", ",", Ложь);
	ОтметитьРеквизитыДляСКД(РеквизитыПередЗаписью, ИменаРеквизитов);
	ОтметитьРеквизитыДляСКД(РеквизитыПриЗаписи, ИменаРеквизитов);
	Схема = бит_омни_СхемыКомпоновки.СхемаПоМетаданным(
		"Документ.Заявка", РеквизитыПередЗаписью, РеквизитыПриЗаписи);
	НаборДанных = ДобавитьНаборДанныхОбъединенный(Схема);
	ВыбранныеПоля = Новый Массив;
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		ТипЗначения = ТипРеквизита(РеквизитыМетаданных, ИмяРеквизита);
		ДобавитьПолеНабораДанных(НаборДанных, ИмяРеквизита, ИмяРеквизита + "После", ТипЗначения);
		ДобавитьПолеНабораДанных(НаборДанных, ИмяРеквизита + "До", ИмяРеквизита + "До", ТипЗначения);
		ДобавитьПолеНабораДанных(НаборДанных, ИмяРеквизита + "После", ИмяРеквизита + "После", ТипЗначения);
		ВыбранныеПоля.Добавить(ИмяРеквизита);
		ВыбранныеПоля.Добавить(ИмяРеквизита + "До");
		ВыбранныеПоля.Добавить(ИмяРеквизита + "После");
	КонецЦикла;
	СоответствиеПолей = Новый Структура("appointment_id,appointment_version,appointment_date,appointment_time,doctor,address",
		"Ссылка", "ДатаНачала", "ДатаНачала", "ДатаНачала", "Сотрудник", "Филиал");
	Для Каждого Пара Из СоответствиеПолей Цикл
		ДобавитьПолеНабораДанных(НаборДанных, Пара.Ключ, Пара.Значение + "После",
			ТипРеквизита(РеквизитыМетаданных, Пара.Значение));
		ВыбранныеПоля.Добавить(Пара.Ключ);
	КонецЦикла;
	НастроитьВыбранныеПоля(Схема, ВыбранныеПоля);
	ДобавитьОтборРавно(Схема, "ПометкаУдаленияПосле", Ложь);
	ДобавитьОтборНеРавно(Схема, "СостояниеПосле", Справочники.ВидыСостоянийЗаявок.Отменена);
	ДобавитьОтборНеРавно(Схема, "КлиентПосле", Справочники.Клиенты.ПустаяСсылка());
	// Нет отбора только новой записи: перенос/отмена должны пересобрать ожидающие сообщения.
	Возврат Схема;

КонецФункции

Функция СоздатьСКДПолучателейСобытияЗаписи()

	РеквизитыМетаданных = бит_омни_СхемыКомпоновки.ТаблицаРеквизитовМетаданных("Документ.Заявка");
	Схема = Новый СхемаКомпоновкиДанных;
	НаборДанных = ДобавитьНаборДанныхОбъединенный(Схема);
	ДобавитьПолеНабораДанных(НаборДанных, "Получатель", "КлиентПосле",
		ТипРеквизита(РеквизитыМетаданных, "Клиент"));
	НастроитьВыбранныеПоля(Схема, СтрРазделить("Получатель", ",", Ложь));
	ДобавитьОтборНеРавно(Схема, "Получатель", Справочники.Клиенты.ПустаяСсылка());
	Возврат Схема;

КонецФункции

Процедура ДобавитьОтборНеРавно(Схема, ИмяПоля, Значение)

	ЭлементОтбора = Схема.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.ПравоеЗначение = Значение;

КонецПроцедуры

Функция ПолучитьИлиСоздатьСКДКонтекстаЗаписи()

	Наименование = "MAX: контекст новой записи";
	СсылкаСКД = Справочники.бит_омни_СхемыКомпоновкиДанных.НайтиПоНаименованию(Наименование, Истина);
	Если Не СсылкаСКД.Пустая() Тогда
		Возврат СсылкаСКД;
	КонецЕсли;

	ОбъектСКД = Справочники.бит_омни_СхемыКомпоновкиДанных.СоздатьЭлемент();
	ОбъектСКД.Наименование = Наименование;
	ОбъектСКД.ХранилищеСКД = Новый ХранилищеЗначения(СоздатьСКДКонтекстаЗаписи(), Новый СжатиеДанных(9));
	ОбъектСКД.Записать();

	Возврат ОбъектСКД.Ссылка;

КонецФункции

Функция ПолучитьИлиСоздатьСКДПолучателейЗаписи()

	Наименование = "MAX: получатели уведомления о записи";

	СсылкаСКД = Справочники.бит_омни_СхемыКомпоновкиДанных.НайтиПоНаименованию(Наименование, Истина);
	Если Не СсылкаСКД.Пустая() Тогда
		Возврат СсылкаСКД;
	КонецЕсли;

	ОбъектСКД = Справочники.бит_омни_СхемыКомпоновкиДанных.СоздатьЭлемент();
	ОбъектСКД.Наименование = Наименование;
	ОбъектСКД.ХранилищеСКД = Новый ХранилищеЗначения(
		СоздатьСКДПолучателейЗаписи(), Новый СжатиеДанных(9));
	ОбъектСКД.Записать();

	Возврат ОбъектСКД.Ссылка;

КонецФункции

Функция СоздатьСКДКонтекстаЗаписи()

	РеквизитыМетаданных = бит_омни_СхемыКомпоновки.ТаблицаРеквизитовМетаданных("Документ.Заявка");
	РеквизитыПередЗаписью = РеквизитыМетаданных.Скопировать();
	РеквизитыПриЗаписи = РеквизитыМетаданных.Скопировать();

	ОтметитьРеквизитыДляСКД(РеквизитыПередЗаписью, СтрРазделить("Ссылка", ",", Ложь));
	ОтметитьРеквизитыДляСКД(РеквизитыПриЗаписи, СтрРазделить(
		"Ссылка,Клиент,ДатаНачала,Сотрудник,Филиал,бит_омни_ЗаписьИзБота", ",", Ложь));

	Схема = бит_омни_СхемыКомпоновки.СхемаПоМетаданным(
		"Документ.Заявка", РеквизитыПередЗаписью, РеквизитыПриЗаписи);

	НаборДанных = ДобавитьНаборДанныхОбъединенный(Схема);
	ДобавитьПолеНабораДанных(
		НаборДанных, "appointment_id", "СсылкаПосле", ТипРеквизита(РеквизитыМетаданных, "Ссылка"));
	ДобавитьПолеНабораДанных(
		НаборДанных, "appointment_date", "ДатаНачалаПосле", ТипРеквизита(РеквизитыМетаданных, "ДатаНачала"));
	ДобавитьПолеНабораДанных(
		НаборДанных, "appointment_time", "ДатаНачалаПосле", ТипРеквизита(РеквизитыМетаданных, "ДатаНачала"));
	ДобавитьПолеНабораДанных(
		НаборДанных, "doctor", "СотрудникПосле", ТипРеквизита(РеквизитыМетаданных, "Сотрудник"));
	ДобавитьПолеНабораДанных(
		НаборДанных, "address", "ФилиалПосле", ТипРеквизита(РеквизитыМетаданных, "Филиал"));
	ДобавитьПолеНабораДанных(
		НаборДанных, "СсылкаДо", "СсылкаДо", ТипРеквизита(РеквизитыМетаданных, "Ссылка"));

	НастроитьВыбранныеПоля(Схема, СтрРазделить(
		"appointment_id,appointment_date,appointment_time,doctor,address", ",", Ложь));
	ДобавитьОтборРавно(Схема, "СсылкаДо", Документы.Заявка.ПустаяСсылка());

	Возврат Схема;

КонецФункции

Функция СоздатьСКДПолучателейЗаписи()

	РеквизитыМетаданных = бит_омни_СхемыКомпоновки.ТаблицаРеквизитовМетаданных("Документ.Заявка");
	Схема = Новый СхемаКомпоновкиДанных;
	НаборДанных = ДобавитьНаборДанныхОбъединенный(Схема);

	ДобавитьПолеНабораДанных(
		НаборДанных, "Получатель", "КлиентПосле", ТипРеквизита(РеквизитыМетаданных, "Клиент"));
	ДобавитьПолеНабораДанных(
		НаборДанных, "СсылкаДо", "СсылкаДо", ТипРеквизита(РеквизитыМетаданных, "Ссылка"));
	ДобавитьПолеНабораДанных(
		НаборДанных,
		"ЗаписьИзБота",
		"бит_омни_ЗаписьИзБотаПосле",
		ТипРеквизита(РеквизитыМетаданных, "бит_омни_ЗаписьИзБота"));

	НастроитьВыбранныеПоля(Схема, СтрРазделить("Получатель", ",", Ложь));
	ДобавитьОтборРавно(Схема, "СсылкаДо", Документы.Заявка.ПустаяСсылка());

	Возврат Схема;

КонецФункции

Функция ДобавитьНаборДанныхОбъединенный(Схема)

	ОбеспечитьИсточникДанныхОбъединения(Схема);
	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "НаборДанныхОбъединенный";
	НаборДанных.ИмяОбъекта = "НаборДанныхОбъединенный";
	НаборДанных.ИсточникДанных = "ИсточникДанных1";

	Возврат НаборДанных;

КонецФункции

Функция ОбеспечитьИсточникДанныхОбъединения(Схема)

	Если Схема.ИсточникиДанных.Найти("ИсточникДанных1") <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИсточникДанных = Схема.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	Возврат Истина;

КонецФункции

Процедура ДобавитьПолеНабораДанных(НаборДанных, ИмяПоля, ПутьКДанным, ТипЗначения)

	Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	// Поле — колонка внешней таблицы; ПутьКДанным — имя в настройках/результате СКД.
	Поле.Поле = ПутьКДанным;
	Поле.ПутьКДанным = ИмяПоля;
	Поле.ТипЗначения = ТипЗначения;
	Поле.Заголовок = ИмяПоля;

КонецПроцедуры

Процедура НастроитьВыбранныеПоля(Схема, ИменаПолей)

	Схема.НастройкиПоУмолчанию.Выбор.Элементы.Очистить();
	Схема.НастройкиПоУмолчанию.Структура.Очистить();
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ВыбранноеПоле = Схема.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(
			Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;

	ДетальныеЗаписи = Схема.НастройкиПоУмолчанию.Структура.Добавить(
		Тип("ГруппировкаКомпоновкиДанных"));
	ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

КонецПроцедуры

Процедура ДобавитьОтборРавно(Схема, ИмяПоля, Значение)

	ЭлементОтбора = Схема.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Значение;

КонецПроцедуры

Процедура ОтметитьРеквизитыДляСКД(Реквизиты, ИменаРеквизитов)

	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		СтрокаРеквизита = Реквизиты.Найти(ИмяРеквизита, "Имя");
		Если СтрокаРеквизита = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru='В документе Заявка не найден реквизит %1.'"), ИмяРеквизита);
		КонецЕсли;
		СтрокаРеквизита.Использовать = Истина;
	КонецЦикла;

КонецПроцедуры

Функция ТипРеквизита(Реквизиты, ИмяРеквизита)

	СтрокаРеквизита = Реквизиты.Найти(ИмяРеквизита, "Имя");
	Если СтрокаРеквизита = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru='В документе Заявка не найден реквизит %1.'"), ИмяРеквизита);
	КонецЕсли;

	Возврат СтрокаРеквизита.ТипЗначения;

КонецФункции

#КонецОбласти
