#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МодульБазовыеПодсистемы = ОбщегоНазначения.ОбщийМодуль("бит_омни_ОбщегоНазначения");
	
	ТипСКД = МодульБазовыеПодсистемы.ОписаниеТиповСхемыКомпоновкиДанных();
	Элементы.Получатели.ОграничениеТипа = ТипСКД;
	Элементы.Контекст.ОграничениеТипа = ТипСКД;

	ЗаполнитьСписокВыбораПринадлежности();
	НастроитьДатыСобытияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Получатели = ТекущийОбъект.СКДПолучатели.Получить();
	Контекст = ТекущийОбъект.СКДКонтекст.Получить();
	Расписание = ТекущийОбъект.Расписание.Получить();
	ЗаполнитьРеквизитыКонтекстаДатНаСервере();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Расписание = Неопределено Тогда
		Расписание = РасписаниеРЗ();        
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();	
	ОбновитьДоступностьДатыСобытия();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.СКДПолучатели = Новый ХранилищеЗначения(Получатели);
	ТекущийОбъект.СКДКонтекст = Новый ХранилищеЗначения(Контекст);
	ТекущийОбъект.Расписание = Новый ХранилищеЗначения(Расписание);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимРассылкиПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РедактироватьРасписание(Команда)

	ДиалогРедактированияРасписания = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);
	
	Оповещение = Новый ОписаниеОповещения("РедактироватьРасписаниеЗавершение", ЭтаФорма); 
	ДиалогРедактированияРасписания.Показать(Оповещение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция РасписаниеРЗ()
	
	Расписание = Новый РасписаниеРегламентногоЗадания();
	Расписание.ПериодПовтораДней = 1;
	Расписание.ДатаНачала = ТекущаяДата();
	Расписание.ПериодПовтораВТечениеДня = 0;
	Расписание.ДниНедели.Добавить(1);
	Расписание.ДниНедели.Добавить(2);
	Расписание.ДниНедели.Добавить(3);
	Расписание.ДниНедели.Добавить(4);
	Расписание.ДниНедели.Добавить(5);
	Расписание.ДниНедели.Добавить(6);
	Расписание.ДниНедели.Добавить(7);
	
	Возврат Расписание;
	
КонецФункции

&НаКлиенте
Процедура РедактироватьРасписаниеЗавершение(РасписаниеНовое, ДополнительныеПараметры) Экспорт

	Расписание = РасписаниеНовое;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	ПоРасписание = ПредопределенноеЗначение("Перечисление.бит_омни_РежимыРассылки.ПоРасписанию");
	РежимПоРасписанию = (Объект.РежимРассылки = ПоРасписание);
	
	Элементы.РедактироватьРасписание.Видимость = РежимПоРасписанию;
	Элементы.ГруппаПринадлежность.Видимость = НЕ РежимПоРасписанию;
	Элементы.ГруппаДатыСобытия.Видимость = РежимПоРасписанию;

КонецПроцедуры

&НаСервере
Процедура НастроитьДатыСобытияНаСервере()

	СписокШаблонов = Элементы.ДатыСобытияШаблон.СписокВыбора;
	СписокШаблонов.Очистить();
	СписокШаблонов.Добавить("ДоДаты", "За N часов до даты");
	СписокШаблонов.Добавить("ПослеДаты", "Через N часов после даты");
	СписокШаблонов.Добавить("ДатаОбъекта", "Дата объекта");
	СписокШаблонов.Добавить("Алгоритм", "Ручной алгоритм");
	Элементы.ДатыСобытияАлгоритмРасчета.ТолькоПросмотр =
		Не бит_омни_ДатыСобытияРассылок.МожноРедактироватьАлгоритм();
	ЗаполнитьРеквизитыКонтекстаДатНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыКонтекстаДатНаСервере()

	СписокРеквизитов = Элементы.ДатыСобытияРеквизитКонтекста.СписокВыбора;
	СписокРеквизитов.Очистить();
	Для Каждого РеквизитКонтекста Из бит_омни_ДатыСобытияРассылок.РеквизитыКонтекста(Контекст) Цикл
		СписокРеквизитов.Добавить(РеквизитКонтекста.Значение, РеквизитКонтекста.Представление);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура КонтекстПриИзменении(Элемент)

	ЗаполнитьРеквизитыКонтекстаДатНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДатыСобытияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	СтрокаДаты = Элемент.ТекущиеДанные;
	Если СтрокаДаты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Копия правила должна получить новый идентификатор при записи объекта.
	СтрокаДаты.ИдентификаторСтроки = "";
	Если Не Копирование Тогда
		СтрокаДаты.Использовать = Истина;
		СтрокаДаты.Шаблон = "ДоДаты";
		СтрокаДаты.РеквизитКонтекста = "ДатаНачала";
		СтрокаДаты.КоличествоЧасов = 24;
	КонецЕсли;
	ОбновитьДоступностьДатыСобытия();

КонецПроцедуры

&НаКлиенте
Процедура ДатыСобытияПриАктивизацииСтроки(Элемент)

	ОбновитьДоступностьДатыСобытия();

КонецПроцедуры

&НаКлиенте
Процедура ДатыСобытияШаблонПриИзменении(Элемент)

	ОбновитьДоступностьДатыСобытия();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьДатыСобытия()

	СтрокаДаты = Элементы.ДатыСобытия.ТекущиеДанные;
	ЕстьСтрока = СтрокаДаты <> Неопределено;
	РучнойАлгоритм = Ложь;
	ЕстьСмещение = Ложь;
	Если ЕстьСтрока Тогда
		РучнойАлгоритм = СтрокаДаты.Шаблон = "Алгоритм";
		ЕстьСмещение = СтрокаДаты.Шаблон = "ДоДаты" Или СтрокаДаты.Шаблон = "ПослеДаты";
	КонецЕсли;
	Элементы.ДатыСобытияКоличествоЧасов.Доступность = ЕстьСмещение;
	Элементы.ДатыСобытияРеквизитКонтекста.Доступность = ЕстьСтрока И Не РучнойАлгоритм;
	Элементы.ДатыСобытияАлгоритмРасчета.Доступность = РучнойАлгоритм;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПринадлежности()
	
	ЗаполнитьСписокВыбораПоМетаданным(Метаданные.Справочники, БиблиотекаКартинок.Справочник);	
	ЗаполнитьСписокВыбораПоМетаданным(Метаданные.Документы, БиблиотекаКартинок.Документ);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораПоМетаданным(МетаданныеКоллекция, Картинка)
	
	СписокВыбора = Элементы.ПринадлежностьОбъект.СписокВыбора;
	
	Для Каждого МетаданныеЭлементКоллекции Из МетаданныеКоллекция Цикл
		СписокВыбора.Добавить(МетаданныеЭлементКоллекции.ПолноеИмя(), 
							  МетаданныеЭлементКоллекции.Представление(),,Картинка)
	КонецЦикла;

КонецПроцедуры


#КонецОбласти
