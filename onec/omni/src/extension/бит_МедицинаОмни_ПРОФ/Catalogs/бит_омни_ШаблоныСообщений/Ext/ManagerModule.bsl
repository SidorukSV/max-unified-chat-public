#Область ПрограммныйИнтерфейс

Функция СформироватьТекстСообщенияПоШаблону(Шаблон, Получатель, Контекст) Экспорт

	Возврат СформироватьЗначениеПоШаблону(Шаблон.ШаблонСообщения, Шаблон, Получатель, Контекст);

КонецФункции

Функция СформироватьКнопкиПоШаблону(Шаблон, Получатель, Контекст) Экспорт

	Если ПустаяСтрока(Шаблон.КнопкиMAX) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Шаблон.КнопкиMAX);
		Кнопки = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		// Подставляем значения после разбора JSON: кавычки в данных не меняют структуру кнопок.
		Если ТипЗнч(Кнопки) = Тип("Массив") Тогда
			Для Каждого Ряд Из Кнопки Цикл
				Если ТипЗнч(Ряд) <> Тип("Массив") Тогда
					ВызватьИсключение "Ожидается массив рядов кнопок MAX.";
				КонецЕсли;
				Для Каждого Кнопка Из Ряд Цикл
					Для Каждого ИмяПараметра Из СтрРазделить("text,payload,url", ",") Цикл
						ЗначениеПараметра = Неопределено;
						Если Кнопка.Свойство(ИмяПараметра, ЗначениеПараметра)
							И ТипЗнч(ЗначениеПараметра) = Тип("Строка") Тогда
							ЗначениеПараметра = СформироватьЗначениеПоШаблону(
								ЗначениеПараметра, Шаблон, Получатель, Контекст);
							Если ИмяПараметра = "payload" Тогда
								// Действия таблицы работают и у старых шаблонов без новых полей расчёта.
								ЗначениеПараметра = СтрЗаменить(ЗначениеПараметра,
									"<ИдентификаторЗаписи>", ЗначениеПоляКонтекста(Контекст, "appointment_id"));
								ЗначениеПараметра = СтрЗаменить(ЗначениеПараметра,
									"<ВерсияЗаписи>", ЗначениеПоляКонтекста(Контекст, "appointment_version"));
							КонецЕсли;
							Кнопка.Вставить(ИмяПараметра, ЗначениеПараметра);
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		Возврат ?(ТипЗнч(Кнопки) = Тип("Массив"), Кнопки, Новый Массив);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.ШаблонКнопок", УровеньЖурналаРегистрации.Ошибка, , Шаблон.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Массив;
	КонецПопытки;

КонецФункции

Функция СтандартныйШаблон(Идентификатор) Экспорт

	Возврат НайтиПоРеквизиту("ИдентификаторСтандартногоШаблона", Идентификатор);

КонецФункции

// Резервный текст не сохраняется: недоступный шаблон не останавливает диалог.
Функция СтандартныйТекстИлиРезервный(Идентификатор, Получатель, Контекст, РезервныйТекст) Экспорт

	Попытка
		Шаблон = СтандартныйШаблон(Идентификатор);
		Если Шаблон.Пустая() Или Шаблон.ПометкаУдаления Тогда
			Возврат РезервныйТекст;
		КонецЕсли;
		Текст = СформироватьТекстСообщенияПоШаблону(Шаблон, Получатель, Контекст);
		Возврат ?(ПустаяСтрока(Текст), РезервныйТекст, Текст);
	Исключение
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.СтандартныйШаблон", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.бит_омни_ШаблоныСообщений, ,
			"Не удалось сформировать шаблон " + Идентификатор + ". Использован резервный текст.");
		Возврат РезервныйТекст;
	КонецПопытки;

КонецФункции

