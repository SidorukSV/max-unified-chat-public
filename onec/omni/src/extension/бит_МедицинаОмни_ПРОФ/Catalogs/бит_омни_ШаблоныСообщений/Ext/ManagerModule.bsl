Функция ЗагрузитьСтандартныеШаблоны(Идентификаторы) Экспорт

	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Или Идентификаторы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	КоличествоЗагруженных = 0;
	Для Каждого ОписаниеШаблона Из СтандартныеШаблоны() Цикл

		Если Идентификаторы.Найти(ОписаниеШаблона.Идентификатор) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СсылкаШаблона = СтандартныйШаблон(ОписаниеШаблона.Идентификатор);
		Если Не СсылкаШаблона.Пустая() Тогда
			// Пользовательские тексты, алгоритмы и кнопки не заменяем при повторной загрузке.
			Продолжить;
		КонецЕсли;

		ОбъектШаблона = СоздатьЭлемент();
		ЗаполнитьОбъектСтандартногоШаблона(ОбъектШаблона, ОписаниеШаблона);
		ОбъектШаблона.Записать();
		КоличествоЗагруженных = КоличествоЗагруженных + 1;

	КонецЦикла;

	Возврат КоличествоЗагруженных;

КонецФункции

Функция СоздатьСтандартныеШаблоныЕслиОтсутствуют(Идентификаторы) Экспорт

	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Или Идентификаторы.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	КоличествоСозданных = 0;
	Для Каждого ОписаниеШаблона Из СтандартныеШаблоны() Цикл
		Если Идентификаторы.Найти(ОписаниеШаблона.Идентификатор) = Неопределено
			Или Не СтандартныйШаблон(ОписаниеШаблона.Идентификатор).Пустая()
		Тогда
			Продолжить;
		КонецЕсли;

		ОбъектШаблона = СоздатьЭлемент();
		ЗаполнитьОбъектСтандартногоШаблона(ОбъектШаблона, ОписаниеШаблона);
		ОбъектШаблона.Записать();
		КоличествоСозданных = КоличествоСозданных + 1;
	КонецЦикла;

	Возврат КоличествоСозданных;

КонецФункции

// Явный безопасный шаг обновления: заменяет только точно распознанные старые кнопки.
// Текст, поля и любые отличающиеся от стандартных кнопки остаются без изменений.
Функция ОбновитьСтандартныеКнопкиНапоминаний() Экспорт

	КоличествоОбновленных = 0;
	Идентификаторы = СтрРазделить(
		"MAX_APPOINTMENT_REMINDER,MAX_APPOINTMENT_REMINDER_24H,MAX_APPOINTMENT_REMINDER_2H", ",");
	Для Каждого ОписаниеШаблона Из СтандартныеШаблоны() Цикл
		Если Идентификаторы.Найти(ОписаниеШаблона.Идентификатор) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Шаблон = СтандартныйШаблон(ОписаниеШаблона.Идентификатор);
		Если Шаблон.Пустая() Или Шаблон.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		ОбъектШаблона = Шаблон.ПолучитьОбъект();
		Если Не ЭтоПрежниеСтандартныеКнопкиНапоминания(ОбъектШаблона.КнопкиMAX) Тогда
			Продолжить;
		КонецЕсли;
		ОбъектШаблона.КнопкиMAX = ОписаниеШаблона.Кнопки;
		ОбъектШаблона.Записать();
		КоличествоОбновленных = КоличествоОбновленных + 1;
	КонецЦикла;
	Возврат КоличествоОбновленных;

КонецФункции

Функция ЗначениеПоляКонтекста(Контекст, ИмяПоля) Экспорт

	Если Контекст = Неопределено Или Контекст = Null Тогда
		Возврат "";
	КонецЕсли;

	Если ИмяПоля = "appointment_version" Тогда
		РезультатПоиска = ЗначениеКонтекстаПоИмени(Контекст, ИмяПоля);
		Если РезультатПоиска.Найдено Тогда
			Если ТипЗнч(РезультатПоиска.Значение) = Тип("Дата") Тогда
				Возврат Формат(РезультатПоиска.Значение, "ДФ=yyyyMMddHHmmss");
			КонецЕсли;
			Возврат СтроковоеЗначение(РезультатПоиска.Значение);
		КонецЕсли;
		Для Каждого ИмяДаты Из СтрРазделить("ДатаНачалаПосле,ДатаНачала,appointment_date", ",") Цикл
			РезультатПоиска = ЗначениеКонтекстаПоИмени(Контекст, ИмяДаты);
			Если РезультатПоиска.Найдено И ТипЗнч(РезультатПоиска.Значение) = Тип("Дата") Тогда
				Возврат Формат(РезультатПоиска.Значение, "ДФ=yyyyMMddHHmmss");
			КонецЕсли;
		КонецЦикла;
		Возврат "";
	КонецЕсли;

	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить(ИмяПоля);
	Для Каждого Псевдоним Из ПсевдонимыПоля(ИмяПоля) Цикл
		ИменаПолей.Добавить(Псевдоним);
	КонецЦикла;

	Для Каждого ИмяПоляКонтекста Из ИменаПолей Цикл
		РезультатПоиска = ЗначениеКонтекстаПоИмени(Контекст, ИмяПоляКонтекста);
		Если РезультатПоиска.Найдено Тогда
			Возврат СтроковоеЗначениеПоляКонтекста(ИмяПоля, РезультатПоиска.Значение);
		КонецЕсли;
	КонецЦикла;

	Если ИмяПоля = "appointment_id" Или ИмяПоля = "survey_id" Тогда
		Попытка
			Возврат Строка(Контекст.УникальныйИдентификатор());
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоПрежниеСтандартныеКнопкиНапоминания(ТекстJSON)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		Кнопки = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		ПрежниеКнопки = Новый Массив;
		ДобавитьРядКнопок(ПрежниеКнопки, КнопкаMAX("callback", "Подтвердить",
			"appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_confirm"));
		ДобавитьРядКнопок(ПрежниеКнопки, КнопкаMAX("callback", "Отменить",
			"appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_cancel"));
		Возврат КнопкиВJSON(Кнопки) = КнопкиВJSON(ПрежниеКнопки);
	Исключение
		// Неизвестный или некорректный JSON оставляем администратору, а не исправляем молча.
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция СформироватьЗначениеПоШаблону(ИсходноеЗначение, Шаблон, Получатель, Контекст)

	РезультирующаяСтрока = ИсходноеЗначение;
	НачалоБлока = ?(НРег(Шаблон.ВариантФормата) = "html", "{{ ", "<");
	КонецБлока = ?(НРег(Шаблон.ВариантФормата) = "html", " }}", ">");

	Для Каждого ПолеШаблона Из Шаблон.ПоляШаблона Цикл
		Поле = НачалоБлока + ПолеШаблона.Поле + КонецБлока;
		Результат = "";
		Выполнить(ПолеШаблона.АлгоритмРасчета);
		РезультирующаяСтрока = СтрЗаменить(РезультирующаяСтрока, Поле, СтроковоеЗначение(Результат));
	КонецЦикла;

	Возврат РезультирующаяСтрока;

КонецФункции

Процедура ДобавитьСтандартныйШаблон(
	Шаблоны, Идентификатор, Наименование, Текст, Формат, Кнопки, Поля)

	Шаблоны.Добавить(Новый Структура(
		"Идентификатор, Наименование, Текст, Формат, Кнопки, Поля, УжеЗагружен",
		Идентификатор, Наименование, Текст, Формат, Кнопки, Поля, Ложь));

КонецПроцедуры

Процедура ЗаполнитьОбъектСтандартногоШаблона(ОбъектШаблона, ОписаниеШаблона)

	ОбъектШаблона.Наименование = ОписаниеШаблона.Наименование;
	ОбъектШаблона.ИдентификаторСтандартногоШаблона = ОписаниеШаблона.Идентификатор;
	ОбъектШаблона.ШаблонСообщения = ОписаниеШаблона.Текст;
	ОбъектШаблона.ВариантФормата = ОписаниеШаблона.Формат;
	ОбъектШаблона.КнопкиMAX = ОписаниеШаблона.Кнопки;
	ОбъектШаблона.ПоляШаблона.Очистить();

	Для Каждого ОписаниеПоля Из ОписаниеШаблона.Поля Цикл
		СтрокаПоля = ОбъектШаблона.ПоляШаблона.Добавить();
		СтрокаПоля.Поле = ОписаниеПоля.Поле;
		СтрокаПоля.АлгоритмРасчета = ОписаниеПоля.АлгоритмРасчета;
	КонецЦикла;

КонецПроцедуры

