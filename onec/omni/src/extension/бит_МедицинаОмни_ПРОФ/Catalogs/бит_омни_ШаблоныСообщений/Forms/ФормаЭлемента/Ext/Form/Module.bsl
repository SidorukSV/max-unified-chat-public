&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Список = Элементы.ТаблицаКнопокДействие.СписокВыбора;
	Список.Добавить("confirm", "Подтвердить приём");
	Список.Добавить("cancel", "Отменить приём");
	Список.Добавить("callback", "Обратный вызов (callback)");
	Список.Добавить("link", "Открыть ссылку");
	Список.Добавить("request_contact", "Запросить телефон");
	Список.Добавить("open_app", "Открыть приложение (совместимость)");
	ЗагрузитьКнопкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ЗагрузитьКнопкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКнопкиНаСервере(ЗапомнитьИсходныйJSON = Истина)
	Если ЗапомнитьИсходныйJSON Тогда
		ИсходныйJSONКнопок = Объект.КнопкиMAX;
	КонецЕсли;
	Попытка
		Таблица = бит_омни_КнопкиMAX.ТаблицаИзJSON(Объект.КнопкиMAX);
		ИсходнаяТаблицаJSON = бит_омни_КнопкиMAX.JSONИзТаблицы(Таблица);
		ЗначениеВРеквизитФормы(Таблица, "ТаблицаКнопок");
		РежимJSONКнопок = Ложь;
		ОшибкаКнопок = "";
	Исключение
		РежимJSONКнопок = Истина;
		ОшибкаКнопок = "Таблица не загружена. Исходный JSON сохранён без изменений. "
			+ "Исправьте JSON и выключите расширенный режим. " + ОписаниеОшибки();
	КонецПопытки;
	ОбновитьВидимостьКнопок();
КонецПроцедуры

&НаКлиенте
Процедура РежимJSONКнопокПриИзменении(Элемент)
	ПереключитьРежимКнопокНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПереключитьРежимКнопокНаСервере()
	Если РежимJSONКнопок Тогда
		Попытка
			ТекстJSON = бит_омни_КнопкиMAX.JSONИзТаблицы(РеквизитФормыВЗначение("ТаблицаКнопок"));
			Если ТекстJSON <> ИсходнаяТаблицаJSON Тогда
				Объект.КнопкиMAX = ТекстJSON;
			КонецЕсли;
			ОшибкаКнопок = "";
		Исключение
			РежимJSONКнопок = Ложь;
			ОшибкаКнопок = ОписаниеОшибки();
		КонецПопытки;
	Иначе
		// Явное применение исправленного JSON, без записи объекта в базу.
		ЗагрузитьКнопкиНаСервере(Ложь);
	КонецЕсли;
	ОбновитьВидимостьКнопок();
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьКнопок()
	Элементы.КнопкиMAX.Видимость = РежимJSONКнопок;
	Элементы.ТаблицаКнопок.Видимость = Не РежимJSONКнопок;
	Элементы.ОшибкаКнопок.Видимость = Не ПустаяСтрока(ОшибкаКнопок);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Попытка
		Если РежимJSONКнопок Тогда
			// Неподдерживаемый формат не мешает сохранить прочие реквизиты.
			// Но новый, вручную исправленный JSON обязан хотя бы разбираться.
			Если ТекущийОбъект.КнопкиMAX <> ИсходныйJSONКнопок
				И Не ПустаяСтрока(ТекущийОбъект.КнопкиMAX) Тогда
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(ТекущийОбъект.КнопкиMAX);
				Если ТипЗнч(ПрочитатьJSON(Чтение)) <> Тип("Массив") Тогда
					ВызватьИсключение "Кнопки MAX должны содержать массив рядов JSON.";
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТекстJSON = бит_омни_КнопкиMAX.JSONИзТаблицы(РеквизитФормыВЗначение("ТаблицаКнопок"));
			Если ТекстJSON <> ИсходнаяТаблицаJSON Тогда
				ТекущийОбъект.КнопкиMAX = ТекстJSON;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Отказ = Истина;
		Сообщить("Кнопки MAX не сохранены: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Объект.КнопкиMAX = ТекущийОбъект.КнопкиMAX;
	ЗагрузитьКнопкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКнопокПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Не Копирование Тогда
		СтрокаКнопки = Элемент.ТекущиеДанные;
		СтрокаКнопки.Ряд = 1;
		СтрокаКнопки.Действие = "callback";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКнопокДействиеПриИзменении(Элемент)
	СтрокаКнопки = Элементы.ТаблицаКнопок.ТекущиеДанные;
	Если СтрокаКнопки.Действие = "confirm" Или СтрокаКнопки.Действие = "cancel" Тогда
		СтрокаКнопки.Параметр = "appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_" + СтрокаКнопки.Действие;
		Если ПустаяСтрока(СтрокаКнопки.Текст) Тогда
			СтрокаКнопки.Текст = ?(СтрокаКнопки.Действие = "confirm", "Подтвердить", "Отменить");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
