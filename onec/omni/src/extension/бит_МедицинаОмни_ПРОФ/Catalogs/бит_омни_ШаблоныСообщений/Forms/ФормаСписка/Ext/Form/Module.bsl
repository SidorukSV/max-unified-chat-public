&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьТаблицуСтандартныхШаблонов();

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыбранныеСтандартные(Команда)

	КоличествоЗагруженных = ЗагрузитьВыбранныеСтандартныеНаСервере();
	Если КоличествоЗагруженных = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не выбрано ни одного шаблона.'"));
	Иначе
		Элементы.Список.Обновить();
		ПоказатьОповещениеПользователя(
			СтрШаблон(НСтр("ru='Загружено шаблонов: %1'"), КоличествоЗагруженных));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьВыбранныеСтандартныеНаСервере()

	Идентификаторы = Новый Массив;
	Для Каждого СтрокаШаблона Из СтандартныеШаблоны Цикл
		Если СтрокаШаблона.Загружать Тогда
			Идентификаторы.Добавить(СтрокаШаблона.Идентификатор);
		КонецЕсли;
	КонецЦикла;

	КоличествоЗагруженных = Справочники.бит_омни_ШаблоныСообщений.ЗагрузитьСтандартныеШаблоны(Идентификаторы);
	ОбновитьТаблицуСтандартныхШаблонов();
	Возврат КоличествоЗагруженных;

КонецФункции

&НаСервере
Процедура ОбновитьТаблицуСтандартныхШаблонов()

	СтандартныеШаблоны.Очистить();
	Для Каждого ОписаниеШаблона Из Справочники.бит_омни_ШаблоныСообщений.СтандартныеШаблоны() Цикл
		СтрокаШаблона = СтандартныеШаблоны.Добавить();
		СтрокаШаблона.Загружать = Не ОписаниеШаблона.УжеЗагружен;
		СтрокаШаблона.Идентификатор = ОписаниеШаблона.Идентификатор;
		СтрокаШаблона.Наименование = ОписаниеШаблона.Наименование;
		СтрокаШаблона.УжеЗагружен = ОписаниеШаблона.УжеЗагружен;
	КонецЦикла;

КонецПроцедуры
