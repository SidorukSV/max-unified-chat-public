
&НаКлиенте
Процедура ЗаполнитьИнформациюОБоте(Команда)
	ЗаполнитьИнформациюОБотеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРассылкиЗаписей(Команда)

	Если Объект.Канал <> ПредопределенноеЗначение("Перечисление.бит_омни_КаналыСвязи.MAX") Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите канал MAX.'"));
		Возврат;
	КонецЕсли;

	Если Не Объект.Использовать Тогда
		ПоказатьПредупреждение(, НСтр("ru='Включите флаг Использовать.'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Объект.Токен) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Укажите токен MAX.'"));
		Возврат;
	КонецЕсли;

	Попытка
		Записать();
		Результат = СоздатьРассылкиЗаписейНаСервере();
		ПоказатьОповещениеПользователя(СтрШаблон(
			НСтр("ru='Готово. Создано: %1, уже было: %2, активировано: %3. Существующие настройки сохранены.'"),
			Результат.Создано,
			Результат.УжеСуществовало,
			Результат.Активировано));
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция СоздатьРассылкиЗаписейНаСервере()

	Возврат Справочники.бит_омни_Рассылки.СоздатьСтандартныеРассылкиЗаписейMAX(Объект.Ссылка);

КонецФункции

&НаСервере
Процедура ЗаполнитьИнформациюОБотеНаСервере()
	
	Если Объект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ДанныеБота = бит_омни_ИнтеграцияСMAX.ИнформацияОБоте(Объект.Токен);
		Если ДанныеБота = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Объект.Идентификатор = Формат(ДанныеБота.user_id, "ЧГ=0");
		Объект.Наименование = Лев(ПредставлениеБотаMAX(ДанныеБота), 150);
		Объект.ИмяПользователя = ИмяПользователяБотаMAX(ДанныеБота);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеБотаMAX(ДанныеБота)
	
	Представление = "";
	Если ДанныеБота.Свойство("name", Представление) И ЗначениеЗаполнено(Представление) Тогда
		Возврат СокрЛП(Представление);
	КонецЕсли;
	
	Если ДанныеБота.Свойство("first_name", Представление) И ЗначениеЗаполнено(Представление) Тогда
		Возврат СокрЛП(Представление);
	КонецЕсли;
	
	Возврат ИмяПользователяБотаMAX(ДанныеБота);
	
КонецФункции

&НаСервереБезКонтекста
Функция ИмяПользователяБотаMAX(ДанныеБота)
	
	ИмяПользователя = "";
	Если ДанныеБота.Свойство("username", ИмяПользователя) Тогда
		Возврат СокрЛП(ИмяПользователя);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции
