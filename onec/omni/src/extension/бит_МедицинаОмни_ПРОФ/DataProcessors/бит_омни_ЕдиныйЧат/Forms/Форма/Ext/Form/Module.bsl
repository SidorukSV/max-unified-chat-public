КонецФункции

// Аватар пациента: круг с инициалами, залитый цветом из палитры.
//
// Цвет выбирается детерминированно по инициалам, поэтому один и тот же пациент
// всегда получает один и тот же круг, а разные пациенты - как правило разные.
//
// Параметры:
//   Инициалы - Строка - одна или две буквы; пустая строка дает серую заглушку.
//
// Возвращаемое значение:
//   Строка - готовый HTML-документ для поля АватарКарточки.
&НаСервереБезКонтекста
Функция АватарHTML(Инициалы)

	ТекстИнициалов = СокрЛП(Инициалы);
	ЦветКруга = ?(ПустаяСтрока(ТекстИнициалов), "#C3CBD4", ЦветАватара(ТекстИнициалов));

	Возврат "<!DOCTYPE html><html><head>"
		+ "<meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8""/>"
		+ "<style>"
		+ "html,body{margin:0;padding:0;overflow:hidden;background:#FFFFFF;}"
		+ ".av{width:34px;height:34px;margin:1px auto 0;border-radius:17px;"
		+ "background:" + ЦветКруга + ";color:#FFFFFF;text-align:center;line-height:34px;"
		+ "font-family:'Segoe UI',Tahoma,Verdana,Arial,sans-serif;font-size:14px;font-weight:bold;}"
		+ "</style></head><body><div class=""av"">"
		+ ЭкранироватьТекстДляHTML(ТекстИнициалов)
		+ "</div></body></html>";

КонецФункции

&НаСервереБезКонтекста
Функция ЦветАватара(Инициалы)

	// Палитра подобрана так, чтобы белые инициалы читались на любом из цветов.
	Палитра = СтрРазделить(
		"#2F6FBF,#7A5AC7,#0F8B7E,#C25A2A,#B5417F,#3C7A2F,#1F7FA8,#8A6A1F,#B03A3A,#4A5B9E,#6B7A1F,#9C4BA0",
		",");

	Хеш = 0;
	Для Позиция = 1 По СтрДлина(Инициалы) Цикл
		Хеш = (Хеш * 31 + КодСимвола(Инициалы, Позиция)) % 1000003;
	КонецЦикла;

	Возврат Палитра[Хеш % Палитра.Количество()];

КонецФункции

&НаСервереБезКонтекста
Функция ЭкранироватьТекстДляHTML(Значение)

	Результат = Строка(Значение);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКлиентСервер

&НаСервереБезКонтекста
Функция СформироватьКлючДиалога(Пациент, Бот)

	Возврат Строка(Пациент.УникальныйИдентификатор())
		+ "|" + Строка(Бот.УникальныйИдентификатор());

КонецФункции

&НаСервереБезКонтекста
Функция СнипетДиалога(СтрокаДиалога)

	Текст = Лев(СокрЛП(СтрокаДиалога.ПоследнееСообщение), 250);
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Текст = СокрЛП(Текст);

	Если ПустаяСтрока(Текст) Тогда
		Возврат "Нет сообщений";
	КонецЕсли;

	Если Не СтрокаДиалога.ПоследнееВходящее Тогда
		Текст = "Вы: " + Текст;
	КонецЕсли;

	Возврат Лев(Текст, 250);

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеВремениДиалога(ДатаСообщения)

	Если Не ЗначениеЗаполнено(ДатаСообщения) Тогда
		Возврат "";
	КонецЕсли;

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	ДеньСообщения = НачалоДня(ДатаСообщения);

	Если ДеньСообщения = Сегодня Тогда
		Возврат Формат(ДатаСообщения, "ДФ=HH:mm");
	ИначеЕсли ДеньСообщения = Сегодня - 86400 Тогда
		Возврат "вчера";
	ИначеЕсли Год(ДеньСообщения) = Год(Сегодня) Тогда
		Возврат Формат(ДатаСообщения, "ДФ='d MMM'");
	КонецЕсли;

	Возврат Формат(ДатаСообщения, "ДФ=dd.MM.yy");

КонецФункции

&НаСервереБезКонтекста
Функция МеткаНепрочитанных(КоличествоНепрочитанных)

	Если КоличествоНепрочитанных <= 0 Тогда
		Возврат "";
	ИначеЕсли КоличествоНепрочитанных > 99 Тогда
		Возврат " 99+ ";
	КонецЕсли;

	Возврат " " + Формат(КоличествоНепрочитанных, "ЧГ=") + " ";

КонецФункции

&НаСервереБезКонтекста
Функция МеткаСостоянияДиалога(СостояниеДиалога, ЭтоМойДиалог, ПоследнееВходящее, ДатаПоследнегоСообщения)

	Если СостояниеДиалога.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт Тогда
		Возврат " Закрыт ";
	ИначеЕсли СостояниеДиалога.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.ВРаботе Тогда
		Возврат " В работе · " + ?(ЭтоМойДиалог, "Вы", Строка(СостояниеДиалога.Ответственный)) + " ";
	КонецЕсли;

	Если Не ПоследнееВходящее Или Не ЗначениеЗаполнено(ДатаПоследнегоСообщения) Тогда
		Возврат "";
	КонецЕсли;

	Прошло = ТекущаяДатаСеанса() - ДатаПоследнегоСообщения;
	Если Прошло < 3600 Тогда
		Возврат СтрШаблон(" Без ответа %1 мин ", Цел(Прошло / 60));
	ИначеЕсли Прошло < 86400 Тогда
		Возврат СтрШаблон(" Без ответа %1 ч ", Цел(Прошло / 3600));
	КонецЕсли;

	Возврат СтрШаблон(" Без ответа %1 дн ", Цел(Прошло / 86400));

КонецФункции

&НаСервереБезКонтекста
Функция ОтпечатокСообщений(ТаблицаСообщений)

	Количество = ТаблицаСообщений.Количество();
	Если Количество = 0 Тогда
		Возврат "0";
	КонецЕсли;

	ПоследнееСообщение = ТаблицаСообщений[Количество - 1];

	Возврат Формат(Количество, "ЧГ=")
		+ "|" + Формат(ПоследнееСообщение.Период, "ДФ=yyyyMMddHHmmss")
		+ "|" + Строка(ПоследнееСообщение.Статус);

КонецФункции

