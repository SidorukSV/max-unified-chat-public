&НаСервереБезКонтекста
Функция ИнициалыПациента(Пациент)

	Слова = СтрРазделить(СокрЛП(Строка(Пациент)), " ", Ложь);
	Инициалы = "";
	Для Каждого Слово Из Слова Цикл
		Инициалы = Инициалы + ВРег(Лев(Слово, 1));
		Если СтрДлина(Инициалы) >= 2 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Инициалы;

КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформлениеСписка()

	УсловноеОформление.Элементы.Очистить();

	// Имя пациента в диалоге с непрочитанными сообщениями выделяется акцентом.
	ОформлениеИмени = УсловноеОформление.Элементы.Добавить();

	ПолеИмени = ОформлениеИмени.Поля.Элементы.Добавить();
	ПолеИмени.Поле = Новый ПолеКомпоновкиДанных("ДиалогиИмяДиалога");

	ОтборИмени = ОформлениеИмени.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборИмени.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Диалоги.Непрочитано");
	ОтборИмени.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборИмени.ПравоеЗначение = 0;

	ОформлениеИмени.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветАкцента());

	// Счетчик непрочитанных оформляется как метка.
	ОформлениеМетки = УсловноеОформление.Элементы.Добавить();

	ПолеМетки = ОформлениеМетки.Поля.Элементы.Добавить();
	ПолеМетки.Поле = Новый ПолеКомпоновкиДанных("ДиалогиМеткаНепрочитанных");

	ОтборМетки = ОформлениеМетки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборМетки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Диалоги.Непрочитано");
	ОтборМетки.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборМетки.ПравоеЗначение = 0;

	ОформлениеМетки.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветАкцента());
	ОформлениеМетки.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Белый);

	// В диалоге с новыми сообщениями текст последнего сообщения перестает быть блеклым.
	ОформлениеСнипета = УсловноеОформление.Элементы.Добавить();

	ПолеСнипета = ОформлениеСнипета.Поля.Элементы.Добавить();
	ПолеСнипета.Поле = Новый ПолеКомпоновкиДанных("ДиалогиСнипет");

	ОтборСнипета = ОформлениеСнипета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСнипета.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Диалоги.Непрочитано");
	ОтборСнипета.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборСнипета.ПравоеЗначение = 0;

	ОформлениеСнипета.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ТемноГрифельноСерый);
	ОформлениеСнипета.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));

	// Метка "Без ответа" оформляется как плашка тревожного цвета.
	ОформлениеМетки2 = УсловноеОформление.Элементы.Добавить();

	ПолеМетки2 = ОформлениеМетки2.Поля.Элементы.Добавить();
	ПолеМетки2.Поле = Новый ПолеКомпоновкиДанных("ДиалогиМеткаСостояния");

	ОтборМетки2 = ОформлениеМетки2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборМетки2.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Диалоги.БезОтвета");
	ОтборМетки2.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборМетки2.ПравоеЗначение = Истина;

	ОформлениеМетки2.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФонаТревоги());
	ОформлениеМетки2.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТревоги());

	// Состояние диалога важнее признака ответа, поэтому оформляется последним.
	ДобавитьОформлениеСостояния(
		Перечисления.бит_омни_СостоянияДиалоговMAX.ВРаботе, ЦветФонаУспеха(), ЦветУспеха());
	ДобавитьОформлениеСостояния(
		Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт, ЦветФонаНейтральный(), ЦветВторичногоТекста());

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеСостояния(Состояние, ЦветФона, ЦветТекста)

	Оформление = УсловноеОформление.Элементы.Добавить();

	Поле = Оформление.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ДиалогиМеткаСостояния");

	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Диалоги.Состояние");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Состояние;

	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦветФонаНейтральный()

	Возврат WebЦвета.ДымчатоБелый;

КонецФункции

&НаСервере
Функция ОбновитьДанныеФормыНаСервере(ПерестроитьЛенту)

	НовыеСообщения = ЗагрузитьДиалогиНаСервере();

	Если ЗначениеЗаполнено(ТекущийПациент) Тогда
		ЗагрузитьСообщенияНаСервере(ПерестроитьЛенту);
		// Открытая переписка помечена прочитанной, счетчик в списке нужно погасить сразу.
		СброситьСчетчикНепрочитанныхНаСервере(КлючТекущегоДиалога);
		ОбновитьШапкуЧатаНаСервере();
	Иначе
		ОчиститьЛентуЧатаНаСервере();
	КонецЕсли;

	ОбновитьОтметкуОбновленияНаСервере();

	Возврат НовыеСообщения;

КонецФункции

&НаСервере
Процедура ОткрытьДиалогНаСервере(Контакт, Пациент, Бот, КлючДиалога)

	ТекущийКонтакт = Контакт;
	ТекущийПациент = Пациент;
	ТекущийБот = Бот;
	КлючТекущегоДиалога = КлючДиалога;

	ОбновитьШапкуЧатаНаСервере();
	ЗагрузитьСообщенияНаСервере(Истина);
	СброситьСчетчикНепрочитанныхНаСервере(КлючДиалога);

КонецПроцедуры

// Перезаполняет список диалогов.
//
// Возвращаемое значение:
//   Массив из Структура - описания входящих сообщений, пришедших после предыдущего
//                         обновления; при первом заполнении списка всегда пустой.
&НаСервере
Функция ЗагрузитьДиалогиНаСервере()

	СвернутыеДиалоги = СвернутыеДиалогиНаСервере();

	Диалоги.Очистить();
	ВсегоДиалогов = СвернутыеДиалоги.Количество();
	ВсегоНепрочитанных = 0;
	ВсегоБезОтвета = 0;
	ВсегоМоих = 0;
	СостоянияДиалогов = СостоянияДиалоговНаСервере();
	НоваяГраница = ГраницаОповещений;
	НовыеСообщения = Новый Массив;

	Для Каждого СтрокаИсточника Из СвернутыеДиалоги Цикл
		Если СтрокаИсточника.ПоследнееВходящее Тогда
			ВсегоБезОтвета = ВсегоБезОтвета + 1;
		КонецЕсли;
		ВсегоНепрочитанных = ВсегоНепрочитанных + СтрокаИсточника.Непрочитано;

		СостояниеДиалога = СостоянияДиалогов.Получить(
			СформироватьКлючДиалога(СтрокаИсточника.Пациент, СтрокаИсточника.Бот));
		Если СостояниеДиалога = Неопределено Тогда
			СостояниеДиалога = Новый Структура("Состояние, Ответственный, ДатаИзменения",
				Перечисления.бит_омни_СостоянияДиалоговMAX.Новый,
				Справочники.Пользователи.ПустаяСсылка(),
				'00010101');
		КонецЕсли;

		// Закрытый диалог с новым входящим сообщением возвращается в распределение.
		Если СостояниеДиалога.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт
			И СтрокаИсточника.ПоследнееВходящее
			И СтрокаИсточника.ДатаПоследнегоСообщения > СостояниеДиалога.ДатаИзменения Тогда

			ВернутьДиалогВРаспределениеНаСервере(СтрокаИсточника.Пациент, СтрокаИсточника.Бот);
			СостояниеДиалога.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Новый;
			СостояниеДиалога.Ответственный = Справочники.Пользователи.ПустаяСсылка();
		КонецЕсли;
		ЭтоМойДиалог = СостояниеДиалога.Ответственный = ТекущийПользователь
			И ЗначениеЗаполнено(ТекущийПользователь);
		Если ЭтоМойДиалог Тогда
			ВсегоМоих = ВсегоМоих + 1;
		КонецЕсли;

		Если ВариантОтбора = 1 И Не СтрокаИсточника.ПоследнееВходящее
			Или ВариантОтбора = 2 И Не ЭтоМойДиалог
			Или ВариантОтбора = 3 И СтрокаИсточника.Непрочитано = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаДиалога = Диалоги.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДиалога, СтрокаИсточника);

		СтрокаДиалога.КлючДиалога = СформироватьКлючДиалога(СтрокаИсточника.Пациент, СтрокаИсточника.Бот);
		СтрокаДиалога.ИмяДиалога = Лев(Строка(СтрокаИсточника.Пациент), 150);
		СтрокаДиалога.Снипет = СнипетДиалога(СтрокаИсточника);
		СтрокаДиалога.Время = ПредставлениеВремениДиалога(СтрокаИсточника.ДатаПоследнегоСообщения);
		СтрокаДиалога.МеткаНепрочитанных = МеткаНепрочитанных(СтрокаИсточника.Непрочитано);
		СтрокаДиалога.БезОтвета = СтрокаИсточника.ПоследнееВходящее;
		СтрокаДиалога.Состояние = СостояниеДиалога.Состояние;
		СтрокаДиалога.Ответственный = СостояниеДиалога.Ответственный;
		СтрокаДиалога.МойДиалог = ЭтоМойДиалог;
		СтрокаДиалога.МеткаСостояния = МеткаСостоянияДиалога(
			СостояниеДиалога, ЭтоМойДиалог,
			СтрокаИсточника.ПоследнееВходящее, СтрокаИсточника.ДатаПоследнегоСообщения);

		Если Не СтрокаИсточника.ПоследнееВходящее Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаИсточника.ДатаПоследнегоСообщения > НоваяГраница Тогда
			НоваяГраница = СтрокаИсточника.ДатаПоследнегоСообщения;
		КонецЕсли;

		// При первом заполнении списка граница еще не установлена: вся история
		// считается уже виденной, иначе оператор получил бы пачку оповещений сразу.
		Если ЗначениеЗаполнено(ГраницаОповещений)
			И СтрокаИсточника.ДатаПоследнегоСообщения > ГраницаОповещений Тогда
			НовыеСообщения.Добавить(Новый Структура(
				"Пациент, Текст, Ключ",
				СтрокаДиалога.ИмяДиалога,
				СтрокаДиалога.Снипет,
				СтрокаДиалога.КлючДиалога));
		КонецЕсли;
	КонецЦикла;

	ГраницаОповещений = НоваяГраница;

	ОбновитьСчетчикДиалоговНаСервере(ВсегоДиалогов, ВсегоНепрочитанных, ВсегоБезОтвета, ВсегоМоих);
	ВосстановитьТекущийДиалогНаСервере();

	Возврат НовыеСообщения;

КонецФункции

&НаСервере
Функция СвернутыеДиалогиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Контакты.Ссылка КАК Контакт,
				   |	ВЫРАЗИТЬ(Контакты.Получатель КАК Справочник.Клиенты) КАК Пациент,
				   |	Контакты.Наименование КАК ИмяMAX,
				   |	Контакты.Бот КАК Бот
				   |ПОМЕСТИТЬ ВТКонтакты
				   |ИЗ
				   |	Справочник.бит_омни_Контакты КАК Контакты
				   |ГДЕ
				   |	Контакты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
				   |	И Контакты.Получатель ССЫЛКА Справочник.Клиенты
				   |	И НЕ Контакты.ПометкаУдаления
				   |	И (&СтрокаПоиска = """"
				   |		ИЛИ Контакты.Наименование ПОДОБНО &ШаблонПоиска
				   |		ИЛИ ВЫРАЗИТЬ(Контакты.Получатель КАК Справочник.Клиенты).Наименование ПОДОБНО &ШаблонПоиска)
				   |
				   |ИНДЕКСИРОВАТЬ ПО
				   |	Контакт,
				   |	Бот
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	История.Контакт КАК Контакт,
				   |	История.Бот КАК Бот,
				   |	МАКСИМУМ(История.Период) КАК ДатаПоследнегоСообщения,
				   |	СУММА(ВЫБОР
				   |			КОГДА История.Входящее
				   |					И НЕ История.Прочитано
				   |				ТОГДА 1
				   |			ИНАЧЕ 0
				   |		КОНЕЦ) КАК Непрочитано
				   |ПОМЕСТИТЬ ВТПоследние
				   |ИЗ
				   |	РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКонтакты КАК Контакты
				   |		ПО История.Контакт = Контакты.Контакт
				   |			И История.Бот = Контакты.Бот
				   |СГРУППИРОВАТЬ ПО
				   |	История.Контакт,
				   |	История.Бот
				   |
				   |ИНДЕКСИРОВАТЬ ПО
				   |	Контакт,
				   |	Бот
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Контакты.Контакт КАК Контакт,
				   |	Контакты.Пациент КАК Пациент,
				   |	Контакты.ИмяMAX КАК ИмяMAX,
				   |	Контакты.Бот КАК Бот,
				   |	ЕСТЬNULL(История.Текст, """") КАК ПоследнееСообщение,
				   |	Последние.ДатаПоследнегоСообщения КАК ДатаПоследнегоСообщения,
				   |	ЕСТЬNULL(Последние.Непрочитано, 0) КАК Непрочитано,
				   |	ЕСТЬNULL(История.Входящее, ЛОЖЬ) КАК ПоследнееВходящее
				   |ИЗ
				   |	ВТКонтакты КАК Контакты
				   |		ЛЕВОЕ СОЕДИНЕНИЕ ВТПоследние КАК Последние
				   |		ПО Контакты.Контакт = Последние.Контакт
				   |			И Контакты.Бот = Последние.Бот
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
				   |		ПО Последние.Контакт = История.Контакт
				   |			И Последние.Бот = История.Бот
				   |			И Последние.ДатаПоследнегоСообщения = История.Период
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	ДатаПоследнегоСообщения УБЫВ,
				   |	Пациент";

	СтрокаОтбора = СокрЛП(СтрокаПоиска);
	Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаОтбора);
	Запрос.УстановитьПараметр("ШаблонПоиска", "%" + СтрокаОтбора + "%");

	РезультатыПакета = Запрос.ВыполнитьПакет();
	ТаблицаКонтактов = РезультатыПакета[РезультатыПакета.Количество() - 1].Выгрузить();

	// Один пациент может быть заведен несколькими контактами MAX: диалоги сворачиваются
	// до пары "пациент + бот", чтобы оператор видел одну переписку.
	СвернутыеДиалоги = ТаблицаКонтактов.СкопироватьКолонки();
	УчтенныеКонтакты = Новый Соответствие;

	Для Каждого СтрокаКонтакта Из ТаблицаКонтактов Цикл
		ОтборДиалога = Новый Структура("Пациент, Бот", СтрокаКонтакта.Пациент, СтрокаКонтакта.Бот);
		НайденныеДиалоги = СвернутыеДиалоги.НайтиСтроки(ОтборДиалога);
		Если НайденныеДиалоги.Количество() = 0 Тогда
			СтрокаДиалога = СвернутыеДиалоги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДиалога, СтрокаКонтакта);
			СтрокаДиалога.Непрочитано = 0;
		Иначе
			СтрокаДиалога = НайденныеДиалоги[0];
		КонецЕсли;

		КлючКонтакта = Строка(СтрокаКонтакта.Контакт.УникальныйИдентификатор());
		Если УчтенныеКонтакты.Получить(КлючКонтакта) = Неопределено Тогда
			СтрокаДиалога.Непрочитано = СтрокаДиалога.Непрочитано + СтрокаКонтакта.Непрочитано;
			УчтенныеКонтакты.Вставить(КлючКонтакта, Истина);
		КонецЕсли;

		ЭтоБолееНовоеСообщение = СтрокаКонтакта.ДатаПоследнегоСообщения > СтрокаДиалога.ДатаПоследнегоСообщения;
		ЭтоОтветВТуЖеСекунду = СтрокаКонтакта.ДатаПоследнегоСообщения = СтрокаДиалога.ДатаПоследнегоСообщения
			И СтрокаДиалога.ПоследнееВходящее И Не СтрокаКонтакта.ПоследнееВходящее;
		Если ЭтоБолееНовоеСообщение Или ЭтоОтветВТуЖеСекунду Тогда
			СтрокаДиалога.Контакт = СтрокаКонтакта.Контакт;
			СтрокаДиалога.ИмяMAX = СтрокаКонтакта.ИмяMAX;
			СтрокаДиалога.ПоследнееСообщение = СтрокаКонтакта.ПоследнееСообщение;
			СтрокаДиалога.ДатаПоследнегоСообщения = СтрокаКонтакта.ДатаПоследнегоСообщения;
			СтрокаДиалога.ПоследнееВходящее = СтрокаКонтакта.ПоследнееВходящее;
		КонецЕсли;
	КонецЦикла;

	СвернутыеДиалоги.Сортировать("ДатаПоследнегоСообщения Убыв, Пациент");

	Возврат СвернутыеДиалоги;

КонецФункции

&НаСервереБезКонтекста
Функция ТекущийПользовательНаСервере()

	Попытка
		Возврат Пользователи.ТекущийПользователь();
	Исключение
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция СостоянияДиалоговНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Состояния.Пациент КАК Пациент,
				   |	Состояния.Бот КАК Бот,
				   |	Состояния.Состояние КАК Состояние,
				   |	Состояния.Ответственный КАК Ответственный,
				   |	Состояния.ДатаИзменения КАК ДатаИзменения
				   |ИЗ
				   |	РегистрСведений.бит_омни_СостоянияДиалоговMAX КАК Состояния";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(
			СформироватьКлючДиалога(Выборка.Пациент, Выборка.Бот),
			Новый Структура("Состояние, Ответственный, ДатаИзменения",
				Выборка.Состояние, Выборка.Ответственный, Выборка.ДатаИзменения));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ВзятьВРаботуНаСервере()

	УстановитьСостояниеДиалогаНаСервере(
		Перечисления.бит_омни_СостоянияДиалоговMAX.ВРаботе, ТекущийПользователь);

КонецПроцедуры

&НаСервере
Процедура ЗакрытьДиалогНаСервере()

	УстановитьСостояниеДиалогаНаСервере(
		Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт, ТекущийПользователь);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВернутьДиалогВРаспределениеНаСервере(Пациент, Бот)

	Запись = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
	Запись.Пациент = Пациент;
	Запись.Бот = Бот;
	Запись.Прочитать();

	Запись.Пациент = Пациент;
	Запись.Бот = Бот;
	Запись.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Новый;
	Запись.Ответственный = Справочники.Пользователи.ПустаяСсылка();
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеДиалогаНаСервере(Состояние, Ответственный)

	Запись = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
	Запись.Пациент = ТекущийПациент;
	Запись.Бот = ТекущийБот;
	Запись.Прочитать();

	Запись.Пациент = ТекущийПациент;
	Запись.Бот = ТекущийБот;
	Запись.Состояние = Состояние;
	Запись.Ответственный = Ответственный;
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

&НаСервере
Процедура ВосстановитьТекущийДиалогНаСервере()

	Если ПустаяСтрока(КлючТекущегоДиалога) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаДиалога Из Диалоги Цикл
		Если СтрокаДиалога.КлючДиалога = КлючТекущегоДиалога Тогда
			Элементы.Диалоги.ТекущаяСтрока = СтрокаДиалога.ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СброситьСчетчикНепрочитанныхНаСервере(КлючДиалога)

	Для Каждого СтрокаДиалога Из Диалоги Цикл
		Если СтрокаДиалога.КлючДиалога = КлючДиалога Тогда
			СтрокаДиалога.Непрочитано = 0;
			СтрокаДиалога.МеткаНепрочитанных = "";
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСчетчикДиалоговНаСервере(КоличествоДиалогов, КоличествоНепрочитанных, КоличествоБезОтвета,
	КоличествоМоих)

	// Счетчики выводятся прямо в переключателе отбора, как вкладки в мессенджере.
	СписокОтбора = Элементы.ОтборДиалогов.СписокВыбора;
	СписокОтбора.Очистить();
	СписокОтбора.Добавить(0, СтрШаблон("Все %1", КоличествоДиалогов));
	СписокОтбора.Добавить(1, СтрШаблон("Без ответа %1", КоличествоБезОтвета));
	СписокОтбора.Добавить(2, СтрШаблон("Мои %1", КоличествоМоих));
	СписокОтбора.Добавить(3, СтрШаблон("Новые %1", КоличествоНепрочитанных));

	Если Диалоги.Количество() = 0 Тогда
		Элементы.НадписьСчетчик.Заголовок = "Ничего не найдено";
	Иначе
		Элементы.НадписьСчетчик.Заголовок = СтрШаблон("Показано: %1", Диалоги.Количество());
	КонецЕсли;

	Элементы.НадписьНовых.Видимость = КоличествоНепрочитанных > 0;
	Элементы.НадписьНовых.Заголовок = СтрШаблон("новых: %1", КоличествоНепрочитанных);

КонецПроцедуры

&НаСервере
Процедура ОбновитьОтметкуОбновленияНаСервере()

	Элементы.НадписьОбновлено.Заголовок = СтрШаблон(
		"Обновлено в %1", Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss"));

КонецПроцедуры

&НаСервере
Процедура ОбновитьШапкуЧатаНаСервере()

	Если Не ЗначениеЗаполнено(ТекущийПациент) Тогда
		Элементы.ЗаголовокЧата.Заголовок = "Диалог не выбран";
		Элементы.НадписьСостояниеДиалога.Заголовок = "";
		Элементы.ПодзаголовокЧата.Заголовок = "Выберите пациента в списке слева";
		ОчиститьКарточкуПациентаНаСервере();
		Возврат;
	КонецЕсли;

	ИмяВMAX = "";
	МеткаСостояния = "";
	СостояниеТекущего = Неопределено;
	Для Каждого СтрокаДиалога Из Диалоги Цикл
		Если СтрокаДиалога.КлючДиалога = КлючТекущегоДиалога Тогда
			ИмяВMAX = СтрокаДиалога.ИмяMAX;
			МеткаСостояния = СокрЛП(СтрокаДиалога.МеткаСостояния);
			СостояниеТекущего = СтрокаДиалога.Состояние;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Элементы.ЗаголовокЧата.Заголовок = Строка(ТекущийПациент);
	Элементы.НадписьСостояниеДиалога.Заголовок = МеткаСостояния;
	Если СостояниеТекущего = Перечисления.бит_омни_СостоянияДиалоговMAX.ВРаботе Тогда
		Элементы.НадписьСостояниеДиалога.ЦветТекста = ЦветУспеха();
	ИначеЕсли СостояниеТекущего = Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт Тогда
		Элементы.НадписьСостояниеДиалога.ЦветТекста = ЦветВторичногоТекста();
	Иначе
		Элементы.НадписьСостояниеДиалога.ЦветТекста = ЦветТревоги();
	КонецЕсли;

	ЧастиПодзаголовка = Новый Массив;
	Если Не ПустаяСтрока(ИмяВMAX) Тогда
		ЧастиПодзаголовка.Добавить(СтрШаблон("MAX: %1", ИмяВMAX));
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущийБот) Тогда
		ЧастиПодзаголовка.Добавить(СтрШаблон("бот «%1»", ТекущийБот));
	КонецЕсли;

	Элементы.ПодзаголовокЧата.Заголовок = СтрСоединить(ЧастиПодзаголовка, " · ");

	ЗаполнитьКарточкуПациентаНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОчиститьКарточкуПациентаНаСервере()

	БлижайшаяЗаявка = Документы.Заявка.ПустаяСсылка();
	ОсновнойСотрудник = Справочники.Сотрудники.ПустаяСсылка();

	Элементы.ЗаголовокКарточки.Заголовок = "Пациент не выбран";
	АватарКарточкиHTML = АватарHTML("");
	Элементы.ПодзаголовокКарточки.Заголовок = "";

	Для Каждого ИмяЗначения Из СтрРазделить("НадписьТелефон,НадписьКарта,НадписьПолис,НадписьВрач", ",") Цикл
		Элементы[ИмяЗначения].Заголовок = "";
	КонецЦикла;

	Элементы.НадписьЗаписьДата.Заголовок = "";
	Элементы.НадписьЗапись.Заголовок = "";
	ОчиститьСтрокиИсторииНаСервере();
	Элементы.ПодписьЗадолженность.Заголовок = "Задолженность";
	Элементы.НадписьЗадолженность.Заголовок = "";
	Элементы.НадписьЗадолженность.ЦветТекста = ЦветВторичногоТекста();
	ОбновитьДоступностьКарточкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОчиститьСтрокиИсторииНаСервере()

	Для Индекс = 1 По 3 Цикл
		Элементы["ГруппаСтрокаИстории" + Индекс].Видимость = Ложь;
		Элементы["НадписьИстория" + Индекс + "Дата"].Заголовок = "";
		Элементы["НадписьИстория" + Индекс].Заголовок = "";
	КонецЦикла;
	Элементы.СсылкаЕщеИстория.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКарточкиНаСервере()

	ЕстьЗапись = ЗначениеЗаполнено(БлижайшаяЗаявка);
	Элементы.КнопкаПеренести.Доступность = ЕстьЗапись;
	Элементы.КнопкаНапомнить.Доступность = ЕстьЗапись;
	Элементы.КнопкаЗаписатьНаПрием.Доступность = ЗначениеЗаполнено(ТекущийПациент);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКарточкуПациентаНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Клиенты.ДатаРождения КАК ДатаРождения,
				   |	Клиенты.Пол КАК Пол,
				   |	Клиенты.ОсновнаяМедицинскаяКарта КАК Карта,
				   |	Клиенты.умцОсновнойСтраховойПолис КАК Полис,
				   |	Клиенты.ОсновнойСотрудник КАК ОсновнойСотрудник
				   |ИЗ
				   |	Справочник.Клиенты КАК Клиенты
				   |ГДЕ
				   |	Клиенты.Ссылка = &Пациент
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				   |	КонтактнаяИнформация.Представление КАК Представление
				   |ИЗ
				   |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
				   |ГДЕ
				   |	КонтактнаяИнформация.Объект = &Пациент
				   |	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
				   |	И КонтактнаяИнформация.Представление <> """"
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				   |	Заявка.ДатаНачала КАК Дата,
				   |	Заявка.Сотрудник КАК Сотрудник,
				   |	Заявка.бит_омни_Специализация КАК Специализация,
				   |	Заявка.Кабинет КАК Кабинет,
				   |	Заявка.Ссылка КАК Ссылка
				   |ИЗ
				   |	Документ.Заявка КАК Заявка
				   |ГДЕ
				   |	Заявка.Клиент = &Пациент
				   |	И Заявка.ДатаНачала >= &НачалоСегодня
				   |	И НЕ Заявка.ПометкаУдаления
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	Дата
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 5
				   |	Продажи.Период КАК Дата,
				   |	Продажи.Номенклатура КАК Номенклатура,
				   |	СУММА(Продажи.Сумма) КАК Сумма
				   |ИЗ
				   |	РегистрНакопления.Продажи КАК Продажи
				   |ГДЕ
				   |	Продажи.Клиент = &Пациент
				   |
				   |СГРУППИРОВАТЬ ПО
				   |	Продажи.Период,
				   |	Продажи.Номенклатура
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	Дата УБЫВ
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	СУММА(Остатки.СуммаОстаток) КАК Долг
				   |ИЗ
				   |	РегистрНакопления.ВзаиморасчетыСКлиентами.Остатки(, Клиент = &Пациент) КАК Остатки";

	Запрос.УстановитьПараметр("Пациент", ТекущийПациент);
	Запрос.УстановитьПараметр("НачалоСегодня", НачалоДня(ТекущаяДатаСеанса()));

	Попытка
		Результаты = Запрос.ВыполнитьПакет();
	Исключение
		// Состав основной конфигурации может отличаться: карточка тогда остается пустой.
		ОчиститьКарточкуПациентаНаСервере();
		Элементы.ЗаголовокКарточки.Заголовок = Строка(ТекущийПациент);
		АватарКарточкиHTML = АватарHTML(ИнициалыПациента(ТекущийПациент));
		Возврат;
	КонецПопытки;

	Элементы.ЗаголовокКарточки.Заголовок = Строка(ТекущийПациент);
	АватарКарточкиHTML = АватарHTML(ИнициалыПациента(ТекущийПациент));

	ЧастиПодзаголовка = Новый Массив;
	Телефон = "";
	Карта = "";
	Полис = "";
	ОсновнойСотрудник = Справочники.Сотрудники.ПустаяСсылка();

	ВыборкаКлиента = Результаты[0].Выбрать();
	Если ВыборкаКлиента.Следующий() Тогда
		Если ЗначениеЗаполнено(ВыборкаКлиента.ДатаРождения) Тогда
			ЧастиПодзаголовка.Добавить(Формат(ВыборкаКлиента.ДатаРождения, "ДФ=dd.MM.yyyy"));
			ЧастиПодзаголовка.Добавить(ПредставлениеВозраста(ВыборкаКлиента.ДатаРождения));
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаКлиента.Пол) Тогда
			ЧастиПодзаголовка.Добавить(НРег(Строка(ВыборкаКлиента.Пол)));
		КонецЕсли;
		Карта = Строка(ВыборкаКлиента.Карта);
		Полис = Строка(ВыборкаКлиента.Полис);
		ОсновнойСотрудник = ВыборкаКлиента.ОсновнойСотрудник;
	КонецЕсли;

	ВыборкаТелефона = Результаты[1].Выбрать();
	Если ВыборкаТелефона.Следующий() Тогда
		Телефон = СокрЛП(ВыборкаТелефона.Представление);
	КонецЕсли;

	Элементы.ПодзаголовокКарточки.Заголовок = СтрСоединить(ЧастиПодзаголовка, " · ");
	Элементы.НадписьТелефон.Заголовок = ?(ПустаяСтрока(Телефон), "не указан", Телефон);
	Элементы.НадписьКарта.Заголовок = ?(ПустаяСтрока(Карта), "нет", Карта);
	Элементы.НадписьПолис.Заголовок = ?(ПустаяСтрока(Полис), "нет", Полис);
	Элементы.НадписьВрач.Заголовок = ?(ЗначениеЗаполнено(ОсновнойСотрудник),
		Строка(ОсновнойСотрудник), "не назначен");

	БлижайшаяЗаявка = Документы.Заявка.ПустаяСсылка();
	ВыборкаЗаписи = Результаты[2].Выбрать();
	Если ВыборкаЗаписи.Следующий() Тогда
		БлижайшаяЗаявка = ВыборкаЗаписи.Ссылка;
		Элементы.НадписьЗаписьДата.Заголовок = Формат(ВыборкаЗаписи.Дата, "ДФ='d MMMM, ddd · HH:mm'");
		Элементы.НадписьЗапись.Заголовок = УточнениеЗаявки(ВыборкаЗаписи);
	Иначе
		Элементы.НадписьЗаписьДата.Заголовок = "Нет запланированных записей";
		Элементы.НадписьЗапись.Заголовок = "";
	КонецЕсли;

	ОчиститьСтрокиИсторииНаСервере();
	Индекс = 0;
	ВыборкаИстории = Результаты[3].Выбрать();
	Пока ВыборкаИстории.Следующий() И Индекс < 3 Цикл
		Индекс = Индекс + 1;
		Элементы["ГруппаСтрокаИстории" + Индекс].Видимость = Истина;
		Элементы["НадписьИстория" + Индекс + "Дата"].Заголовок = Формат(ВыборкаИстории.Дата, "ДФ='d MMM'");
		Элементы["НадписьИстория" + Индекс].Заголовок = ПредставлениеПосещения(ВыборкаИстории);
	КонецЦикла;

	Если Индекс = 0 Тогда
		Элементы.ГруппаСтрокаИстории1.Видимость = Истина;
		Элементы.НадписьИстория1.Заголовок = "Посещений не было";
	Иначе
		Элементы.СсылкаЕщеИстория.Видимость = Истина;
	КонецЕсли;

	ОбновитьДоступностьКарточкиНаСервере();

	ЗаполнитьВзаиморасчетыНаСервере(Результаты[4]);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВзаиморасчетыНаСервере(РезультатОстатков)

	Долг = 0;
	Выборка = РезультатОстатков.Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Долг) Тогда
		Долг = Выборка.Долг;
	КонецЕсли;

	Если Долг > 0 Тогда
		Элементы.ПодписьЗадолженность.Заголовок = "Задолженность";
		Элементы.НадписьЗадолженность.Заголовок = Формат(Долг, "ЧДЦ=2; ЧН=0") + " руб.";
		Элементы.НадписьЗадолженность.ЦветТекста = ЦветТревоги();
	ИначеЕсли Долг < 0 Тогда
		Элементы.ПодписьЗадолженность.Заголовок = "Аванс";
		Элементы.НадписьЗадолженность.Заголовок = Формат(-Долг, "ЧДЦ=2; ЧН=0") + " руб.";
		Элементы.НадписьЗадолженность.ЦветТекста = ЦветВторичногоТекста();
	Иначе
		Элементы.ПодписьЗадолженность.Заголовок = "Задолженность";
		Элементы.НадписьЗадолженность.Заголовок = "нет";
		Элементы.НадписьЗадолженность.ЦветТекста = ЦветВторичногоТекста();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция УточнениеЗаявки(Выборка)

	Уточнение = Новый Массив;
	Если ЗначениеЗаполнено(Выборка.Специализация) Тогда
		Уточнение.Добавить(Строка(Выборка.Специализация));
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Сотрудник) Тогда
		Уточнение.Добавить(Строка(Выборка.Сотрудник));
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Кабинет) Тогда
		Уточнение.Добавить(СтрШаблон("каб. %1", Выборка.Кабинет));
	КонецЕсли;

	Возврат СтрСоединить(Уточнение, " · ");

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеПосещения(Выборка)

	Представление = Строка(Выборка.Номенклатура);
	Если ЗначениеЗаполнено(Выборка.Сумма) Тогда
		Представление = Представление + " · " + Формат(Выборка.Сумма, "ЧДЦ=2; ЧН=0") + " руб.";
	КонецЕсли;

	Возврат Лев(Представление, 120);

КонецФункции

&НаСервереБезКонтекста
Функция ДанныеЗаявкиДляПереносаНаСервере(Знач Заявка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Заявка.ДатаНачала КАК ДатаНачала,
				   |	Заявка.Сотрудник КАК Сотрудник,
				   |	Заявка.бит_омни_Специализация КАК Специализация
				   |ИЗ
				   |	Документ.Заявка КАК Заявка
				   |ГДЕ
				   |	Заявка.Ссылка = &Ссылка
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Работы.Номенклатура КАК Номенклатура
				   |ИЗ
				   |	Документ.Заявка.Работы КАК Работы
				   |ГДЕ
				   |	Работы.Ссылка = &Ссылка
				   |	И Работы.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
				   |";

	Запрос.УстановитьПараметр("Ссылка", Заявка);

	Результат = Новый Структура("ДатаНачала, Сотрудник, Специализация, Работы",
		НачалоДня(ТекущаяДатаСеанса()),
		Справочники.Сотрудники.ПустаяСсылка(),
		Неопределено,
		Новый Массив);

	Результаты = Запрос.ВыполнитьПакет();

	ВыборкаЗаявки = Результаты[0].Выбрать();
	Если ВыборкаЗаявки.Следующий() Тогда
		// Журнал записи открывается на день заявки, поэтому время отбрасывается.
		Результат.ДатаНачала = НачалоДня(ВыборкаЗаявки.ДатаНачала);
		Результат.Сотрудник = ВыборкаЗаявки.Сотрудник;
		Результат.Специализация = ВыборкаЗаявки.Специализация;
	КонецЕсли;

	ВыборкаРабот = Результаты[1].Выбрать();
	Пока ВыборкаРабот.Следующий() Цикл
		Результат.Работы.Добавить(ВыборкаРабот.Номенклатура);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПлановаяДатаЗаписиНаСервере()

	НачалоДняЗаписи = НачалоДня(ТекущаяДатаСеанса());

	Попытка
		ВремяНачалаРаботы = УправлениеНастройками.ПолучитьПараметрУчетнойПолитики(
			"ВремяНачалаРаботы");
		Возврат НачалоДняЗаписи + ОбщегоНазначения.ВремяВСекунды(ВремяНачалаРаботы);
	Исключение
		// Учетная политика может быть не заполнена: тогда берется начало текущего дня.
		Возврат НачалоДняЗаписи;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеВозраста(ДатаРождения)

	Возраст = Год(ТекущаяДатаСеанса()) - Год(ДатаРождения);
	Если Формат(ТекущаяДатаСеанса(), "ДФ=MMdd") < Формат(ДатаРождения, "ДФ=MMdd") Тогда
		Возраст = Возраст - 1;
	КонецЕсли;

	Остаток = Возраст % 100;
	Если Остаток >= 11 И Остаток <= 14 Тогда
		Окончание = "лет";
	Иначе
		Остаток = Возраст % 10;
		Если Остаток = 1 Тогда
			Окончание = "год";
		ИначеЕсли Остаток >= 2 И Остаток <= 4 Тогда
			Окончание = "года";
		Иначе
			Окончание = "лет";
		КонецЕсли;
	КонецЕсли;

	Возврат СтрШаблон("%1 %2", Возраст, Окончание);

КонецФункции

&НаСервереБезКонтекста
Функция ТекстШаблонаНаСервере(Шаблон)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Шаблоны.ШаблонСообщения КАК Текст
				   |ИЗ
				   |	Справочник.бит_омни_ШаблоныСообщений КАК Шаблоны
				   |ГДЕ
				   |	Шаблоны.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Шаблон);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.Текст));
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервере
Процедура ЗагрузитьСообщенияНаСервере(ПерестроитьЛенту)

	Если Не ЗначениеЗаполнено(ТекущийПациент) Тогда
		ОчиститьЛентуЧатаНаСервере();
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	История.Период КАК Период,
				   |	История.Входящее КАК Входящее,
				   |	История.Прочитано КАК Прочитано,
				   |	История.Автор КАК Автор,
				   |	История.Текст КАК Текст,
				   |	История.Статус КАК Статус,
				   |	История.ОписаниеОшибки КАК ОписаниеОшибки,
				   |	История.ВидСообщения КАК ВидСообщения,
				   |	История.ВидОтправителя КАК ВидОтправителя
				   |ИЗ
				   |	РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
				   |ГДЕ
				   |	История.Контакт.Получатель = &Пациент
				   |	И История.Бот = &Бот
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	Период";

	Запрос.УстановитьПараметр("Пациент", ТекущийПациент);
	Запрос.УстановитьПараметр("Бот", ТекущийБот);

	ТаблицаСообщений = Запрос.Выполнить().Выгрузить();

	ЕстьНепрочитанные = Ложь;
	Для Каждого Сообщение Из ТаблицаСообщений Цикл
		Если Сообщение.Входящее И Не Сообщение.Прочитано Тогда
			ЕстьНепрочитанные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьНепрочитанные Тогда
		ПометитьВходящиеПрочитаннымиНаСервере();
	КонецЕсли;

	НовыйОтпечаток = ОтпечатокСообщений(ТаблицаСообщений);
	Если Не ПерестроитьЛенту И НовыйОтпечаток = ОтпечатокЛенты Тогда
		Возврат;
	КонецЕсли;

	ОтпечатокЛенты = НовыйОтпечаток;
	ЛентаЧата = ЛентаЧатаHTML(ТаблицаСообщений);

КонецПроцедуры

&НаСервере
Процедура ОчиститьЛентуЧатаНаСервере()

	ОтпечатокЛенты = "";
	ЛентаЧата = ЗаглушкаЛентыHTML();

КонецПроцедуры

&НаСервере
Процедура ПометитьВходящиеПрочитаннымиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	Контакты.Ссылка КАК Контакт
				   |ИЗ
				   |	Справочник.бит_омни_Контакты КАК Контакты
				   |ГДЕ
				   |	Контакты.Получатель = &Пациент
				   |	И Контакты.Бот = &Бот
				   |	И НЕ Контакты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Пациент", ТекущийПациент);
	Запрос.УстановитьПараметр("Бот", ТекущийБот);

	ВыборкаКонтактов = Запрос.Выполнить().Выбрать();
	Пока ВыборкаКонтактов.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Контакт.Установить(ВыборкаКонтактов.Контакт);
		НаборЗаписей.Отбор.Бот.Установить(ТекущийБот);
		НаборЗаписей.Отбор.Входящее.Установить(Истина);
		НаборЗаписей.Прочитать();

		ЕстьИзменения = Ложь;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Не Запись.Прочитано Тогда
				Запись.Прочитано = Истина;
				ЕстьИзменения = Истина;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьИзменения Тогда
			НаборЗаписей.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОтправитьОтветНаСервере()

	Попытка
		РезультатОтправки = бит_омни_ИнтеграцияСMAX.ОтправитьТекстовоеСообщение(
			СокрЛП(ТекстОтвета), ТекущийКонтакт, ТекущийБот, ,
			Перечисления.бит_омни_ВидыОтправителейMAX.Оператор, ТекущийПользователь);

		Успех = Истина;
		ОписаниеОшибки = "";
		Если ТипЗнч(РезультатОтправки) = Тип("Структура") Тогда
			ЗначениеУспеха = Неопределено;
			Если РезультатОтправки.Свойство("success", ЗначениеУспеха)
				И ТипЗнч(ЗначениеУспеха) = Тип("Булево") Тогда
				Успех = ЗначениеУспеха;
			КонецЕсли;

			СообщениеОбОшибке = Неопределено;
			Если РезультатОтправки.Свойство("message", СообщениеОбОшибке)
				И ТипЗнч(СообщениеОбОшибке) = Тип("Строка") Тогда
				ОписаниеОшибки = СообщениеОбОшибке;
			КонецЕсли;
		КонецЕсли;

		Если Успех Тогда
			РезультатЗаписи = РезультатПоследнейОтправкиНаСервере();
			Если РезультатЗаписи <> Неопределено И РезультатЗаписи.Статус = "Ошибка" Тогда
				Успех = Ложь;
				ОписаниеОшибки = РезультатЗаписи.ОписаниеОшибки;
			КонецЕсли;
		КонецЕсли;

		Если Не Успех И ПустаяСтрока(ОписаниеОшибки) Тогда
			ОписаниеОшибки = "MAX отклонил сообщение.";
		КонецЕсли;

		Возврат Новый Структура(
			"Успех, ОписаниеОшибки",
			Успех,
			?(Успех, "", ОписаниеОшибки));
	Исключение
		Возврат Новый Структура(
			"Успех, ОписаниеОшибки",
			Ложь,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

&НаСервере
Функция РезультатПоследнейОтправкиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				   |	История.Статус КАК Статус,
				   |	История.ОписаниеОшибки КАК ОписаниеОшибки
				   |ИЗ
				   |	РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
				   |ГДЕ
				   |	История.Контакт = &Контакт
				   |	И История.Бот = &Бот
				   |	И НЕ История.Входящее
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	История.Период УБЫВ";

	Запрос.УстановитьПараметр("Контакт", ТекущийКонтакт);
	Запрос.УстановитьПараметр("Бот", ТекущийБот);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура(
			"Статус, ОписаниеОшибки",
			Выборка.Статус,
			Выборка.ОписаниеОшибки);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ФормированиеЛентыЧата

&НаСервереБезКонтекста
Функция ЛентаЧатаHTML(ТаблицаСообщений)

	Если ТаблицаСообщений.Количество() = 0 Тогда
		Возврат ЗаготовкаЛентыHTML(
			"<div class=""empty""><div class=""empty-title"">Сообщений пока нет</div>"
			+ "<div class=""empty-hint"">Напишите первым, и сообщение уйдет пациенту в MAX.</div></div>");
	КонецЕсли;

	ЧастиЛенты = Новый Массив;
	ПредыдущийДень = '00010101';
	ПредыдущееВходящее = Неопределено;
	ПредыдущийПериод = '00010101';

	Для Каждого Сообщение Из ТаблицаСообщений Цикл
		ДеньСообщения = НачалоДня(Сообщение.Период);
		Если ДеньСообщения <> ПредыдущийДень Тогда
			ЧастиЛенты.Добавить("<div class=""day""><span>"
				+ ЭкранироватьТекстДляHTML(ПредставлениеДняЛенты(ДеньСообщения))
				+ "</span></div>");
			ПредыдущийДень = ДеньСообщения;
			ПредыдущееВходящее = Неопределено;
		КонецЕсли;

		ПродолжениеСерии = (ПредыдущееВходящее = Сообщение.Входящее)
			И (Сообщение.Период - ПредыдущийПериод) <= 300;

		ЧастиЛенты.Добавить(ПузырекСообщенияHTML(Сообщение, ПродолжениеСерии));

		ПредыдущееВходящее = Сообщение.Входящее;
		ПредыдущийПериод = Сообщение.Период;
	КонецЦикла;

	Возврат ЗаготовкаЛентыHTML(СтрСоединить(ЧастиЛенты, ""));

КонецФункции

&НаСервереБезКонтекста
Функция ПузырекСообщенияHTML(Сообщение, ПродолжениеСерии)

	Если ЭтоАвтоответБота(Сообщение) Тогда
		Возврат БлокБотаHTML(Сообщение);
	КонецЕсли;

	КлассСтроки = ?(Сообщение.Входящее, "row in", "row out");
	Если ПродолжениеСерии Тогда
		КлассСтроки = КлассСтроки + " cont";
	КонецЕсли;

	ЧастиПузырька = Новый Массив;
	ЧастиПузырька.Добавить("<div class=""" + КлассСтроки + """><div class=""bubble"">");

	Если Не ПродолжениеСерии Тогда
		ЧастиПузырька.Добавить("<div class=""who"">"
			+ ЭкранироватьТекстДляHTML(АвторСообщения(Сообщение)) + "</div>");
	КонецЕсли;

	ТекстСообщения = СтрЗаменить(Строка(Сообщение.Текст), Символы.ВК, "");

	Если ЭтоВложение(Сообщение.ВидСообщения) Тогда
		ЧастиПузырька.Добавить("<div class=""att"">"
			+ ЭкранироватьТекстДляHTML(ПредставлениеВложения(Сообщение.ВидСообщения)) + "</div>");

		// Интеграция подставляет в текст "[Вложение: ...]", когда сообщение состоит
		// из одного вложения. Дублировать эту подпись под чипом не нужно.
		Если СокрЛП(ТекстСообщения) = СтрШаблон("[Вложение: %1]", Сообщение.ВидСообщения) Тогда
			ТекстСообщения = "";
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		ЧастиПузырька.Добавить("<div class=""text"">"
			+ ЭкранироватьТекстДляHTML(ТекстСообщения) + "</div>");
	КонецЕсли;

	МетаHTML = ЭкранироватьТекстДляHTML(МетаСообщения(Сообщение)) + ЗначокСтатусаHTML(Сообщение);
	ЧастиПузырька.Добавить("<div class=""meta"">" + МетаHTML + "</div>");

	Если Не ПустаяСтрока(Сообщение.ОписаниеОшибки) Тогда
		ЧастиПузырька.Добавить("<div class=""err"">"
			+ ЭкранироватьТекстДляHTML(Лев(СокрЛП(Сообщение.ОписаниеОшибки), 500)) + "</div>");
	КонецЕсли;

	ЧастиПузырька.Добавить("</div></div>");

	Возврат СтрСоединить(ЧастиПузырька, "");

КонецФункции

// Сообщения бота отличаются от операторских наличием интерактивной клавиатуры MAX:
// оператор такие вложения отправить не может.
&НаСервереБезКонтекста
Функция ЭтоАвтоответБота(Сообщение)

	Если Сообщение.Входящее Тогда
		Возврат Ложь;
	КонецЕсли;

	// У сообщений, записанных до доработки регистра, вид отправителя не заполнен:
	// для них ботом считается все, что не отправлял оператор.
	Если ЗначениеЗаполнено(Сообщение.ВидОтправителя) Тогда
		Возврат Сообщение.ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Бот;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(Сообщение.ВидСообщения))) = "inline_keyboard";

КонецФункции

&НаСервереБезКонтекста
Функция БлокБотаHTML(Сообщение)

	ТекстСообщения = СтрЗаменить(Строка(Сообщение.Текст), Символы.ВК, "");

	Возврат "<div class=""bot""><div class=""bot-box"">"
		+ "<div class=""bot-cap"">АВТООТВЕТ БОТА</div>"
		+ "<div class=""bot-text"">" + ЭкранироватьТекстДляHTML(ТекстСообщения) + "</div>"
		+ "<div class=""bot-meta"">" + ЭкранироватьТекстДляHTML(МетаСообщения(Сообщение)) + "</div>"
		+ "</div></div>";

КонецФункции

&НаСервереБезКонтекста
Функция АвторСообщения(Сообщение)

	Автор = СокрЛП(Строка(Сообщение.Автор));
	Если Не ПустаяСтрока(Автор) Тогда
		Возврат Автор;
	КонецЕсли;

	Возврат ?(Сообщение.Входящее, "Пациент", "Клиника");

КонецФункции

&НаСервереБезКонтекста
Функция МетаСообщения(Сообщение)

	Время = Формат(Сообщение.Период, "ДФ=HH:mm");
	Если Сообщение.Входящее Или ПустаяСтрока(Сообщение.Статус) Тогда
		Возврат Время;
	КонецЕсли;

	// Статус показывает значок, поэтому словом он не дублируется.
	Возврат Время;

КонецФункции

// Значок статуса исходящего сообщения.
//
// Формы значков повторяют набор Phosphor: check (доставлено), checks (прочитано)
// и warning-diamond (ошибка отправки).
&НаСервереБезКонтекста
Функция ЗначокСтатусаHTML(Сообщение)

	Если Сообщение.Входящее Тогда
		Возврат "";
	КонецЕсли;

	Статус = СокрЛП(Строка(Сообщение.Статус));

	Если Статус = "Ошибка" Тогда
		Возврат ЗначокHTML(
			"i-err",
			"<path d=""M128 20 L236 128 L128 236 L20 128 Z""/>"
			+ "<path d=""M128 84 L128 140""/>"
			+ "<circle cx=""128"" cy=""176"" r=""10"" fill=""currentColor"" stroke=""none""/>",
			16);
	ИначеЕсли Статус = "Прочитано" Тогда
		Возврат ЗначокHTML(
			"i-ok",
			"<path d=""M20 140 L72 192 L164 84""/>"
			+ "<path d=""M104 152 L124 172 L236 60""/>",
			24);
	ИначеЕсли Статус = "Отправлено" Тогда
		Возврат ЗначокHTML(
			"i-ok",
			"<path d=""M40 144 L96 200 L216 80""/>",
			16);
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция ЗначокHTML(КлассЦвета, Содержимое, ТолщинаЛинии)

	Возврат " <svg class=""ic " + КлассЦвета + """ viewBox=""0 0 256 256"" fill=""none"""
		+ " stroke=""currentColor"" stroke-width=""" + ТолщинаЛинии + """"
		+ " stroke-linecap=""round"" stroke-linejoin=""round"">" + Содержимое + "</svg>";

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеВложения(ВидСообщения)

	Вид = НРег(СокрЛП(Строка(ВидСообщения)));

	Если Вид = "contact" Тогда
		Возврат "Контакт";
	ИначеЕсли Вид = "image" Или Вид = "photo" Тогда
		Возврат "Изображение";
	ИначеЕсли Вид = "file" Тогда
		Возврат "Файл";
	ИначеЕсли Вид = "audio" Тогда
		Возврат "Аудио";
	ИначеЕсли Вид = "video" Тогда
		Возврат "Видео";
	ИначеЕсли Вид = "location" Тогда
		Возврат "Геопозиция";
	КонецЕсли;

	Возврат "Вложение: " + Строка(ВидСообщения);

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоВложение(ВидСообщения)

	Вид = НРег(СокрЛП(Строка(ВидСообщения)));
	Возврат Не ПустаяСтрока(Вид) И Вид <> "text";

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеДняЛенты(ДеньСообщения)

	Сегодня = НачалоДня(ТекущаяДатаСеанса());

	Если ДеньСообщения = Сегодня Тогда
		Возврат "Сегодня";
	ИначеЕсли ДеньСообщения = Сегодня - 86400 Тогда
		Возврат "Вчера";
	ИначеЕсли Год(ДеньСообщения) = Год(Сегодня) Тогда
		Возврат Формат(ДеньСообщения, "ДФ='d MMMM'");
	КонецЕсли;

	Возврат Формат(ДеньСообщения, "ДФ='d MMMM yyyy'");

КонецФункции

&НаСервереБезКонтекста
Функция ЗаглушкаЛентыHTML()

	Возврат ЗаготовкаЛентыHTML(
		"<div class=""empty""><div class=""empty-title"">Диалог не выбран</div>"
		+ "<div class=""empty-hint"">Выберите пациента в списке слева, чтобы открыть переписку.</div></div>");

КонецФункции

&НаСервереБезКонтекста
Функция ЗаготовкаЛентыHTML(СодержимоеHTML)

	Возврат "<html><head><meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8""/>"
		+ "<style>" + СтилиЛентыHTML() + "</style></head><body><div class=""feed"">"
		+ СодержимоеHTML
		+ "</div><div id=""feedEnd""></div>"
		+ "<script>window.onload=function(){var e=document.getElementById('feedEnd');if(e){e.scrollIntoView();}};</script>"
		+ "</body></html>";

КонецФункции

&НаСервереБезКонтекста
Функция СтилиЛентыHTML()

	Возврат "
		|html,body{margin:0;padding:0;}
		|body{background:#EEF2F6;color:#1B232C;
		|	font-family:'Segoe UI',Tahoma,Verdana,Arial,sans-serif;font-size:13px;line-height:1.45;}
		|.feed{max-width:820px;margin:0 auto;padding:16px 24px 20px;}
		|.day{text-align:center;margin:14px 0 10px;}
		|.day span{display:inline-block;padding:3px 12px;border-radius:11px;
		|	background:#DEE5EC;color:#5A6773;font-size:11px;font-weight:bold;}
		|.row{margin:12px 0;}
		|.row.cont{margin:3px 0;}
