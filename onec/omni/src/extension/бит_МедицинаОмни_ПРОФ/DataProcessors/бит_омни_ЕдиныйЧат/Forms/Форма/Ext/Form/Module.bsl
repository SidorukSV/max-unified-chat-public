#Область ОписаниеПеременных

&НаКлиенте
Перем ИдетОбновлениеСписка;

&НаКлиенте
Перем ИдетОтправкаСообщения;

&НаКлиенте
Перем ЕстьЧерновикСообщения;

&НаКлиенте
Перем ЧерновикСообщения;

&НаКлиенте
Перем НомерОперацииФормы;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Автообновление = Истина;
	ВариантОтбора = 0;
	ТекущийПользователь = ТекущийПользовательНаСервере();

	НастроитьВнешнийВидФормы();
	УстановитьУсловноеОформлениеСписка();

	// Результат не используется: при первом заполнении оповещать не о чем.
	ЗагрузитьДиалогиНаСервере();

	ОчиститьЛентуЧатаНаСервере();
	ОбновитьШапкуЧатаНаСервере();
	ОчиститьКарточкуПациентаНаСервере();
	ОбновитьОтметкуОбновленияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ИдетОбновлениеСписка = Ложь;
	ИдетОтправкаСообщения = Ложь;
	ЕстьЧерновикСообщения = Ложь;
	ЧерновикСообщения = "";
	НомерОперацииФормы = 0;
	ОбновитьДоступностьДействий();
	УправлятьАвтообновлением();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПолеПоискаПриИзменении(Элемент)

	ОбновитьДанныеФормы(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОтборДиалоговПриИзменении(Элемент)

	ОбновитьДанныеФормы(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПолеШаблонПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(ШаблонСообщения) Тогда
		Возврат;
	КонецЕсли;

	ТекстШаблона = ТекстШаблонаНаСервере(ШаблонСообщения);
	Если Не ПустаяСтрока(ТекстШаблона) Тогда
		ТекстОтвета = ?(ПустаяСтрока(ТекстОтвета), ТекстШаблона, ТекстОтвета + Символы.ПС + ТекстШаблона);
		ОбновитьЧерновикСообщения(ТекстОтвета);
	КонецЕсли;

	ШаблонСообщения = ПредопределенноеЗначение("Справочник.бит_омни_ШаблоныСообщений.ПустаяСсылка");
	ТекущийЭлемент = Элементы.ТекстОтвета;

КонецПроцедуры

&НаКлиенте
Процедура ТекстОтветаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)

	ОбновитьЧерновикСообщения(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ТекстОтветаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)

	ОбновитьЧерновикСообщения(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьАвтообновлениеОбработка(Команда)

	Автообновление = Не Автообновление;
	УправлятьАвтообновлением();

КонецПроцедуры

&НаКлиенте
Процедура ДиалогиПриАктивизацииСтроки(Элемент)

	Если ИдетОбновлениеСписка = Истина Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.КлючДиалога = КлючТекущегоДиалога Тогда
		Возврат;
	КонецЕсли;

	ОткрытьДиалогНаСервере(
		ТекущиеДанные.Контакт,
		ТекущиеДанные.Пациент,
		ТекущиеДанные.Бот,
		ТекущиеДанные.КлючДиалога);

	ОбновитьДоступностьДействий();

КонецПроцедуры

// Сам перенос выполняет журнал записи: расширение формы календаря переставляет
// заявку в выбранную ячейку. Здесь остается только обновить карточку пациента,
// когда заявка изменилась, - в том числе после переноса.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия <> "ЗаявкаИзменение" Или Не ЗначениеЗаполнено(ТекущийПациент) Тогда
		Возврат;
	КонецЕсли;

	ОбновитьДанныеФормы(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЛентаЧатаДокументСформирован(Элемент)

	ПрокрутитьЛентуВКонец(Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьДанныеФормы(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОбработка(Команда)

	// Текст редактирования хранится в клиентской переменной и не может быть
	// перезаписан запоздалым ответом серверного автообновления формы.
	Если ЕстьЧерновикСообщения Тогда
		ТекстОтвета = ЧерновикСообщения;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийКонтакт) Тогда
		Сообщить("Выберите диалог в списке слева.");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Сообщить("Введите текст сообщения.");
		Возврат;
	КонецЕсли;

	НомерОперацииФормы = НомерОперацииФормы + 1;
	ПриостановитьАвтообновлениеНаВремяОтправки();
	Попытка
		Результат = ОтправитьОтветНаСервере();
		Если Результат.Успех Тогда
			// Текст очищается только при успехе: иначе оператору пришлось бы набирать его заново.
			ТекстОтвета = "";
			ОбновитьЧерновикСообщения(ТекстОтвета);
		КонецЕсли;

		// После записи исходящего сообщения лента перестраивается до возобновления таймера.
		ОбновитьДанныеФормы(Истина);
		Если Не Результат.Успех Тогда
			ТекстОтвета = ЧерновикСообщения;
		КонецЕсли;
	Исключение
		ТекстОтвета = ЧерновикСообщения;
		ВозобновитьАвтообновлениеПослеОтправки();
		ВызватьИсключение;
	КонецПопытки;
	ВозобновитьАвтообновлениеПослеОтправки();

	Если Не Результат.Успех Тогда
		Сообщить(Результат.ОписаниеОшибки);
	КонецЕсли;

	ТекущийЭлемент = Элементы.ТекстОтвета;

КонецПроцедуры

&НаКлиенте
Процедура ВзятьВРаботуОбработка(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтакт) Тогда
		Сообщить("Выберите диалог в списке слева.");
		Возврат;
	КонецЕсли;

	ВзятьВРаботуНаСервере();
	ОбновитьДанныеФормы(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьДиалогОбработка(Команда)

	Если Не ЗначениеЗаполнено(ТекущийКонтакт) Тогда
		Сообщить("Выберите диалог в списке слева.");
		Возврат;
	КонецЕсли;

	ЗакрытьДиалогНаСервере();
	ОбновитьДанныеФормы(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНаПриемОбработка(Команда)

	Если Не ЗначениеЗаполнено(ТекущийПациент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите диалог в списке слева.");
		Возврат;
	КонецЕсли;

	ОткрытьКалендарьСНамерениемЗаписи(
		ПредопределенноеЗначение("Документ.Прием.ПустаяСсылка"),
		Новый Массив,
		ПлановаяДатаЗаписиНаСервере(),
		ОсновнойСотрудник,
		Неопределено);

КонецПроцедуры

// Открывает журнал записи календаря планирования и передает ему намерение записи.
//
// Календарь по этому оповещению заполняет клиента, документ-основание, отбор по врачу
// и период. Порядок вызова повторяет общую форму СводкаПоКлиенту.
//
// Переносимая заявка передается дополнительным ключом: типовой обработчик календаря
// его игнорирует, а расширение формы календаря по нему понимает, что вместо создания
// новой заявки нужно переставить существующую. Ссылку на заявку нельзя передать
// в ДокументЗаписи: реквизит календаря и реквизит Заявка.Основание типизированы
// ОпределяемымТипом.ОснованиеЗаписиВРасписание, куда Заявка не входит.
//
// Параметры:
//   ДокументЗаписи - ДокументСсылка - основание записи, пустой прием для новой записи.
//   Работы - Массив - номенклатура, которую нужно перенести в новую заявку.
//   ДатаЗаписи - Дата - день, на который открывается журнал.
//   Сотрудник - СправочникСсылка.Сотрудники - врач для отбора.
//   Специализация - СправочникСсылка - используется, если врач не задан.
//   ПереносимаяЗапись - ДокументСсылка.Заявка - заявка, которую нужно переставить.
&НаКлиенте
Процедура ОткрытьКалендарьСНамерениемЗаписи(ДокументЗаписи, Работы, ДатаЗаписи, Сотрудник, Специализация,
	ПереносимаяЗапись = Неопределено)

	ПараметрыЗаписи = Новый Структура("ДокументЗаписи, Клиент, Работы, ЛистОжидания",
		ДокументЗаписи, ТекущийПациент, Работы);
	ПараметрыЗаписи.Вставить("ДанныеЛистаОжидания",
		Новый Структура("ДатаНачала, ДатаОкончания, Сотрудник, Специализация",
			ДатаЗаписи, ДатаЗаписи, Сотрудник, Специализация));
	ПараметрыЗаписи.Вставить("бит_омни_ПереносимаяЗаявка",
		?(ПереносимаяЗапись = Неопределено,
			ПредопределенноеЗначение("Документ.Заявка.ПустаяСсылка"),
			ПереносимаяЗапись));

	КалендарьПланированияКлиент.ОткрытьАктивизироватьКалендарьПланирования();
	Оповестить("НамерениеЗаписиПоДокументу", ПараметрыЗаписи, ПараметрыЗаписи.ДокументЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиЗаписьОбработка(Команда)

	Если Не ЗначениеЗаполнено(БлижайшаяЗаявка) Тогда
		Возврат;
	КонецЕсли;

	// Журнал открывается на периоде и враче самой заявки, а сама заявка передается
	// как переносимая: выбрав ячейку, оператор переставит именно ее.
	ДанныеЗаявки = ДанныеЗаявкиДляПереносаНаСервере(БлижайшаяЗаявка);

	ОткрытьКалендарьСНамерениемЗаписи(
		ПредопределенноеЗначение("Документ.Прием.ПустаяСсылка"),
		ДанныеЗаявки.Работы,
		ДанныеЗаявки.ДатаНачала,
		ДанныеЗаявки.Сотрудник,
		ДанныеЗаявки.Специализация,
		БлижайшаяЗаявка);

КонецПроцедуры

&НаКлиенте
Процедура НапомнитьОЗаписиОбработка(Команда)

	Если Не ЗначениеЗаполнено(БлижайшаяЗаявка) Тогда
		Возврат;
	КонецЕсли;

	ТекстНапоминания = СтрШаблон(
		"Напоминаем о записи: %1. %2",
		Элементы.НадписьЗаписьДата.Заголовок,
		Элементы.НадписьЗапись.Заголовок);

	ТекстОтвета = ?(ПустаяСтрока(ТекстОтвета), ТекстНапоминания,
		ТекстОтвета + Символы.ПС + ТекстНапоминания);
	ОбновитьЧерновикСообщения(ТекстОтвета);
	ТекущийЭлемент = Элементы.ТекстОтвета;

КонецПроцедуры

&НаКлиенте
Процедура СсылкаЕщеИсторияНажатие(Элемент)

	Если Не ЗначениеЗаполнено(ТекущийПациент) Тогда
		Возврат;
	КонецЕсли;

	// У отчета нет собственной формы, поэтому открывается автогенерируемая.
	// Отбор передается через стандартный параметр, но состав параметров отчета
	// может отличаться, поэтому при отказе форма открывается без отбора.
	Попытка
		ПараметрыОтчета = Новый Структура;
		ПараметрыОтчета.Вставить("Отбор", Новый Структура("Клиент", ТекущийПациент));
		ОткрытьФорму("Отчет.ИсторияПосещенийКлиента.Форма", ПараметрыОтчета, ЭтаФорма);
	Исключение
		ОткрытьФорму("Отчет.ИсторияПосещенийКлиента.Форма", , ЭтаФорма);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуПациентаОбработка(Команда)

	Если Не ЗначениеЗаполнено(ТекущийПациент) Тогда
		Сообщить("Выберите диалог в списке слева.");
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(, ТекущийПациент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОжидания

&НаКлиенте
Процедура ОбработчикАвтообновления()

	Если Не Автообновление Тогда
		Возврат;
	КонецЕсли;

	Если ЕстьЧерновикСообщения Или ИдетОтправкаСообщения Тогда
		Возврат;
	КонецЕсли;

	Если ИдетОбновлениеСписка Тогда
		УправлятьАвтообновлением();
		Возврат;
	КонецЕсли;

	НомерОперацииПередОбновлением = НомерОперацииФормы;
	Попытка
		ОбновитьДанныеФормы(Ложь);
	Исключение
		УправлятьАвтообновлением();
		ВызватьИсключение;
	КонецПопытки;

	// Пока выполнялся серверный вызов, оператор мог начать ввод или отправить
	// сообщение. Запоздалый ответ не должен оставаться последним состоянием формы.
	Если НомерОперацииПередОбновлением <> НомерОперацииФормы
		И Не ИдетОтправкаСообщения
		И Не ЕстьЧерновикСообщения Тогда
		ОбновитьДанныеФормы(Истина);
	КонецЕсли;

	Если ЕстьЧерновикСообщения Тогда
		ТекстОтвета = ЧерновикСообщения;
	КонецЕсли;

	УправлятьАвтообновлением();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииКлиента

&НаКлиенте
Процедура ОбновитьЧерновикСообщения(ТекстЧерновика)

	ЧерновикСообщения = ТекстЧерновика;
	ЕстьЧерновикСообщения = Не ПустаяСтрока(СокрЛП(ЧерновикСообщения));
	НомерОперацииФормы = НомерОперацииФормы + 1;
	УправлятьАвтообновлением();

КонецПроцедуры

&НаКлиенте
Процедура ПриостановитьАвтообновлениеНаВремяОтправки()

	ИдетОтправкаСообщения = Истина;
	ОтключитьОбработчикОжидания("ОбработчикАвтообновления");

КонецПроцедуры

&НаКлиенте
Процедура ВозобновитьАвтообновлениеПослеОтправки()

	ИдетОтправкаСообщения = Ложь;
	УправлятьАвтообновлением();

КонецПроцедуры

&НаКлиенте
Процедура УправлятьАвтообновлением()

	ОтключитьОбработчикОжидания("ОбработчикАвтообновления");
	Если Автообновление
		И Не ИдетОтправкаСообщения
		И Не ЕстьЧерновикСообщения Тогда
		// Одноразовый обработчик исключает накопление параллельных тиков.
		// Следующий тик планируется только после завершения текущего.
		ПодключитьОбработчикОжидания("ОбработчикАвтообновления", ИнтервалАвтообновления(), Истина);
	КонецЕсли;

	ОбновитьИндикаторАвтообновления();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИндикаторАвтообновления()

	Если Автообновление Тогда
		Элементы.КнопкаАвтообновление.Заголовок = "Онлайн";
		Элементы.КнопкаАвтообновление.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;
	Иначе
		Элементы.КнопкаАвтообновление.Заголовок = "Офлайн";
		Элементы.КнопкаАвтообновление.Картинка = БиблиотекаКартинок.ОформлениеКругКрасный;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ИнтервалАвтообновления()

	Возврат 20;

КонецФункции

&НаКлиенте
Процедура ОбновитьДанныеФормы(ПерестроитьЛенту)

	ИдетОбновлениеСписка = Истина;
	Попытка
		НовыеСообщения = ОбновитьДанныеФормыНаСервере(ПерестроитьЛенту);
	Исключение
		ИдетОбновлениеСписка = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	ИдетОбновлениеСписка = Ложь;

	ОбновитьДоступностьДействий();
	ПоказатьОповещенияОНовыхСообщениях(НовыеСообщения);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОповещенияОНовыхСообщениях(НовыеСообщения)

	Для Каждого Оповещение Из НовыеСообщения Цикл
		ПоказатьОповещениеПользователя(
			"Новое сообщение в MAX",
			,
			Оповещение.Пациент + ": " + Оповещение.Текст,
			,
			СтатусОповещенияПользователя.Важное,
			Оповещение.Ключ);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьДействий()

	ДиалогВыбран = ЗначениеЗаполнено(ТекущийКонтакт);

	Элементы.ТекстОтвета.Доступность = ДиалогВыбран;
	Элементы.ОтправитьКнопка.Доступность = ДиалогВыбран;
	Элементы.КарточкаПациентаКнопка.Доступность = ЗначениеЗаполнено(ТекущийПациент);

КонецПроцедуры

&НаКлиенте
Процедура ПрокрутитьЛентуВКонец(Элемент)

	Попытка
		ДокументHTML = Элемент.Документ;
		Если ДокументHTML = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Якорь = ДокументHTML.getElementById("feedEnd");
		Если Якорь <> Неопределено Тогда
			Якорь.scrollIntoView();
		КонецЕсли;
	Исключение
		// Прокрутка средствами DOM доступна не на всех платформах: лента остается в начале,
		// сообщение об ошибке оператору не показывается.
		Возврат;
	КонецПопытки;

КонецПроцедуры

