#Область ПрограммныйИнтерфейс

// Хранилище шаблона остается прежним: массив рядов, содержащих объекты кнопок.
// Оригинал каждой кнопки нужен для сохранения дополнительных полей MAX.
Функция ТаблицаИзJSON(ТекстJSON) Экспорт
	Таблица = НоваяТаблица();
	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат Таблица;
	КонецЕсли;
	Ряды = ПрочитатьСтрокуJSON(ТекстJSON);
	Если ТипЗнч(Ряды) <> Тип("Массив") Тогда
		ВызватьИсключение "Кнопки MAX: ожидается массив рядов.";
	КонецЕсли;
	НомерРяда = 0;
	Для Каждого Ряд Из Ряды Цикл
		НомерРяда = НомерРяда + 1;
		Если ТипЗнч(Ряд) <> Тип("Массив") Тогда
			ВызватьИсключение "Кнопки MAX: каждый ряд должен быть массивом.";
		КонецЕсли;
		Для Каждого Кнопка Из Ряд Цикл
			Если ТипЗнч(Кнопка) <> Тип("Структура") Тогда
				ВызватьИсключение "Кнопки MAX: кнопка должна быть объектом JSON.";
			КонецЕсли;
			СтрокаТаблицы = Таблица.Добавить();
			СтрокаТаблицы.Ряд = НомерРяда;
			СтрокаТаблицы.Действие = СтроковоеПоле(Кнопка, "type");
			СтрокаТаблицы.Текст = СтроковоеПоле(Кнопка, "text");
			СтрокаТаблицы.Параметр = СтроковоеПоле(Кнопка, "payload");
			СтрокаТаблицы.URL = СтроковоеПоле(Кнопка, "url");
			СтрокаТаблицы.ИсходныйJSON = СтрокаJSON(Кнопка);
			Если СтрокаТаблицы.Действие = "callback" Тогда
				Если СтрокаТаблицы.Параметр = "appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_confirm" Тогда
					СтрокаТаблицы.Действие = "confirm";
				ИначеЕсли СтрокаТаблицы.Параметр = "appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_cancel" Тогда
					СтрокаТаблицы.Действие = "cancel";
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Таблица;
КонецФункции

Функция JSONИзТаблицы(Таблица) Экспорт
	Ряды = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.Ряд < 1 Или СтрокаТаблицы.Ряд > 100
			Или Цел(СтрокаТаблицы.Ряд) <> СтрокаТаблицы.Ряд Тогда
			ВызватьИсключение "Номер ряда кнопок должен быть целым числом от 1 до 100.";
		КонецЕсли;
		Пока Ряды.Количество() < СтрокаТаблицы.Ряд Цикл
			Ряды.Добавить(Новый Массив);
		КонецЦикла;
		Ряды[СтрокаТаблицы.Ряд - 1].Добавить(КнопкаИзСтроки(СтрокаТаблицы));
	КонецЦикла;
	Возврат СтрокаJSON(Ряды);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблица()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ряд", Новый ОписаниеТипов("Число"));
	Для Каждого Имя Из СтрРазделить("Действие,Текст,Параметр,URL,ИсходныйJSON", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Возврат Таблица;
КонецФункции

Функция СтроковоеПоле(ОбъектJSON, Имя)
	Значение = "";
	Если Не ОбъектJSON.Свойство(Имя, Значение) Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "Нестроковое поле кнопки: " + Имя + ". Используйте режим JSON.";
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция КнопкаИзСтроки(СтрокаТаблицы)
	Если ПустаяСтрока(СтрокаТаблицы.ИсходныйJSON) Тогда
		Кнопка = Новый Структура;
		ИсходныйТип = "";
	Иначе
		Кнопка = ПрочитатьСтрокуJSON(СтрокаТаблицы.ИсходныйJSON);
		ИсходныйТип = СтроковоеПоле(Кнопка, "type");
	КонецЕсли;
	ТипКнопки = СтрокаТаблицы.Действие;
	Параметр = СтрокаТаблицы.Параметр;
	Если ТипКнопки = "confirm" Или ТипКнопки = "cancel" Тогда
		Параметр = "appointment_<ИдентификаторЗаписи>_<ВерсияЗаписи>_" + ТипКнопки;
		ТипКнопки = "callback";
	КонецЕсли;
	Если ПустаяСтрока(ТипКнопки) Или ПустаяСтрока(СтрокаТаблицы.Текст) Тогда
		ВызватьИсключение "Заполните действие и текст каждой кнопки.";
	КонецЕсли;
	Если ТипКнопки = "callback" И ПустаяСтрока(Параметр) Тогда
		ВызватьИсключение "Укажите параметр callback или выберите действие подтверждения/отмены.";
	КонецЕсли;
	Если ТипКнопки = "link" И ПустаяСтрока(СтрокаТаблицы.URL) Тогда
		ВызватьИсключение "Укажите URL для кнопки-ссылки.";
	КонецЕсли;
	Если ТипКнопки <> ИсходныйТип Тогда
		Кнопка.Удалить("payload");
		Кнопка.Удалить("url");
	КонецЕсли;
	Кнопка.Вставить("type", ТипКнопки);
	Кнопка.Вставить("text", СтрокаТаблицы.Текст);
	Если ТипКнопки = "callback" Или ТипКнопки = "open_app" Тогда
		Если Не ПустаяСтрока(Параметр) Или Кнопка.Свойство("payload") Тогда
			Кнопка.Вставить("payload", Параметр);
		КонецЕсли;
	ИначеЕсли ТипКнопки = "link" Тогда
		Кнопка.Вставить("url", СтрокаТаблицы.URL);
	ИначеЕсли ТипКнопки <> "request_contact" Тогда
		// Неизвестный тип: сохраняем его и дополнительные поля без преобразования.
		Если Не ПустаяСтрока(Параметр) Или Кнопка.Свойство("payload") Тогда
			Кнопка.Вставить("payload", Параметр);
		КонецЕсли;
		Если Не ПустаяСтрока(СтрокаТаблицы.URL) Или Кнопка.Свойство("url") Тогда
			Кнопка.Вставить("url", СтрокаТаблицы.URL);
		КонецЕсли;
	КонецЕсли;
	Возврат Кнопка;
КонецФункции

Функция ПрочитатьСтрокуJSON(ТекстJSON)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

Функция СтрокаJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти
