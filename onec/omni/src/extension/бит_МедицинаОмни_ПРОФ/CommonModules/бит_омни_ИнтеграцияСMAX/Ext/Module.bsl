Функция ОсновнойБотMAX()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_омни_Боты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.бит_омни_Боты КАК бит_омни_Боты
	|ГДЕ
	|	бит_омни_Боты.Использовать
	|	И НЕ бит_омни_Боты.ПометкаУдаления
	|	И бит_омни_Боты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
	|УПОРЯДОЧИТЬ ПО
	|	бит_омни_Боты.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.бит_омни_Боты.ПустаяСсылка();

