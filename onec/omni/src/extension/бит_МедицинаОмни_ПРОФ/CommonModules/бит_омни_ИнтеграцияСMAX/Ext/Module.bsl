#Область ПрограммныйИнтерфейс

Функция ИнформацияОБоте(Токен) Экспорт

	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(Токен);

	Запрос = Новый HTTPЗапрос("/me", Заголовки);
	Ответ = Соединение.Получить(Запрос);

	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Код ошибки: %1
														|Текст ошибки: %2", Ответ.КодСостояния, ДанныеОтвета.Текст));
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДанныеОтвета.Тело;

КонецФункции

// Отправляет текстовое сообщение через бота в мессенджер MAX с возможностью указания форматирования.
//
// Параметры:
//   ТекстСообщения - Строка - текст отправляемого сообщения
//   Получатель - - получатель сообщения
//     - Массив из СправочникСсылка.бит_омни_Контакты, СправочникСсылка.Сотрудники, СправочникСсылка.Клиенты  
//     - СправочникСсылка.бит_омни_Контакты
//     - СправочникСсылка.Сотрудники
//     - СправочникСсылка.Клиенты
//   Бот - СправочникСсылка.бит_омни_Боты - идентификатор бота, от имени которого отправляется сообщение
//   Формат - Строка - форматирование текста сообщения (например, "markdown", "html")
//           - Неопределено - используется форматирование по умолчанию
//
// Возвращаемое значение:
//   см. бит_омни_ИнтеграцияСMAX.ОтправитьСообщение
Функция ОтправитьТекстовоеСообщение(ТекстСообщения, Получатель, Бот, Формат = Неопределено,
	ВидОтправителя = Неопределено, Пользователь = Неопределено) Экспорт

	ПараметрыСообщения = Новый Структура("text", ТекстСообщения);

	Если ЗначениеЗаполнено(Формат) Тогда
		ПараметрыСообщения.Вставить("format", Формат);
	КонецЕсли;

	Возврат ОтправитьСообщение(ПараметрыСообщения, Получатель, Бот, , ВидОтправителя, Пользователь);

КонецФункции

// Отправляет сообщение через интеграцию с MAX одному или нескольким получателям
//
// Параметры:
//   ПараметрыСообщения - Структура, СправочникСсылка.бит_омни_ШаблоныСообщений - параметры сообщения (зависят от типа сообщения)
//   Получатель - Строка, Массив из Строка - идентификатор получателя или массив получателей
//   Бот - Строка - идентификатор бота
//   Контекст - Структура, Неопределено - дополнительные параметры для отправки сообщения
//
// Возвращаемое значение:
//   см. бит_омни_ИнтеграцияСMAX.ОтправитьСообщениеПолучателю
Функция ОтправитьСообщение(ПараметрыСообщения, Получатель, Бот, Контекст = Неопределено,
	ВидОтправителя = Неопределено, Пользователь = Неопределено) Экспорт

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не найден бот MAX'"));
	КонецЕсли;

	Получатели = ПолучателиСообщенияMAX(Получатель);
	Если ТипЗнч(Получатель) = Тип("Массив") Тогда

		РезультатыОтправки = Новый Массив;
		Для Каждого ТекущийПолучатель Из Получатели Цикл
			РезультатыОтправки.Добавить(ОтправитьСообщениеПолучателю(ПараметрыСообщения, ТекущийПолучатель, Бот,
				ДанныеБота, Контекст, ВидОтправителя, Пользователь));
		КонецЦикла;

		Возврат РезультатыОтправки;

	КонецЕсли;

	Если Получатели.Количество() = 0 Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не определен получатель сообщения MAX'"));
	КонецЕсли;

	Возврат ОтправитьСообщениеПолучателю(ПараметрыСообщения, Получатели[0], Бот, ДанныеБота, Контекст,
		ВидОтправителя, Пользователь);

КонецФункции

// Подготовка внутри транзакции записи объекта: только разрешение адресата и рендер.
// JSON является снимком, токены и заголовки авторизации в него не добавляются.
Функция ПодготовитьСообщенияДляОчереди(Шаблон, Получатели, Бот, Контекст) Экспорт

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда ВызватьИсключение "Не найден бот MAX для очереди."; КонецЕсли;
	Если ТипЗнч(Получатели) = Тип("Массив") Тогда
		ИсходныеПолучатели = Получатели;
	Иначе
		ИсходныеПолучатели = Новый Массив;
		ИсходныеПолучатели.Добавить(Получатели);
	КонецЕсли;
	Результат = Новый Массив;
	Контакты = Новый Соответствие;
	Для Каждого Получатель Из ИсходныеПолучатели Цикл
		Если Получатель = Неопределено Или Получатель = Null Тогда
			ВызватьИсключение "Не определен получатель сообщения MAX для очереди.";
		КонецЕсли;
		Контакт = ПолучательСообщенияMAX(Получатель, Бот);
		Если ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или НЕ ЗначениеЗаполнено(Контакт) Тогда
			// Отсутствие MAX у обычного пациента не является ошибкой записи объекта.
			Продолжить;
		КонецЕсли;
		Если Контакт.ПометкаУдаления Или Контакт.Заблокирован Или Контакт.Бот <> Бот
			Или Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Или Контакт.Идентификатор <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Контакт.Получатель) = Тип("СправочникСсылка.Клиенты")
			И ЗначениеЗаполнено(Контакт.Получатель) И Контакт.Получатель.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Если Контакты.Получить(Контакт) <> Неопределено Тогда Продолжить; КонецЕсли;
		Адресат = ПараметрыАдресата(Контакт, Бот);
		Если Адресат = Неопределено Тогда Продолжить; КонецЕсли;
		Параметры = ПараметрыСообщенияMAX(Шаблон, Контакт, Контекст, ДанныеБота);
		Тело = ТелоСообщенияMAX(Параметры);
		Если Тело = Неопределено Тогда ВызватьИсключение "Не заполнены текст или вложения сообщения MAX."; КонецЕсли;
		// Только поля сообщения. Служебные ключи из произвольной структуры не сохраняются.
		Снимок = Новый Структура;
		Для Каждого Имя Из СтрРазделить("text,format,attachments,notify,disable_link_preview", ",") Цикл
			ЗначениеПоля = Неопределено;
			Если Тело.Свойство(Имя, ЗначениеПоля) Тогда Снимок.Вставить(Имя, ЗначениеПоля); КонецЕсли;
		КонецЦикла;
		Адресат.Вставить("ИдентификаторСообщенияКлиента", Строка(Новый УникальныйИдентификатор));
		Адресат.Вставить("ОтпечатокПолучателя", ОтпечатокПолучателяКонтактаMAX(Контакт));
		Результат.Добавить(Новый Структура("Контакт,ТелоJSON,АдресатJSON",
			Контакт, СтруктураВJSON(Снимок), СтруктураВJSON(Адресат)));
		Контакты.Вставить(Контакт, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Единственная попытка отправки сохраненного снимка. Никаких повторов, перерендера
// или нового поиска получателя. Вызывать после фиксации захвата очереди, вне транзакции.
Функция ОтправитьПодготовленноеСообщение(Бот, Контакт, ТелоJSON, АдресатJSON) Экспорт

	Результат = Новый Структура("Состояние,ИдентификаторСообщения,ОписаниеОшибки,КодHTTP", "Ошибка", "", "", 0);
	КодОтвета = 0;
	Попытка
		Тело = JSONВСтруктуру(ТелоJSON);
		Адресат = JSONВСтруктуру(АдресатJSON);
		ПроверитьСнимокОчередиMAX(Бот, Контакт, Тело, Адресат);
		ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
		ЧерезVDS = ИспользоватьОбменЧерезVDS();
		Если ДанныеБота = Неопределено Или (НЕ ЧерезVDS И ПустаяСтрока(ДанныеБота.Токен)) Тогда
			ВызватьИсключение "Не настроен бот MAX для отправки.";
		КонецЕсли;
	Исключение
		Результат.ОписаниеОшибки = "Предварительная проверка снимка, контакта или настроек MAX не пройдена. Отправка не выполнялась.";
		Возврат Результат;
	КонецПопытки;
	Попытка
		Если ЧерезVDS Тогда
			// Оболочка транспорта формируется из сохраненного адреса, не из карточки контакта.
			Тело.Вставить(Адресат.Параметр, Адресат.Значение);
			Тело.Вставить("client_message_id", Адресат.ИдентификаторСообщенияКлиента);
			Ответ = ОтправитьСообщениеЧерезVDS(Тело, Адресат);
		Иначе
			Ответ = ОтправитьСообщениеНапрямуюВMAX(Тело, Адресат, ДанныеБота.Токен);
		КонецЕсли;
		КодОтвета = Ответ.КодСостояния;
		ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
		Результат = КлассифицироватьОтветОчередиMAX(КодОтвета, ДанныеОтвета.Тело);
	Исключение
		Результат.Состояние = "Неопределено";
		Результат.КодHTTP = КодОтвета;
		Результат.ОписаниеОшибки = "Нет однозначного ответа MAX/VDS. Сообщение могло быть доставлено; автоматический повтор запрещен.";
	КонецПопытки;
	Попытка
		ИдентификаторИстории = ?(ПустаяСтрока(Результат.ИдентификаторСообщения),
			Адресат.ИдентификаторСообщенияКлиента, Результат.ИдентификаторСообщения);
		Вложения = ЗначениеСвойства(Тело, "attachments");
		ЗаписатьСообщениеЧатаMAX(ИдентификаторИстории, Контакт, Бот, Ложь,
			СтроковоеСвойство(Тело, "text"), ВидСообщенияMAX(Вложения), НСтр("ru='Клиника'"),
			Результат.Состояние, Результат.ОписаниеОшибки, JSONВложенийMAX(Вложения));
	Исключение
		// Подтвержденный MID не теряется из-за ошибки записи истории: нельзя повторять доставку.
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + " Не удалось записать историю чата.";
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Чистая классификация HTTP-ответа, экспорт для регрессионных тестов без сети.
Функция КлассифицироватьОтветОчередиMAX(КодСостояния, ТелоОтвета) Экспорт

	Результат = Новый Структура("Состояние,ИдентификаторСообщения,ОписаниеОшибки,КодHTTP", "Неопределено", "", "", КодСостояния);
	Если ЯвныйОтказОчередиMAX(КодСостояния) Тогда
		Результат.Состояние = "Ошибка";
		Результат.ОписаниеОшибки = "Отказ в отправке: HTTP " + Строка(КодСостояния) + ".";
		Возврат Результат;
	КонецЕсли;
	Результат.ОписаниеОшибки = "Результат отправки не подтвержден (HTTP " + Строка(КодСостояния) + "). Автоматический повтор запрещен.";
	Если КодСостояния < 200 Или КодСостояния >= 300 Или ТипЗнч(ТелоОтвета) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	ОтветMAX = ТелоОтвета;
	Если ТелоОтвета.Свойство("results") Или ТелоОтвета.Свойство("sent") Или ТелоОтвета.Свойство("failed") Тогда
		Результаты = ЗначениеСвойства(ТелоОтвета, "results");
		Если ТипЗнч(Результаты) <> Тип("Массив") Тогда Возврат Результат; КонецЕсли;
		Если Результаты.Количество() <> 1 Тогда Возврат Результат; КонецЕсли;
		Отправка = Результаты[0];
		Если ТипЗнч(Отправка) <> Тип("Структура") Тогда Возврат Результат; КонецЕсли;
		Если ЗначениеСвойства(ТелоОтвета, "ok") = Ложь И ЗначениеСвойства(ТелоОтвета, "sent") = 0
			И ЗначениеСвойства(ТелоОтвета, "failed") = 1 И ЗначениеСвойства(Отправка, "ok") = Ложь Тогда
			ТекстОшибки = СтроковоеСвойство(Отправка, "error");
			ЧастиОшибки = СтрРазделить(ТекстОшибки, ":", Истина);
			Если ЧастиОшибки.Количество() >= 2 И ЧастиОшибки[0] = "max_api_request_failed" Тогда
				Для Каждого КодОтказа Из СтрРазделить("400,401,403,404,422,429", ",") Цикл
					Если ЧастиОшибки[1] = КодОтказа Тогда
						Результат.Состояние = "Ошибка";
						Результат.ОписаниеОшибки = "MAX отклонил сообщение: HTTP " + КодОтказа + ".";
						Возврат Результат;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
		Если ЗначениеСвойства(ТелоОтвета, "ok") <> Истина Или ЗначениеСвойства(ТелоОтвета, "sent") <> 1
			Или ЗначениеСвойства(ТелоОтвета, "failed") <> 0 Или ЗначениеСвойства(Отправка, "ok") <> Истина Тогда
			Возврат Результат;
		КонецЕсли;
		ОтветMAX = ЗначениеСвойства(Отправка, "max_response");
	КонецЕсли;
	Если ЗначениеСвойства(ОтветMAX, "success") = Ложь Или ЗначениеСвойства(ОтветMAX, "ok") = Ложь Тогда
		Возврат Результат;
	КонецЕсли;
	СообщениеОтвета = ЗначениеСвойства(ОтветMAX, "message", ОтветMAX);
	ТелоСообщенияОтвета = ЗначениеСвойства(СообщениеОтвета, "body", СообщениеОтвета);
	Идентификатор = ЗначениеСвойства(ТелоСообщенияОтвета, "mid");
	Если ТипЗнч(Идентификатор) = Тип("Строка") И НЕ ПустаяСтрока(Идентификатор) Тогда
		Результат.Состояние = "Отправлено";
		Результат.ИдентификаторСообщения = Идентификатор;
		Результат.ОписаниеОшибки = "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОтправитьСообщениеПолучателю(ПараметрыСообщения, Получатель, Бот, ДанныеБота, Контекст,
	ВидОтправителя = Неопределено, Пользователь = Неопределено)

	ПолучательСообщения = ПолучательСообщенияMAX(Получатель, Бот);
	Адресат = ПараметрыАдресата(ПолучательСообщения, Бот);
	Если Адресат = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не определен получатель сообщения MAX'"));
	КонецЕсли;

	ПараметрыТекущегоСообщения = ПараметрыСообщенияMAX(
		ПараметрыСообщения, ПолучательСообщения, Контекст, ДанныеБота);
	ТелоСообщения = ТелоСообщенияMAX(ПараметрыТекущегоСообщения);
	Если ТелоСообщения = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не заполнен текст или вложения сообщения MAX'"));
	КонецЕсли;

	Если ИспользоватьОбменЧерезVDS() Тогда
		Ответ = ОтправитьСообщениеЧерезVDS(ТелоСообщения, Адресат);
	Иначе
		Ответ = ОтправитьСообщениеНапрямуюВMAX(ТелоСообщения, Адресат, ДанныеБота.Токен);
	КонецЕсли;
	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);

	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.ОшибкаОтправки", УровеньЖурналаРегистрации.Ошибка, , , СтрШаблон(
			"Код ответа MAX: %1. Тело ответа: %2", Ответ.КодСостояния, ДанныеОтвета.Текст));
	КонецЕсли;

	ЗаписатьИсходящееСообщениеMAX(
		ТелоСообщения, ПолучательСообщения, Бот, ДанныеОтвета.Тело, Ответ.КодСостояния, ДанныеОтвета.Текст,
		ВидОтправителя, Пользователь);

	Возврат ДанныеОтвета.Тело;

КонецФункции

Процедура ВыполнитьРегламентныйОбменСVDS() Экспорт

	Если Не ИспользоватьОбменЧерезVDS() Тогда
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.VDS.Polling", УровеньЖурналаРегистрации.Информация, , ,
			НСтр("ru='VDS обмен MAX не настроен: пропуск регламентного задания'"));
		Возврат;
	КонецЕсли;

	Бот = ОсновнойБотMAX();
	Если Бот.Пустая() Тогда
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.VDS.Polling", УровеньЖурналаРегистрации.Предупреждение, , ,
			НСтр("ru='Не найден активный MAX-бот для обработки входящих сообщений'"));
		Возврат;
	КонецЕсли;

	Попытка
		// Проверка протокола не затрагивает очередь старого backend с удаляющей выдачей.
		Возможности = ВыполнитьЗапросVDS("/api/v1/onec/capabilities");
		Если ЗначениеСвойства(Возможности, "incoming_ack") <> Истина
			Или ЗначениеСвойства(Возможности, "callback_answer") <> Истина Тогда
			ВызватьИсключение "Сначала обновите backend VDS: необходим протокол claim/ACK и ответ на callback.";
		КонецЕсли;
		Для НомерСообщения = 1 По ЛимитPollingVDS() Цикл
			Ответ = ПолучитьВходящиеСообщенияЧерезVDS(?(НомерСообщения = 1, ОжиданиеLongPollingVDS(), 0));
			ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
			Если Ответ.КодСостояния <> 200 Тогда
				ВызватьИсключение СтрШаблон("Ошибка получения очереди VDS: HTTP %1", Ответ.КодСостояния);
			КонецЕсли;
			Сообщения = ЗначениеСвойства(ДанныеОтвета.Тело, "messages");
			Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
				ВызватьИсключение "Некорректный формат очереди VDS.";
			КонецЕсли;
			Если Сообщения.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			СообщениеОчереди = Сообщения[0];
			Квитанция = СтроковоеСвойство(СообщениеОчереди, "receipt");
			Если ПустаяСтрока(Квитанция) Тогда
				ВызватьИсключение "Backend не вернул квитанцию claim/ACK.";
			КонецЕсли;
			Попытка
				Обновление = ЗначениеСвойства(СообщениеОчереди, "update");
				Если ТипЗнч(Обновление) <> Тип("Структура") Тогда
					ВызватьИсключение "Некорректное событие MAX в очереди.";
				КонецЕсли;
				ОбработатьОбновление(Обновление, Бот);
				Квитанции = Новый Массив;
				Квитанции.Добавить(Квитанция);
				Подтверждение = ВыполнитьЗапросVDS("/api/v1/onec/messages/incoming/ack",
					Новый Структура("receipts", Квитанции));
				Если ЗначениеСвойства(Подтверждение, "acknowledged") <> 1 Тогда
					ВызватьИсключение "Квитанция VDS просрочена: событие будет доставлено повторно.";
				КонецЕсли;
			Исключение
				// Без ACK событие вернётся после lease; другие сообщения продолжаем обрабатывать.
				ЗаписьЖурналаРегистрации("ОМНИ.MAX.VDS.Processing",
					УровеньЖурналаРегистрации.Ошибка, , ,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Если ЗначениеСвойства(ДанныеОтвета.Тело, "remaining") = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

	Исключение
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.VDS.Polling", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

КонецПроцедуры

Функция ОбработатьWebhook(HTTPЗапрос, Бот) Экспорт

	Попытка
		Обновление = бит_омни_ИнтеграцияСервер.ТелоЗапросаВСтруктуру(HTTPЗапрос);
		Если ТипЗнч(Обновление) <> Тип("Структура") Тогда
			Возврат бит_омни_ИнтеграцияСервер.ОтветСОшибкой("invalid_max_update");
		КонецЕсли;

		ОбработатьОбновление(Обновление, Бот);

		Возврат бит_омни_ИнтеграцияСервер.УспешныйОтвет(Новый Структура("success", Истина));

	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфоОшибки);

		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.Webhook", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

		Возврат бит_омни_ИнтеграцияСервер.ОтветСОшибкой("max_webhook_error", 500, ТекстОшибки);
	КонецПопытки;

КонецФункции

// Телефон берем только из подписанного MAX контакта владельца диалога.
// История используется также для обращений, полученных до этой версии расширения.
Функция ПодтвержденныйТелефонКонтактаMAX(Контакт) Экспорт

	Если ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или Контакт.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Бот = Контакт.Бот;
	Если Не ЗначениеЗаполнено(Бот) Или Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 20
	| История.ДанныеВложений КАК ДанныеВложений
	|ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
	|ГДЕ История.Контакт = &Контакт И История.Бот = &Бот
	| И История.Входящее И История.ВидСообщения = &Вид
	|УПОРЯДОЧИТЬ ПО История.Период УБЫВ";
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Вид", "contact");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Вложения = JSONВСтруктуру(Выборка.ДанныеВложений);
		Исключение
			Продолжить;
		КонецПопытки;
		Если ТипЗнч(Вложения) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вложение Из Вложения Цикл
			Если СтроковоеСвойство(Вложение, "type") <> "contact" Тогда
				Продолжить;
			КонецЕсли;
			Данные = ЗначениеСвойства(Вложение, "payload");
			Аккаунт = ЗначениеСвойства(Данные, "max_info");
			Если СтрокаИдентификатора(ЗначениеСвойства(Аккаунт, "user_id")) <> СтрокаИдентификатора(Контакт.Идентификатор) Тогда
				Продолжить;
			КонецЕсли;
			VCF = ЗначениеСвойства(Данные, "vcf_info", "");
			Если ТипЗнч(VCF) <> Тип("Строка") Или ПустаяСтрока(VCF) Тогда
				Продолжить;
			КонецЕсли;
			VCF = НормализоватьVCFMAX(VCF);
			Хеш = НРег(СтроковоеСвойство(Данные, "hash"));
			Если Не ПустаяСтрока(Хеш) И ХешиРавныMAX(Хеш, HMACSHA256MAX(Бот.Токен, VCF)) Тогда
				Возврат НомерТелефонаИзVCFMAX(VCF);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

// Привязка по осознанному выбору оператора, без автоматического создания пациента.
Процедура ПривязатьКонтактКПациентуMAX(Контакт, Пациент, Бот) Экспорт

	Если ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или Не ЗначениеЗаполнено(Контакт)
		Или ТипЗнч(Пациент) <> Тип("СправочникСсылка.Клиенты") Или Не ЗначениеЗаполнено(Пациент) Тогда
		ВызватьИсключение "Необходимо выбрать контакт MAX и пациента.";
	КонецЕсли;
	Если Пациент.ПометкаУдаления Или Пациент.ЭтоГруппа Тогда
		ВызватьИсключение "Нельзя привязать контакт к группе или удаленному пациенту.";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_омни_Контакты");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Контакт);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		ОбъектКонтакта = Контакт.ПолучитьОбъект();
		Если ОбъектКонтакта.ПометкаУдаления Или ОбъектКонтакта.Бот <> Бот
			Или ОбъектКонтакта.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
			ВызватьИсключение "Контакт диалога изменился. Обновите список и повторите выбор.";
		КонецЕсли;
		Если ЗначениеЗаполнено(ОбъектКонтакта.Получатель) И ОбъектКонтакта.Получатель <> Пациент Тогда
			ВызватьИсключение "Контакт уже привязан к другому пациенту. Существующая связь не изменена.";
		КонецЕсли;
		ОбъектКонтакта.Получатель = Пациент;
		ОбъектКонтакта.ОбменДанными.Загрузка = Истина;
		ОбъектКонтакта.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
		ОбъектКонтакта.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ОбработатьОбновление(Обновление, Бот) Экспорт

	ТипОбновления = СтроковоеСвойство(Обновление, "update_type");

	Если ТипОбновления = "message_created" Тогда
		ОбработатьСозданиеСообщения(Обновление, Бот);
	ИначеЕсли ТипОбновления = "bot_started" Тогда
		ОбработатьЗапускБота(Обновление, Бот);
	ИначеЕсли ТипОбновления = "bot_stopped" Тогда
		ОбработатьОстановкуБота(Обновление, Бот);
	ИначеЕсли ТипОбновления = "message_callback" Тогда
		ОбработатьCallback(Обновление, Бот);
	Иначе
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Событие MAX пропущено'"));
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьКонтактПоUser(User, Бот) Экспорт

	Если ТипЗнч(User) <> Тип("Структура") Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	ИдентификаторПользователя = ЗначениеСвойства(User, "user_id");
	Если Не ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	Контакт = НайтиКонтактMAX(ИдентификаторПользователя, ДанныеБота.Ссылка);
	Если Не Контакт.Пустая() Тогда
		Возврат Контакт;
	КонецЕсли;

	КонтактОбъект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
	КонтактОбъект.Наименование = Лев(ПредставлениеПользователяMAX(User), 25);
	КонтактОбъект.Идентификатор = ИдентификаторПользователя;
	КонтактОбъект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
	КонтактОбъект.Бот = ДанныеБота.Ссылка;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();

	Возврат КонтактОбъект.Ссылка;

КонецФункции

#КонецОбласти

#Область ОбработкаВходящихСобытий

Процедура ОбработатьСозданиеСообщения(Обновление, Бот)

	Сообщение = ЗначениеСвойства(Обновление, "message");
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Отправитель = ЗначениеСвойства(Сообщение, "sender");
	Если ЗначениеСвойства(Отправитель, "is_bot", Ложь) Тогда
		Возврат;
	КонецЕсли;

	Контакт = ПолучитьКонтактПоUser(Отправитель, Бот);
	ТекстСообщения = ТекстСообщенияMAX(Сообщение);

	ЗаписатьВходящееСообщениеMAX(Сообщение, Контакт, Бот);

	Если ЭтоКомандаMAX(ТекстСообщения) Тогда
		ОбработатьКоманду(Сообщение, Контакт, Бот, КомандаИзТекста(ТекстСообщения));
	Иначе
		ОбработатьСообщение(Сообщение, Контакт, Бот);
	КонецЕсли;

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Получено сообщение MAX'"));

КонецПроцедуры

Процедура ОбработатьЗапускБота(Обновление, Бот)

	User = ЗначениеСвойства(Обновление, "user");
	Контакт = ПолучитьКонтактПоUser(User, Бот);

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	УстановитьБлокировкуКонтакта(Контакт, Ложь);

	// Событие запуска тоже является обращением, даже до получения телефона.
	СообщениеЗапуска = Новый Структура("sender", User);
	ИдентификаторЗапуска = "bot_started:" + СтроковоеСвойство(Обновление, "timestamp");
	СообщениеЗапуска.Вставить("body", Новый Структура("text, mid",
		"Клиент начал диалог с ботом", ИдентификаторЗапуска));
	ЗаписатьВходящееСообщениеMAX(СообщениеЗапуска, Контакт, Бот);

	Если Не ЗначениеЗаполнено(Контакт.Получатель)
		И ОтправитьСтандартноеСообщениеMAX("MAX_WELCOME", Контакт, Бот)
	Тогда
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Отправлено приветствие MAX'"));
		Возврат;
	КонецЕсли;

	Сообщение = Новый Структура;
	Сообщение.Вставить("sender", User);
	Сообщение.Вставить("timestamp", ЗначениеСвойства(Обновление, "timestamp"));

	Payload = СтроковоеСвойство(Обновление, "payload");
	Сообщение.Вставить("body", Новый Структура("text, mid", "/start " + Payload, СтроковоеСвойство(Обновление,
		"timestamp")));

	ОбработатьКоманду(Сообщение, Контакт, Бот, "/start");

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Пользователь запустил бота MAX'"));

КонецПроцедуры

Процедура ОбработатьОстановкуБота(Обновление, Бот)

	Контакт = ПолучитьКонтактПоUser(ЗначениеСвойства(Обновление, "user"), Бот);
	Если Не Контакт.Пустая() Тогда
		УстановитьБлокировкуКонтакта(Контакт, Истина);
	КонецЕсли;

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Пользователь остановил бота MAX'"));

КонецПроцедуры

Процедура ОбработатьCallback(Обновление, Бот)

	Callback = ЗначениеСвойства(Обновление, "callback");
	Если Лев(СтроковоеСвойство(Callback, "payload"), 12) = "appointment_" Тогда
		ОбработатьКомандуЗаписиMAX(Callback, Бот);
		Возврат;
	КонецЕсли;

	Обработчик = бит_омни_ИнтеграцияСMAXПовтИсп.ОбработчикКоманды("callback");
	Если ПустаяСтрока(Обработчик) Тогда
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Callback MAX пропущен'"));
		Возврат;
	КонецЕсли;

	ВыполнитьОбработчик(Обработчик, Обновление, Справочники.бит_омни_Контакты.ПустаяСсылка(), Бот);

КонецПроцедуры

// Строгий разбор внешних данных; ни имя метода, ни BSL-код из payload не исполняются.
Функция РазобратьКомандуЗаписиMAX(Команда) Экспорт

	Если ТипЗнч(Команда) <> Тип("Строка") Или СтрДлина(Команда) > 100 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Части = СтрРазделить(Команда, "_", Истина);
	Если Части.Количество() <> 4 Или Части[0] <> "appointment"
		Или (Части[3] <> "confirm" И Части[3] <> "cancel")
		Или СтрДлина(Части[1]) <> 36 Или СтрДлина(Части[2]) <> 14 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Позиция = 1 По 14 Цикл
		Если СтрНайти("0123456789", Сред(Части[2], Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Части[1]);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Новый Структура("Заявка,Версия,Действие",
		Документы.Заявка.ПолучитьСсылку(Идентификатор), Части[2], Части[3]);

КонецФункции

Процедура ОбработатьКомандуЗаписиMAX(Callback, Бот)

	Результат = Новый Структура("Успех,Текст", Ложь,
		"Не удалось применить действие. Возможно, кнопка устарела. Обратитесь в клинику.");
	Параметры = РазобратьКомандуЗаписиMAX(СтроковоеСвойство(Callback, "payload"));
	Пользователь = ЗначениеСвойства(Callback, "user");
	ИдентификаторMAX = СтрокаИдентификатора(ЗначениеСвойства(Пользователь, "user_id"));
	// Реквизит контакта числовой; строковый параметр запроса не найдёт числовой ID.
	ЧисловойИдентификатор = 0;
	Если Не ПустаяСтрока(ИдентификаторMAX) Тогда
		Попытка
			ЧисловойИдентификатор = Число(ИдентификаторMAX);
		Исключение
			ИдентификаторMAX = "";
		КонецПопытки;
	КонецЕсли;
	Если Параметры <> Неопределено И Не ПустаяСтрока(ИдентификаторMAX) Тогда
		// Не создаём контакт по callback. При неоднозначной привязке отказываем.
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 2 Контакты.Ссылка КАК Ссылка
			|ИЗ Справочник.бит_омни_Контакты КАК Контакты
			|ГДЕ Контакты.Идентификатор = &Идентификатор
			| И Контакты.Бот = &Бот
			| И Контакты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
			| И НЕ Контакты.ПометкаУдаления");
		Запрос.УстановитьПараметр("Идентификатор", ЧисловойИдентификатор);
		Запрос.УстановитьПараметр("Бот", Бот);
		Контакты = Запрос.Выполнить().Выгрузить();
		Если Контакты.Количество() = 1 Тогда
			Результат = Документы.Заявка.бит_омни_ОбработатьCallbackMAX(
				Параметры.Заявка, Контакты[0].Ссылка, Бот, ИдентификаторMAX,
				Параметры.Версия, Параметры.Действие);
		КонецЕсли;
	КонецЕсли;

	// Бизнес-транзакция уже завершена. Сбой ответа MAX не отменяет изменение записи.
	Попытка
		Если Не ИспользоватьОбменЧерезVDS() Тогда
			ВызватьИсключение "Ответы на кнопки записи требуют обмена через VDS.";
		КонецЕсли;
		Сообщение = Новый Структура("text,attachments,notify", Результат.Текст, Новый Массив, Ложь);
		ВыполнитьЗапросVDS("/api/v1/onec/callbacks/answer", Новый Структура(
			"callback_id,message", СтроковоеСвойство(Callback, "callback_id"), Сообщение));
	Исключение
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Callback.Answer",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Действие обработано, но MAX не подтвердил обновление сообщения. Проверьте доступность VDS/MAX.");
	КонецПопытки;

КонецПроцедуры

Процедура ОбработатьСообщение(Сообщение, Контакт, Бот)

	ТелоСообщения = ЗначениеСвойства(Сообщение, "body");
	Вложения = ЗначениеСвойства(ТелоСообщения, "attachments");
	Если ТипЗнч(Вложения) = Тип("Массив") И Вложения.Количество() Тогда
		ПервоеВложение = Вложения.Получить(0);
		Если ПервоеВложение.type = "contact" Тогда
			ИнформацияОКонтакте = ЗначениеСвойства(ПервоеВложение, "payload");
			ОбработатьПолученныйКонтактMAX(ИнформацияОКонтакте, Контакт, Бот);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Обработчик = бит_омни_ИнтеграцияСMAXПовтИсп.ОбработчикСообщения();
	Если ПустаяСтрока(Обработчик) Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьОбработчик(Обработчик, Сообщение, Контакт, Бот);

КонецПроцедуры

Процедура ОбработатьКоманду(Сообщение, Контакт, Бот, Команда, Параметры = Неопределено)

	ИмяКоманды = СокрЛП(Команда);
	Если Лев(ИмяКоманды, 1) = "/" Тогда
		ИмяКоманды = Сред(ИмяКоманды, 2);
	КонецЕсли;

	ДействиеКоманды = РегистрыСведений.бит_омни_Команды.СоздатьМенеджерЗаписи();
	ДействиеКоманды.Команда = ИмяКоманды;
	ДействиеКоманды.Прочитать();

	Если ДействиеКоманды.Выбран() И Не ДействиеКоманды.Действие.Пустая() Тогда

		Результат = Справочники.бит_омни_Действия.ВыполнитьДействие(ДействиеКоманды.Действие, Сообщение.body.text,
			Контакт, Бот, Параметры);

		Если Не Результат.Ошибка Тогда
			Возврат;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Команды", УровеньЖурналаРегистрации.Ошибка, , ДействиеКоманды.Действие,
			Результат.Описание);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЯвныйОтказОчередиMAX(КодСостояния)
	Возврат КодСостояния = 400 Или КодСостояния = 401 Или КодСостояния = 403
		Или КодСостояния = 404 Или КодСостояния = 422 Или КодСостояния = 429;
КонецФункции

Процедура ПроверитьСнимокОчередиMAX(Бот, Контакт, Тело, Адресат)
	Если ТипЗнч(Бот) <> Тип("СправочникСсылка.бит_омни_Боты") Или НЕ ЗначениеЗаполнено(Бот)
		Или ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или НЕ ЗначениеЗаполнено(Контакт) Тогда
		ВызватьИсключение "Не определены бот или контакт снимка.";
	КонецЕсли;
	Если Бот.ПометкаУдаления Или НЕ Бот.Использовать Или Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX
		Или Контакт.ПометкаУдаления Или Контакт.Заблокирован Или Контакт.Бот <> Бот
		Или Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ВызватьИсключение "Бот или контакт недоступен.";
	КонецЕсли;
	Если ТипЗнч(Тело) <> Тип("Структура") Или ТелоСообщенияMAX(Тело) = Неопределено
		Или ТипЗнч(Адресат) <> Тип("Структура") Тогда ВызватьИсключение "Некорректный снимок JSON."; КонецЕсли;
	Если СтроковоеСвойство(Адресат, "Параметр") <> "user_id"
		Или СтроковоеСвойство(Адресат, "Значение") <> СтрокаИдентификатора(Контакт.Идентификатор)
		Или НЕ ЗначениеЗаполнено(Контакт.Идентификатор)
		Или ПустаяСтрока(СтроковоеСвойство(Адресат, "ИдентификаторСообщенияКлиента")) Тогда
		ВызватьИсключение "Адресат снимка не соответствует контакту.";
	КонецЕсли;
	// Один MAX ID может остаться прежним после перепривязки карточки к другому пациенту.
	// Отсутствующий отпечаток старого снимка также запрещает автоматическую отправку.
	Если НЕ Адресат.Свойство("ОтпечатокПолучателя")
		Или ТипЗнч(Адресат.ОтпечатокПолучателя) <> Тип("Строка")
		Или Адресат.ОтпечатокПолучателя <> ОтпечатокПолучателяКонтактаMAX(Контакт) Тогда
		ВызватьИсключение "Привязка контакта изменилась после подготовки сообщения.";
	КонецЕсли;
	Для Каждого Поле Из Тело Цикл
		Если СтрРазделить("text,format,attachments,notify,disable_link_preview", ",").Найти(Поле.Ключ) = Неопределено Тогда
			ВызватьИсключение "Недопустимое поле тела снимка.";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ОтпечатокПолучателяКонтактаMAX(Контакт)
	ПолучательКонтакта = Контакт.Получатель;
	Если НЕ ЗначениеЗаполнено(ПолучательКонтакта) Тогда Возврат ""; КонецЕсли;
	// Только тип и технический UUID: без ФИО, телефона и представления пациента.
	Возврат Строка(ТипЗнч(ПолучательКонтакта)) + ":" + Строка(ПолучательКонтакта.УникальныйИдентификатор());
КонецФункции

Функция ЗаголовкиMAX(Токен)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", Токен);

	Возврат Заголовки;

КонецФункции

Функция ИспользоватьОбменЧерезVDS()

	Возврат Не ПустаяСтрока(БазовыйАдресVDS())
		И Не ПустаяСтрока(СервисныйКлючVDS());

КонецФункции

Функция ОтправитьСообщениеНапрямуюВMAX(ТелоСообщения, Адресат, Токен)

	СтрокаЗапроса = СтруктураВJSON(ТелоСообщения);

	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(Токен);
	Заголовки.Вставить("Content-Type", "application/json");

	Ресурс = СтрШаблон("/messages?%1=%2", Адресат.Параметр, Адресат.Значение);
	Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаЗапроса, КодировкаТекста.UTF8);

	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ОтправитьСообщениеЧерезVDS(ТелоСообщения, Адресат)

	ТелоСообщения.Вставить(Адресат.Параметр, Адресат.Значение);
	Если Не ТелоСообщения.Свойство("client_message_id") Тогда
		ТелоСообщения.Вставить("client_message_id", Строка(Новый УникальныйИдентификатор));
	КонецЕсли;

	СтрокаЗапроса = СтруктураВJSON(ТелоСообщения);
	Соединение = СоединениеVDS(60);
	Запрос = Новый HTTPЗапрос("/api/v1/onec/messages/outgoing", ЗаголовкиVDS());
	Запрос.УстановитьТелоИзСтроки(СтрокаЗапроса, КодировкаТекста.UTF8);

	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ПолучитьВходящиеСообщенияЧерезVDS(ОжиданиеМС)

	// Claim по одному: пакет не должен исчерпать lease следующих событий.
	Ресурс = СтрШаблон("/api/v1/onec/messages/incoming?ack=true&limit=1&waitMs=%1", ОжиданиеМС);

	Соединение = СоединениеVDS(Макс(60, Окр(ОжиданиеМС / 1000, 0) + 10));
	Запрос = Новый HTTPЗапрос(Ресурс, ЗаголовкиVDS());

	Возврат Соединение.Получить(Запрос);

КонецФункции

Функция ВыполнитьЗапросVDS(Ресурс, Тело = Неопределено)

	Соединение = СоединениеVDS(60);
	Запрос = Новый HTTPЗапрос(Ресурс, ЗаголовкиVDS());
	Если Тело = Неопределено Тогда
		Ответ = Соединение.Получить(Запрос);
	Иначе
		Запрос.УстановитьТелоИзСтроки(СтруктураВJSON(Тело), КодировкаТекста.UTF8);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	КонецЕсли;
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон("Ошибка протокола VDS: HTTP %1", Ответ.КодСостояния);
	КонецЕсли;
	Возврат ПрочитатьОтветMAX(Ответ).Тело;

КонецФункции

Функция СоединениеVDS(Таймаут = 60)

	СтруктураURIВебСервиса = ОбщегоНазначенияКлиентСервер.СтруктураURI(БазовыйАдресVDS());
	Сервер = СтруктураURIВебСервиса.ИмяСервера;
	Порт = ?(ЗначениеЗаполнено(СтруктураURIВебСервиса.Порт), СтруктураURIВебСервиса.Порт, Неопределено);
	Прокси = Неопределено;

	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
		МодульПолучениеФайловИзИнтернета = ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");
		Прокси = МодульПолучениеФайловИзИнтернета.ПолучитьПрокси(СтруктураURIВебСервиса.Схема);
	КонецЕсли;

	ЗащищенноеСоединение = Неопределено;
	Если НРег(СтруктураURIВебСервиса.Схема) = "https" Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
	КонецЕсли;

	Возврат Новый HTTPСоединение(Сервер, Порт,,, Прокси, Таймаут, ЗащищенноеСоединение);

КонецФункции

Функция ЗаголовкиVDS()

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Onec-Api-Key", СервисныйКлючVDS());
	Заголовки.Вставить("Content-Type", "application/json");

	Возврат Заголовки;

КонецФункции

Функция БазовыйАдресVDS()

	Адрес = СокрЛП(Строка(бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("MAX_VDS_URL")));
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;

	Возврат Адрес;

КонецФункции

Функция СервисныйКлючVDS()

	Возврат СокрЛП(Строка(бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("MAX_VDS_API_KEY")));

КонецФункции

Функция ЛимитPollingVDS()

	Лимит = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("MAX_VDS_POLL_LIMIT");
	Если ТипЗнч(Лимит) <> Тип("Число") Или Лимит <= 0 Тогда
		Возврат 50;
	КонецЕсли;

	Возврат Мин(100, Окр(Лимит, 0));

КонецФункции

Функция ОжиданиеLongPollingVDS()

	ОжиданиеМС = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("MAX_VDS_LONG_POLL_WAIT_MS");
	Если ТипЗнч(ОжиданиеМС) <> Тип("Число") Или ОжиданиеМС <= 0 Тогда
		Возврат 25000;
	КонецЕсли;

	Возврат Мин(55000, Окр(ОжиданиеМС, 0));

КонецФункции

Функция ОсновнойБотMAX()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_омни_Боты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.бит_омни_Боты КАК бит_омни_Боты
	|ГДЕ
	|	бит_омни_Боты.Использовать
	|	И НЕ бит_омни_Боты.ПометкаУдаления
	|	И бит_омни_Боты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
	|УПОРЯДОЧИТЬ ПО
	|	бит_омни_Боты.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.бит_омни_Боты.ПустаяСсылка();

КонецФункции

Функция ПрочитатьОтветMAX(Ответ)

	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
	ТелоОтвета = Неопределено;

	Если Не ПустаяСтрока(ТекстОтвета) Тогда
		Попытка
			ТелоОтвета = JSONВСтруктуру(ТекстОтвета);
		Исключение
			ТелоОтвета = Новый Структура("raw", ТекстОтвета);
		КонецПопытки;
	КонецЕсли;

	Возврат Новый Структура("Текст, Тело", ТекстОтвета, ТелоОтвета);

КонецФункции

Функция JSONВСтруктуру(СтрокаJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(Чтение);

КонецФункции

Функция СтруктураВJSON(Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция ПараметрыСообщенияMAX(ПараметрыСообщения, Получатель, Контекст, ДанныеБота)

	Если Не ЭтоШаблонСообщенияMAX(ПараметрыСообщения) Тогда
		Возврат ПараметрыСообщения;
	КонецЕсли;

	ТекстСообщения = бит_омни_РаботаССообщениями.СформироватьТекстСообщенияПоШаблону(ПараметрыСообщения, Получатель,
		Контекст);
	ПараметрыТекущегоСообщения = Новый Структура("text", ТекстСообщения);

	Формат = ПараметрыСообщения.ВариантФормата;
	Если ЗначениеЗаполнено(Формат) Тогда
		ПараметрыТекущегоСообщения.Вставить("format", НРег(Формат));
	КонецЕсли;

	Кнопки = Справочники.бит_омни_ШаблоныСообщений.СформироватьКнопкиПоШаблону(
		ПараметрыСообщения, Получатель, Контекст);
	Если Кнопки.Количество() > 0 Тогда
		ЗаполнитьWebAppКнопокMAX(Кнопки, ДанныеБота);
		Вложения = Новый Массив;
		Вложения.Добавить(Новый Структура(
			"type, payload", "inline_keyboard", Новый Структура("buttons", Кнопки)));
		ПараметрыТекущегоСообщения.Вставить("attachments", Вложения);
	КонецЕсли;

	Возврат ПараметрыТекущегоСообщения;

КонецФункции

Процедура ЗаполнитьWebAppКнопокMAX(РядыКнопок, ДанныеБота)

	ИмяWebApp = СокрЛП(Строка(ДанныеБота.Ссылка.ИмяПользователя));
	Для Каждого РядКнопок Из РядыКнопок Цикл
		Для Каждого Кнопка Из РядКнопок Цикл
			Если СтроковоеСвойство(Кнопка, "type") = "open_app"
				И ПустаяСтрока(СтроковоеСвойство(Кнопка, "web_app"))
			Тогда
				Кнопка.Вставить("web_app", ИмяWebApp);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьПолученныйКонтактMAX(ИнформацияОКонтакте, Контакт, Бот)

	Если ТипЗнч(ИнформацияОКонтакте) <> Тип("Структура")
		Или Контакт.Пустая()
	Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Некорректные данные контакта");
		Возврат;
	КонецЕсли;

	ИнформацияОбАккаунтеMAX = ЗначениеСвойства(ИнформацияОКонтакте, "max_info");
	ИдентификаторКонтакта = ЗначениеСвойства(ИнформацияОбАккаунтеMAX, "user_id");
	Если СтрокаИдентификатора(ИдентификаторКонтакта) <> СтрокаИдентификатора(Контакт.Идентификатор) Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Контакт принадлежит другому пользователю MAX");
		Возврат;
	КонецЕсли;

	VCF = ЗначениеСвойства(ИнформацияОКонтакте, "vcf_info", "");
	Если VCF = Неопределено Или VCF = Null Тогда
		VCF = "";
	Иначе
		// Завершающий перенос строки входит в подписываемые MAX данные VCard.
		// СтроковоеСвойство() здесь применять нельзя: СокрЛП() удалит этот перенос.
		VCF = Строка(VCF);
	КонецЕсли;
	VCF = НормализоватьVCFMAX(VCF);
	Хеш = НРег(СтроковоеСвойство(ИнформацияОКонтакте, "hash"));
	Если ПустаяСтрока(VCF)
		Или ПустаяСтрока(Хеш)
		Или Не ХешиРавныMAX(Хеш, HMACSHA256MAX(Бот.Токен, VCF))
	Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Не подтверждена подпись контакта MAX");
		Возврат;
	КонецЕсли;

	НомерТелефона = НомерТелефонаИзVCFMAX(VCF);
	Если ПустаяСтрока(НомерТелефона) Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "В контакте отсутствует номер телефона");
		Возврат;
	КонецЕсли;

	ВидКонтактнойИнформации = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты(
		"ВидКонтактнойИнформации_ДляПоискаКлиента");
	НайденныеКонтакты = бит_омни_КонтактнаяИнформацияСерверПереопределяемый.НайтиОбъектыПоНомеруТелефона(
		НомерТелефона, Тип("СправочникСсылка.Клиенты"), Истина, ВидКонтактнойИнформации);

	Клиенты = Новый Массив;
	Для Каждого НайденныйКонтакт Из НайденныеКонтакты Цикл
		Если Клиенты.Найти(НайденныйКонтакт.Объект) = Неопределено Тогда
			Клиенты.Добавить(НайденныйКонтакт.Объект);
		КонецЕсли;
	КонецЦикла;

	Если Клиенты.Количество() <> 1 Тогда
		ОтправитьОтказВАторизацииMAX(
			Контакт, Бот, ?(Клиенты.Количество() = 0, "Клиент по номеру не найден", "Найдено несколько клиентов"));
		Возврат;
	КонецЕсли;

	Клиент = Клиенты[0];
	Если ЗначениеЗаполнено(Контакт.Получатель) И Контакт.Получатель <> Клиент Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Контакт уже привязан к другому клиенту");
		Возврат;
	КонецЕсли;

	КонтактОбъект = Контакт.ПолучитьОбъект();
	КонтактОбъект.Получатель = Клиент;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();

	бит_омни_КонтактнаяИнформацияСерверПереопределяемый.ПослеПривязкиПользователяМессенджера(
		КонтактОбъект.Ссылка, Клиент, Бот, ИнформацияОКонтакте);

	Контекст = Новый Структура("client_name, phone", Строка(Клиент), НомерТелефона);
	Если Не ОтправитьСтандартноеСообщениеMAX("MAX_AUTH_SUCCESS", КонтактОбъект.Ссылка, Бот, Контекст) Тогда
		ОтправитьТекстовоеСообщение(
			"Авторизация прошла успешно.", КонтактОбъект.Ссылка, Бот);
	КонецЕсли;

КонецПроцедуры

Процедура ОтправитьОтказВАторизацииMAX(Контакт, Бот, Причина)

	ЗаписьЖурналаРегистрации(
		"ОМНИ.MAX.Авторизация", УровеньЖурналаРегистрации.Предупреждение, , Контакт, Причина);

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Если Не ОтправитьСтандартноеСообщениеMAX("MAX_AUTH_DENIED", Контакт, Бот, Новый Структура("reason", Причина)) Тогда
		ОтправитьТекстовоеСообщение(
			"Не удалось выполнить авторизацию. Пожалуйста, свяжитесь с клиникой.", Контакт, Бот);
	КонецЕсли;

КонецПроцедуры

Функция ОтправитьСтандартноеСообщениеMAX(ИдентификаторШаблона, Контакт, Бот, Контекст = Неопределено)

	Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(ИдентификаторШаблона);
	Если Шаблон.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	ОтправитьСообщение(Шаблон, Контакт, Бот, Контекст);
	Возврат Истина;

КонецФункции

Функция НормализоватьVCFMAX(VCF)

	Результат = СтрЗаменить(VCF, "\r\n", Символы.ВК + Символы.ПС);
	Результат = СтрЗаменить(Результат, "\n", Символы.ПС);
	Возврат Результат;

КонецФункции

Функция НомерТелефонаИзVCFMAX(VCF)

	СтрокиVCF = СтрРазделить(СтрЗаменить(VCF, Символы.ВК, ""), Символы.ПС, Ложь);
	Для Каждого СтрокаVCF Из СтрокиVCF Цикл
		Если Лев(ВРег(СтрокаVCF), 3) <> "TEL" Тогда
			Продолжить;
		КонецЕсли;

		ПозицияРазделителя = СтрНайти(СтрокаVCF, ":");
		Если ПозицияРазделителя > 0 Тогда
			Возврат СокрЛП(Сред(СтрокаVCF, ПозицияРазделителя + 1));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция HMACSHA256MAX(Ключ, Данные)

	РазмерБлока = 64;
	БуферКлюча = ПолучитьБуферДвоичныхДанныхИзСтроки(Ключ, КодировкаТекста.UTF8, Ложь);

	Если БуферКлюча.Размер > РазмерБлока Тогда
		ХешКлюча = Новый ХешированиеДанных(ХешФункция.SHA256);
		ХешКлюча.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферКлюча));
		БуферКлюча = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ХешКлюча.ХешСумма);
	КонецЕсли;

	КлючБлока = Новый БуферДвоичныхДанных(РазмерБлока);
	КлючБлока.Записать(0, БуферКлюча);

	ВнутреннийКлюч = Новый БуферДвоичныхДанных(РазмерБлока);
	ВнешнийКлюч = Новый БуферДвоичныхДанных(РазмерБлока);
	Для Индекс = 0 По РазмерБлока - 1 Цикл
		ВнутреннийКлюч.Установить(Индекс, 54);
		ВнешнийКлюч.Установить(Индекс, 92);
	КонецЦикла;
	ВнутреннийКлюч.ЗаписатьПобитовоеИсключительноеИли(0, КлючБлока);
	ВнешнийКлюч.ЗаписатьПобитовоеИсключительноеИли(0, КлючБлока);

	ВнутреннийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	ВнутреннийХеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ВнутреннийКлюч));
	ВнутреннийХеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Данные, КодировкаТекста.UTF8, Ложь));

	ВнешнийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	ВнешнийХеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ВнешнийКлюч));
	ВнешнийХеш.Добавить(ВнутреннийХеш.ХешСумма);

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ВнешнийХеш.ХешСумма));

КонецФункции

Функция ХешиРавныMAX(ПервыйХеш, ВторойХеш)

	Если СтрДлина(ПервыйХеш) <> СтрДлина(ВторойХеш) Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатСравнения = 0;
	Для Индекс = 1 По СтрДлина(ПервыйХеш) Цикл
		Если Сред(ПервыйХеш, Индекс, 1) <> Сред(ВторойХеш, Индекс, 1) Тогда
			РезультатСравнения = РезультатСравнения + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат РезультатСравнения = 0;

КонецФункции

Функция ЭтоШаблонСообщенияMAX(ПараметрыСообщения)

	ТипПараметров = ТипЗнч(ПараметрыСообщения);

	Возврат ТипПараметров = Тип("СправочникСсылка.бит_омни_ШаблоныСообщений") Или ТипПараметров = Тип(
		"СправочникОбъект.бит_омни_ШаблоныСообщений");

КонецФункции

Функция ПолучателиСообщенияMAX(Получатели)

	Результат = Новый Массив;

	Если ТипЗнч(Получатели) = Тип("Массив") Тогда
		ИсходныеПолучатели = Получатели;
	Иначе
		ИсходныеПолучатели = Новый Массив;
		ИсходныеПолучатели.Добавить(Получатели);
	КонецЕсли;

	Для Каждого Получатель Из ИсходныеПолучатели Цикл

		Если Получатель = Неопределено Или Получатель = Null Тогда
			Продолжить;
		КонецЕсли;

		Если Результат.Найти(Получатель) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ПолучательЗаблокированMAX(Получатель) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Получатель);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучательСообщенияMAX(Получатель, Бот)

	ДоступныеТипыПолучателей = ДоступныеТипыПолучателейMAX();

	Если ДоступныеТипыПолучателей.СодержитТип(ТипЗнч(Получатель)) Тогда
		Получатель = НайтиКонтактПоДанным1С(Получатель, Бот);
	КонецЕсли;

	Если Получатель.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Получатель;

