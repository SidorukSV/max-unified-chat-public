Процедура ЗапроситьПациентаMAX(Контакт, Бот, Клиенты)

	Ряды = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Клиенты.Ссылка КАК Клиент,
		| ПРЕДСТАВЛЕНИЕ(Клиенты.Ссылка) КАК Представление,
		| Клиенты.ДатаРождения КАК ДатаРождения
		|ИЗ Справочник.Клиенты КАК Клиенты
		|ГДЕ Клиенты.Ссылка В(&Клиенты)
		|УПОРЯДОЧИТЬ ПО Клиенты.Наименование, Клиенты.ДатаРождения");
	Запрос.УстановитьПараметр("Клиенты", Клиенты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПодписьКнопки = СокрЛП(Выборка.Представление);
		Если ЗначениеЗаполнено(Выборка.ДатаРождения) Тогда
			ПодписьКнопки = ПодписьКнопки + " · " + Формат(Выборка.ДатаРождения, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		Ряд = Новый Массив;
		Ряд.Добавить(Новый Структура("type,text,payload", "callback", Лев(ПодписьКнопки, 128),
			"patient:" + Строка(Выборка.Клиент.УникальныйИдентификатор())));
		Ряды.Добавить(Ряд);
		Если Ряды.Количество() = 30 Тогда
			ОтправитьКлавиатуруПациентовMAX(Контакт, Бот, Ряды);
			Ряды = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Ряды.Количество() > 0 Тогда ОтправитьКлавиатуруПациентовMAX(Контакт, Бот, Ряды); КонецЕсли;

КонецПроцедуры

Процедура ОтправитьКлавиатуруПациентовMAX(Контакт, Бот, Ряды)

	Вложения = Новый Массив;
	Вложения.Добавить(Новый Структура("type,payload", "inline_keyboard", Новый Структура("buttons", Ряды)));
	//+бит_Сафаров ШИ 25.09.2026
	// БЫЛО:
	// Текст = Справочники.бит_омни_ШаблоныСообщений.СтандартныйТекстИлиРезервный(
	// 	"MAX_PATIENT_SELECTION", Контакт, Неопределено,
	// 	"По вашему номеру найдено несколько карточек. Выберите пациента:");
	// СТАЛО: для единственной карточки не показываем шаблон про несколько пациентов.
	Если Ряды.Количество() = 1 Тогда
		Текст = "Выберите пациента:";
	Иначе
		Текст = Справочники.бит_омни_ШаблоныСообщений.СтандартныйТекстИлиРезервный(
			"MAX_PATIENT_SELECTION", Контакт, Неопределено,
			"По вашему номеру найдено несколько карточек. Выберите пациента:");
	КонецЕсли;
	//-бит_Сафаров ШИ 25.09.2026
	ОтправитьСообщение(Новый Структура("text,attachments", Текст, Вложения), Контакт, Бот);

КонецПроцедуры

Процедура ОбработатьВыборПациентаMAX(Callback, Бот)

	ТекстОтвета = "Не удалось выбрать пациента. Откройте меню бота и выберите «Выбрать пациента».";
	ПациентВыбран = Ложь;
	Контакт = КонтактИзCallbackMAX(Callback, Бот);
	Пациент = ПациентИзКомандыMAX(СтроковоеСвойство(Callback, "payload"));
	Если ЗначениеЗаполнено(Контакт) И Пациент <> Неопределено Тогда
		Телефон = ПодтвержденныйТелефонКонтактаMAX(Контакт);
		Клиенты = КлиентыПоТелефонуMAX(Телефон);
		Если Клиенты.Найти(Пациент) <> Неопределено Тогда
			Контакт = ИзменитьМаршрутизациюКонтактаMAX(Контакт, Бот, Пациент, Ложь, Ложь);
			ТекстОтвета = "Выбран пациент: " + Строка(Пациент) + ".";
			ПациентВыбран = Истина;
		КонецЕсли;
	КонецЕсли;
	Попытка
		бит_ОтветитьНаCallbackMAX(Callback,
			Новый Структура("text,attachments,notify", ТекстОтвета, Новый Массив, Ложь), Бот);
	Исключение
		Если ТранзакцияАктивна() Тогда ВызватьИсключение; КонецЕсли;
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Пациент.Ответ", УровеньЖурналаРегистрации.Ошибка,
			, , "MAX не подтвердил обновление сообщения о выборе пациента.");
	КонецПопытки;
	Если ПациентВыбран И Не ЗначениеЗаполнено(Контакт.ОтделениеMAX) Тогда
		ЗапроситьОтделениеMAX(Контакт, Бот);
	КонецЕсли;

КонецПроцедуры

Функция КонтактИзCallbackMAX(Callback, Бот)

	ПользовательMAX = ЗначениеСвойства(Callback, "user");
	ИдентификаторMAX = ЗначениеСвойства(ПользовательMAX, "user_id");
	Если ТипЗнч(ИдентификаторMAX) <> Тип("Число") Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;
	Контакт = бит_омни_НадежныйОбменMAX.ПолучитьСуществующийКонтакт(ИдентификаторMAX, Бот);
	Если Контакт.Пустая() Или ПустаяСтрока(ПодтвержденныйТелефонКонтактаMAX(Контакт)) Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;
	Возврат Контакт;

КонецФункции

Функция ПациентИзКомандыMAX(Команда)

	Если ТипЗнч(Команда) <> Тип("Строка") Или СтрДлина(Команда) <> 44 Или Лев(Команда, 8) <> "patient:" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Сред(Команда, 9));
