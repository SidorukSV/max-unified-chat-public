// Команды отображаются в постоянном меню MAX при вводе «/».
Процедура НастроитьКомандыБотаMAX(Бот)

	Если ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;
	Команды = Новый Массив;
	Команды.Добавить(Новый Структура("name,description", "patient", "Выбрать пациента"));
