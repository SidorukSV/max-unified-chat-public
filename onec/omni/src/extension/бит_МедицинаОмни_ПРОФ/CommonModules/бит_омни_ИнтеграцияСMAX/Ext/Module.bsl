Функция ЛимитPollingVDS()

	Лимит = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("MAX_VDS_POLL_LIMIT");
	Если ТипЗнч(Лимит) <> Тип("Число") Или Лимит <= 0 Тогда
		Возврат 50;
	КонецЕсли;

	Возврат Мин(100, Окр(Лимит, 0));

КонецФункции

Функция ОжиданиеLongPollingVDS()

	ОжиданиеМС = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("MAX_VDS_LONG_POLL_WAIT_MS");
	Если ТипЗнч(ОжиданиеМС) <> Тип("Число") Или ОжиданиеМС <= 0 Тогда
		Возврат 25000;
	КонецЕсли;

	Возврат Мин(55000, Окр(ОжиданиеМС, 0));

