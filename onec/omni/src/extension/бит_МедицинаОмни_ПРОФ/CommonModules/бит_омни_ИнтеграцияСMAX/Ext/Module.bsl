Функция ПараметрыСообщенияMAX(ПараметрыСообщения, Получатель, Контекст, ДанныеБота)

	Если Не ЭтоШаблонСообщенияMAX(ПараметрыСообщения) Тогда
		Возврат ПараметрыСообщения;
	КонецЕсли;

	СообщениеШаблона = Справочники.бит_омни_ШаблоныСообщений.СформироватьСообщениеПоШаблону(
		ПараметрыСообщения, Получатель, Контекст);
	ПараметрыТекущегоСообщения = Новый Структура("text", СообщениеШаблона.Текст);

	Формат = ПараметрыСообщения.ВариантФормата;
	Если ЗначениеЗаполнено(Формат) Тогда
		ПараметрыТекущегоСообщения.Вставить("format", НРег(Формат));
	КонецЕсли;

	Кнопки = СообщениеШаблона.Кнопки;
	Если Кнопки.Количество() > 0 Тогда
		ЗаполнитьWebAppКнопокMAX(Кнопки, ДанныеБота);
		Вложения = Новый Массив;
		Вложения.Добавить(Новый Структура(
			"type, payload", "inline_keyboard", Новый Структура("buttons", Кнопки)));
		ПараметрыТекущегоСообщения.Вставить("attachments", Вложения);
	КонецЕсли;

	Возврат ПараметрыТекущегоСообщения;

КонецФункции

Процедура ЗаполнитьWebAppКнопокMAX(РядыКнопок, ДанныеБота)

	ИмяWebApp = СокрЛП(Строка(ДанныеБота.Ссылка.ИмяПользователя));
	Для Каждого РядКнопок Из РядыКнопок Цикл
		Для Каждого Кнопка Из РядКнопок Цикл
			Если СтроковоеСвойство(Кнопка, "type") = "open_app"
				И ПустаяСтрока(СтроковоеСвойство(Кнопка, "web_app"))
			Тогда
				Кнопка.Вставить("web_app", ИмяWebApp);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьПолученныйКонтактMAX(ИнформацияОКонтакте, Контакт, Бот)

	Если ТипЗнч(ИнформацияОКонтакте) <> Тип("Структура")
		Или Контакт.Пустая()
	Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Некорректные данные контакта");
		Возврат;
	КонецЕсли;

	ИнформацияОбАккаунтеMAX = ЗначениеСвойства(ИнформацияОКонтакте, "max_info");
	ИдентификаторКонтакта = ЗначениеСвойства(ИнформацияОбАккаунтеMAX, "user_id");
	Если СтрокаИдентификатора(ИдентификаторКонтакта) <> СтрокаИдентификатора(Контакт.Идентификатор) Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Контакт принадлежит другому пользователю MAX");
		Возврат;
	КонецЕсли;

	VCF = ЗначениеСвойства(ИнформацияОКонтакте, "vcf_info", "");
	Если VCF = Неопределено Или VCF = Null Тогда
		VCF = "";
	Иначе
		// Завершающий перенос строки входит в подписываемые MAX данные VCard.
		// СтроковоеСвойство() здесь применять нельзя: СокрЛП() удалит этот перенос.
		VCF = Строка(VCF);
	КонецЕсли;
	VCF = НормализоватьVCFMAX(VCF);
	Хеш = НРег(СтроковоеСвойство(ИнформацияОКонтакте, "hash"));
	Если ПустаяСтрока(VCF)
		Или ПустаяСтрока(Хеш)
		Или Не ХешиРавныMAX(Хеш, HMACSHA256MAX(Бот.Токен, VCF))
	Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Не подтверждена подпись контакта MAX");
		Возврат;
	КонецЕсли;

	НомерТелефона = НомерТелефонаИзVCFMAX(VCF);
	Если ПустаяСтрока(НомерТелефона) Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "В контакте отсутствует номер телефона");
		Возврат;
	КонецЕсли;

	Клиенты = КлиентыПоТелефонуMAX(НомерТелефона);

	Если Клиенты.Количество() = 0 Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Клиент по номеру не найден");
		// Непривязанный контакт тоже должен попасть в выбранное отделение.
		ЗапроситьОтделениеMAX(Контакт, Бот);
		Возврат;
	КонецЕсли;
	Если Клиенты.Количество() > 1 Тогда
		ИзменитьМаршрутизациюКонтактаMAX(Контакт, Бот, , Истина, Ложь);
		//+бит_Сафаров ШИ 25.09.2026
		// БЫЛО: ЗапроситьПациентаMAX(Контакт, Бот, Клиенты);
		// СТАЛО: сначала выбор отделения, затем пациента.
		Если ЗначениеЗаполнено(Контакт.ОтделениеMAX) Тогда
			ЗапроситьПациентаMAX(Контакт, Бот, Клиенты);
		Иначе
			ЗапроситьОтделениеMAX(Контакт, Бот);
		КонецЕсли;
		//-бит_Сафаров ШИ 25.09.2026
		Возврат;
	КонецЕсли;

	Клиент = Клиенты[0];
	Если ЗначениеЗаполнено(Контакт.Получатель) И Контакт.Получатель <> Клиент Тогда
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Контакт уже привязан к другому клиенту");
		Возврат;
	КонецЕсли;

	КонтактОбъект = Контакт.ПолучитьОбъект();
	КонтактОбъект.Получатель = Клиент;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();

	бит_омни_КонтактнаяИнформацияСерверПереопределяемый.ПослеПривязкиПользователяМессенджера(
		КонтактОбъект.Ссылка, Клиент, Бот, ИнформацияОКонтакте);

	//+бит_Сафаров ШИ 17.09.2026
	//БЫЛО: Контекст = Новый Структура("client_name, phone", Строка(Клиент), НомерТелефона);
	//СТАЛО: фамилия не попадает в автоматическое сообщение.
	Контекст = Новый Структура("client_name, phone", бит_ИмяОтчествоПациентаMAX(Клиент), НомерТелефона);
	//-бит_Сафаров ШИ 17.09.2026
	Если Не ОтправитьСтандартноеСообщениеMAX("MAX_AUTH_SUCCESS", КонтактОбъект.Ссылка, Бот, Контекст) Тогда
		ОтправитьТекстовоеСообщение(
			"Авторизация прошла успешно.", КонтактОбъект.Ссылка, Бот);
	КонецЕсли;
	ЗапроситьОтделениеMAX(КонтактОбъект.Ссылка, Бот);

КонецПроцедуры

Функция КлиентыПоТелефонуMAX(НомерТелефона)

	Клиенты = Новый Массив;
	Если ПустаяСтрока(СокрЛП(НомерТелефона)) Тогда
		Возврат Клиенты;
	КонецЕсли;
	ВидКонтактнойИнформации = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты(
		"ВидКонтактнойИнформации_ДляПоискаКлиента");
	НайденныеКонтакты = бит_омни_КонтактнаяИнформацияСерверПереопределяемый.НайтиОбъектыПоНомеруТелефона(
		НомерТелефона, Тип("СправочникСсылка.Клиенты"), Истина, ВидКонтактнойИнформации);
	Для Каждого НайденныйКонтакт Из НайденныеКонтакты Цикл
		Клиент = НайденныйКонтакт.Объект;
		Если ТипЗнч(Клиент) = Тип("СправочникСсылка.Клиенты") И ЗначениеЗаполнено(Клиент)
			И Не Клиент.ПометкаУдаления И Не Клиент.ЭтоГруппа
			И Клиенты.Найти(Клиент) = Неопределено Тогда
			Клиенты.Добавить(Клиент);
		КонецЕсли;
	КонецЦикла;
	Возврат Клиенты;

КонецФункции

Функция ДиалогЗакрытMAX(Контакт, Бот)

	Если Не ЗначениеЗаполнено(Контакт) Или Контакт.Бот <> Бот Тогда
		Возврат Ложь;
	КонецЕсли;
	Пациент = ?(ТипЗнч(Контакт.Получатель) = Тип("СправочникСсылка.Клиенты")
		И ЗначениеЗаполнено(Контакт.Получатель), Контакт.Получатель, Контакт);
	Запись = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
	Запись.Пациент = Пациент;
	Запись.Бот = Бот;
	Запись.Отделение = Контакт.ОтделениеMAX;
	Запись.Прочитать();
	Возврат Запись.Выбран()
		И Запись.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт;

КонецФункции

Функция ПодготовитьПовторноеОбращениеMAX(Контакт, Бот)

	Если ТранзакцияАктивна() Тогда
		Возврат ПодготовитьПовторноеОбращениеВТранзакцииMAX(Контакт, Бот);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Результат = ПодготовитьПовторноеОбращениеВТранзакцииMAX(Контакт, Бот);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ПодготовитьПовторноеОбращениеВТранзакцииMAX(Контакт, Бот)

	//+бит_Сафаров ШИ 25.09.2026
	// БЫЛО: сохраненное отделение пропускало сброс маршрута закрытого диалога.
	//Если ЗначениеЗаполнено(Контакт.ОтделениеMAX) Тогда
	//	ПеревестиЗакрытыйДиалогВНовыйMAX(Контакт, Бот);
	//	Возврат Новый Структура("Контакт,Телефон,Клиенты", Контакт, "", Новый Массив);
	//КонецЕсли;
	// СТАЛО: общий путь ниже всегда очищает отделение перед новым обращением.
	//-бит_Сафаров ШИ 25.09.2026
	Телефон = ПодтвержденныйТелефонКонтактаMAX(Контакт);
	Клиенты = КлиентыПоТелефонуMAX(Телефон);
	Пациент = Неопределено;
	СброситьПациента = Истина;
	Если Клиенты.Количество() = 1 Тогда
		Пациент = Клиенты[0];
		СброситьПациента = Ложь;
	КонецЕсли;
	ПеревестиЗакрытыйДиалогВНовыйMAX(Контакт, Бот);
	Контакт = ИзменитьМаршрутизациюКонтактаВТранзакцииMAX(
		Контакт, Бот, Пациент, СброситьПациента, Истина);
	Возврат Новый Структура("Контакт,Телефон,Клиенты", Контакт, Телефон, Клиенты);

КонецФункции

// Только серверный прием события внутри его транзакции. Не меняет маршрут и историю.
//
// Параметры:
//  Контакт - СправочникСсылка.бит_омни_Контакты - контакт отправителя MAX.
//  Бот - СправочникСсылка.бит_омни_Боты - бот принятого события.
Процедура ПеревестиЗакрытыйДиалогВНовыйMAX(Контакт, Бот) Экспорт

	Данные = СостояниеДиалогаПодБлокировкойMAX(Контакт, Бот);
	Запись = Данные.Запись;
	Если Не Запись.Выбран()
		Или Запись.Состояние <> Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт Тогда
		Возврат;
	КонецЕсли;
	Запись.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Новый;
	Запись.Ответственный = Справочники.Пользователи.ПустаяСсылка();
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

// Сохраняемый inbox-контекст содержит только булево и строковые отпечатки.
// Вызывать после дедупликации и сохранения нового входящего в той же транзакции.
//
// Параметры:
//  Контакт - СправочникСсылка.бит_омни_Контакты - контакт отправителя MAX.
//  Бот - СправочникСсылка.бит_омни_Боты - бот принятого события.
//
// Возвращаемое значение:
//  Структура - ПовторноеОбращение (Булево), ОтпечатокМаршрута и ОтпечатокСостояния (Строка).
Функция ФиксироватьОткрытиеДиалогаПриПриемеMAX(Контакт, Бот) Экспорт

	Данные = СостояниеДиалогаПодБлокировкойMAX(Контакт, Бот);
	ПовторноеОбращение = Данные.Запись.Выбран()
		И Данные.Запись.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Закрыт;
	Если ПовторноеОбращение Тогда
		ПеревестиЗакрытыйДиалогВНовыйMAX(Контакт, Бот);
		Данные = СостояниеДиалогаПодБлокировкойMAX(Контакт, Бот);
	КонецЕсли;
	Результат = ОтпечаткиСостоянияДиалогаMAX(Данные);
	Результат.Вставить("ПовторноеОбращение", ПовторноеОбращение);
	Результат.Вставить("ОтпечатокВходящих", ОтпечатокВходящихДиалогаMAX(Контакт, Бот));
	Возврат Результат;

КонецФункции

// Актуальность сохраненного контекста для обычного события и повторного обращения.
// Признак ПовторноеОбращение выбирает сценарий, но не влияет на актуальность.
//
// Параметры:
//  Контакт - СправочникСсылка.бит_омни_Контакты - контакт отправителя MAX.
//  Бот - СправочникСсылка.бит_омни_Боты - бот принятого события.
//  КонтекстПриема - Структура - результат ФиксироватьОткрытиеДиалогаПриПриемеMAX.
//  ИдентификаторСообщения - Строка - MID сохраненного входящего.
//  ПериодСообщения - Дата - фактический период сохраненного входящего.
//
// Возвращаемое значение:
//  Булево - старое обращение еще не вытеснено новым событием или изменением маршрута/состояния.
Функция ПовторноеОбращениеАктуальноMAX(
		Контакт, Бот, КонтекстПриема, ИдентификаторСообщения, ПериодСообщения) Экспорт

	Данные = СостояниеДиалогаПодБлокировкойMAX(Контакт, Бот);
	Отпечатки = ОтпечаткиСостоянияДиалогаMAX(Данные);
	Если Отпечатки.ОтпечатокМаршрута <> СтроковоеСвойство(КонтекстПриема, "ОтпечатокМаршрута")
		Или Отпечатки.ОтпечатокСостояния <> СтроковоеСвойство(КонтекстПриема, "ОтпечатокСостояния")
		Или ПустаяСтрока(ИдентификаторСообщения) Или ТипЗнч(ПериодСообщения) <> Тип("Дата") Тогда
		Возврат Ложь;
	КонецЕсли;
	// Снимок учитывает и предыдущие сообщения той же секунды: они не являются
	// более новыми. Перенос history -> archive сохраняет объединенный снимок.
	ОтпечатокВходящих = СтроковоеСвойство(КонтекстПриема, "ОтпечатокВходящих");
	Если Не ПустаяСтрока(ОтпечатокВходящих) Тогда
		Возврат ОтпечатокВходящих = ОтпечатокВходящихДиалогаMAX(Контакт, Бот);
	КонецЕсли;
	// Совместимость с сохраненным контекстом без снимка входящих.
	// При одинаковой секунде считаем другой MID более новым: безопаснее отложить
	// старый сценарий, чем сбросить выбор пациента от более нового обращения.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 История.ИдентификаторСообщения КАК Идентификатор
		|ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
		|ГДЕ История.Контакт = &Контакт И История.Бот = &Бот И История.Входящее
		| И История.Период >= &Период И История.ИдентификаторСообщения <> &Идентификатор
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ ПЕРВЫЕ 1 Архив.ИдентификаторСообщения
		|ИЗ РегистрСведений.бит_омни_АрхивЧатовMAX КАК Архив
		|ГДЕ Архив.Контакт = &Контакт И Архив.Бот = &Бот И Архив.Входящее
		| И Архив.Период >= &Период И Архив.ИдентификаторСообщения <> &Идентификатор");
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Период", ПериодСообщения);
	Запрос.УстановитьПараметр("Идентификатор", Лев(ИдентификаторСообщения, 150));
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

Функция ОтпечатокВходящихДиалогаMAX(Контакт, Бот)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество,
		| МАКСИМУМ(Сообщения.Период) КАК ПоследнийПериод,
		| МАКСИМУМ(Сообщения.ИдентификаторСообщения) КАК ПоследнийИдентификатор
		|ИЗ (
		| ВЫБРАТЬ История.Период КАК Период, История.ИдентификаторСообщения КАК ИдентификаторСообщения
		| ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
		| ГДЕ История.Контакт = &Контакт И История.Бот = &Бот И История.Входящее
		| ОБЪЕДИНИТЬ
		| ВЫБРАТЬ Архив.Период, Архив.ИдентификаторСообщения
		| ИЗ РегистрСведений.бит_омни_АрхивЧатовMAX КАК Архив
		| ГДЕ Архив.Контакт = &Контакт И Архив.Бот = &Бот И Архив.Входящее
		|) КАК Сообщения");
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", Бот);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Снимок = Формат(Выборка.Количество, "ЧГ=0; ЧН=0");
	Если Выборка.Количество > 0 Тогда
		Снимок = Снимок + "|" + Формат(Выборка.ПоследнийПериод, "ДФ=yyyyMMddHHmmss")
			+ "|" + Выборка.ПоследнийИдентификатор;
	КонецЕсли;
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Снимок, КодировкаТекста.UTF8, Ложь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));

КонецФункции

Функция СостояниеДиалогаПодБлокировкойMAX(Контакт, Бот)

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Открытие диалога MAX выполняется только внутри транзакции.";
	КонецЕсли;
	Если ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или Не ЗначениеЗаполнено(Контакт)
		Или ТипЗнч(Бот) <> Тип("СправочникСсылка.бит_омни_Боты") Или Не ЗначениеЗаполнено(Бот) Тогда
		ВызватьИсключение "Не задан контакт или бот MAX.";
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.бит_омни_Контакты");
	Элемент.УстановитьЗначение("Ссылка", Контакт);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	КонтактОбъект = Контакт.ПолучитьОбъект();
	Если КонтактОбъект.ПометкаУдаления Или КонтактОбъект.Заблокирован
		Или КонтактОбъект.Бот <> Бот
		Или КонтактОбъект.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX
		Или Бот.ПометкаУдаления Или Не Бот.Использовать
		Или Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ВызватьИсключение "Диалог MAX недоступен для нового обращения.";
	КонецЕсли;
	Пациент = ?(ТипЗнч(КонтактОбъект.Получатель) = Тип("СправочникСсылка.Клиенты")
		И ЗначениеЗаполнено(КонтактОбъект.Получатель), КонтактОбъект.Получатель, Контакт);
	БлокировкаСостояния = Новый БлокировкаДанных;
	Элемент = БлокировкаСостояния.Добавить("РегистрСведений.бит_омни_СостоянияДиалоговMAX");
	Элемент.УстановитьЗначение("Пациент", Пациент);
	Элемент.УстановитьЗначение("Бот", Бот);
	Элемент.УстановитьЗначение("Отделение", КонтактОбъект.ОтделениеMAX);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаСостояния.Заблокировать();
	Запись = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
	Запись.Пациент = Пациент;
	Запись.Бот = Бот;
	Запись.Отделение = КонтактОбъект.ОтделениеMAX;
	Запись.Прочитать();
	// При отсутствии строки восстанавливаем измерения менеджера для отпечатка.
	Запись.Пациент = Пациент;
	Запись.Бот = Бот;
	Запись.Отделение = КонтактОбъект.ОтделениеMAX;
	Возврат Новый Структура("КонтактОбъект,Запись", КонтактОбъект, Запись);

КонецФункции

Функция ОтпечаткиСостоянияДиалогаMAX(Данные)

	Запись = Данные.Запись;
	Маршрут = Строка(Данные.КонтактОбъект.Ссылка.УникальныйИдентификатор()) + "|"
		+ Строка(Запись.Пациент.УникальныйИдентификатор()) + "|"
		+ Строка(Запись.Бот.УникальныйИдентификатор()) + "|"
		+ Строка(Запись.Отделение.УникальныйИдентификатор());
	Состояние = "НетЗаписи";
	Если Запись.Выбран() Тогда
		Состояние = Строка(Запись.Состояние) + "|"
			+ Формат(Запись.ДатаИзменения, "ДФ=yyyyMMddHHmmss") + "|"
			+ Строка(Запись.Ответственный.УникальныйИдентификатор());
	КонецЕсли;
	ХешМаршрута = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешМаршрута.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Маршрут, КодировкаТекста.UTF8, Ложь));
	ХешСостояния = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешСостояния.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Состояние, КодировкаТекста.UTF8, Ложь));
	Возврат Новый Структура("ОтпечатокМаршрута,ОтпечатокСостояния",
		НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешМаршрута.ХешСумма)),
		НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешСостояния.ХешСумма)));

КонецФункции

Функция ИзменитьМаршрутизациюКонтактаMAX(
		Контакт, Бот, Пациент = Неопределено, СброситьПациента = Ложь, СброситьОтделение = Ложь)

	Если ТранзакцияАктивна() Тогда
		Возврат ИзменитьМаршрутизациюКонтактаВТранзакцииMAX(
			Контакт, Бот, Пациент, СброситьПациента, СброситьОтделение);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Результат = ИзменитьМаршрутизациюКонтактаВТранзакцииMAX(
			Контакт, Бот, Пациент, СброситьПациента, СброситьОтделение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ИзменитьМаршрутизациюКонтактаВТранзакцииMAX(
		Контакт, Бот, Пациент = Неопределено, СброситьПациента = Ложь, СброситьОтделение = Ложь)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_омни_Контакты");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Контакт);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	КонтактОбъект = Контакт.ПолучитьОбъект();
	Если КонтактОбъект.ПометкаУдаления Или КонтактОбъект.Заблокирован Или КонтактОбъект.Бот <> Бот
		Или КонтактОбъект.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ВызватьИсключение "Контакт MAX изменился во время маршрутизации.";
	КонецЕсли;
	Если СброситьПациента Тогда
		КонтактОбъект.Получатель = Справочники.Клиенты.ПустаяСсылка();
	ИначеЕсли Пациент <> Неопределено Тогда
		КонтактОбъект.Получатель = Пациент;
	КонецЕсли;
	Если СброситьОтделение Тогда
		КонтактОбъект.ОтделениеMAX = Справочники.бит_омни_ОтделенияMAX.ПустаяСсылка();
	КонецЕсли;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();
	// После смены пациента/отделения закрытым может оказаться именно итоговый ключ.
	ПеревестиЗакрытыйДиалогВНовыйMAX(КонтактОбъект.Ссылка, Бот);
	Возврат КонтактОбъект.Ссылка;

КонецФункции

Процедура НачатьВыборПациентаMAX(Контакт, Бот)

	Телефон = ПодтвержденныйТелефонКонтактаMAX(Контакт);
	Если ПустаяСтрока(Телефон) Тогда
		ОтправитьСтандартноеСообщениеMAX("MAX_WELCOME", Контакт, Бот);
		Возврат;
	КонецЕсли;
	Клиенты = КлиентыПоТелефонуMAX(Телефон);
	Если Клиенты.Количество() = 0 Тогда
		ИзменитьМаршрутизациюКонтактаMAX(Контакт, Бот, , Истина, Ложь);
		ОтправитьОтказВАторизацииMAX(Контакт, Бот, "Клиент по номеру не найден");
		Возврат;
	ИначеЕсли Клиенты.Количество() = 1 Тогда
		Контакт = ИзменитьМаршрутизациюКонтактаMAX(Контакт, Бот, Клиенты[0], Ложь, Ложь);
		ОтправитьТекстовоеСообщение("Выбран пациент: " + Строка(Клиенты[0]) + ".", Контакт, Бот);
		Если Не ЗначениеЗаполнено(Контакт.ОтделениеMAX) Тогда ЗапроситьОтделениеMAX(Контакт, Бот); КонецЕсли;
		Возврат;
	КонецЕсли;
	Контакт = ИзменитьМаршрутизациюКонтактаMAX(Контакт, Бот, , Истина, Ложь);
	ЗапроситьПациентаMAX(Контакт, Бот, Клиенты);

