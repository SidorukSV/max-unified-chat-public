Функция ОтправитьСообщениеНапрямуюВMAX(ТелоСообщения, Адресат, Токен)

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "HTTP MAX внутри транзакции запрещен."; КонецЕсли;
	СтрокаЗапроса = СтруктураВJSON(ТелоСообщения);

	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(Токен);
	Заголовки.Вставить("Content-Type", "application/json");

	Ресурс = СтрШаблон("/messages?%1=%2", Адресат.Параметр, Адресат.Значение);
	Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаЗапроса, КодировкаТекста.UTF8);

	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ОтправитьСообщениеЧерезVDS(ТелоСообщения, Адресат)

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "HTTP VDS внутри транзакции запрещен."; КонецЕсли;
	ТелоСообщения.Вставить(Адресат.Параметр, Адресат.Значение);
	Если Не ТелоСообщения.Свойство("client_message_id") Тогда
		ТелоСообщения.Вставить("client_message_id", Строка(Новый УникальныйИдентификатор));
	КонецЕсли;

	СтрокаЗапроса = СтруктураВJSON(ТелоСообщения);
	Соединение = СоединениеVDS(60);
	Запрос = Новый HTTPЗапрос("/api/v1/onec/messages/outgoing", ЗаголовкиVDS());
	Запрос.УстановитьТелоИзСтроки(СтрокаЗапроса, КодировкаТекста.UTF8);

	Возврат Соединение.ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ПолучитьВходящиеСообщенияЧерезVDS(ОжиданиеМС)

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Polling VDS внутри транзакции запрещен."; КонецЕсли;
	// Claim по одному: пакет не должен исчерпать lease следующих событий.
	Ресурс = СтрШаблон("/api/v1/onec/messages/incoming?ack=true&limit=1&waitMs=%1", ОжиданиеМС);

	Соединение = СоединениеVDS(Макс(60, Окр(ОжиданиеМС / 1000, 0) + 10));
	Запрос = Новый HTTPЗапрос(Ресурс, ЗаголовкиVDS());

	Возврат Соединение.Получить(Запрос);

КонецФункции

Функция ВыполнитьЗапросVDS(Ресурс, Тело = Неопределено)

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "HTTP VDS внутри транзакции запрещен."; КонецЕсли;
	Соединение = СоединениеVDS(60);
	Запрос = Новый HTTPЗапрос(Ресурс, ЗаголовкиVDS());
	Если Тело = Неопределено Тогда
		Ответ = Соединение.Получить(Запрос);
	Иначе
		Запрос.УстановитьТелоИзСтроки(СтруктураВJSON(Тело), КодировкаТекста.UTF8);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	КонецЕсли;
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон("Ошибка протокола VDS: HTTP %1", Ответ.КодСостояния);
	КонецЕсли;
	Возврат ПрочитатьОтветMAX(Ответ).Тело;

КонецФункции

Функция СоединениеVDS(Таймаут = 60)

	СтруктураURIВебСервиса = ОбщегоНазначенияКлиентСервер.СтруктураURI(БазовыйАдресVDS());
	Если НРег(СтруктураURIВебСервиса.Схема) <> "https" Тогда
		ВызватьИсключение "Обмен с VDS разрешен только по HTTPS. Сервисный ключ и данные не отправлены.";
	КонецЕсли;
	Сервер = СтруктураURIВебСервиса.ИмяСервера;
	Порт = ?(ЗначениеЗаполнено(СтруктураURIВебСервиса.Порт), СтруктураURIВебСервиса.Порт, Неопределено);
	Прокси = Неопределено;

	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
		МодульПолучениеФайловИзИнтернета = ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");
		Прокси = МодульПолучениеФайловИзИнтернета.ПолучитьПрокси(СтруктураURIВебСервиса.Схема);
	КонецЕсли;

	ЗащищенноеСоединение = Неопределено;
	Если НРег(СтруктураURIВебСервиса.Схема) = "https" Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
	КонецЕсли;

	Возврат Новый HTTPСоединение(Сервер, Порт,,, Прокси, Таймаут, ЗащищенноеСоединение);

КонецФункции

