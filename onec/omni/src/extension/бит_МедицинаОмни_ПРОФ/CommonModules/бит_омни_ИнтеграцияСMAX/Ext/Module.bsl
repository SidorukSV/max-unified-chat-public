// Отдельное сообщение после собственного подписанного контакта, без миниприложения.
Процедура ЗапроситьОтделениеMAX(Контакт, Бот)

	Если ЗначениеЗаполнено(Контакт.ОтделениеMAX) Тогда
		Возврат;
	КонецЕсли;
	Отделения = бит_омни_ОтделенияMAXСервер.ДоступныеОтделения();
	Если Отделения.Количество() = 0 Тогда
		ОтправитьТекстовоеСообщение(
			"Сейчас нет доступных отделений для обращения. Пожалуйста, свяжитесь с клиникой по телефону.",
			Контакт, Бот);
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Отделения", УровеньЖурналаРегистрации.Предупреждение,
			, , "Не настроены доступные отделения MAX.");
		Возврат;
	КонецЕсли;
	Ряды = Новый Массив;
	Для Каждого Отделение Из Отделения Цикл
		Ряд = Новый Массив;
		Ряд.Добавить(Новый Структура("type,text,payload", "callback",
			Отделение.Наименование, "department:" + Строка(Отделение.Ссылка.УникальныйИдентификатор())));
		Ряды.Добавить(Ряд);
		// Ограничение MAX: не более 30 рядов в одной inline-клавиатуре.
		Если Ряды.Количество() = 30 Тогда
			ОтправитьКлавиатуруОтделенийMAX(Контакт, Бот, Ряды);
			Ряды = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Ряды.Количество() > 0 Тогда
		ОтправитьКлавиатуруОтделенийMAX(Контакт, Бот, Ряды);
	КонецЕсли;

КонецПроцедуры

Процедура ОтправитьКлавиатуруОтделенийMAX(Контакт, Бот, Ряды)

	Вложения = Новый Массив;
	Вложения.Добавить(Новый Структура("type,payload", "inline_keyboard", Новый Структура("buttons", Ряды)));
	Текст = Справочники.бит_омни_ШаблоныСообщений.СтандартныйТекстИлиРезервный(
		"MAX_DEPARTMENT_SELECTION", Контакт, Неопределено,
		"В какое отделение вы обращаетесь? Выберите отделение:");
	ОтправитьСообщение(Новый Структура("text,attachments", Текст, Вложения), Контакт, Бот);

КонецПроцедуры

Процедура ОбработатьВыборОтделенияMAX(Callback, Бот)

	ТекстОтвета = "Не удалось выбрать отделение. Нажмите «Начать», отправьте свой контакт и выберите отделение.";
	ОтделениеИзменено = Ложь;
	Телефон = "";
	Отделение = бит_омни_ОтделенияMAXСервер.ОтделениеИзКоманды(СтроковоеСвойство(Callback, "payload"));
	ПользовательMAX = ЗначениеСвойства(Callback, "user");
	ИдентификаторMAX = ЗначениеСвойства(ПользовательMAX, "user_id");
	Если Отделение <> Неопределено И ТипЗнч(ИдентификаторMAX) = Тип("Число") Тогда
		Контакт = бит_омни_НадежныйОбменMAX.ПолучитьСуществующийКонтакт(ИдентификаторMAX, Бот);
		Если Не Контакт.Пустая() И Контакт.Бот = Бот
			И СтрокаИдентификатора(Контакт.Идентификатор) = СтрокаИдентификатора(ИдентификаторMAX)
			И Не Контакт.ПометкаУдаления И Не Контакт.Заблокирован
			И Не Бот.ПометкаУдаления И Бот.Использовать Тогда
			Телефон = ПодтвержденныйТелефонКонтактаMAX(Контакт);
		КонецЕсли;
		Если Не ПустаяСтрока(Телефон) Тогда
			// Проверка собственного подписанного контакта выполнена до привилегий.
			// После назначения RLS может скрыть контакт от пользователя обмена.
			Клиенты = КлиентыПоТелефонуMAX(Телефон);
			КлючСобытия = СтроковоеСвойство(Callback, "callback_id");
			Если ПустаяСтрока(КлючСобытия) Тогда КлючСобытия = СтруктураВJSON(Callback); КонецЕсли;
			ХешСобытия = Новый ХешированиеДанных(ХешФункция.SHA256);
			ХешСобытия.Добавить(ПолучитьДвоичныеДанныеИзСтроки(КлючСобытия, КодировкаТекста.UTF8, Ложь));
			ИдентификаторСобытия = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешСобытия.ХешСумма));
			БылПривилегированныйРежим = ПривилегированныйРежим();
			УстановитьПривилегированныйРежим(Истина);
			Попытка
				Результат = бит_омни_ОтделенияMAXСервер.ЗакрепитьОтделение(
					Контакт, Бот, Отделение, ИдентификаторСобытия);
				ТекстОтвета = "Ваше обращение направлено в отделение: " + Строка(Результат.Отделение) + ".";
				ОтделениеИзменено = Результат.Изменено;
				Если ОтделениеИзменено Тогда
					ОтправитьТекстовоеСообщение(ТекстОтвета, Контакт, Бот);
					// Сохраняем явный выбор даже для одной карточки; автоматически
					// перепривязывать пациента при выборе отделения нельзя.
					Если Клиенты.Количество() > 0 Тогда ЗапроситьПациентаMAX(Контакт, Бот, Клиенты); КонецЕсли;
				КонецЕсли;
				УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
			Исключение
				УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
				// Ошибка записи/постановки меню должна откатить inbox, а не дать ложный ACK.
				ВызватьИсключение;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	// В inbox назначение, история и ответы фиксируются общей транзакцией.
	Попытка
		бит_ОтветитьНаCallbackMAX(Callback,
			Новый Структура("text,attachments,notify", ТекстОтвета, Новый Массив, Ложь), Бот);
	Исключение
		Если ТранзакцияАктивна() Тогда ВызватьИсключение; КонецЕсли;
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Отделения.Ответ", УровеньЖурналаРегистрации.Ошибка,
			, , "MAX не подтвердил обновление сообщения о выборе отделения.");
	КонецПопытки;

КонецПроцедуры

// Только серверный вызов внутри транзакции назначения отделения.
Процедура ЗаписатьВыборОтделенияMAX(Контакт, Бот, Отделение, ИдентификаторСобытия = "") Экспорт

	// Старые серверные вызовы без callback получают отдельное событие назначения.
	Если ПустаяСтрока(ИдентификаторСобытия) Тогда ИдентификаторСобытия = Строка(Новый УникальныйИдентификатор); КонецЕсли;
	Идентификатор = "department:" + ИдентификаторСобытия;
	Если Не СообщениеЧатаУжеЗаписаноMAX(Идентификатор, Контакт, Бот, Истина) Тогда
		ПеревестиЗакрытыйДиалогВНовыйMAX(Контакт, Бот);
		ЗаписатьСообщениеЧатаMAX(Идентификатор, Контакт, Бот, Истина,
			"Пациент выбрал отделение: " + Строка(Отделение) + ".",
			"text", "Пациент", "Получено", "", "");
	КонецЕсли;

КонецПроцедуры

Процедура ОтправитьОтказВАторизацииMAX(Контакт, Бот, Причина)

	ЗаписьЖурналаРегистрации(
		"ОМНИ.MAX.Авторизация", УровеньЖурналаРегистрации.Предупреждение, , Контакт, Причина);

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Если Не ОтправитьСтандартноеСообщениеMAX("MAX_AUTH_DENIED", Контакт, Бот, Новый Структура("reason", Причина)) Тогда
		ОтправитьТекстовоеСообщение(
			"Не удалось выполнить авторизацию. Пожалуйста, свяжитесь с клиникой.", Контакт, Бот);
	КонецЕсли;

КонецПроцедуры

Функция ОтправитьСтандартноеСообщениеMAX(ИдентификаторШаблона, Контакт, Бот, Контекст = Неопределено)

	Шаблон = Справочники.бит_омни_ШаблоныСообщений.СтандартныйШаблон(ИдентификаторШаблона);
	Если Шаблон.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	Результат = ОтправитьСообщение(Шаблон, Контакт, Бот, Контекст);
	Если ЗначениеСвойства(Результат, "success", Ложь) = Истина
		Или ЗначениеСвойства(Результат, "accepted", Ложь) = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	// Не посылаем резервный текст после неизвестной доставки уже подготовленного шаблона.
	ВызватьИсключение СтроковоеСвойство(Результат, "message", "Отправка стандартного сообщения MAX не подтверждена.");

КонецФункции

Функция НормализоватьVCFMAX(VCF)

	Результат = СтрЗаменить(VCF, "\r\n", Символы.ВК + Символы.ПС);
	Результат = СтрЗаменить(Результат, "\n", Символы.ПС);
	Возврат Результат;

КонецФункции

Функция НомерТелефонаИзVCFMAX(VCF)

	СтрокиVCF = СтрРазделить(СтрЗаменить(VCF, Символы.ВК, ""), Символы.ПС, Ложь);
	Для Каждого СтрокаVCF Из СтрокиVCF Цикл
		Если Лев(ВРег(СтрокаVCF), 3) <> "TEL" Тогда
			Продолжить;
		КонецЕсли;

		ПозицияРазделителя = СтрНайти(СтрокаVCF, ":");
		Если ПозицияРазделителя > 0 Тогда
			Возврат СокрЛП(Сред(СтрокаVCF, ПозицияРазделителя + 1));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция HMACSHA256MAX(Ключ, Данные)

	РазмерБлока = 64;
	БуферКлюча = ПолучитьБуферДвоичныхДанныхИзСтроки(Ключ, КодировкаТекста.UTF8, Ложь);

	Если БуферКлюча.Размер > РазмерБлока Тогда
		ХешКлюча = Новый ХешированиеДанных(ХешФункция.SHA256);
		ХешКлюча.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферКлюча));
		БуферКлюча = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ХешКлюча.ХешСумма);
	КонецЕсли;

	КлючБлока = Новый БуферДвоичныхДанных(РазмерБлока);
	КлючБлока.Записать(0, БуферКлюча);

	ВнутреннийКлюч = Новый БуферДвоичныхДанных(РазмерБлока);
	ВнешнийКлюч = Новый БуферДвоичныхДанных(РазмерБлока);
	Для Индекс = 0 По РазмерБлока - 1 Цикл
		ВнутреннийКлюч.Установить(Индекс, 54);
		ВнешнийКлюч.Установить(Индекс, 92);
	КонецЦикла;
	ВнутреннийКлюч.ЗаписатьПобитовоеИсключительноеИли(0, КлючБлока);
	ВнешнийКлюч.ЗаписатьПобитовоеИсключительноеИли(0, КлючБлока);

	ВнутреннийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	ВнутреннийХеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ВнутреннийКлюч));
	ВнутреннийХеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Данные, КодировкаТекста.UTF8, Ложь));

	ВнешнийХеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	ВнешнийХеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ВнешнийКлюч));
	ВнешнийХеш.Добавить(ВнутреннийХеш.ХешСумма);

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ВнешнийХеш.ХешСумма));

КонецФункции

Функция ХешиРавныMAX(ПервыйХеш, ВторойХеш)

	Если СтрДлина(ПервыйХеш) <> СтрДлина(ВторойХеш) Тогда
		Возврат Ложь;
	КонецЕсли;

	РезультатСравнения = 0;
	Для Индекс = 1 По СтрДлина(ПервыйХеш) Цикл
		Если Сред(ПервыйХеш, Индекс, 1) <> Сред(ВторойХеш, Индекс, 1) Тогда
			РезультатСравнения = РезультатСравнения + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат РезультатСравнения = 0;

КонецФункции

Функция ЭтоШаблонСообщенияMAX(ПараметрыСообщения)

	ТипПараметров = ТипЗнч(ПараметрыСообщения);

	Возврат ТипПараметров = Тип("СправочникСсылка.бит_омни_ШаблоныСообщений") Или ТипПараметров = Тип(
		"СправочникОбъект.бит_омни_ШаблоныСообщений");

КонецФункции

Функция ПолучателиСообщенияMAX(Получатели)

	Результат = Новый Массив;

	Если ТипЗнч(Получатели) = Тип("Массив") Тогда
		ИсходныеПолучатели = Получатели;
	Иначе
		ИсходныеПолучатели = Новый Массив;
		ИсходныеПолучатели.Добавить(Получатели);
	КонецЕсли;

	Для Каждого Получатель Из ИсходныеПолучатели Цикл

		Если Получатель = Неопределено Или Получатель = Null Тогда
			Продолжить;
		КонецЕсли;

		Если Результат.Найти(Получатель) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ПолучательЗаблокированMAX(Получатель) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Получатель);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучательСообщенияMAX(Получатель, Бот)

	ДоступныеТипыПолучателей = ДоступныеТипыПолучателейMAX();

	Если ДоступныеТипыПолучателей.СодержитТип(ТипЗнч(Получатель)) Тогда
		Получатель = НайтиКонтактПоДанным1С(Получатель, Бот);
	КонецЕсли;

	Если Получатель.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Получатель;

КонецФункции

Функция ДоступныеТипыПолучателейMAX()

	Возврат Метаданные.Справочники.бит_омни_Контакты.Реквизиты.Получатель.Тип;

КонецФункции
Функция ПолучательЗаблокированMAX(Получатель)

	Если ТипЗнч(Получатель) <> Тип("СправочникСсылка.бит_омни_Контакты") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Получатель.Пустая() Тогда
		Возврат Истина;
	КонецЕсли;

	РеквизитыПолучателя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Получатель, "Заблокирован");
	Возврат РеквизитыПолучателя.Заблокирован;

КонецФункции

Функция ТелоСообщенияMAX(ПараметрыСообщения)

	Если ТипЗнч(ПараметрыСообщения) = Тип("Строка") Или ТипЗнч(ПараметрыСообщения) = Тип("ФорматированнаяСтрока") Тогда
		Возврат Новый Структура("text", Строка(ПараметрыСообщения));
	КонецЕсли;

	Если ТипЗнч(ПараметрыСообщения) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЕстьТекст = ЗначениеЗаполнено(СтроковоеСвойство(ПараметрыСообщения, "text"));
	ЕстьВложения = ЗначениеСвойства(ПараметрыСообщения, "attachments") <> Неопределено;

	Если Не ЕстьТекст И Не ЕстьВложения Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПараметрыСообщения;

КонецФункции

Функция ПараметрыАдресата(Получатель, Бот)

	Если ТипЗнч(Получатель) = Тип("СправочникСсылка.бит_омни_Контакты") Тогда

		Если Получатель.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;

		РеквизитыПолучателя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Получатель, "Идентификатор");
		Если ЗначениеЗаполнено(РеквизитыПолучателя.Идентификатор) Тогда
			Возврат Новый Структура("Параметр, Значение", "user_id", СтрокаИдентификатора(
				РеквизитыПолучателя.Идентификатор));
		КонецЕсли;

		Возврат Неопределено;

	КонецЕсли;

	Если ТипЗнч(Получатель) = Тип("Структура") Тогда

		Если ЗначениеЗаполнено(ЗначениеСвойства(Получатель, "chat_id")) Тогда
			Возврат Новый Структура("Параметр, Значение", "chat_id", СтрокаИдентификатора(Получатель.chat_id));
		ИначеЕсли ЗначениеЗаполнено(ЗначениеСвойства(Получатель, "user_id")) Тогда
			Возврат Новый Структура("Параметр, Значение", "user_id", СтрокаИдентификатора(Получатель.user_id));
		КонецЕсли;

		Возврат Неопределено;

	КонецЕсли;

	Если ТипЗнч(Получатель) = Тип("Число") Или ТипЗнч(Получатель) = Тип("Строка") Тогда
		Возврат Новый Структура("Параметр, Значение", "user_id", СтрокаИдентификатора(Получатель));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НайтиКонтактПоДанным1С(Ссылка, Бот)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				   |	бит_омни_Контакты.Ссылка КАК Ссылка
				   |ИЗ
				   |	Справочник.бит_омни_Контакты КАК бит_омни_Контакты
				   |ГДЕ
				   |	бит_омни_Контакты.Получатель = &Ссылка
				   |	И бит_омни_Контакты.Бот = &Бот
				   |	И бит_омни_Контакты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
				   |	И НЕ бит_омни_Контакты.ПометкаУдаления
				   |	И НЕ бит_омни_Контакты.Заблокирован";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Бот", Бот);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();

КонецФункции
Функция НайтиКонтактMAX(ИдентификаторПользователя, Бот)

	ПустойКонтакт = Справочники.бит_омни_Контакты.ПустаяСсылка();
	Если ТипЗнч(ИдентификаторПользователя) <> Тип("Число") Тогда
		Возврат ПустойКонтакт;
	КонецЕсли;
	Если ИдентификаторПользователя <= 0 Или ИдентификаторПользователя <> Цел(ИдентификаторПользователя)
		Или ИдентификаторПользователя > 999999999999999 Тогда
		Возврат ПустойКонтакт;
	КонецЕсли;
	Если ТипЗнч(Бот) <> Тип("СправочникСсылка.бит_омни_Боты") Или Не ЗначениеЗаполнено(Бот) Тогда
		Возврат ПустойКонтакт;
	КонецЕсли;
	ЗаписьИдентичности = РегистрыСведений.бит_омни_ИдентичностиКонтактовMAX.СоздатьМенеджерЗаписи();
	ЗаписьИдентичности.Бот = Бот;
	ЗаписьИдентичности.Идентификатор = ИдентификаторПользователя;
	ЗаписьИдентичности.Прочитать();
	Если ЗаписьИдентичности.Выбран() Тогда
		// Поврежденная существующая привязка не разрешает выбирать другой контакт.
		Контакт = ЗаписьИдентичности.Контакт;
	Иначе
		Контакт = бит_омни_НадежныйОбменMAX.ПолучитьСуществующийКонтакт(ИдентификаторПользователя, Бот);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Контакт) Тогда
		Возврат ПустойКонтакт;
	КонецЕсли;
	Если Контакт.ПометкаУдаления Или Контакт.Заблокирован Или Контакт.Бот <> Бот
		Или Контакт.Идентификатор <> ИдентификаторПользователя
		Или Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		Возврат ПустойКонтакт;
	КонецЕсли;
	Возврат Контакт;

КонецФункции

Процедура УстановитьБлокировкуКонтакта(Контакт, Заблокирован)

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	КонтактОбъект = Контакт.ПолучитьОбъект();
	Если КонтактОбъект.Заблокирован = Заблокирован Тогда
		Возврат;
	КонецЕсли;

	КонтактОбъект.Заблокирован = Заблокирован;
	КонтактОбъект.ОбменДанными.Загрузка = Истина;
	КонтактОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	КонтактОбъект.Записать();

КонецПроцедуры

Функция ПредставлениеПользователяMAX(User)

	Имя = СтроковоеСвойство(User, "first_name");
	Фамилия = СтроковоеСвойство(User, "last_name");
	ИмяУстаревшее = СтроковоеСвойство(User, "name");
	Username = СтроковоеСвойство(User, "username");

	Представление = СокрЛП(Имя + " " + Фамилия);
	Если ПустаяСтрока(Представление) Тогда
		Представление = ИмяУстаревшее;
	КонецЕсли;

	Если ПустаяСтрока(Представление) Тогда
		Представление = Username;
	КонецЕсли;

	Если ПустаяСтрока(Представление) Тогда
		Представление = СтрокаИдентификатора(ЗначениеСвойства(User, "user_id"));
	КонецЕсли;

	Возврат Представление;

КонецФункции

Функция ТекстСообщенияMAX(Сообщение)

	Тело = ЗначениеСвойства(Сообщение, "body");
	Возврат СтроковоеСвойство(Тело, "text");

КонецФункции

Функция ИдентификаторВходящегоСообщенияMAX(Сообщение)
	Идентификатор = СтроковоеСвойство(ЗначениеСвойства(Сообщение, "body"), "mid");
	Если Не ПустаяСтрока(Идентификатор) Тогда Возврат Лев(Идентификатор, 150); КонецЕсли;
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(СтруктураВJSON(Сообщение), КодировкаТекста.UTF8, Ложь));
	Возврат "incoming:" + НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Процедура ЗаписатьВходящееСообщениеMAX(Сообщение, Контакт, Бот)

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Тело = ЗначениеСвойства(Сообщение, "body");
	ИдентификаторСообщения = ИдентификаторВходящегоСообщенияMAX(Сообщение);
	Если СообщениеЧатаУжеЗаписаноMAX(ИдентификаторСообщения, Контакт, Бот, Истина) Тогда
		Возврат;
	КонецЕсли;

	Текст = СтроковоеСвойство(Тело, "text");
	Вложения = ЗначениеСвойства(Тело, "attachments");
	Если ПустаяСтрока(Текст) И (ТипЗнч(Вложения) <> Тип("Массив") Или Вложения.Количество() = 0) Тогда
		Возврат;
	КонецЕсли;
	ВидСообщения = ВидСообщенияMAX(Вложения);
	Если ПустаяСтрока(Текст) И Не ПустаяСтрока(ВидСообщения) Тогда
		Текст = СтрШаблон("[Вложение: %1]", ВидСообщения);
	КонецЕсли;

	Отправитель = ЗначениеСвойства(Сообщение, "sender");
	ЗаписатьСообщениеЧатаMAX(
		ИдентификаторСообщения,
		Контакт,
		Бот,
		Истина,
		Текст,
		ВидСообщения,
		ПредставлениеПользователяMAX(Отправитель),
		"Получено",
		"",
		JSONВложенийMAX(Вложения));

КонецПроцедуры

Процедура ЗаписатьИсходящееСообщениеMAX(
		ТелоСообщения,
		Получатель,
		Бот,
		ОтветMAX,
		КодСостояния,
		ТекстОтвета,
		ВидОтправителя = Неопределено,
		Пользователь = Неопределено)

	Если ТипЗнч(Получатель) <> Тип("СправочникСсылка.бит_омни_Контакты")
		Или Получатель.Пустая()
	Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторСообщения = ИдентификаторСообщенияИзОтветаMAX(ОтветMAX);
	Если ПустаяСтрока(ИдентификаторСообщения) Тогда
		ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	Текст = СтроковоеСвойство(ТелоСообщения, "text");
	Вложения = ЗначениеСвойства(ТелоСообщения, "attachments");
	ВидСообщения = ВидСообщенияMAX(Вложения);
	Если ПустаяСтрока(Текст) И Не ПустаяСтрока(ВидСообщения) Тогда
		Текст = СтрШаблон("[Вложение: %1]", ВидСообщения);
	КонецЕсли;

	// Оператор передает себя явно, все остальные исходящие пишет бот.
	Если ВидОтправителя = Неопределено Тогда
		ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Бот;
	КонецЕсли;

	Если ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Оператор
		И ЗначениеЗаполнено(Пользователь) Тогда
		Автор = Строка(Пользователь);
	Иначе
		Автор = НСтр("ru='Клиника'");
	КонецЕсли;

	Классификация = КлассифицироватьОтветОчередиMAX(КодСостояния, ОтветMAX);
	ЗаписатьСообщениеЧатаMAX(
		ИдентификаторСообщения,
		Получатель,
		Бот,
		Ложь,
		Текст,
		ВидСообщения,
		Автор,
		Классификация.Состояние,
		Классификация.ОписаниеОшибки,
		JSONВложенийMAX(Вложения),
		ВидОтправителя,
		Пользователь);

КонецПроцедуры

Процедура ЗаписатьСообщениеЧатаMAX(
		ИдентификаторСообщения,
		Контакт,
		Бот,
		Входящее,
		Текст,
		ВидСообщения,
		Автор,
		Статус,
		ОписаниеОшибки,
		ДанныеВложений,
		ВидОтправителя = Неопределено,
		Пользователь = Неопределено)

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ИдентификаторСообщения = Лев(ИдентификаторСообщения, 150);
	Запись.Контакт = Контакт;
	Запись.Бот = ДанныеБота.Ссылка;
	Запись.Входящее = Входящее;
	Запись.Текст = Текст;
	Запись.ВидСообщения = Лев(ВидСообщения, 50);
	Запись.Автор = Лев(Автор, 150);
	Запись.Прочитано = Не Входящее;
	Запись.Статус = Лев(Статус, 30);
	Запись.ОписаниеОшибки = ОписаниеОшибки;
	Запись.ДанныеВложений = ДанныеВложений;

	Если ВидОтправителя = Неопределено Тогда
		ВидОтправителя = ?(Входящее,
			Перечисления.бит_омни_ВидыОтправителейMAX.Пациент,
			Перечисления.бит_омни_ВидыОтправителейMAX.Бот);
	КонецЕсли;
	Запись.ВидОтправителя = ВидОтправителя;
	Запись.Пользователь = ?(Пользователь = Неопределено, Справочники.Пользователи.ПустаяСсылка(), Пользователь);

	Запись.Записать();

КонецПроцедуры

Функция СообщениеЧатаУжеЗаписаноMAX(ИдентификаторСообщения, Контакт, Бот, Входящее)

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				   |	ИсторияЧатов.Период КАК Период
				   |ИЗ
				   |	РегистрСведений.бит_омни_ИсторияЧатовMAX КАК ИсторияЧатов
				   |ГДЕ
				   |	ИсторияЧатов.ИдентификаторСообщения = &ИдентификаторСообщения
				   |	И ИсторияЧатов.Контакт = &Контакт
				   |	И ИсторияЧатов.Бот = &Бот
				   |	И ИсторияЧатов.Входящее = &Входящее
				   |ОБЪЕДИНИТЬ ВСЕ
				   |ВЫБРАТЬ ПЕРВЫЕ 1 Архив.Период
				   |ИЗ РегистрСведений.бит_омни_АрхивЧатовMAX КАК Архив
				   |ГДЕ Архив.ИдентификаторСообщения = &ИдентификаторСообщения
				   | И Архив.Контакт = &Контакт И Архив.Бот = &Бот
				   | И Архив.Входящее = &Входящее";

	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", ДанныеБота.Ссылка);
	Запрос.УстановитьПараметр("Входящее", Входящее);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ИдентификаторСообщенияИзОтветаMAX(ОтветMAX)

	Тело = ЗначениеСвойства(ОтветMAX, "body");
	Идентификатор = СтроковоеСвойство(Тело, "mid");
	Если Не ПустаяСтрока(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;

	Сообщение = ЗначениеСвойства(ОтветMAX, "message");
	Тело = ЗначениеСвойства(Сообщение, "body");
	Идентификатор = СтроковоеСвойство(Тело, "mid");
	Если Не ПустаяСтрока(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;

	Возврат СтроковоеСвойство(ОтветMAX, "mid");

КонецФункции

Функция ВидСообщенияMAX(Вложения)

	Если ТипЗнч(Вложения) <> Тип("Массив") Или Вложения.Количество() = 0 Тогда
		Возврат "text";
	КонецЕсли;

	Возврат СтроковоеСвойство(Вложения[0], "type", "attachment");

КонецФункции

Функция JSONВложенийMAX(Вложения)

	Если ТипЗнч(Вложения) <> Тип("Массив") Или Вложения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат СтруктураВJSON(Вложения);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ЭтоКомандаMAX(ТекстСообщения)

	Возврат ЗначениеЗаполнено(ТекстСообщения) И Лев(СокрЛП(ТекстСообщения), 1) = "/";

КонецФункции

Функция КомандаИзТекста(ТекстСообщения)

	ЧастиКоманды = СтрРазделить(СокрЛП(ТекстСообщения), " ");
	Если ЧастиКоманды.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ЧастиКоманды[0];

КонецФункции

Функция СтроковоеСвойство(Данные, ИмяСвойства, ЗначениеПоУмолчанию = "")

	Значение = ЗначениеСвойства(Данные, ИмяСвойства, ЗначениеПоУмолчанию);
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЗначениеСвойства(Данные, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если Данные.Свойство(ИмяСвойства, Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция СтрокаИдентификатора(Идентификатор)

	Если Идентификатор = Неопределено Или Идентификатор = Null Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Идентификатор) = Тип("Число") Тогда
		Возврат Формат(Идентификатор, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(Строка(Идентификатор));

КонецФункции

// Восстанавливаем исходный режим вызывающего кода, в том числе после исключения.
// BSLLS:DisableSafeMode-off
Процедура ВыполнитьОбработчик(Обработчик, Сообщение, Контакт, Бот)

	БылБезопасныйРежим = БезопасныйРежим();
	Попытка
		УстановитьБезопасныйРежим(Истина);
		Выполнить (СтрШаблон("%1(Сообщение, Контакт, Бот);", Обработчик));
		УстановитьБезопасныйРежим(БылБезопасныйРежим);
	Исключение
		УстановитьБезопасныйРежим(БылБезопасныйРежим);
		//@skip-check undefined-type
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.ОшибкаОбработчика", УровеньЖурналаРегистрации.Ошибка, , , 
