#Область ПрограммныйИнтерфейс

// Одна HTTP-попытка сохраненного outbox, вне любой бизнес-транзакции.
// Возвращаем единый контракт классификатора; история относится к UUID именно этой попытки.
Функция бит_ОтправитьНамерениеMAX(Намерение) Экспорт
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "HTTP MAX внутри транзакции запрещен."; КонецЕсли;
	Результат = Новый Структура("Состояние,ИдентификаторСообщения,ОписаниеОшибки,КодHTTP", "Ошибка", "", "", 0);
	Попытка
		Тело = JSONВСтруктуру(Намерение.ТелоJSON);
		Если Намерение.Бот.ПометкаУдаления Или Не Намерение.Бот.Использовать
			Или Намерение.Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
			ВызватьИсключение "Бот недоступен.";
		КонецЕсли;
		Если Намерение.Вид = "callback" Тогда
			Адресат = JSONВСтруктуру(Намерение.АдресатJSON);
			ПроверитьСнимокCallbackMAX(Намерение.Бот, Намерение.Контакт, Тело, Адресат);
		ИначеЕсли ЗначениеЗаполнено(Намерение.Контакт) Тогда
			Адресат = JSONВСтруктуру(Намерение.АдресатJSON);
			Если Намерение.Контакт.ПометкаУдаления Или Намерение.Контакт.Заблокирован
				Или Намерение.Контакт.Бот <> Намерение.Бот
				Или Намерение.Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX
				Или СтроковоеСвойство(Адресат, "Значение") <> СтрокаИдентификатора(Намерение.Контакт.Идентификатор)
				Или СтроковоеСвойство(Адресат, "ОтпечатокПолучателя") <> ОтпечатокПолучателяКонтактаMAX(Намерение.Контакт) Тогда
				ВызватьИсключение "Контакт или привязка пациента изменились после подготовки сообщения.";
			КонецЕсли;
		ИначеЕсли Намерение.Вид = "message" Тогда
			ВызватьИсключение "Не определен контакт сообщения.";
		КонецЕсли;
		Если Намерение.Вид = "message" Тогда
			//+бит_Сафаров ШИ 17.09.2026
			Если СтрНайти(СтроковоеСвойство(Тело, "text"), "[бит_ДолгПослеЗаписиMAX]") > 0 Тогда
				Если Не бит_ОбновитьТелоДолгаПередОтправкойMAX(Тело, Намерение.Контакт) Тогда
					Результат.Состояние = "Отправлено";
					Результат.ОписаниеОшибки = "Долг не положительный; сообщение пациенту не требовалось.";
					Возврат Результат;
				КонецЕсли;
			КонецЕсли;
			//-бит_Сафаров ШИ 17.09.2026
			Если ТелоСообщенияMAX(Тело) = Неопределено Тогда ВызватьИсключение "Пустой снимок сообщения."; КонецЕсли;
			Тело.Вставить("client_message_id", Намерение.Ключ);
		ИначеЕсли Намерение.Вид <> "callback" Тогда
			ВызватьИсключение "Неизвестный вид намерения.";
		КонецЕсли;
	Исключение
		Результат.ОписаниеОшибки = "Снимок, контакт или настройки изменились. Отправка не выполнялась.";
		Если Намерение.Вид = "callback" Тогда
			// Некорректный снимок не исправится повторной HTTP-попыткой.
			Результат.Состояние = "Отменено";
			Результат.ОписаниеОшибки = "Некорректный или устаревший снимок callback MAX; требуется повторное действие пользователя."
				+ " Отправка не выполнялась.";
		КонецЕсли;
		Возврат Результат;
	КонецПопытки;

	Если Намерение.Вид = "message" Тогда
		Попытка
			ДоHTTP = Новый Структура("Состояние,ОписаниеОшибки", "Неопределено",
				"Попытка зафиксирована до HTTP. Итог еще не получен; перед повтором проверьте MAX.");
			бит_СохранитьИсториюНамеренияMAX(Намерение, Тело, ДоHTTP);
		Исключение
			Результат.ОписаниеОшибки = "Не удалось сохранить попытку в истории. Отправка не выполнялась.";
			Возврат Результат;
		КонецПопытки;
	КонецЕсли;
	Попытка
		Если Намерение.Вид = "callback" Тогда
			Ответ = ВыполнитьЗапросVDS("/api/v1/onec/callbacks/answer", Тело);
			Если ЗначениеСвойства(Ответ, "ok", Ложь) = Истина Тогда
				Результат.Состояние = "Отправлено";
				Результат.КодHTTP = 200;
			Иначе
				Результат.Состояние = "Неопределено";
				Результат.ОписаниеОшибки = "MAX не подтвердил обновление сообщения.";
			КонецЕсли;
		Иначе
			Если ИспользоватьОбменЧерезVDS() Тогда
				ОтветHTTP = ОтправитьСообщениеЧерезVDS(Тело, Адресат);
			Иначе
				ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Намерение.Бот);
				ОтветHTTP = ОтправитьСообщениеНапрямуюВMAX(Тело, Адресат, ДанныеБота.Токен);
			КонецЕсли;
			ДанныеОтвета = ПрочитатьОтветMAX(ОтветHTTP);
			Результат = КлассифицироватьОтветФайлаMAX(ОтветHTTP.КодСостояния, ДанныеОтвета.Тело, Намерение.Ключ);
			Если Не ИспользоватьОбменЧерезVDS() Тогда
				Результат = КлассифицироватьОтветОчередиMAX(ОтветHTTP.КодСостояния, ДанныеОтвета.Тело);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат.Состояние = "Неопределено";
		Результат.ОписаниеОшибки = "Нет однозначного ответа MAX/VDS. Перед повтором проверьте MAX; автоматический повтор запрещен.";
	КонецПопытки;
	Если Намерение.Вид = "message" Тогда
		Попытка
			бит_СохранитьИсториюНамеренияMAX(Намерение, Тело, Результат);
		Исключение
			Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + " Не удалось обновить историю конкретной попытки.";
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура бит_СохранитьИсториюНамеренияMAX(Намерение, Тело, Результат)
	История = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	История.Период = Намерение.ДатаСоздания;
	История.ИдентификаторСообщения = Намерение.Ключ;
	История.Контакт = Намерение.Контакт;
	История.Бот = Намерение.Бот;
	История.Входящее = Ложь;
	История.Текст = СтроковоеСвойство(Тело, "text");
	История.ВидСообщения = ВидСообщенияMAX(ЗначениеСвойства(Тело, "attachments"));
	История.ДанныеВложений = JSONВложенийMAX(ЗначениеСвойства(Тело, "attachments"));
	История.ВидОтправителя = Намерение.ВидОтправителя;
	История.Пользователь = Намерение.Пользователь;
	История.Автор = ?(ЗначениеЗаполнено(Намерение.Пользователь), Лев(Строка(Намерение.Пользователь), 150), "Клиника");
	История.Прочитано = Истина;
	История.Статус = Результат.Состояние;
	История.ОписаниеОшибки = Результат.ОписаниеОшибки;
	История.Записать(Истина);
КонецПроцедуры

Процедура бит_ОтветитьНаCallbackMAX(Callback, Сообщение, Бот)
	Тело = Новый Структура("callback_id,message", СтроковоеСвойство(Callback, "callback_id"), Сообщение);
	Идентификатор = ЗначениеСвойства(ЗначениеСвойства(Callback, "user"), "user_id");
	Контакт = НайтиКонтактMAX(Идентификатор, Бот);
	// Callback относится к MAX sender, а не к выбранному в карточке пациенту.
	Адресат = Новый Структура("Параметр,Значение,ИдентификаторCallback",
		"user_id", СтрокаИдентификатора(Идентификатор), Тело.callback_id);
	ПроверитьСнимокCallbackMAX(Бот, Контакт, Тело, Адресат);
	Если Не ТранзакцияАктивна() Тогда
		ВыполнитьЗапросVDS("/api/v1/onec/callbacks/answer", Тело);
		Возврат;
	КонецЕсли;
	бит_омни_НадежныйОбменMAX.ПоставитьИсходящее(Бот, Контакт, "callback", Тело, Адресат);
КонецПроцедуры

Функция ИнформацияОБоте(Токен) Экспорт

	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(Токен);

	Запрос = Новый HTTPЗапрос("/me", Заголовки);
	Ответ = Соединение.Получить(Запрос);

	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
	Если Ответ.КодСостояния <> 200 Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Код ошибки: %1
														|Текст ошибки: %2", Ответ.КодСостояния, ДанныеОтвета.Текст));
		Возврат Неопределено;
	КонецЕсли;

	Возврат ДанныеОтвета.Тело;

КонецФункции

// Отправляет текстовое сообщение через бота в мессенджер MAX с возможностью указания форматирования.
//
// Параметры:
//   ТекстСообщения - Строка - текст отправляемого сообщения
//   Получатель - - получатель сообщения
//     - Массив из СправочникСсылка.бит_омни_Контакты, СправочникСсылка.Сотрудники, СправочникСсылка.Клиенты  
//     - СправочникСсылка.бит_омни_Контакты
//     - СправочникСсылка.Сотрудники
//     - СправочникСсылка.Клиенты
//   Бот - СправочникСсылка.бит_омни_Боты - идентификатор бота, от имени которого отправляется сообщение
//   Формат - Строка - форматирование текста сообщения (например, "markdown", "html")
//           - Неопределено - используется форматирование по умолчанию
//
// Возвращаемое значение:
//   см. бит_омни_ИнтеграцияСMAX.ОтправитьСообщение
Функция ОтправитьТекстовоеСообщение(ТекстСообщения, Получатель, Бот, Формат = Неопределено,
	ВидОтправителя = Неопределено, Пользователь = Неопределено) Экспорт

	ПараметрыСообщения = Новый Структура("text", ТекстСообщения);

	Если ЗначениеЗаполнено(Формат) Тогда
		ПараметрыСообщения.Вставить("format", Формат);
	КонецЕсли;

	Возврат ОтправитьСообщение(ПараметрыСообщения, Получатель, Бот, , ВидОтправителя, Пользователь);

КонецФункции

Функция бит_ИзменитьСообщениеОператораMAX(Бот, ИдентификаторСообщения, Текст, Удалить) Экспорт

	//+бит_Сафаров ШИ 17.09.2026
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Изменение сообщения MAX внутри транзакции запрещено.";
	КонецЕсли;
	Если ТипЗнч(ИдентификаторСообщения) <> Тип("Строка")
		Или ПустаяСтрока(ИдентификаторСообщения)
		Или СтрДлина(ИдентификаторСообщения) > 150 Тогда
		ВызватьИсключение "Некорректный идентификатор сообщения MAX.";
	КонецЕсли;
	Для НомерСимвола = 1 По СтрДлина(ИдентификаторСообщения) Цикл
		Если СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.:",
			Сред(ИдентификаторСообщения, НомерСимвола, 1)) = 0 Тогда
			ВызватьИсключение "Идентификатор сообщения MAX содержит недопустимый символ.";
		КонецЕсли;
	КонецЦикла;

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Или ПустаяСтрока(ДанныеБота.Токен) Тогда
		ВызватьИсключение "Не настроен токен бота MAX для изменения сообщения.";
	КонецЕсли;

	Соединение = бит_омни_ИнтеграцияСMAXПовтИсп.СоединениеCAPI();
	Заголовки = ЗаголовкиMAX(ДанныеБота.Токен);
	Ресурс = "/messages?message_id=" + ИдентификаторСообщения;
	Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
	Если Удалить Тогда
		Ответ = Соединение.Удалить(Запрос);
	Иначе
		Заголовки.Вставить("Content-Type", "application/json");
		Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
		Запрос.УстановитьТелоИзСтроки(СтруктураВJSON(Новый Структура("text", Текст)),
			КодировкаТекста.UTF8);
		Ответ = Соединение.Изменить(Запрос);
	КонецЕсли;

	ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
	Если Ответ.КодСостояния <> 200 Или ТипЗнч(ДанныеОтвета.Тело) <> Тип("Структура")
		Или ЗначениеСвойства(ДанныеОтвета.Тело, "success") <> Истина Тогда
		ВызватьИсключение "MAX не подтвердил изменение сообщения (HTTP "
			+ Строка(Ответ.КодСостояния) + ").";
	КонецЕсли;
	Возврат Истина;
	//-бит_Сафаров ШИ 17.09.2026

КонецФункции

// Отправляет сообщение через интеграцию с MAX одному или нескольким получателям
//
// Параметры:
//   ПараметрыСообщения - Структура, СправочникСсылка.бит_омни_ШаблоныСообщений - параметры сообщения (зависят от типа сообщения)
//   Получатель - Строка, Массив из Строка - идентификатор получателя или массив получателей
//   Бот - Строка - идентификатор бота
//   Контекст - Структура, Неопределено - дополнительные параметры для отправки сообщения
//
// Возвращаемое значение:
//   см. бит_омни_ИнтеграцияСMAX.ОтправитьСообщениеПолучателю
Функция ОтправитьСообщение(ПараметрыСообщения, Получатель, Бот, Контекст = Неопределено,
	ВидОтправителя = Неопределено, Пользователь = Неопределено) Экспорт

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не найден бот MAX'"));
	КонецЕсли;

	Получатели = ПолучателиСообщенияMAX(Получатель);
	Если ТипЗнч(Получатель) = Тип("Массив") Тогда

		РезультатыОтправки = Новый Массив;
		Для Каждого ТекущийПолучатель Из Получатели Цикл
			РезультатыОтправки.Добавить(ОтправитьСообщениеПолучателю(ПараметрыСообщения, ТекущийПолучатель, Бот,
				ДанныеБота, Контекст, ВидОтправителя, Пользователь));
		КонецЦикла;

		Возврат РезультатыОтправки;

	КонецЕсли;

	Если Получатели.Количество() = 0 Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не определен получатель сообщения MAX'"));
	КонецЕсли;

	Возврат ОтправитьСообщениеПолучателю(ПараметрыСообщения, Получатели[0], Бот, ДанныеБота, Контекст,
		ВидОтправителя, Пользователь);

КонецФункции

// Подготовка внутри транзакции записи объекта: только разрешение адресата и рендер.
// JSON является снимком, токены и заголовки авторизации в него не добавляются.
Функция ПодготовитьСообщенияДляОчереди(Шаблон, Получатели, Бот, Контекст) Экспорт

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда ВызватьИсключение "Не найден бот MAX для очереди."; КонецЕсли;
	Если ТипЗнч(Получатели) = Тип("Массив") Тогда
		ИсходныеПолучатели = Получатели;
	Иначе
		ИсходныеПолучатели = Новый Массив;
		ИсходныеПолучатели.Добавить(Получатели);
	КонецЕсли;
	Результат = Новый Массив;
	Контакты = Новый Соответствие;
	Для Каждого Получатель Из ИсходныеПолучатели Цикл
		Если Получатель = Неопределено Или Получатель = Null Тогда
			ВызватьИсключение "Не определен получатель сообщения MAX для очереди.";
		КонецЕсли;
		Контакт = ПолучательСообщенияMAX(Получатель, Бот);
		Если ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или НЕ ЗначениеЗаполнено(Контакт) Тогда
			// Отсутствие MAX у обычного пациента не является ошибкой записи объекта.
			Продолжить;
		КонецЕсли;
		Если Контакт.ПометкаУдаления Или Контакт.Заблокирован Или Контакт.Бот <> Бот
			Или Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Или Контакт.Идентификатор <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Контакт.Получатель) = Тип("СправочникСсылка.Клиенты")
			И ЗначениеЗаполнено(Контакт.Получатель) И Контакт.Получатель.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Если Контакты.Получить(Контакт) <> Неопределено Тогда Продолжить; КонецЕсли;
		Адресат = ПараметрыАдресата(Контакт, Бот);
		Если Адресат = Неопределено Тогда Продолжить; КонецЕсли;
		Параметры = ПараметрыСообщенияMAX(Шаблон, Контакт, Контекст, ДанныеБота);
		Тело = ТелоСообщенияMAX(Параметры);
		Если Тело = Неопределено Тогда ВызватьИсключение "Не заполнены текст или вложения сообщения MAX."; КонецЕсли;
		//+бит_Сафаров ШИ 17.09.2026
		бит_ДобавитьОбращениеКПациентуMAX(Тело, Контакт);
		//-бит_Сафаров ШИ 17.09.2026
		// Только поля сообщения. Служебные ключи из произвольной структуры не сохраняются.
		Снимок = Новый Структура;
		Для Каждого Имя Из СтрРазделить("text,format,attachments,notify,disable_link_preview", ",") Цикл
			ЗначениеПоля = Неопределено;
			Если Тело.Свойство(Имя, ЗначениеПоля) Тогда Снимок.Вставить(Имя, ЗначениеПоля); КонецЕсли;
		КонецЦикла;
		Адресат.Вставить("ИдентификаторСообщенияКлиента", Строка(Новый УникальныйИдентификатор));
		Адресат.Вставить("ОтпечатокПолучателя", ОтпечатокПолучателяКонтактаMAX(Контакт));
		Результат.Добавить(Новый Структура("Контакт,ТелоJSON,АдресатJSON",
			Контакт, СтруктураВJSON(Снимок), СтруктураВJSON(Адресат)));
		Контакты.Вставить(Контакт, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Единственная попытка отправки сохраненного снимка. Никаких повторов, перерендера
// или нового поиска получателя. Вызывать после фиксации захвата очереди, вне транзакции.
Функция ОтправитьПодготовленноеСообщение(Бот, Контакт, ТелоJSON, АдресатJSON) Экспорт

	Результат = Новый Структура("Состояние,ИдентификаторСообщения,ОписаниеОшибки,КодHTTP", "Ошибка", "", "", 0);
	КодОтвета = 0;
	Попытка
		Тело = JSONВСтруктуру(ТелоJSON);
		Адресат = JSONВСтруктуру(АдресатJSON);
		ПроверитьСнимокОчередиMAX(Бот, Контакт, Тело, Адресат);
		ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
		ЧерезVDS = ИспользоватьОбменЧерезVDS();
		Если ДанныеБота = Неопределено Или (НЕ ЧерезVDS И ПустаяСтрока(ДанныеБота.Токен)) Тогда
			ВызватьИсключение "Не настроен бот MAX для отправки.";
		КонецЕсли;
	Исключение
		Результат.ОписаниеОшибки = "Предварительная проверка снимка, контакта или настроек MAX не пройдена. Отправка не выполнялась.";
		Возврат Результат;
	КонецПопытки;
	Попытка
		Если ЧерезVDS Тогда
			// Оболочка транспорта формируется из сохраненного адреса, не из карточки контакта.
			Тело.Вставить(Адресат.Параметр, Адресат.Значение);
			Тело.Вставить("client_message_id", Адресат.ИдентификаторСообщенияКлиента);
			Ответ = ОтправитьСообщениеЧерезVDS(Тело, Адресат);
		Иначе
			Ответ = ОтправитьСообщениеНапрямуюВMAX(Тело, Адресат, ДанныеБота.Токен);
		КонецЕсли;
		КодОтвета = Ответ.КодСостояния;
		ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
		Результат = КлассифицироватьОтветОчередиMAX(КодОтвета, ДанныеОтвета.Тело);
	Исключение
		Результат.Состояние = "Неопределено";
		Результат.КодHTTP = КодОтвета;
		Результат.ОписаниеОшибки = "Нет однозначного ответа MAX/VDS. Сообщение могло быть доставлено; автоматический повтор запрещен.";
	КонецПопытки;
	Попытка
		ИдентификаторИстории = ?(ПустаяСтрока(Результат.ИдентификаторСообщения),
			Адресат.ИдентификаторСообщенияКлиента, Результат.ИдентификаторСообщения);
		Вложения = ЗначениеСвойства(Тело, "attachments");
		ЗаписатьСообщениеЧатаMAX(ИдентификаторИстории, Контакт, Бот, Ложь,
			СтроковоеСвойство(Тело, "text"), ВидСообщенияMAX(Вложения), НСтр("ru='Клиника'"),
			Результат.Состояние, Результат.ОписаниеОшибки, JSONВложенийMAX(Вложения));
	Исключение
		// Подтвержденный MID не теряется из-за ошибки записи истории: нельзя повторять доставку.
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + " Не удалось записать историю чата.";
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Чистая классификация HTTP-ответа, экспорт для регрессионных тестов без сети.
Функция КлассифицироватьОтветОчередиMAX(КодСостояния, ТелоОтвета) Экспорт

	Результат = Новый Структура("Состояние,ИдентификаторСообщения,ОписаниеОшибки,КодHTTP", "Неопределено", "", "", КодСостояния);
	Если ЯвныйОтказОчередиMAX(КодСостояния) Тогда
		Результат.Состояние = "Ошибка";
		Результат.ОписаниеОшибки = "Отказ в отправке: HTTP " + Строка(КодСостояния) + ".";
		Возврат Результат;
	КонецЕсли;
	Результат.ОписаниеОшибки = "Результат отправки не подтвержден (HTTP " + Строка(КодСостояния) + "). Автоматический повтор запрещен.";
	Если КодСостояния < 200 Или КодСостояния >= 300 Или ТипЗнч(ТелоОтвета) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	ОтветMAX = ТелоОтвета;
	Если ТелоОтвета.Свойство("results") Или ТелоОтвета.Свойство("sent") Или ТелоОтвета.Свойство("failed") Тогда
		Результаты = ЗначениеСвойства(ТелоОтвета, "results");
		Если ТипЗнч(Результаты) <> Тип("Массив") Тогда Возврат Результат; КонецЕсли;
		Если Результаты.Количество() <> 1 Тогда Возврат Результат; КонецЕсли;
		Отправка = Результаты[0];
		Если ТипЗнч(Отправка) <> Тип("Структура") Тогда Возврат Результат; КонецЕсли;
		Если ЗначениеСвойства(ТелоОтвета, "ok") = Ложь И ЗначениеСвойства(ТелоОтвета, "sent") = 0
			И ЗначениеСвойства(ТелоОтвета, "failed") = 1 И ЗначениеСвойства(Отправка, "ok") = Ложь Тогда
			// Новый backend не передает текст исключения, а явно классифицирует доставку.
			// Незнакомый или неоднозначный статус никогда не разрешает повтор.
			Если Отправка.Свойство("delivery_status") Тогда
				Если СтроковоеСвойство(Отправка, "delivery_status") = "not_sent" Тогда
					Результат.Состояние = "Ошибка";
					Результат.ОписаниеОшибки = "MAX/VDS явно отклонил сообщение. Отправка не выполнена.";
				КонецЕсли;
				Возврат Результат;
			КонецЕсли;
			ТекстОшибки = СтроковоеСвойство(Отправка, "error");
			ЧастиОшибки = СтрРазделить(ТекстОшибки, ":", Истина);
			Если ЧастиОшибки.Количество() >= 2 И ЧастиОшибки[0] = "max_api_request_failed" Тогда
				Для Каждого КодОтказа Из СтрРазделить("400,401,403,404,422,429", ",") Цикл
					Если ЧастиОшибки[1] = КодОтказа Тогда
						Результат.Состояние = "Ошибка";
						Результат.ОписаниеОшибки = "MAX отклонил сообщение: HTTP " + КодОтказа + ".";
						Возврат Результат;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
		Если ЗначениеСвойства(ТелоОтвета, "ok") <> Истина Или ЗначениеСвойства(ТелоОтвета, "sent") <> 1
			Или ЗначениеСвойства(ТелоОтвета, "failed") <> 0 Или ЗначениеСвойства(Отправка, "ok") <> Истина Тогда
			Возврат Результат;
		КонецЕсли;
		ОтветMAX = ЗначениеСвойства(Отправка, "max_response");
	КонецЕсли;
	Если ЗначениеСвойства(ОтветMAX, "success") = Ложь Или ЗначениеСвойства(ОтветMAX, "ok") = Ложь Тогда
		Возврат Результат;
	КонецЕсли;
	СообщениеОтвета = ЗначениеСвойства(ОтветMAX, "message", ОтветMAX);
	ТелоСообщенияОтвета = ЗначениеСвойства(СообщениеОтвета, "body", СообщениеОтвета);
	Идентификатор = ЗначениеСвойства(ТелоСообщенияОтвета, "mid");
	Если ТипЗнч(Идентификатор) = Тип("Строка") И НЕ ПустаяСтрока(Идентификатор) Тогда
		Результат.Состояние = "Отправлено";
		Результат.ИдентификаторСообщения = Идентификатор;
		Результат.ОписаниеОшибки = "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОтправитьСообщениеПолучателю(ПараметрыСообщения, Получатель, Бот, ДанныеБота, Контекст,
	ВидОтправителя = Неопределено, Пользователь = Неопределено)

	ПолучательСообщения = ПолучательСообщенияMAX(Получатель, Бот);
	Адресат = ПараметрыАдресата(ПолучательСообщения, Бот);
	Если Адресат = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не определен получатель сообщения MAX'"));
	КонецЕсли;

	ПараметрыТекущегоСообщения = ПараметрыСообщенияMAX(
		ПараметрыСообщения, ПолучательСообщения, Контекст, ДанныеБота);
	ТелоСообщения = ТелоСообщенияMAX(ПараметрыТекущегоСообщения);
	Если ТелоСообщения = Неопределено Тогда
		Возврат Новый Структура("success, message", Ложь, НСтр("ru='Не заполнен текст или вложения сообщения MAX'"));
	КонецЕсли;
	//+бит_Сафаров ШИ 17.09.2026
	Если ВидОтправителя <> Перечисления.бит_омни_ВидыОтправителейMAX.Оператор Тогда
		бит_ДобавитьОбращениеКПациентуMAX(ТелоСообщения, ПолучательСообщения);
	КонецЕсли;
	//-бит_Сафаров ШИ 17.09.2026

	Адресат.Вставить("ОтпечатокПолучателя", ОтпечатокПолучателяКонтактаMAX(ПолучательСообщения));
	Если ТранзакцияАктивна() Тогда
		Возврат бит_омни_НадежныйОбменMAX.ПоставитьИсходящее(ДанныеБота.Ссылка, ПолучательСообщения,
			"message", ТелоСообщения, Адресат, ВидОтправителя, Пользователь);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Намерение = бит_омни_НадежныйОбменMAX.ПоставитьИсходящее(ДанныеБота.Ссылка, ПолучательСообщения,
			"message", ТелоСообщения, Адресат, ВидОтправителя, Пользователь);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат бит_омни_НадежныйОбменMAX.ОтправитьПоКлючу(Намерение.ИдентификаторПопытки);

КонецФункции

Процедура ВыполнитьРегламентныйОбменСVDS() Экспорт

	Если Не ИспользоватьОбменЧерезVDS() Тогда
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.VDS.Polling", УровеньЖурналаРегистрации.Информация, , ,
			НСтр("ru='VDS обмен MAX не настроен: пропуск регламентного задания'"));
		Возврат;
	КонецЕсли;

	Бот = ОсновнойБотMAX();
	Если Бот.Пустая() Тогда
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.VDS.Polling", УровеньЖурналаРегистрации.Предупреждение, , ,
			НСтр("ru='Не найден активный MAX-бот для обработки входящих сообщений'"));
		Возврат;
	КонецЕсли;

	Попытка
		// Проверка протокола не затрагивает очередь старого backend с удаляющей выдачей.
		Возможности = ВыполнитьЗапросVDS("/api/v1/onec/capabilities");
		Если ЗначениеСвойства(Возможности, "incoming_ack") <> Истина
			Или ЗначениеСвойства(Возможности, "callback_answer") <> Истина Тогда
			ВызватьИсключение "Сначала обновите backend VDS: необходим протокол claim/ACK и ответ на callback.";
		КонецЕсли;
		бит_омни_НадежныйОбменMAX.ОбработатьЛокальныеПовторы();
		бит_омни_НадежныйОбменMAX.ОтправитьОжидающие();
		НужноНастроитьКоманды = Ложь;
		Для НомерСообщения = 1 По ЛимитPollingVDS() Цикл
			Ответ = ПолучитьВходящиеСообщенияЧерезVDS(?(НомерСообщения = 1, ОжиданиеLongPollingVDS(), 0));
			ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
			Если Ответ.КодСостояния <> 200 Тогда
				ВызватьИсключение СтрШаблон("Ошибка получения очереди VDS: HTTP %1", Ответ.КодСостояния);
			КонецЕсли;
			Сообщения = ЗначениеСвойства(ДанныеОтвета.Тело, "messages");
			Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
				ВызватьИсключение "Некорректный формат очереди VDS.";
			КонецЕсли;
			Если Сообщения.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			СообщениеОчереди = Сообщения[0];
			Квитанция = СтроковоеСвойство(СообщениеОчереди, "receipt");
			Если ПустаяСтрока(Квитанция) Тогда
				ВызватьИсключение "Backend не вернул квитанцию claim/ACK.";
			КонецЕсли;
			Попытка
				Обновление = ЗначениеСвойства(СообщениеОчереди, "update");
				Если ТипЗнч(Обновление) <> Тип("Структура") Тогда
					ВызватьИсключение "Некорректное событие MAX в очереди.";
				КонецЕсли;
				Если Не бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот) Тогда
					Продолжить;
				КонецЕсли;
				НужноНастроитьКоманды = Истина;
				Квитанции = Новый Массив;
				Квитанции.Добавить(Квитанция);
				Подтверждение = ВыполнитьЗапросVDS("/api/v1/onec/messages/incoming/ack",
					Новый Структура("receipts", Квитанции));
				Если ЗначениеСвойства(Подтверждение, "acknowledged") <> 1 Тогда
					ВызватьИсключение "Квитанция VDS просрочена: событие будет доставлено повторно.";
				КонецЕсли;
			Исключение
				// Без ACK событие вернётся после lease; другие сообщения продолжаем обрабатывать.
				ЗаписьЖурналаРегистрации("ОМНИ.MAX.VDS.Processing",
					УровеньЖурналаРегистрации.Ошибка, , ,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Если ЗначениеСвойства(ДанныеОтвета.Тело, "remaining") = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НужноНастроитьКоманды Тогда
			// Выполняется после транзакции надежной обработки. Так меню появляется
			// и у пользователей, которые запустили бота до обновления расширения.
			НастроитьКомандыБотаMAX(Бот);
		КонецЕсли;
		бит_омни_НадежныйОбменMAX.ОтправитьОжидающие();

	Исключение
		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.VDS.Polling", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

КонецПроцедуры

Функция ОбработатьWebhook(HTTPЗапрос, Бот) Экспорт

	Попытка
		Обновление = бит_омни_ИнтеграцияСервер.ТелоЗапросаВСтруктуру(HTTPЗапрос);
		Если ТипЗнч(Обновление) <> Тип("Структура") Тогда
			Возврат бит_омни_ИнтеграцияСервер.ОтветСОшибкой("invalid_max_update");
		КонецЕсли;

		ОбработатьОбновление(Обновление, Бот);
		НастроитьКомандыБотаMAX(Бот);

		Возврат бит_омни_ИнтеграцияСервер.УспешныйОтвет(Новый Структура("success", Истина));

	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфоОшибки);

		ЗаписьЖурналаРегистрации(
			"ОМНИ.MAX.Webhook", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

		Возврат бит_омни_ИнтеграцияСервер.ОтветСОшибкой("max_webhook_error", 500, ТекстОшибки);
	КонецПопытки;

КонецФункции

// Телефон берем только из подписанного MAX контакта владельца диалога.
// История используется также для обращений, полученных до этой версии расширения.
Функция ПодтвержденныйТелефонКонтактаMAX(Контакт) Экспорт

	Если ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или Контакт.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	Бот = Контакт.Бот;
	Если Не ЗначениеЗаполнено(Бот) Или Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 20
	| История.ДанныеВложений КАК ДанныеВложений
	|ИЗ (
	|	ВЫБРАТЬ История.Период КАК Период, История.ДанныеВложений КАК ДанныеВложений
	|	ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
	|	ГДЕ История.Контакт = &Контакт И История.Бот = &Бот
	|	 И История.Входящее И История.ВидСообщения = &Вид
	|	ОБЪЕДИНИТЬ ВСЕ
	|	ВЫБРАТЬ Архив.Период, Архив.ДанныеВложений
	|	ИЗ РегистрСведений.бит_омни_АрхивЧатовMAX КАК Архив
	|	ГДЕ Архив.Контакт = &Контакт И Архив.Бот = &Бот
	|	 И Архив.Входящее И Архив.ВидСообщения = &Вид
	|) КАК История
	|УПОРЯДОЧИТЬ ПО История.Период УБЫВ";
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Вид", "contact");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Вложения = JSONВСтруктуру(Выборка.ДанныеВложений);
		Исключение
			Продолжить;
		КонецПопытки;
		Если ТипЗнч(Вложения) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вложение Из Вложения Цикл
			Если СтроковоеСвойство(Вложение, "type") <> "contact" Тогда
				Продолжить;
			КонецЕсли;
			Данные = ЗначениеСвойства(Вложение, "payload");
			Аккаунт = ЗначениеСвойства(Данные, "max_info");
			Если СтрокаИдентификатора(ЗначениеСвойства(Аккаунт, "user_id")) <> СтрокаИдентификатора(Контакт.Идентификатор) Тогда
				Продолжить;
			КонецЕсли;
			VCF = ЗначениеСвойства(Данные, "vcf_info", "");
			Если ТипЗнч(VCF) <> Тип("Строка") Или ПустаяСтрока(VCF) Тогда
				Продолжить;
			КонецЕсли;
			VCF = НормализоватьVCFMAX(VCF);
			Хеш = НРег(СтроковоеСвойство(Данные, "hash"));
			Если Не ПустаяСтрока(Хеш) И ХешиРавныMAX(Хеш, HMACSHA256MAX(Бот.Токен, VCF)) Тогда
				Возврат НомерТелефонаИзVCFMAX(VCF);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

// Привязка по осознанному выбору оператора, без автоматического создания пациента.
Процедура ПривязатьКонтактКПациентуMAX(Контакт, Пациент, Бот) Экспорт

	Если ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или Не ЗначениеЗаполнено(Контакт)
		Или ТипЗнч(Пациент) <> Тип("СправочникСсылка.Клиенты") Или Не ЗначениеЗаполнено(Пациент) Тогда
		ВызватьИсключение "Необходимо выбрать контакт MAX и пациента.";
	КонецЕсли;
	Если Пациент.ПометкаУдаления Или Пациент.ЭтоГруппа Тогда
		ВызватьИсключение "Нельзя привязать контакт к группе или удаленному пациенту.";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_омни_Контакты");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Контакт);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		ОбъектКонтакта = Контакт.ПолучитьОбъект();
		Если ОбъектКонтакта.ПометкаУдаления Или ОбъектКонтакта.Бот <> Бот
			Или ОбъектКонтакта.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
			ВызватьИсключение "Контакт диалога изменился. Обновите список и повторите выбор.";
		КонецЕсли;
		Если ЗначениеЗаполнено(ОбъектКонтакта.Получатель) И ОбъектКонтакта.Получатель <> Пациент Тогда
			ВызватьИсключение "Контакт уже привязан к другому пациенту. Существующая связь не изменена.";
		КонецЕсли;
		ОбъектКонтакта.Получатель = Пациент;
		ОбъектКонтакта.ОбменДанными.Загрузка = Истина;
		ОбъектКонтакта.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
		ОбъектКонтакта.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ОбработатьОбновление(Обновление, Бот, КонтекстПриема = Неопределено) Экспорт

	Если Не ТранзакцияАктивна() Тогда
		Если Не бит_омни_НадежныйОбменMAX.ОбработатьВходящее(Обновление, Бот) Тогда
			ВызватьИсключение "Сценарий MAX не завершен; событие сохранено для ограниченного повтора.";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если КонтекстПриема = Неопределено Тогда
		КонтекстПриема = СохранитьПриемОбновленияMAX(Обновление, Бот);
	КонецЕсли;
	Если ЗначениеСвойства(КонтекстПриема, "Дубль", Ложь) Тогда Возврат; КонецЕсли;
	Если КонтекстПриема.Свойство("КонтактUUID") Тогда
		КонтактПриема = Справочники.бит_омни_Контакты.ПолучитьСсылку(
			Новый УникальныйИдентификатор(КонтекстПриема.КонтактUUID));
		Если Не ПовторноеОбращениеАктуальноMAX(КонтактПриема, Бот, КонтекстПриема,
			КонтекстПриема.ИдентификаторСообщения, Дата(КонтекстПриема.ПериодСообщения)) Тогда
			ВызватьИсключение "Контекст входящего MAX устарел: диалог или маршрутизация изменились. Требуется разбор события.";
		КонецЕсли;
	КонецЕсли;

	ТипОбновления = СтроковоеСвойство(Обновление, "update_type");

	Если ТипОбновления = "message_created" Тогда
		ОбработатьСозданиеСообщения(Обновление, Бот, КонтекстПриема);
	ИначеЕсли ТипОбновления = "bot_started" Тогда
		ОбработатьЗапускБота(Обновление, Бот);
	ИначеЕсли ТипОбновления = "bot_stopped" Тогда
		ОбработатьОстановкуБота(Обновление, Бот);
	ИначеЕсли ТипОбновления = "message_callback" Тогда
		ОбработатьCallback(Обновление, Бот);
	Иначе
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Событие MAX пропущено'"));
	КонецЕсли;

КонецПроцедуры

// Только локальное сохранение приема, без сценариев, поиска телефона и исходящих.
// Контекст содержит только JSON-совместимые значения и фиксируется вместе с inbox.
Функция СохранитьПриемОбновленияMAX(Обновление, Бот) Экспорт

	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Прием MAX требует транзакции inbox."; КонецЕсли;
	Контекст = Новый Структура("Дубль,ПовторноеОбращение", Ложь, Ложь);
	ТипОбновления = СтроковоеСвойство(Обновление, "update_type");
	Если ТипОбновления = "message_created" Тогда
		Сообщение = ЗначениеСвойства(Обновление, "message");
	ИначеЕсли ТипОбновления = "bot_started" Тогда
		Сообщение = Новый Структура("sender,body", ЗначениеСвойства(Обновление, "user"),
			Новый Структура("text,mid", "Клиент начал диалог с ботом",
			"bot_started:" + СтроковоеСвойство(Обновление, "timestamp")));
	Иначе
		Возврат Контекст;
	КонецЕсли;
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда ВызватьИсключение "Нет сообщения MAX."; КонецЕсли;
	Отправитель = ЗначениеСвойства(Сообщение, "sender");
	Если ЗначениеСвойства(Отправитель, "is_bot", Ложь) Тогда
		Контекст.Дубль = Истина;
		Возврат Контекст;
	КонецЕсли;
	Контакт = ПолучитьКонтактПоUser(Отправитель, Бот);
	Если Контакт.Пустая() Тогда ВызватьИсключение "Не определен контакт входящего MAX."; КонецЕсли;
	// Общий lock с архивацией сериализует проверку в двух регистрах и запись.
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ИсторияЧатовMAX");
	Элемент.УстановитьЗначение("Контакт", Контакт);
	Элемент.УстановитьЗначение("Бот", Бот);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Тело = ЗначениеСвойства(Сообщение, "body");
	Идентификатор = ИдентификаторВходящегоСообщенияMAX(Сообщение);
	Если СообщениеЧатаУжеЗаписаноMAX(Идентификатор, Контакт, Бот, Истина) Тогда
		Контекст.Дубль = Истина;
		Возврат Контекст;
	КонецЕсли;
	// Запрещенные файлы не сохраняем и не отправляем отказ на стадии приема.
	РазрешенныеВложения = Новый Массив;
	Вложения = ЗначениеСвойства(Тело, "attachments");
	Если ТипЗнч(Вложения) = Тип("Массив") Тогда
		Для Каждого Вложение Из Вложения Цикл
			Если СтроковоеСвойство(Вложение, "type") = "contact" Тогда РазрешенныеВложения.Добавить(Вложение); КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Текст = СтроковоеСвойство(Тело, "text");
	Если ПустаяСтрока(Текст) И РазрешенныеВложения.Количество() = 0 Тогда Возврат Контекст; КонецЕсли;
	КопияСообщения = Новый Структура("sender,body", Отправитель,
		Новый Структура("text,mid,attachments", Текст, Идентификатор, РазрешенныеВложения));
	ЗаписатьВходящееСообщениеMAX(КопияСообщения, Контакт, Бот);
	ЗапросПриема = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Период ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX
	|ГДЕ Бот = &Бот И Контакт = &Контакт И Входящее И ИдентификаторСообщения = &Идентификатор");
	ЗапросПриема.УстановитьПараметр("Бот", Бот);
	ЗапросПриема.УстановитьПараметр("Контакт", Контакт);
	ЗапросПриема.УстановитьПараметр("Идентификатор", Идентификатор);
	ВыборкаПриема = ЗапросПриема.Выполнить().Выбрать();
	Если Не ВыборкаПриема.Следующий() Тогда
		ВызватьИсключение "Входящее MAX не сохранено в истории.";
	КонецЕсли;
	Если ТипОбновления = "bot_started" Тогда
		// Подтвержденный старт возобновляет остановленный контакт до проверки state.
		УстановитьБлокировкуКонтакта(Контакт, Ложь);
	КонецЕсли;
	Контекст = ФиксироватьОткрытиеДиалогаПриПриемеMAX(Контакт, Бот);
	Контекст.Вставить("Дубль", Ложь);
	Контекст.Вставить("КонтактUUID", Строка(Контакт.УникальныйИдентификатор()));
	Контекст.Вставить("ИдентификаторСообщения", Идентификатор);
	Контекст.Вставить("ПериодСообщения", Формат(ВыборкаПриема.Период, "ДФ=yyyyMMddHHmmss"));
	Возврат Контекст;

КонецФункции

Функция ПолучитьКонтактПоUser(User, Бот) Экспорт

	Если ТипЗнч(User) <> Тип("Структура") Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	ДанныеБота = бит_омни_ИнтеграцияСMAXПовтИсп.ДанныеБота(Бот);
	Если ДанныеБота = Неопределено Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	ИдентификаторПользователя = ЗначениеСвойства(User, "user_id");
	Если Не ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
		Возврат Справочники.бит_омни_Контакты.ПустаяСсылка();
	КонецЕсли;

	Возврат бит_омни_НадежныйОбменMAX.ПолучитьИлиСоздатьКонтакт(
		ИдентификаторПользователя, ДанныеБота.Ссылка, ПредставлениеПользователяMAX(User));

КонецФункции

#КонецОбласти

#Область ОбработкаВходящихСобытий

Процедура ОбработатьСозданиеСообщения(Обновление, Бот, КонтекстПриема)

	Сообщение = ЗначениеСвойства(Обновление, "message");
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Отправитель = ЗначениеСвойства(Сообщение, "sender");
	Если ЗначениеСвойства(Отправитель, "is_bot", Ложь) Тогда
		Возврат;
	КонецЕсли;

	Контакт = ПолучитьКонтактПоUser(Отправитель, Бот);
	ПовторноеОбращение = ЗначениеСвойства(КонтекстПриема, "ПовторноеОбращение", Ложь);
	Если ПовторноеОбращение Тогда
		ПараметрыМаршрутизации = ПодготовитьПовторноеОбращениеMAX(Контакт, Бот);
		Контакт = ПараметрыМаршрутизации.Контакт;
	КонецЕсли;
	ОтклонитьВходящиеВложенияMAX(Сообщение, Контакт, Бот);
	ТекстСообщения = ТекстСообщенияMAX(Сообщение);

	// Исходный текст уже зафиксирован стадией приема и при повторе не записывается.
	ОставшиесяВложения = ЗначениеСвойства(ЗначениеСвойства(Сообщение, "body"), "attachments");
	Если ПустаяСтрока(ТекстСообщения) И (ТипЗнч(ОставшиесяВложения) <> Тип("Массив")
		Или ОставшиесяВложения.Количество() = 0) Тогда Возврат; КонецЕсли;

	//+бит_Сафаров ШИ 17.09.2026
	//БЫЛО: Если ПовторноеОбращение Тогда
	//СТАЛО: сохраняем действующую маршрутизацию закрытого диалога.
	Если ПовторноеОбращение И Не ЗначениеЗаполнено(Контакт.ОтделениеMAX) Тогда
	//-бит_Сафаров ШИ 17.09.2026
		Если ТипЗнч(ОставшиесяВложения) = Тип("Массив") И ОставшиесяВложения.Количество() > 0 Тогда
			ПервоеВложение = ОставшиесяВложения[0];
			Если СтроковоеСвойство(ПервоеВложение, "type") = "contact" Тогда
				ОбработатьПолученныйКонтактMAX(ЗначениеСвойства(ПервоеВложение, "payload"), Контакт, Бот);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Если ПустаяСтрока(ПараметрыМаршрутизации.Телефон) Тогда
			ОтправитьСтандартноеСообщениеMAX("MAX_WELCOME", Контакт, Бот);
		ИначеЕсли ПараметрыМаршрутизации.Клиенты.Количество() > 1 Тогда
			ЗапроситьПациентаMAX(Контакт, Бот, ПараметрыМаршрутизации.Клиенты);
		Иначе
			ЗапроситьОтделениеMAX(Контакт, Бот);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ЭтоКомандаMAX(ТекстСообщения) Тогда
		ОбработатьКоманду(Сообщение, Контакт, Бот, КомандаИзТекста(ТекстСообщения));
	Иначе
		ОбработатьСообщение(Сообщение, Контакт, Бот);
	КонецЕсли;

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Получено сообщение MAX'"));

КонецПроцедуры

Процедура ОбработатьЗапускБота(Обновление, Бот)

	User = ЗначениеСвойства(Обновление, "user");
	Контакт = ПолучитьКонтактПоUser(User, Бот);

	Если Контакт.Пустая() Тогда
		Возврат;
	КонецЕсли;

	УстановитьБлокировкуКонтакта(Контакт, Ложь);

	// Событие запуска тоже является обращением, даже до получения телефона.
	СообщениеЗапуска = Новый Структура("sender", User);
	ИдентификаторЗапуска = "bot_started:" + СтроковоеСвойство(Обновление, "timestamp");
	СообщениеЗапуска.Вставить("body", Новый Структура("text, mid",
		"Клиент начал диалог с ботом", ИдентификаторЗапуска));
	ЗаписатьВходящееСообщениеMAX(СообщениеЗапуска, Контакт, Бот);

	//+бит_Сафаров ШИ 17.09.2026
	//БЫЛО
	//Если Не ЗначениеЗаполнено(Контакт.ОтделениеMAX)
	//	И Не ПустаяСтрока(ПодтвержденныйТелефонКонтактаMAX(Контакт)) Тогда
	//	ЗапроситьОтделениеMAX(Контакт, Бот);
	//СТАЛО
	Если Не ПустаяСтрока(ПодтвержденныйТелефонКонтактаMAX(Контакт)) Тогда
		бит_НачатьВыборОтделенияЗановоMAX(Контакт, Бот);
		Возврат;
	КонецЕсли;
	//-бит_Сафаров ШИ 17.09.2026

	Если (Не ЗначениеЗаполнено(Контакт.Получатель) Или Не ЗначениеЗаполнено(Контакт.ОтделениеMAX))
		И ОтправитьСтандартноеСообщениеMAX("MAX_WELCOME", Контакт, Бот)
	Тогда
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Приветствие MAX принято к отправке'"));
		Возврат;
	КонецЕсли;

	Сообщение = Новый Структура;
	Сообщение.Вставить("sender", User);
	Сообщение.Вставить("timestamp", ЗначениеСвойства(Обновление, "timestamp"));

	Payload = СтроковоеСвойство(Обновление, "payload");
	Сообщение.Вставить("body", Новый Структура("text, mid", "/start " + Payload, СтроковоеСвойство(Обновление,
		"timestamp")));

	ОбработатьКоманду(Сообщение, Контакт, Бот, "/start");

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Пользователь запустил бота MAX'"));

КонецПроцедуры

Процедура ОбработатьОстановкуБота(Обновление, Бот)

	Контакт = ПолучитьКонтактПоUser(ЗначениеСвойства(Обновление, "user"), Бот);
	Если Не Контакт.Пустая() Тогда
		УстановитьБлокировкуКонтакта(Контакт, Истина);
	КонецЕсли;

	ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Пользователь остановил бота MAX'"));

КонецПроцедуры

Процедура ОбработатьCallback(Обновление, Бот)

	Callback = ЗначениеСвойства(Обновление, "callback");
	Если Лев(СтроковоеСвойство(Callback, "payload"), 11) = "department:" Тогда
		ОбработатьВыборОтделенияMAX(Callback, Бот);
		Возврат;
	КонецЕсли;
	Если Лев(СтроковоеСвойство(Callback, "payload"), 8) = "patient:" Тогда
		ОбработатьВыборПациентаMAX(Callback, Бот);
		Возврат;
	КонецЕсли;
	Если Лев(СтроковоеСвойство(Callback, "payload"), 12) = "appointment_" Тогда
		ОбработатьКомандуЗаписиMAX(Callback, Бот);
		Возврат;
	КонецЕсли;

	Обработчик = бит_омни_ИнтеграцияСMAXПовтИсп.ОбработчикКоманды("callback");
	Если ПустаяСтрока(Обработчик) Тогда
		ЗаписатьСобытиеВЖурнал(Обновление, Бот, НСтр("ru='Callback MAX пропущен'"));
		Возврат;
	КонецЕсли;

	ВыполнитьОбработчик(Обработчик, Обновление, Справочники.бит_омни_Контакты.ПустаяСсылка(), Бот);

КонецПроцедуры

// Строгий разбор внешних данных; ни имя метода, ни BSL-код из payload не исполняются.
Функция РазобратьКомандуЗаписиMAX(Команда) Экспорт

	Если ТипЗнч(Команда) <> Тип("Строка") Или СтрДлина(Команда) > 100 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Части = СтрРазделить(Команда, "_", Истина);
	Если Части.Количество() <> 4 Или Части[0] <> "appointment"
		Или СтрДлина(Части[1]) <> 36 Или СтрДлина(Части[2]) <> 14 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Действие = Части[3];
	КлючОтмены = "";
	Если Лев(Действие, 10) = "cancelYes-" Или Лев(Действие, 9) = "cancelNo-" Тогда
		ЧастиДействия = СтрРазделить(Действие, "-", Истина);
		Если ЧастиДействия.Количество() <> 2 Или СтрДлина(ЧастиДействия[1]) <> 12 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Действие = ЧастиДействия[0];
		КлючОтмены = ЧастиДействия[1];
		Для ПозицияКлюча = 1 По 12 Цикл
			Если СтрНайти("0123456789abcdef", Сред(КлючОтмены, ПозицияКлюча, 1)) = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Действие <> "confirm" И Действие <> "cancel" И Действие <> "reschedule" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Позиция = 1 По 14 Цикл
		Если СтрНайти("0123456789", Сред(Части[2], Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Части[1]);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Новый Структура("Заявка,Версия,Действие,КлючОтмены",
		Документы.Заявка.ПолучитьСсылку(Идентификатор), Части[2], Действие, КлючОтмены);

КонецФункции

Процедура ОбработатьКомандуЗаписиMAX(Callback, Бот)

	Результат = Новый Структура("Успех,Текст", Ложь,
		"Не удалось применить действие. Возможно, кнопка устарела. Обратитесь в клинику.");
	Параметры = РазобратьКомандуЗаписиMAX(СтроковоеСвойство(Callback, "payload"));
	Пользователь = ЗначениеСвойства(Callback, "user");
	ИдентификаторMAX = СтрокаИдентификатора(ЗначениеСвойства(Пользователь, "user_id"));
	// Реквизит контакта числовой; строковый параметр запроса не найдёт числовой ID.
	ЧисловойИдентификатор = 0;
	Если Не ПустаяСтрока(ИдентификаторMAX) Тогда
		Попытка
			ЧисловойИдентификатор = Число(ИдентификаторMAX);
		Исключение
			ИдентификаторMAX = "";
		КонецПопытки;
	КонецЕсли;
	Если Параметры <> Неопределено И Не ПустаяСтрока(ИдентификаторMAX) Тогда
		// Не создаём контакт по callback. Используем сохраненную каноническую
		// идентичность, чтобы исторический дубль не блокировал действие пациента.
		Контакт = бит_омни_НадежныйОбменMAX.ПолучитьСуществующийКонтакт(ЧисловойИдентификатор, Бот);
		Если Не Контакт.Пустая() Тогда
			Результат = Документы.Заявка.бит_омни_ОбработатьCallbackMAX(
				Параметры.Заявка, Контакт, Бот, ИдентификаторMAX,
				Параметры.Версия, Параметры.Действие, Параметры.КлючОтмены);
		КонецЕсли;
	КонецЕсли;

	// Бизнес-транзакция уже завершена. Сбой ответа MAX не отменяет изменение записи.
	Попытка
		Если Не ИспользоватьОбменЧерезVDS() Тогда
			ВызватьИсключение "Ответы на кнопки записи требуют обмена через VDS.";
		КонецЕсли;
		ВложенияОтвета = Новый Массив;
		Если Не Результат.Свойство("Вложения", ВложенияОтвета) Тогда
			ВложенияОтвета = Новый Массив;
		КонецЕсли;
		Сообщение = Новый Структура("text,attachments,notify", Результат.Текст, ВложенияОтвета, Ложь);
		бит_ОтветитьНаCallbackMAX(Callback, Сообщение, Бот);
	Исключение
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Callback.Answer",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Действие обработано, но MAX не подтвердил обновление сообщения. Проверьте доступность VDS/MAX.");
	КонецПопытки;

КонецПроцедуры

// Удаляем входящие файлы до записи истории и вызова пользовательских обработчиков.
// Подтвержденный contact сохраняется: без него невозможен запрос телефона.
Процедура ОтклонитьВходящиеВложенияMAX(Сообщение, Контакт, Бот)

	Тело = ЗначениеСвойства(Сообщение, "body");
	Вложения = ЗначениеСвойства(Тело, "attachments");
	Если ТипЗнч(Вложения) <> Тип("Массив") Тогда Возврат; КонецЕсли;
	Разрешенные = Новый Массив;
	ЕстьФайлы = Ложь;
	Для Каждого Вложение Из Вложения Цикл
		Если СтроковоеСвойство(Вложение, "type") = "contact" Тогда
			Разрешенные.Добавить(Вложение);
		Иначе
			ЕстьФайлы = Истина;
		КонецЕсли;
	КонецЦикла;
	Тело.Вставить("attachments", Разрешенные);
	Если Не ЕстьФайлы Или Контакт.Пустая() Тогда Возврат; КонецЕсли;
	Идентификатор = СтроковоеСвойство(Тело, "mid");
	Если ПустаяСтрока(Идентификатор) Тогда
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Вложения", УровеньЖурналаРегистрации.Предупреждение,
			, , "Вложение без идентификатора удалено. Автоответ не отправлен: нет ключа защиты от повторов.");
		Возврат;
	КонецЕсли;
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Идентификатор, КодировкаТекста.UTF8, Ложь));
	КлючОтказа = "file-reject:" + НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ИсторияЧатовMAX");
		Элемент.УстановитьЗначение("ИдентификаторСообщения", КлючОтказа);
		Элемент.УстановитьЗначение("Контакт", Контакт);
		Элемент.УстановитьЗначение("Бот", Бот);
		Элемент.УстановитьЗначение("Входящее", Ложь);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		УжеОбработано = СообщениеЧатаУжеЗаписаноMAX(КлючОтказа, Контакт, Бот, Ложь);
		Если Не УжеОбработано Тогда
			ЗаписатьСообщениеЧатаMAX(КлючОтказа, Контакт, Бот, Ложь,
				"Входящее вложение отклонено. Содержимое файла не сохранено.", "text", "Система",
				"Обработано", "", "");
			Если Не СообщениеЧатаУжеЗаписаноMAX(КлючОтказа, Контакт, Бот, Ложь) Тогда
				ВызватьИсключение "Не удалось сохранить отметку отклоненного вложения.";
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если УжеОбработано Тогда Возврат; КонецЕсли;
	// Маркер фиксируется ДО HTTP: при неизвестном результате не спамим повторными отказами.
	Попытка
		Почта = СокрЛП(Строка(РегистрыСведений.бит_омни_ЗначенияНастроек.ЗначениеКонстанты("MAX_CLINIC_EMAIL")));
		Если ПустаяСтрока(Почта) Тогда Почта = "уточните адрес электронной почты у оператора клиники"; КонецЕсли;
		Текст = Справочники.бит_омни_ШаблоныСообщений.СтандартныйТекстИлиРезервный(
			"MAX_ATTACHMENTS_REJECTED", Контакт, Новый Структура("clinic_email", Почта),
			"К сожалению, мы пока не принимаем вложения в чате. Для отправки документов: " + Почта + ".");
		Ответ = ОтправитьТекстовоеСообщение(Текст, Контакт, Бот);
		Если ТипЗнч(Ответ) <> Тип("Структура")
			Или (ЗначениеСвойства(Ответ, "success", Ложь) <> Истина
				И ЗначениеСвойства(Ответ, "accepted", Ложь) <> Истина
				И ЗначениеСвойства(Ответ, "ok", Ложь) <> Истина
				И ПустаяСтрока(ИдентификаторСообщенияИзОтветаMAX(Ответ))) Тогда
			ВызватьИсключение "Доставка отказа не подтверждена.";
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Вложения.Ответ", УровеньЖурналаРегистрации.Ошибка,
			, , "Доставка отказа не подтверждена; автоматический повтор отключен.");
	КонецПопытки;

КонецПроцедуры

// Доверенный серверный транспорт. Проверка доступа оператора выполняется фасадом отделений.
Функция ОтправитьФайлMAX(ДанныеФайла, ИмяФайла, Контакт, Бот, Пользователь) Экспорт

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Загрузка файла MAX внутри транзакции запрещена."; КонецЕсли;
	Если Не ИспользоватьОбменЧерезVDS() Тогда ВызватьИсключение "Файлы отправляются только через VDS."; КонецЕсли;
	// Адрес фиксируется один раз для контакта, уже проверенного серверным фасадом.
	Адресат = ПараметрыАдресата(Контакт, Бот);
	Если Адресат = Неопределено Тогда ВызватьИсключение "Не определен адресат файла MAX."; КонецЕсли;
	ДанныеBase64 = СтрЗаменить(СтрЗаменить(Base64Строка(ДанныеФайла), Символы.ВК, ""), Символы.ПС, "");
	ОтветЗагрузки = ВыполнитьЗапросVDS("/api/v1/onec/attachments/upload",
		Новый Структура("filename,data_base64", ИмяФайла, ДанныеBase64));
	Вложение = ЗначениеСвойства(ОтветЗагрузки, "attachment");
	Если ЗначениеСвойства(ОтветЗагрузки, "ok") <> Истина Или ТипЗнч(Вложение) <> Тип("Структура") Тогда
		ВызватьИсключение "VDS не подтвердил загрузку файла. Сообщение не отправлялось.";
	КонецЕсли;
	Если СтроковоеСвойство(Вложение, "type") <> "file"
		Или ПустаяСтрока(СтроковоеСвойство(ЗначениеСвойства(Вложение, "payload"), "token")) Тогда
		ВызватьИсключение "VDS не вернул токен файла. Сообщение не отправлялось.";
	КонецЕсли;
	Вложения = Новый Массив;
	Вложения.Добавить(Вложение);
	ПараметрыСообщения = Новый Структура("text,attachments", "Файл: " + ИмяФайла, Вложения);
	// Токен и факт попытки сохраняются до отправки. Один ключ и период на весь вызов.
	ИдентификаторПопытки = "file-send:" + Строка(Новый УникальныйИдентификатор);
	ПараметрыСообщения.Вставить("client_message_id", ИдентификаторПопытки);
	История = ИсторияПопыткиОтправкиФайлаMAX(ИдентификаторПопытки, ИмяФайла, Контакт, Бот, Пользователь, Вложения);
	История.Записать(Истина);
	Результат = Новый Структура("success,message,delivery_status,ИдентификаторСообщения,ИсторияЗаписана",
		Ложь, "Доставка файла не подтверждена. Проверьте MAX перед повторной отправкой.", "unknown", "", Истина);
	Попытка
		// Обычная ОтправитьСообщение создает другую строку истории: здесь нужен только транспорт.
		Ответ = ОтправитьСообщениеЧерезVDS(ПараметрыСообщения, Адресат);
		ДанныеОтвета = ПрочитатьОтветMAX(Ответ);
		Классификация = КлассифицироватьОтветФайлаMAX(Ответ.КодСостояния, ДанныеОтвета.Тело, ИдентификаторПопытки);
		Результат.success = Классификация.Состояние = "Отправлено";
		Результат.ИдентификаторСообщения = Классификация.ИдентификаторСообщения;
		Результат.delivery_status = ?(Результат.success, "sent", ?(Классификация.Состояние = "Ошибка", "not_sent", "unknown"));
		Результат.message = ?(Результат.success, "", Классификация.ОписаниеОшибки);
	Исключение
		// Транспортная ошибка не доказывает недоставку; не повторяем и не теряем токен.
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Вложения.Отправка", УровеньЖурналаРегистрации.Предупреждение,
			, , "Нет однозначного ответа отправки файла. Автоматический повтор запрещен.");
	КонецПопытки;
	История.Статус = ?(Результат.success, "Отправлено", ?(Результат.delivery_status = "not_sent", "Ошибка", "Доставка неизвестна"));
	История.ОписаниеОшибки = Результат.message;
	Попытка
		//+бит_Сафаров ШИ 24.09.2026
		// Подтвержденный MID связываем с UUID попытки; ключ истории не меняем.
		НачатьТранзакцию();
		Если Результат.success Тогда
			Намерение = РегистрыСведений.бит_омни_ИсходящиеНамеренияMAX.СоздатьМенеджерЗаписи();
			Намерение.Ключ = Сред(ИдентификаторПопытки, 11);
			Намерение.Бот = Бот;
			Намерение.Контакт = Контакт;
			Намерение.Вид = "message";
			Намерение.Состояние = "Отправлено";
			Намерение.ИдентификаторMAX = Результат.ИдентификаторСообщения;
			Намерение.ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Оператор;
			Намерение.Пользователь = Пользователь;
			Намерение.ДатаСоздания = История.Период;
			Намерение.Записать();
		КонецЕсли;
		История.Записать(Истина);
		ЗафиксироватьТранзакцию();
		//-бит_Сафаров ШИ 24.09.2026
	Исключение
		//+бит_Сафаров ШИ 24.09.2026
		ОтменитьТранзакцию();
		//-бит_Сафаров ШИ 24.09.2026
		Результат.ИсторияЗаписана = Ложь;
		Результат.message = Результат.message + " Не удалось обновить историю. Повторная отправка запрещена без проверки MAX.";
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Вложения.История", УровеньЖурналаРегистрации.Ошибка,
			, , "Результат отправки файла получен, но история не обновлена. Автоматический повтор запрещен.");
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ИсторияПопыткиОтправкиФайлаMAX(ИдентификаторПопытки, ИмяФайла, Контакт, Бот, Пользователь, Вложения)

	История = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
	История.Период = ТекущаяДатаСеанса();
	История.ИдентификаторСообщения = ИдентификаторПопытки;
	История.Контакт = Контакт;
	История.Бот = Бот;
	История.Входящее = Ложь;
	История.Текст = "Файл: " + ИмяФайла;
	История.ВидСообщения = "file";
	История.Автор = Лев(Строка(Пользователь), 150);
	История.Прочитано = Истина;
	// Если процесс аварийно остановится после HTTP, не останется ложного «Отправляется».
	История.Статус = "Доставка неизвестна";
	История.ОписаниеОшибки = "Попытка отправки зафиксирована. Итог еще не получен; перед повтором проверьте MAX.";
	История.ДанныеВложений = JSONВложенийMAX(Вложения);
	История.ВидОтправителя = Перечисления.бит_омни_ВидыОтправителейMAX.Оператор;
	История.Пользователь = Пользователь;
	Возврат История;

КонецФункции

Функция КлассифицироватьОтветФайлаMAX(КодСостояния, ТелоОтвета, ИдентификаторПопытки)

	// Корреляция защищает от признания чужого/пакетного ответа успешной отправкой файла.
	Если КодСостояния >= 200 И КодСостояния < 300 Тогда
		Результаты = ЗначениеСвойства(ТелоОтвета, "results");
		Если ТипЗнч(Результаты) = Тип("Массив") Тогда
			Если Результаты.Количество() = 1 Тогда
				Если СтроковоеСвойство(Результаты[0], "client_message_id") = ИдентификаторПопытки Тогда
					Возврат КлассифицироватьОтветОчередиMAX(КодСостояния, ТелоОтвета);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Возврат Новый Структура("Состояние,ИдентификаторСообщения,ОписаниеОшибки,КодHTTP", "Неопределено", "",
			"VDS не подтвердил именно эту попытку отправки файла. Перед повтором проверьте MAX.", КодСостояния);
	КонецЕсли;
	Возврат КлассифицироватьОтветОчередиMAX(КодСостояния, ТелоОтвета);

КонецФункции

Процедура ОбработатьСообщение(Сообщение, Контакт, Бот)

	ТелоСообщения = ЗначениеСвойства(Сообщение, "body");
	Вложения = ЗначениеСвойства(ТелоСообщения, "attachments");
	Если ТипЗнч(Вложения) = Тип("Массив") И Вложения.Количество() Тогда
		ПервоеВложение = Вложения.Получить(0);
		Если ПервоеВложение.type = "contact" Тогда
			ИнформацияОКонтакте = ЗначениеСвойства(ПервоеВложение, "payload");
			ОбработатьПолученныйКонтактMAX(ИнформацияОКонтакте, Контакт, Бот);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Обработчик = бит_омни_ИнтеграцияСMAXПовтИсп.ОбработчикСообщения();
	Если ПустаяСтрока(Обработчик) Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьОбработчик(Обработчик, Сообщение, Контакт, Бот);

КонецПроцедуры

Процедура ОбработатьКоманду(Сообщение, Контакт, Бот, Команда, Параметры = Неопределено)

	ИмяКоманды = СокрЛП(Команда);
	Если Лев(ИмяКоманды, 1) = "/" Тогда
		ИмяКоманды = Сред(ИмяКоманды, 2);
	КонецЕсли;
	ИмяКоманды = НРег(ИмяКоманды);

	//+бит_Сафаров ШИ 17.09.2026
	Если ИмяКоманды = "start" Тогда
		НачатьВыборОтделенияMAX(Контакт, Бот);
		Возврат;
	КонецЕсли;
	//-бит_Сафаров ШИ 17.09.2026

	Если ИмяКоманды = "patient" Тогда
		НачатьВыборПациентаMAX(Контакт, Бот);
		Возврат;
	ИначеЕсли ИмяКоманды = "department" Тогда
		НачатьВыборОтделенияMAX(Контакт, Бот);
		Возврат;
	КонецЕсли;

	ДействиеКоманды = РегистрыСведений.бит_омни_Команды.СоздатьМенеджерЗаписи();
	ДействиеКоманды.Команда = ИмяКоманды;
	ДействиеКоманды.Прочитать();

	Если ДействиеКоманды.Выбран() И Не ДействиеКоманды.Действие.Пустая() Тогда

		Результат = Справочники.бит_омни_Действия.ВыполнитьДействие(ДействиеКоманды.Действие, Сообщение.body.text,
			Контакт, Бот, Параметры);

		Если Не Результат.Ошибка Тогда
			Возврат;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Команды", УровеньЖурналаРегистрации.Ошибка, , ДействиеКоманды.Действие,
			Результат.Описание);
		ВызватьИсключение Результат.Описание;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция бит_ОбновитьТелоДолгаПередОтправкойMAX(Тело, Контакт)
	//+бит_Сафаров ШИ 17.09.2026
	Пациент = Контакт.Получатель;
	Если ТипЗнч(Пациент) <> Тип("СправочникСсылка.Клиенты") Или Не ЗначениеЗаполнено(Пациент) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| СУММА(Остатки.СуммаОстаток) КАК Долг
	|ИЗ РегистрНакопления.ВзаиморасчетыСКлиентами.Остатки(, Клиент = &Пациент) КАК Остатки");
	Запрос.УстановитьПараметр("Пациент", Пациент);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Долг", УровеньЖурналаРегистрации.Ошибка,
			,, "Этап расчёта долга перед отправкой: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	Если Не Выборка.Следующий() Или Не ЗначениеЗаполнено(Выборка.Долг)
		Или Выборка.Долг <= 0 Тогда Возврат Ложь; КонецЕсли;
	Тело.Вставить("text", "Напоминаем, что у вас имеется задолженность "
		+ Формат(Выборка.Долг, "ЧДЦ=2; ЧН=0") + " рублей");
	бит_ДобавитьОбращениеКПациентуMAX(Тело, Контакт);
	Возврат Истина;
	//-бит_Сафаров ШИ 17.09.2026
КонецФункции

Функция бит_ИмяОтчествоПациентаMAX(Пациент)
	//+бит_Сафаров ШИ 17.09.2026
	Если ТипЗнч(Пациент) <> Тип("СправочникСсылка.Клиенты") Или Не ЗначениеЗаполнено(Пациент) Тогда
		Возврат "";
	КонецЕсли;
	Имя = СокрЛП(Пациент.Имя);
	Если ПустаяСтрока(Имя) Тогда Возврат ""; КонецЕсли;
	Отчество = СокрЛП(Пациент.Отчество);
	Возврат Имя + ?(ПустаяСтрока(Отчество), "", " " + Отчество);
	//-бит_Сафаров ШИ 17.09.2026
КонецФункции

Процедура бит_ДобавитьОбращениеКПациентуMAX(Тело, Контакт)
	//+бит_Сафаров ШИ 17.09.2026
	Если ТипЗнч(Тело) <> Тип("Структура") Или ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Тогда
		Возврат;
	КонецЕсли;
	ИмяОтчество = бит_ИмяОтчествоПациентаMAX(Контакт.Получатель);
	Если ПустаяСтрока(ИмяОтчество) Тогда Возврат; КонецЕсли;
	Текст = СтроковоеСвойство(Тело, "text");
	Если ПустаяСтрока(Текст) Тогда Возврат; КонецЕсли;
	Если СтрНайти(Лев(Текст, 60), ИмяОтчество) > 0 Тогда Возврат; КонецЕсли;
	Если НРег(СтроковоеСвойство(Тело, "format")) = "html" Тогда
		ИмяОтчество = СтрЗаменить(ИмяОтчество, "&", "&amp;");
		ИмяОтчество = СтрЗаменить(ИмяОтчество, "<", "&lt;");
		ИмяОтчество = СтрЗаменить(ИмяОтчество, ">", "&gt;");
	КонецЕсли;
	Тело.Вставить("text", ИмяОтчество + ", " + Текст);
	//-бит_Сафаров ШИ 17.09.2026
КонецПроцедуры

Функция ЯвныйОтказОчередиMAX(КодСостояния)
	Возврат КодСостояния = 400 Или КодСостояния = 401 Или КодСостояния = 403
		Или КодСостояния = 404 Или КодСостояния = 422 Или КодСостояния = 429;
КонецФункции

// Снимок callback: MAX user_id и callback_id неизменны при выборе другого пациента.
// Старые снимки без callback_id в адресате требуют повторного действия пользователя.
Процедура ПроверитьСнимокCallbackMAX(Бот, Контакт, Тело, Адресат)
	Если ТипЗнч(Бот) <> Тип("СправочникСсылка.бит_омни_Боты") Или Не ЗначениеЗаполнено(Бот)
		Или ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или Не ЗначениеЗаполнено(Контакт) Тогда
		ВызватьИсключение "Не определены бот или контакт callback MAX.";
	КонецЕсли;
	Если Бот.ПометкаУдаления Или Не Бот.Использовать Или Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX
		Или Контакт.ПометкаУдаления Или Контакт.Заблокирован Или Контакт.Бот <> Бот
		Или Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ВызватьИсключение "Бот или контакт callback MAX недоступен.";
	КонецЕсли;
	Если ТипЗнч(Тело) <> Тип("Структура") Или ТипЗнч(Адресат) <> Тип("Структура") Тогда
		ВызватьИсключение "Некорректный снимок callback MAX.";
	КонецЕсли;
	Если СтроковоеСвойство(Адресат, "Параметр") <> "user_id"
		Или СтроковоеСвойство(Адресат, "Значение") <> СтрокаИдентификатора(Контакт.Идентификатор)
		Или ПустаяСтрока(СтроковоеСвойство(Тело, "callback_id"))
		Или СтроковоеСвойство(Адресат, "ИдентификаторCallback") <> СтроковоеСвойство(Тело, "callback_id") Тогда
		ВызватьИсключение "Адресат или callback_id снимка MAX изменился либо отсутствует.";
	КонецЕсли;
	Если НайтиКонтактMAX(Контакт.Идентификатор, Бот) <> Контакт Тогда
		ВызватьИсключение "Каноническая привязка callback MAX изменилась.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСнимокОчередиMAX(Бот, Контакт, Тело, Адресат)
	Если ТипЗнч(Бот) <> Тип("СправочникСсылка.бит_омни_Боты") Или НЕ ЗначениеЗаполнено(Бот)
		Или ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты") Или НЕ ЗначениеЗаполнено(Контакт) Тогда
		ВызватьИсключение "Не определены бот или контакт снимка.";
	КонецЕсли;
	Если Бот.ПометкаУдаления Или НЕ Бот.Использовать Или Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX
		Или Контакт.ПометкаУдаления Или Контакт.Заблокирован Или Контакт.Бот <> Бот
		Или Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ВызватьИсключение "Бот или контакт недоступен.";
	КонецЕсли;
	Если ТипЗнч(Тело) <> Тип("Структура") Или ТелоСообщенияMAX(Тело) = Неопределено
		Или ТипЗнч(Адресат) <> Тип("Структура") Тогда ВызватьИсключение "Некорректный снимок JSON."; КонецЕсли;
	Если СтроковоеСвойство(Адресат, "Параметр") <> "user_id"
		Или СтроковоеСвойство(Адресат, "Значение") <> СтрокаИдентификатора(Контакт.Идентификатор)
		Или НЕ ЗначениеЗаполнено(Контакт.Идентификатор)
		Или ПустаяСтрока(СтроковоеСвойство(Адресат, "ИдентификаторСообщенияКлиента")) Тогда
		ВызватьИсключение "Адресат снимка не соответствует контакту.";
	КонецЕсли;
	// Один MAX ID может остаться прежним после перепривязки карточки к другому пациенту.
	// Отсутствующий отпечаток старого снимка также запрещает автоматическую отправку.
	Если НЕ Адресат.Свойство("ОтпечатокПолучателя")
		Или ТипЗнч(Адресат.ОтпечатокПолучателя) <> Тип("Строка")
		Или Адресат.ОтпечатокПолучателя <> ОтпечатокПолучателяКонтактаMAX(Контакт) Тогда
		ВызватьИсключение "Привязка контакта изменилась после подготовки сообщения.";
	КонецЕсли;
	Для Каждого Поле Из Тело Цикл
		Если СтрРазделить("text,format,attachments,notify,disable_link_preview", ",").Найти(Поле.Ключ) = Неопределено Тогда
			ВызватьИсключение "Недопустимое поле тела снимка.";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ОтпечатокПолучателяКонтактаMAX(Контакт)
	ПолучательКонтакта = Контакт.Получатель;
	Если НЕ ЗначениеЗаполнено(ПолучательКонтакта) Тогда Возврат ""; КонецЕсли;
	// Только тип и технический UUID: без ФИО, телефона и представления пациента.
	Возврат Строка(ТипЗнч(ПолучательКонтакта)) + ":" + Строка(ПолучательКонтакта.УникальныйИдентификатор());
КонецФункции

