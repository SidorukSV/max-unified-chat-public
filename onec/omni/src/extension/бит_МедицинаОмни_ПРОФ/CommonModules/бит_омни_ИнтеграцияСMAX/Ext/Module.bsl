Функция БазовыйАдресVDS()

	Адрес = СокрЛП(Строка(бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("MAX_VDS_URL")));
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;

	Возврат Адрес;

КонецФункции

Функция СервисныйКлючVDS()

	Возврат СокрЛП(Строка(бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("MAX_VDS_API_KEY")));

