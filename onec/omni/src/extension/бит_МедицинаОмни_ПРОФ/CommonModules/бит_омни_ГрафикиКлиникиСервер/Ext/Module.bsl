
// Даты действия сравниваются как календарные дни, обе границы включены.
Функция ГраницыПериода(ДатаНачала, ДатаОкончания) Экспорт

	Возврат Новый Структура("Начало,Окончание",
		?(ЗначениеЗаполнено(ДатаНачала), НачалоДня(ДатаНачала), Дата(1, 1, 1)),
		?(ЗначениеЗаполнено(ДатаОкончания), НачалоДня(ДатаОкончания), Дата(3999, 12, 31)));

КонецФункции

Функция ПериодыКонфликтуют(Начало1, Окончание1, Редакция1, Начало2, Окончание2, Редакция2) Экспорт

	Первый = ГраницыПериода(Начало1, Окончание1);
	Второй = ГраницыПериода(Начало2, Окончание2);
	Если Первый.Начало > Второй.Окончание Или Второй.Начало > Первый.Окончание Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Первый.Начало = Второй.Начало И Первый.Окончание = Второй.Окончание Тогда
		Возврат Редакция1 = Редакция2;
	КонецЕсли;
	ПервыйВнутри = Первый.Начало >= Второй.Начало И Первый.Окончание <= Второй.Окончание;
	ВторойВнутри = Второй.Начало >= Первый.Начало И Второй.Окончание <= Первый.Окончание;
	Возврат Не ПервыйВнутри И Не ВторойВнутри;

КонецФункции

// Сравнение по вложенности сохраняет приоритет и при одной незаполненной границе.
Функция ГрафикПриоритетнее(Кандидат, Выбранный) Экспорт

	Если Выбранный = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Первый = ГраницыПериода(Кандидат.ДатаНачала, Кандидат.ДатаОкончания);
	Второй = ГраницыПериода(Выбранный.ДатаНачала, Выбранный.ДатаОкончания);
	Если Первый.Начало = Второй.Начало И Первый.Окончание = Второй.Окончание Тогда
		Возврат Кандидат.Период > Выбранный.Период;
	КонецЕсли;
	Возврат Первый.Начало >= Второй.Начало И Первый.Окончание <= Второй.Окончание;

КонецФункции

Функция ДеньВПериоде(День, ДатаНачала, ДатаОкончания) Экспорт

	Границы = ГраницыПериода(ДатаНачала, ДатаОкончания);
	День = НачалоДня(День);
	Возврат День >= Границы.Начало И День <= Границы.Окончание;

КонецФункции

Функция ОшибкаГрафика(ДатаНачала, ДатаОкончания, График) Экспорт

	Границы = ГраницыПериода(ДатаНачала, ДатаОкончания);
	Если Границы.Начало > Границы.Окончание Тогда
		Возврат "Дата окончания действия графика не может быть раньше даты начала.";
	КонецЕсли;
	Если График.Количество() <> 7 Тогда
		Возврат "График должен содержать ровно семь дней с понедельника по воскресенье.";
	КонецЕсли;
	НомерДня = 0;
	Для Каждого День Из График Цикл
		НомерДня = НомерДня + 1;
		Если День.ДеньНедели <> НомерДня Тогда
			Возврат "Состав и порядок дней недели изменять нельзя.";
		КонецЕсли;
		ЕстьНачало = ЗначениеЗаполнено(День.ВремяНачала);
		ЕстьОкончание = ЗначениеЗаполнено(День.ВремяОкончания);
		Если ЕстьНачало <> ЕстьОкончание Тогда
			Возврат ИмяДняНедели(НомерДня) + ": заполните оба времени или оставьте оба пустыми для выходного.";
		КонецЕсли;
		Если ЕстьНачало И СекундыВремени(День.ВремяНачала) >= СекундыВремени(День.ВремяОкончания) Тогда
			Возврат ИмяДняНедели(НомерДня) + ": окончание работы должно быть позже начала в пределах одного дня.";
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ИмяДняНедели(НомерДня) Экспорт

	Дни = СтрРазделить("Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье", ",");
	Если НомерДня < 1 Или НомерДня > 7 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Дни[НомерДня - 1];

КонецФункции

Функция СекундыВремени(Время) Экспорт

	Возврат Час(Время) * 3600 + Минута(Время) * 60 + Секунда(Время);

КонецФункции

Функция ВРабочееВремя(Момент, ВремяНачала, ВремяОкончания) Экспорт

	Если Не ЗначениеЗаполнено(ВремяНачала) Или Не ЗначениеЗаполнено(ВремяОкончания) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекущееВремя = СекундыВремени(Момент);
	Возврат ТекущееВремя >= СекундыВремени(ВремяНачала)
		И ТекущееВремя < СекундыВремени(ВремяОкончания);

КонецФункции

Процедура ПроверитьПересечения(СсылкаДокумента, Филиал, ДатаНачала, ДатаОкончания, ДатаДокумента) Экспорт

	// Блокировка филиала удерживается транзакцией проведения до записи семи строк.
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ГрафикиРаботыКлиники");
	Элемент.УстановитьЗначение("Филиал", Филиал);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		| Графики.Регистратор КАК Регистратор, Графики.Период КАК Период,
		| Графики.ДатаНачала КАК ДатаНачала, Графики.ДатаОкончания КАК ДатаОкончания
		|ИЗ РегистрСведений.бит_омни_ГрафикиРаботыКлиники КАК Графики
		|ГДЕ Графики.Филиал = &Филиал И Графики.Активность
		| И Графики.Регистратор <> &Документ");
	Запрос.УстановитьПараметр("Филиал", Филиал);
	Запрос.УстановитьПараметр("Документ", СсылкаДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПериодыКонфликтуют(ДатаНачала, ДатаОкончания, ДатаДокумента,
			Выборка.ДатаНачала, Выборка.ДатаОкончания, Выборка.Период) Тогда
			ВызватьИсключение "График конфликтует с документом «" + Строка(Выборка.Регистратор)
				+ "». Периоды должны быть вложенными или не пересекаться. Для одинаковых периодов даты документов должны различаться.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ДействующийГрафик(Филиал, Момент) Экспорт

	Если Не ЗначениеЗаполнено(Филиал) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		| Графики.Регистратор КАК Регистратор, Графики.Период КАК Период,
		| Графики.ДатаНачала КАК ДатаНачала, Графики.ДатаОкончания КАК ДатаОкончания,
		| Графики.ДеньНедели КАК ДеньНедели,
		| Графики.ВремяНачала КАК ВремяНачала, Графики.ВремяОкончания КАК ВремяОкончания
		|ИЗ РегистрСведений.бит_омни_ГрафикиРаботыКлиники КАК Графики
		|ГДЕ Графики.Филиал = &Филиал И Графики.Активность
		| И (Графики.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Графики.ДатаНачала <= &День)
		| И (Графики.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Графики.ДатаОкончания >= &День)
		|УПОРЯДОЧИТЬ ПО Графики.ДеньНедели");
	Запрос.УстановитьПараметр("Филиал", Филиал);
	Запрос.УстановитьПараметр("День", НачалоДня(Момент));
	Строки = Запрос.Выполнить().Выгрузить();
	Выбранный = Неопределено;
	Для Каждого СтрокаГрафика Из Строки Цикл
		Если ГрафикПриоритетнее(СтрокаГрафика, Выбранный) Тогда
			Выбранный = СтрокаГрафика;
		КонецЕсли;
	КонецЦикла;
	Если Выбранный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Строки.Скопировать(Новый Структура("Регистратор", Выбранный.Регистратор));
	Если Результат.Количество() <> 7 Тогда
		ВызватьИсключение "В действующем графике клиники отсутствуют дни недели.";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПредставлениеГрафика(График) Экспорт

	Строки = Новый Массив;
	Для Каждого День Из График Цикл
		Часы = ?(ЗначениеЗаполнено(День.ВремяНачала),
			Формат(День.ВремяНачала, "ДФ=HH:mm") + "-" + Формат(День.ВремяОкончания, "ДФ=HH:mm"), "выходной");
		Строки.Добавить(ИмяДняНедели(День.ДеньНедели) + ": " + Часы);
	КонецЦикла;
	Возврат СтрСоединить(Строки, "; ");

КонецФункции

Функция ФилиалДляАвтоответа(Контакт) Экспорт

	Если ЗначениеЗаполнено(Контакт.ОтделениеMAX) Тогда
		Филиал = Контакт.ОтделениеMAX.Филиал;
		Если ЗначениеЗаполнено(Филиал) Тогда
			Возврат Филиал;
		КонецЕсли;
	КонецЕсли;
	Возврат бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("ФилиалАвтоответаMAX");

КонецФункции

Процедура АвтоответНаВходящее(Контакт, Бот) Экспорт

	Если Не ЗначениеЗаполнено(Контакт) Тогда
		Возврат;
	КонецЕсли;
	Если бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("АвтоответВнеРабочегоВремени") <> Истина Тогда
		Возврат;
	КонецЕсли;
	Филиал = ФилиалДляАвтоответа(Контакт);
	Если Не ЗначениеЗаполнено(Филиал) Тогда
		Возврат;
	КонецЕсли;
	// Серверный модуль: часы компьютера пациента и часовой пояс сеанса не используются.
	Момент = ТекущаяДата();
	График = ДействующийГрафик(Филиал, Момент);
	Если График = Неопределено Тогда
		Возврат;
	КонецЕсли;
	День = График.Найти(ДеньНедели(Момент), "ДеньНедели");
	Если День = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ВРабочееВремя(Момент, День.ВремяНачала, День.ВремяОкончания) Тогда
		Возврат;
	КонецЕсли;
	Шаблон = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты("ШаблонАвтоответаВнеРабочегоВремени");
	Если ТипЗнч(Шаблон) <> Тип("Строка") Или ПустаяСтрока(Шаблон) Тогда
		Возврат;
	КонецЕсли;
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Автоответ формируется только внутри транзакции обработки входящего сообщения.";
	КонецЕсли;
	Текст = СтрЗаменить(Шаблон, "{ГрафикРаботы}", ПредставлениеГрафика(График));
	// Вызов внутри обработки inbox: намерение и отметка обработки фиксируются одной транзакцией.
	бит_омни_ИнтеграцияСMAX.ОтправитьТекстовоеСообщение(Текст, Контакт, Бот);

КонецПроцедуры
