
#Область ПрограммныйИнтерфейс

// Параметры RLS заполняются лениво из модуля сеанса. Клиент не имеет права Set.
Процедура УстановитьПараметрыДоступаСеанса() Экспорт

	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Доступ = ПолучитьПараметрыДоступаMAX();
		ПараметрыСеанса.бит_омни_ПолныеПраваMAX = Доступ.ПолныеПрава;
		ПараметрыСеанса.бит_омни_ОтделениеПользователяMAX = Доступ.Отделение;
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Не вызывать с клиента. Пользователь определяется на сервере, а не из реквизитов формы.
// Возвращает ПолныеПрава (Булево), Отделение (СправочникСсылка.бит_омни_ОтделенияMAX).
Функция ПолучитьПараметрыДоступаMAX() Экспорт

	Результат = Новый Структура("ПолныеПрава,Отделение",
		РольДоступна("ПолныеПрава"), Справочники.бит_омни_ОтделенияMAX.ПустаяСсылка());
	Если Результат.ПолныеПрава Тогда
		Возврат Результат;
	КонецЕсли;
	Пользователь = Пользователи.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Назначения.Отделение КАК Отделение
		|ИЗ РегистрСведений.бит_омни_ОтделенияПользователейMAX КАК Назначения
		|ГДЕ Назначения.Пользователь = &Пользователь");
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Отделение = Выборка.Отделение;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает проверенные Бот, Пациент, Отделение. Пустое назначение - запрет, не "все".
Функция ПроверитьДоступККонтакту(Контакт, Бот = Неопределено) Экспорт

	Если ТипЗнч(Контакт) <> Тип("СправочникСсылка.бит_омни_Контакты")
		Или Не ЗначениеЗаполнено(Контакт) Тогда
		ВызватьИсключение "Не выбран доступный диалог MAX.";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Контакты.Бот КАК Бот, Контакты.ОтделениеMAX КАК Отделение,
		| ЕСТЬNULL(ВЫРАЗИТЬ(Контакты.Получатель КАК Справочник.Клиенты),
		| ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)) КАК Пациент
		|ИЗ Справочник.бит_омни_Контакты КАК Контакты
		|ГДЕ Контакты.Ссылка = &Контакт И НЕ Контакты.ПометкаУдаления
		| И Контакты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)");
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Диалог MAX недоступен.";
	КонецЕсли;
	Доступ = ПолучитьПараметрыДоступаMAX();
	Если (Бот <> Неопределено И Бот <> Выборка.Бот)
		Или (Не Доступ.ПолныеПрава И (Не ЗначениеЗаполнено(Доступ.Отделение)
			Или Доступ.Отделение <> Выборка.Отделение)) Тогда
		ВызватьИсключение "Нет доступа к диалогу другого отделения или отделение пользователя не задано.";
	КонецЕсли;
	Возврат Новый Структура("Бот,Пациент,Отделение", Выборка.Бот, Выборка.Пациент, Выборка.Отделение);

КонецФункции

// Проверка доступа выполняется до повышения прав. Токен бота клиенту не возвращается.
Функция ТелефонКонтактаДляОператора(Контакт) Экспорт

	ПроверитьДоступККонтакту(Контакт);
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Телефон = бит_омни_ИнтеграцияСMAX.ПодтвержденныйТелефонКонтактаMAX(Контакт);
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Телефон;

КонецФункции

// Узкий серверный фасад: только текст, один проверенный контакт, текущий оператор.
// Повышение прав нужно транспорту для чтения токена, а не для выбора адресата.
Функция ОтправитьТекстОператора(Текст, Контакт, Бот) Экспорт

	ДанныеКонтакта = ПроверитьДоступККонтакту(Контакт, Бот);
	Пользователь = Пользователи.ТекущийПользователь();
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = бит_омни_ИнтеграцияСMAX.ОтправитьТекстовоеСообщение(
			Текст, Контакт, ДанныеКонтакта.Бот, ,
			Перечисления.бит_омни_ВидыОтправителейMAX.Оператор, Пользователь);
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция бит_ИзменитьСообщениеОператора(
	Контакт, Бот, ИдентификаторСообщения, НовыйТекст, Удалить = Ложь) Экспорт

	//+бит_Сафаров ШИ 17.09.2026
	ПроверитьДоступККонтакту(Контакт, Бот);
	Если ТипЗнч(ИдентификаторСообщения) <> Тип("Строка")
		Или ПустаяСтрока(ИдентификаторСообщения) Тогда
		ВызватьИсключение "Не выбрано сообщение клиники.";
	КонецЕсли;
	Если Не Удалить И (ТипЗнч(НовыйТекст) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(НовыйТекст)) Или СтрДлина(НовыйТекст) > 4000) Тогда
		ВызватьИсключение "Текст сообщения должен содержать от 1 до 4000 символов.";
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
		| История.Период КАК Период,
		| История.ВидСообщения КАК ВидСообщения,
		| История.Текст КАК Текст
		|ИЗ РегистрСведений.бит_омни_ИсторияЧатовMAX КАК История
		|ГДЕ История.Контакт = &Контакт И История.Бот = &Бот
		| И История.ИдентификаторСообщения = &Идентификатор
		| И НЕ История.Входящее
		| И История.ВидОтправителя = ЗНАЧЕНИЕ(Перечисление.бит_омни_ВидыОтправителейMAX.Оператор)
		| И История.Статус = ""Отправлено""");
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторСообщения);
	Сообщения = Запрос.Выполнить().Выгрузить();
	Если Сообщения.Количество() <> 1 Тогда
		ВызватьИсключение "Сообщение клиники не найдено или не подтверждено MAX.";
	КонецЕсли;
	Сообщение = Сообщения[0];
	Если Не Удалить И Сообщение.ВидСообщения <> "text" Тогда
		ВызватьИсключение "Редактировать можно только текстовое сообщение клиники.";
	КонецЕсли;
	Если Не Удалить И ТекущаяДатаСеанса() - Сообщение.Период >= 7 * 24 * 60 * 60 Тогда
		ВызватьИсключение "MAX разрешает редактировать текст в личном диалоге только 7 суток.";
	КонецЕсли;

	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		// История надёжной отправки хранит UUID попытки; API MAX ожидает подтверждённый mid.
		ИдентификаторMAX = ИдентификаторСообщения;
		//+бит_Сафаров ШИ 24.09.2026
		ЭтоФайл = Лев(ИдентификаторСообщения, 10) = "file-send:"
			И СтрДлина(ИдентификаторСообщения) = 46;
		Если СтрДлина(ИдентификаторСообщения) = 36 Или ЭтоФайл Тогда
			Намерение = РегистрыСведений.бит_омни_ИсходящиеНамеренияMAX.СоздатьМенеджерЗаписи();
			Намерение.Ключ = ?(ЭтоФайл, Сред(ИдентификаторСообщения, 11), ИдентификаторСообщения);
			Намерение.Прочитать();
			Если Намерение.Выбран() Тогда
				Если Намерение.Бот <> Бот Или Намерение.Контакт <> Контакт
					Или Намерение.Вид <> "message"
					Или Намерение.ВидОтправителя <> Перечисления.бит_омни_ВидыОтправителейMAX.Оператор
					Или Намерение.Состояние <> "Отправлено"
					Или ПустаяСтрока(Намерение.ИдентификаторMAX) Тогда
					ВызватьИсключение "Не найден подтверждённый идентификатор сообщения MAX.";
				КонецЕсли;
				ИдентификаторMAX = Намерение.ИдентификаторMAX;
			ИначеЕсли ЭтоФайл Тогда
				ВызватьИсключение "Не найден подтверждённый идентификатор файла MAX.";
			КонецЕсли;
		КонецЕсли;
		//-бит_Сафаров ШИ 24.09.2026
		бит_омни_ИнтеграцияСMAX.бит_ИзменитьСообщениеОператораMAX(
			Бот, ИдентификаторMAX, СокрЛП(НовыйТекст), Удалить);
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;

	Попытка
		Запись = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
		Запись.Период = Сообщение.Период;
		Запись.ИдентификаторСообщения = ИдентификаторСообщения;
		Запись.Контакт = Контакт;
		Запись.Бот = Бот;
		Запись.Входящее = Ложь;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Если Удалить Тогда
				Запись.Удалить();
			Иначе
				Запись.Текст = СокрЛП(НовыйТекст);
				Запись.Записать();
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Сообщения", УровеньЖурналаРегистрации.Ошибка,
			, Контакт, "MAX изменён, но история 1С не обновлена: " + ИдентификаторСообщения);
		ВызватьИсключение "MAX изменён, но локальная история не обновлена. Обратитесь к администратору.";
	КонецПопытки;
	ЗаписьЖурналаРегистрации("ОМНИ.MAX.Сообщения", УровеньЖурналаРегистрации.Информация,
		, Контакт, ?(Удалить, "Удалено сообщение ", "Отредактировано сообщение ")
			+ ИдентификаторСообщения);
	Возврат Истина;
	//-бит_Сафаров ШИ 17.09.2026

КонецФункции

// Ни адресат, ни путь к серверному файлу не принимаются без проверки.
Функция ОтправитьФайлОператора(ДанныеФайла, ИмяФайла, Контакт, Бот) Экспорт

	ДанныеКонтакта = ПроверитьДоступККонтакту(Контакт, Бот);
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда ВызватьИсключение "Файл не загружен."; КонецЕсли;
	Если ДанныеФайла.Размер() = 0 Или ДанныеФайла.Размер() > 5 * 1024 * 1024 Тогда
		ВызватьИсключение "Допустим непустой файл не более 5 МБ.";
	КонецЕсли;
	Если ТипЗнч(ИмяФайла) <> Тип("Строка") Или СтрДлина(ИмяФайла) > 180
		Или СтрНайти(ИмяФайла, "/") > 0 Или СтрНайти(ИмяФайла, "\") > 0
		Или СтрНайти(ИмяФайла, ":") > 0 Тогда
		ВызватьИсключение "Некорректное имя файла.";
	КонецЕсли;
	ЧастиИмени = СтрРазделить(НРег(ИмяФайла), ".", Истина);
	Если ЧастиИмени.Количество() < 2 Или СтрРазделить("pdf,doc,docx,xls,xlsx,txt,png,jpg,jpeg", ",").Найти(
		ЧастиИмени[ЧастиИмени.Количество() - 1]) = Неопределено Тогда
		ВызватьИсключение "Поддерживаются PDF, DOC/DOCX, XLS/XLSX, TXT, PNG и JPG.";
	КонецЕсли;
	Пользователь = Пользователи.ТекущийПользователь();
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = бит_омни_ИнтеграцияСMAX.ОтправитьФайлMAX(ДанныеФайла, ИмяФайла, Контакт, ДанныеКонтакта.Бот, Пользователь);
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Доступные отделения читаются один раз для построения клавиатуры.
Функция ДоступныеОтделения() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Отделения.Ссылка КАК Ссылка, Отделения.Наименование КАК Наименование
		|ИЗ Справочник.бит_омни_ОтделенияMAX КАК Отделения
		|ГДЕ НЕ Отделения.ПометкаУдаления И НЕ Отделения.НедоступноДляВыбора
		|УПОРЯДОЧИТЬ ПО Наименование, Ссылка");
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Строгий разбор callback: внешняя строка никогда не исполняется как BSL.
Функция ОтделениеИзКоманды(Команда) Экспорт

	Если ТипЗнч(Команда) <> Тип("Строка") Или СтрДлина(Команда) <> 47
		Или Лев(Команда, 11) <> "department:" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Сред(Команда, 12));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Справочники.бит_омни_ОтделенияMAX.ПолучитьСсылку(Идентификатор);

КонецФункции

// Вызывается только доверенным серверным обработчиком после проверки подписи телефона.
// Первый выбор фиксируется; повторный callback не меняет отделение.
Функция ЗакрепитьОтделение(Контакт, Бот, Отделение) Экспорт

	// Callback уже обрабатывается внутри транзакции надежного inbox. В этом случае
	// нельзя самостоятельно отменять транзакцию: иначе событие останется без ACK.
	Если ТранзакцияАктивна() Тогда
		Возврат ЗакрепитьОтделениеВТранзакции(Контакт, Бот, Отделение);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Результат = ЗакрепитьОтделениеВТранзакции(Контакт, Бот, Отделение);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Узкий доверенный путь callback: выбор отделения уже проверен по payload,
// контакту, боту и списку доступных отделений. Повышение прав необходимо только
// служебной записи защищенных полей и не доступно клиентскому вызову.
Функция ЗакрепитьОтделениеВТранзакции(Контакт, Бот, Отделение)

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Закрепление отделения выполняется только внутри транзакции.";
	КонецЕсли;
	Результат = Новый Структура("Изменено,Отделение", Ложь,
		Справочники.бит_омни_ОтделенияMAX.ПустаяСсылка());
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.бит_омни_Контакты");
	Элемент.УстановитьЗначение("Ссылка", Контакт);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	ОбъектКонтакта = Контакт.ПолучитьОбъект();
	Если ОбъектКонтакта.ПометкаУдаления Или ОбъектКонтакта.Бот <> Бот
		Или ОбъектКонтакта.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		ВызватьИсключение "Контакт MAX недоступен.";
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектКонтакта.ОтделениеMAX) Тогда
		Результат.Отделение = ОбъектКонтакта.ОтделениеMAX;
		Возврат Результат;
	КонецЕсли;
	Отбор = Новый Структура("Ссылка", Отделение);
	Если ДоступныеОтделения().НайтиСтроки(Отбор).Количество() <> 1 Тогда
		ВызватьИсключение "Выбранное отделение больше недоступно.";
	КонецЕсли;
	ОбъектКонтакта.ОтделениеMAX = Отделение;
	ОбъектКонтакта.ОбменДанными.Загрузка = Истина;
	ОбъектКонтакта.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ОбъектКонтакта.Записать();
		бит_омни_ИнтеграцияСMAX.ЗаписатьВыборОтделенияMAX(Контакт, Бот, Отделение);
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	Результат.Изменено = Истина;
	Результат.Отделение = Отделение;
	Возврат Результат;

КонецФункции

