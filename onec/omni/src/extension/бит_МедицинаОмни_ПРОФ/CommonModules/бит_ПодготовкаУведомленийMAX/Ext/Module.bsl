#Область ПрограммныйИнтерфейс

// Доверенный серверный модуль, без ServerCall. Здесь нет сетевых вызовов.
// В медицинской транзакции нет доступа к содержимому СКД и алгоритмов.
Процедура ЗафиксироватьДоЗаписи(Источник) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Активные.Рассылка КАК Рассылка, Активные.Бот КАК Бот
	|ИЗ РегистрСведений.бит_омни_АктивныеРассылки КАК Активные
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_омни_Рассылки.Принадлежность КАК Принадлежность
	| ПО Принадлежность.Ссылка = Активные.Рассылка
	|ГДЕ Принадлежность.Объект = &Имя
	| И Активные.Рассылка.РежимРассылки = &Режим И НЕ Активные.Рассылка.ПометкаУдаления
	| И Активные.Бот.Использовать И НЕ Активные.Бот.ПометкаУдаления
	| И Активные.Бот.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)");
	Запрос.УстановитьПараметр("Имя", Источник.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("Режим", Перечисления.бит_омни_РежимыРассылки.ПриЗаписиОбъекта);
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Рассылки = Запрос.Выполнить().Выгрузить();
		УстановитьПривилегированныйРежим(ПрежнийРежим);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	Если Рассылки.Количество() = 0 Тогда Возврат; КонецЕсли;
	До = Новый Структура;
	Если Не Источник.ЭтоНовый() Тогда
		До = СнимокРеквизитов(Источник.Ссылка.ПолучитьОбъект());
	КонецЕсли;
	Источник.ДополнительныеСвойства.Вставить("бит_ПодготовкаРассылок", Новый Структура("Рассылки,До", Рассылки, До));
КонецПроцедуры

Процедура ЗафиксироватьПослеЗаписи(Источник) Экспорт
	Данные = Неопределено;
	Если Не Источник.ДополнительныеСвойства.Свойство("бит_ПодготовкаРассылок", Данные) Тогда Возврат; КонецЕсли;
	Источник.ДополнительныеСвойства.Удалить("бит_ПодготовкаРассылок");
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Намерение уведомления должно фиксироваться вместе с объектом."; КонецЕсли;
	КлючИсточника = Источник.Метаданные().ПолноеИмя() + ":" + Строка(Источник.Ссылка.УникальныйИдентификатор());
	После = СнимокРеквизитов(Источник);
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		СохранитьНамерения(Источник.Ссылка, КлючИсточника, Данные, После);
		УстановитьПривилегированныйРежим(ПрежнийРежим);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура СохранитьНамерения(СсылкаИсточника, КлючИсточника, Данные, После)
	Для Каждого Рассылка Из Данные.Рассылки Цикл
		ЗаблокироватьНамерение(КлючИсточника, Рассылка.Рассылка, Рассылка.Бот);
		Запись = ПрочитатьНамерение(КлючИсточника, Рассылка.Рассылка, Рассылка.Бот);
		До = Данные.До;
		// Сохраняем исходное событие создания при нескольких сохранениях до worker.
		Если Запись.Выбран() И Запись.Состояние <> "Готово" Тогда
			До = Запись.Снимок.Получить().До;
		КонецЕсли;
		Запись.Снимок = Новый ХранилищеЗначения(Новый Структура("Источник,До,После", СсылкаИсточника, До, После));
		Запись.Версия = Строка(Новый УникальныйИдентификатор);
		Запись.Состояние = "Ожидает";
		Запись.Попыток = 0;
		Запись.СледующаяПопытка = ТекущаяДатаСеанса();
		Запись.Обновлено = ТекущаяДатаСеанса();
		Запись.Ошибка = "";
		Запись.Записать();
	КонецЦикла;
КонецПроцедуры

// Необязательная рассылка ошибается в отдельной транзакции, после сохранения
// медицинского объекта. Пять попыток, затем явный карантин с сохранённым снимком.
Процедура ВыполнитьПодготовку(ТолькоИсточник = "", ТолькоБот = Неопределено) Экспорт
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Подготовка уведомлений запускается вне транзакции объекта."; КонецЕсли;
	ВосстановитьСтарыеСнимки(ТолькоИсточник, ТолькоБот);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100 Намерения.Источник КАК Источник,
	| Намерения.Рассылка КАК Рассылка, Намерения.Бот КАК Бот, Намерения.Версия КАК Версия
	|ИЗ РегистрСведений.бит_ПодготовкаРассылокMAX КАК Намерения
	|ГДЕ Намерения.Состояние = ""Ожидает"" И Намерения.СледующаяПопытка <= &Момент
	| И (&ТолькоИсточник = """" ИЛИ Намерения.Источник = &ТолькоИсточник)
	| И (&ВсеБоты ИЛИ Намерения.Бот = &ТолькоБот)
	|УПОРЯДОЧИТЬ ПО Намерения.Обновлено, Намерения.Источник");
	Запрос.УстановитьПараметр("Момент", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ТолькоИсточник", ТолькоИсточник);
	Запрос.УстановитьПараметр("ВсеБоты", ТолькоБот = Неопределено);
	Запрос.УстановитьПараметр("ТолькоБот", ТолькоБот);
	Для Каждого Кандидат Из Запрос.Выполнить().Выгрузить() Цикл
		// СКД/алгоритмы и чтение источника вне блокировки намерения: нет цикла
		// "worker держит намерение -> ждёт документ -> документ ждёт намерение".
		Попытка
			ИсходнаяЗапись = ПрочитатьНамерение(Кандидат.Источник, Кандидат.Рассылка, Кандидат.Бот);
			Если Не ИсходнаяЗапись.Выбран() Или ИсходнаяЗапись.Версия <> Кандидат.Версия Тогда Продолжить; КонецЕсли;
			Снимок = ИсходнаяЗапись.Снимок.Получить();
			Подготовка = ПодготовитьНамерение(Снимок, Кандидат.Рассылка, Кандидат.Бот);
			Если ТранзакцияАктивна() Тогда ВызватьИсключение "Алгоритм рассылки оставил незавершённую транзакцию."; КонецЕсли;
			ПрименитьНамерение(Кандидат, Снимок, Подготовка);
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			// Worker вошёл без транзакции; это только незакрытая транзакция
			// ошибочного пользовательского алгоритма, не транзакция медицинской записи.
			// BSLLS:WrongUseOfRollbackTransactionMethod-off
			// BSLLS:PairingBrokenTransaction-off
			Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
			// BSLLS:PairingBrokenTransaction-on
			// BSLLS:WrongUseOfRollbackTransactionMethod-on
			ЗафиксироватьОшибку(Кандидат, ТекстОшибки);
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Отмена изменяет поколение намерения: ранее рассчитанный вне транзакции план
// не сможет воскресить отменённое уведомление при последующем CAS.
Процедура ОтменитьНамеренияЗаявки(Заявка) Экспорт
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Отмена намерений требует транзакцию заявки."; КонецЕсли;
	Источник = "Документ.Заявка:" + Строка(Заявка.УникальныйИдентификатор());
	Запрос = Новый Запрос("ВЫБРАТЬ Намерения.Рассылка КАК Рассылка, Намерения.Бот КАК Бот
	|ИЗ РегистрСведений.бит_ПодготовкаРассылокMAX КАК Намерения
	|ГДЕ Намерения.Источник = &Источник
	|УПОРЯДОЧИТЬ ПО Намерения.Рассылка, Намерения.Бот");
	Запрос.УстановитьПараметр("Источник", Источник);
	Для Каждого СтрокаНамерения Из Запрос.Выполнить().Выгрузить() Цикл
		ЗаблокироватьНамерение(Источник, СтрокаНамерения.Рассылка, СтрокаНамерения.Бот);
		Запись = ПрочитатьНамерение(Источник, СтрокаНамерения.Рассылка, СтрокаНамерения.Бот);
		Если Запись.Выбран() Тогда
			Запись.Версия = Строка(Новый УникальныйИдентификатор);
			Запись.Состояние = "Готово";
			Запись.Снимок = Новый ХранилищеЗначения(Неопределено);
			Запись.Ошибка = "Подготовка отменена вместе с заявкой.";
			Запись.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Администратор исправляет СКД/шаблон, затем явно повторяет сохранённое намерение.
Процедура ПовторитьПодготовку(Источник, Рассылка, Бот) Экспорт
	Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Повтор подготовки доступен администратору."; КонецЕсли;
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Повтор подготовки требует отдельной транзакции."; КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНамерение(Источник, Рассылка, Бот);
		Запись = ПрочитатьНамерение(Источник, Рассылка, Бот);
		Если Запись.Выбран() И Запись.Состояние = "Ошибка" Тогда
			Запись.Состояние = "Ожидает";
			Запись.Попыток = 0;
			Запись.СледующаяПопытка = ТекущаяДатаСеанса();
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьНамерение(Кандидат, Снимок, Подготовка)
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНамерение(Кандидат.Источник, Кандидат.Рассылка, Кандидат.Бот);
		Запись = ПрочитатьНамерение(Кандидат.Источник, Кандидат.Рассылка, Кандидат.Бот);
		Если Запись.Выбран() И Запись.Состояние = "Ожидает" И Запись.Версия = Кандидат.Версия Тогда
			бит_омни_ОчередьСообщенийMAX.бит_ПрименитьПодготовку(
				Снимок.После, Кандидат.Рассылка, Кандидат.Бот, Подготовка);
			Запись.Состояние = "Готово";
			Запись.Снимок = Новый ХранилищеЗначения(Неопределено);
			Запись.Ошибка = "";
			Запись.Обновлено = ТекущаяДатаСеанса();
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Одноразовая ленивая миграция ожидающих снимков .35. Старые сообщения не
// отправляются без версии события: сначала готовятся заново из текущей заявки.
Процедура ВосстановитьСтарыеСнимки(ТолькоИсточник, ТолькоБот)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100 Очередь.Источник КАК Источник,
	| Очередь.Рассылка КАК Рассылка, Очередь.Бот КАК Бот,
	| ЕСТЬNULL(Намерения.Версия, """") КАК Версия
	|ИЗ РегистрСведений.бит_омни_ОчередьСообщенийMAX КАК Очередь
	| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПодготовкаРассылокMAX КАК Намерения
	| ПО Намерения.Источник = Очередь.Источник И Намерения.Рассылка = Очередь.Рассылка И Намерения.Бот = Очередь.Бот
	|ГДЕ Очередь.Состояние = ""Ожидает"" И Очередь.Источник ПОДОБНО ""Документ.Заявка:%""
	| И НЕ Очередь.АдресатJSON ПОДОБНО ""%ВерсияСобытияИсточника%""
	| И (Намерения.Состояние ЕСТЬ NULL ИЛИ Намерения.Состояние = ""Готово"")
	| И (&ТолькоИсточник = """" ИЛИ Очередь.Источник = &ТолькоИсточник)
	| И (&ВсеБоты ИЛИ Очередь.Бот = &ТолькоБот)");
	Запрос.УстановитьПараметр("ТолькоИсточник", ТолькоИсточник);
	Запрос.УстановитьПараметр("ВсеБоты", ТолькоБот = Неопределено);
	Запрос.УстановитьПараметр("ТолькоБот", ТолькоБот);
	Для Каждого Кандидат Из Запрос.Выполнить().Выгрузить() Цикл
		Ссылка = Документы.Заявка.ПолучитьСсылку(Новый УникальныйИдентификатор(Сред(Кандидат.Источник, СтрДлина("Документ.Заявка:") + 1)));
		Данные = СнимокРеквизитов(Ссылка.ПолучитьОбъект());
		Если Данные.Количество() = 0 Тогда Продолжить; КонецЕсли;
		НачатьТранзакцию();
		Попытка
			ЗаблокироватьНамерение(Кандидат.Источник, Кандидат.Рассылка, Кандидат.Бот);
			Запись = ПрочитатьНамерение(Кандидат.Источник, Кандидат.Рассылка, Кандидат.Бот);
			Если Не Запись.Выбран() Или Запись.Состояние = "Готово" И Запись.Версия = Кандидат.Версия Тогда
				Запись.Снимок = Новый ХранилищеЗначения(Новый Структура("Источник,До,После", Ссылка, Данные, Данные));
				Запись.Версия = Строка(Новый УникальныйИдентификатор);
				Запись.Состояние = "Ожидает";
				Запись.Попыток = 0;
				Запись.СледующаяПопытка = ТекущаяДатаСеанса();
				Запись.Обновлено = ТекущаяДатаСеанса();
				Запись.Записать();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ПодготовитьНамерение(Снимок, СсылкаРассылки, Бот)
	Источник = Снимок.После;
	Настройка = СсылкаРассылки.ПолучитьОбъект();
	МодульСхемыКомпоновки = ОбщегоНазначения.ОбщийМодуль("бит_омни_СхемыКомпоновки");
	Рассылка = Новый Структура("Рассылка,Бот,СКДКонтекст,СКДПолучатели,ПередЗаписью,ПриЗаписи",
		СсылкаРассылки, Бот, Настройка.СКДКонтекст.Получить(), Настройка.СКДПолучатели.Получить(),
		Неопределено, Неопределено);
	Рассылка.ПередЗаписью = МодульСхемыКомпоновки.ОписаниеНабораДанных(Рассылка.СКДКонтекст, "ПередЗаписью");
	Рассылка.ПриЗаписи = МодульСхемыКомпоновки.ОписаниеНабораДанных(Рассылка.СКДКонтекст, "ПриЗаписи");
	НоваяЗапись = Рассылка.ПередЗаписью.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, Снимок.До);
	// Старый стандартный шаблон отбирал только пустую СсылкаДо. Для уже
	// ожидающего события восстанавливаем лишь этот технический признак;
	// остальные условия/получатели вычисляются заново по свежему снимку.
	Если Настройка.ДатыСобытия.Количество() = 0
		И Настройка.Шаблон.ИдентификаторСтандартногоШаблона = "MAX_APPOINTMENT_CREATED"
		И бит_омни_ОчередьСообщенийMAX.бит_ЕстьОжидающееСобытие(Источник.Ссылка, СсылкаРассылки, Бот)
		И Рассылка.ПередЗаписью.Колонки.Найти("Ссылка") <> Неопределено Тогда
		НоваяЗапись.Ссылка = Документы.Заявка.ПустаяСсылка();
	КонецЕсли;
	НоваяЗапись = Рассылка.ПриЗаписи.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, Снимок.После);
	ТаблицаОбъединения = Рассылка.ПередЗаписью.Скопировать();
	
	Для Каждого Колонка Из ТаблицаОбъединения.Колонки Цикл
		Колонка.Имя = Колонка.Имя + "До";	
	КонецЦикла;
	
	Для Каждого Колонка Из Рассылка.ПриЗаписи.Колонки Цикл
		ТаблицаОбъединения.Колонки.Добавить(Колонка.Имя + "После", Колонка.ТипЗначения);
		ТаблицаОбъединения[0][Колонка.Имя + "После"] = НоваяЗапись[Колонка.Имя];
	КонецЦикла;
	
	СКДКонтекст = Рассылка.СКДКонтекст.ХранилищеСКД.Получить();
	// Схемы старого генератора могли не содержать описание local-источника.
	Если СКДКонтекст.ИсточникиДанных.Найти("ИсточникДанных1") = Неопределено Тогда
		ИсточникСКД = СКДКонтекст.ИсточникиДанных.Добавить();
		ИсточникСКД.Имя = "ИсточникДанных1";
		ИсточникСКД.ТипИсточникаДанных = "Local";
	КонецЕсли;
	НаборДанныхОбъединенный = СКДКонтекст.НаборыДанных.Найти("НаборДанныхОбъединенный");
	Если НаборДанныхОбъединенный = Неопределено Тогда
		НаборДанныхОбъединенный = СКДКонтекст.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	КонецЕсли;
	НаборДанныхОбъединенный.Имя = "НаборДанныхОбъединенный"; 
	НаборДанныхОбъединенный.ИмяОбъекта = "НаборДанныхОбъединенный"; 
	НаборДанныхОбъединенный.ИсточникДанных = "ИсточникДанных1"; 
	Для Каждого Колонка Из ТаблицаОбъединения.Колонки Цикл
		
		Если НаборДанныхОбъединенный.Поля.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Колонка.ТипЗначения.СодержитТип(Тип("ТаблицаЗначений")) Тогда
			Поле = НаборДанныхОбъединенный.Поля.Добавить(Тип("ВложенныйНаборДанныхСхемыКомпоновкиДанных"));
		Иначе
			Поле = НаборДанныхОбъединенный.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			Поле.ТипЗначения = Колонка.ТипЗначения;
		КонецЕсли;
		
		Поле.Поле = Колонка.Имя;
		Поле.ПутьКДанным = Колонка.Имя;
		Поле.Заголовок = Колонка.Заголовок;
		
	КонецЦикла;
	
	НДПередЗаписью = СКДКонтекст.НаборыДанных.Найти("ПередЗаписью");
	НДПриЗаписи = СКДКонтекст.НаборыДанных.Найти("ПриЗаписи");
	
	Если НДПередЗаписью <> Неопределено Тогда
		СКДКонтекст.НаборыДанных.Удалить(НДПередЗаписью);	
	КонецЕсли;                                           
	
	Если НДПриЗаписи <> Неопределено Тогда
		СКДКонтекст.НаборыДанных.Удалить(НДПриЗаписи);	
	КонецЕсли;
	
	ПараметрыВыполнения = МодульСхемыКомпоновки.ПараметрыВыполненияСхемы("ТаблицаЗначений");
	ПараметрыВыполнения.ВнешниеНаборыДанных.Вставить("НаборДанныхОбъединенный", ТаблицаОбъединения);
	
	Контекст = МодульСхемыКомпоновки.ВыполнитьСхему(СКДКонтекст, ПараметрыВыполнения);
	ПолучателиТЗ = МодульСхемыКомпоновки.ВыполнитьСхему(Рассылка.СКДПолучатели, ПараметрыВыполнения);
	Получатели = ПолучателиТЗ.ВыгрузитьКолонку("Получатель");
	
	Если Контекст.Количество() > 1 Тогда ВызватьИсключение "Контекст рассылки при записи должен возвращать не более одной строки."; КонецЕсли;
	Снимки = Новый Массив;
	Даты = Новый Соответствие;
	Если Контекст.Количество() = 1 Тогда
		Снимки = бит_омни_ИнтеграцияСMAX.ПодготовитьСообщенияДляОчереди(Настройка.Шаблон, Получатели, Бот, Контекст[0]);
		Для Каждого Правило Из Настройка.ДатыСобытия Цикл
			Даты.Вставить(Правило.ИдентификаторСтроки, бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст[0]));
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("Контекст,Снимки,Даты", Контекст, Снимки, Даты);
КонецФункции

Функция СнимокРеквизитов(Объект)
	Результат = Новый Структура;
	Если Объект = Неопределено Тогда Возврат Результат; КонецЕсли;
	Результат.Вставить("Ссылка", Объект.Ссылка);
	Для Каждого Реквизит Из Объект.Метаданные().СтандартныеРеквизиты Цикл
		// Эти стандартные реквизиты не являются хранимыми данными объекта.
		Если СтрРазделить("Представление,ВерсияДанных,Предопределенный,ИмяПредопределенныхДанных", ",").Найти(Реквизит.Имя) <> Неопределено Тогда Продолжить; КонецЕсли;
		Результат.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);
	КонецЦикла;
	Для Каждого Реквизит Из Объект.Метаданные().Реквизиты Цикл
		Результат.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из Объект.Метаданные().ТабличныеЧасти Цикл
		Результат.Вставить(ТабличнаяЧасть.Имя, Объект[ТабличнаяЧасть.Имя].Выгрузить());
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаблокироватьНамерение(Источник, Рассылка, Бот)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_ПодготовкаРассылокMAX");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Источник", Источник);
	Элемент.УстановитьЗначение("Рассылка", Рассылка);
	Элемент.УстановитьЗначение("Бот", Бот);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ПрочитатьНамерение(Источник, Рассылка, Бот)
	Запись = РегистрыСведений.бит_ПодготовкаРассылокMAX.СоздатьМенеджерЗаписи();
	Запись.Источник = Источник;
	Запись.Рассылка = Рассылка;
	Запись.Бот = Бот;
	Запись.Прочитать();
	Запись.Источник = Источник;
	Запись.Рассылка = Рассылка;
	Запись.Бот = Бот;
	Возврат Запись;
КонецФункции

Процедура ЗафиксироватьОшибку(Кандидат, ТекстОшибки)
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНамерение(Кандидат.Источник, Кандидат.Рассылка, Кандидат.Бот);
		Запись = ПрочитатьНамерение(Кандидат.Источник, Кандидат.Рассылка, Кандидат.Бот);
		Если Запись.Выбран() И Запись.Версия = Кандидат.Версия Тогда
			Запись.Попыток = Запись.Попыток + 1;
			Запись.Состояние = ?(Запись.Попыток >= 5, "Ошибка", "Ожидает");
			Запись.СледующаяПопытка = ТекущаяДатаСеанса() + 60 * Запись.Попыток;
			Запись.Ошибка = Лев(ТекстОшибки, 1000);
			Запись.Обновлено = ТекущаяДатаСеанса();
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ЗаписьЖурналаРегистрации("МАКС.Подготовка.Ошибка", УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Справочники.бит_омни_Рассылки, Кандидат.Рассылка,
		"Источник: " + Кандидат.Источник + ". " + ТекстОшибки);
КонецПроцедуры

#КонецОбласти
