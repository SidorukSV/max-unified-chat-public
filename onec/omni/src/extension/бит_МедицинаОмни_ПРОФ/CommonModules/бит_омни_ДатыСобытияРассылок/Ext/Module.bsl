#Область ПрограммныйИнтерфейс

// Вызывается только серверным кодом. Модуль намеренно недоступен для вызова с клиента:
// ручной BSL поступает из сохраненного правила, авторство которого проверено при записи.
Функция РассчитатьДату(Правило, Контекст) Экспорт
	Если НЕ Правило.Использовать Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПроверитьПравило(Правило);
	Если Правило.Шаблон = "Алгоритм" Тогда
		ДатаСобытия = ВыполнитьАлгоритм(Правило.АлгоритмРасчета, КопияСкалярногоКонтекста(Контекст));
		Если ДатаСобытия = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Попытка
			ДатаСобытия = Контекст[Правило.РеквизитКонтекста];
		Исключение
			ВызватьИсключение "В контексте рассылки отсутствует реквизит даты: " + Правило.РеквизитКонтекста;
		КонецПопытки;
		ПроверитьДату(ДатаСобытия, Правило.РеквизитКонтекста);
		Если Правило.Шаблон = "ДоДаты" Тогда
			ДатаСобытия = ДатаСобытия - Правило.КоличествоЧасов * 3600;
		ИначеЕсли Правило.Шаблон = "ПослеДаты" Тогда
			ДатаСобытия = ДатаСобытия + Правило.КоличествоЧасов * 3600;
		КонецЕсли;
	КонецЕсли;
	ПроверитьДату(ДатаСобытия, "Результат расчета");
	Возврат ДатаСобытия;
КонецФункции

Функция МожноРедактироватьАлгоритм() Экспорт
	Возврат ПравоДоступа("Администрирование", Метаданные);
КонецФункции

Процедура ПроверитьДатыПередЗаписью(ОбъектРассылки) Экспорт
	Идентификаторы = Новый Соответствие;
	Для Каждого Правило Из ОбъектРассылки.ДатыСобытия Цикл
		Правило.ИдентификаторСтроки = СокрЛП(Правило.ИдентификаторСтроки);
		Если НЕ КорректныйИдентификаторСтроки(Правило.ИдентификаторСтроки)
			Или Идентификаторы.Получить(Правило.ИдентификаторСтроки) <> Неопределено Тогда
			Правило.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		Идентификаторы.Вставить(Правило.ИдентификаторСтроки, Истина);
		ПроверитьПравило(Правило);
	КонецЦикла;
	Если НЕ МожноРедактироватьАлгоритм() Тогда
		ПроверитьНеизменностьАлгоритмов(ОбъектРассылки);
	КонецЕсли;
КонецПроцедуры

// Возвращает имена реквизитов типа Дата. Поле допускает ручной ввод имени алиаса СКД.
Функция РеквизитыКонтекста(КонтекстСКД = Неопределено) Экспорт
	Результат = Новый СписокЗначений;
	// Даты берутся именно из выбранного контекста, а не из жестко заданной Заявки.
	Если ТипЗнч(КонтекстСКД) <> Тип("СхемаКомпоновкиДанных") И НЕ ЗначениеЗаполнено(КонтекстСКД) Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(КонтекстСКД) = Тип("СхемаКомпоновкиДанных") Тогда
		Схема = КонтекстСКД;
	Иначе
		Схема = КонтекстСКД.ХранилищеСКД.Получить();
	КонецЕсли;
	Для Каждого НаборДанных Из Схема.НаборыДанных Цикл
		Для Каждого Поле Из НаборДанных.Поля Цикл
			Если ТипЗнч(Поле) <> Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;
			ИмяПоля = Строка(Поле.ПутьКДанным);
			Если Поле.ТипЗначения.СодержитТип(Тип("Дата")) И ДопустимоеИмяРеквизита(ИмяПоля)
				И Результат.НайтиПоЗначению(ИмяПоля) = Неопределено Тогда
				Результат.Добавить(ИмяПоля, ИмяПоля + " (контекст СКД)");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПравило(Правило)
	Если Правило.КоличествоЧасов < 0 Или Правило.КоличествоЧасов > 87600 Тогда
		ВызватьИсключение "Даты события: количество часов должно быть от 0 до 87600.";
	КонецЕсли;
	Если СтрДлина(Правило.АлгоритмРасчета) > 10000 Тогда
		ВызватьИсключение "Даты события: ручной алгоритм не должен превышать 10000 символов.";
	КонецЕсли;
	Если НЕ Правило.Использовать И ПустаяСтрока(Правило.Шаблон) Тогда
		Возврат;
	КонецЕсли;
	Если Правило.Шаблон = "Алгоритм" Тогда
		Если Правило.Использовать И ПустаяСтрока(Правило.АлгоритмРасчета) Тогда
			ВызватьИсключение "Даты события: заполните ручной алгоритм (переменная Результат).";
		КонецЕсли;
	ИначеЕсли Правило.Шаблон = "ДоДаты" Или Правило.Шаблон = "ПослеДаты" Или Правило.Шаблон = "ДатаОбъекта" Тогда
		Если Правило.Использовать И НЕ ДопустимоеИмяРеквизита(Правило.РеквизитКонтекста) Тогда
			ВызватьИсключение "Даты события: укажите имя реквизита контекста без выражений и вложенных путей.";
		КонецЕсли;
	Иначе
		ВызватьИсключение "Даты события: неизвестный шаблон расчета даты.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьДату(ЗначениеДаты, ИмяРеквизита)
	Если ТипЗнч(ЗначениеДаты) <> Тип("Дата") Или НЕ ЗначениеЗаполнено(ЗначениеДаты) Тогда
		ВызватьИсключение "Даты события: " + ИмяРеквизита + " должен содержать непустую дату.";
	КонецЕсли;
КонецПроцедуры

Функция ДопустимоеИмяРеквизита(ИмяРеквизита)
	Если ПустаяСтрока(ИмяРеквизита) Или СтрДлина(ИмяРеквизита) > 128 Тогда
		Возврат Ложь;
	КонецЕсли;
	Буквы = "_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZабвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	Для НомерСимвола = 1 По СтрДлина(ИмяРеквизита) Цикл
		ДопустимыеСимволы = Буквы + ?(НомерСимвола = 1, "", "0123456789");
		Если СтрНайти(ДопустимыеСимволы, Сред(ИмяРеквизита, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция КорректныйИдентификаторСтроки(Идентификатор)
	Если СтрДлина(Идентификатор) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		ИдентификаторUUID = Новый УникальныйИдентификатор(Идентификатор);
		Возврат НРег(Строка(ИдентификаторUUID)) = НРег(Идентификатор);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура ПроверитьНеизменностьАлгоритмов(ОбъектРассылки)
	СтарыеАлгоритмы = Новый Соответствие;
	Если НЕ ОбъектРассылки.ЭтоНовый() Тогда
		СтарыйОбъект = ОбъектРассылки.Ссылка.ПолучитьОбъект();
		Для Каждого Правило Из СтарыйОбъект.ДатыСобытия Цикл
			Если Правило.Шаблон = "Алгоритм" Или НЕ ПустаяСтрока(Правило.АлгоритмРасчета) Тогда
				СтарыеАлгоритмы.Вставить(Правило.ИдентификаторСтроки, Правило);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Правило Из ОбъектРассылки.ДатыСобытия Цикл
		Старое = СтарыеАлгоритмы.Получить(Правило.ИдентификаторСтроки);
		Если Старое = Неопределено И Правило.Шаблон <> "Алгоритм" И ПустаяСтрока(Правило.АлгоритмРасчета) Тогда
			Продолжить;
		КонецЕсли;
		Если Старое = Неопределено Тогда
			ВызватьИсключение "Создавать или изменять ручные алгоритмы дат событий может только администратор.";
		КонецЕсли;
		Если Старое.АлгоритмРасчета <> Правило.АлгоритмРасчета Или Старое.Шаблон <> Правило.Шаблон
			Или Старое.Использовать <> Правило.Использовать Или Старое.РеквизитКонтекста <> Правило.РеквизитКонтекста
			Или Старое.КоличествоЧасов <> Правило.КоличествоЧасов Тогда
			ВызватьИсключение "Изменять ручные алгоритмы дат событий может только администратор.";
		КонецЕсли;
		СтарыеАлгоритмы.Удалить(Правило.ИдентификаторСтроки);
	КонецЦикла;
	Если СтарыеАлгоритмы.Количество() > 0 Тогда
		ВызватьИсключение "Удалять ручные алгоритмы дат событий может только администратор.";
	КонецЕсли;
КонецПроцедуры

Функция КопияСкалярногоКонтекста(Контекст)
	Копия = Новый Структура;
	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
		Для Каждого Пара Из Контекст Цикл
			ДобавитьСкаляр(Копия, Пара.Ключ, Пара.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Контекст) = Тип("СтрокаТаблицыЗначений") Тогда
		Для Каждого Колонка Из Контекст.Владелец().Колонки Цикл
			ДобавитьСкаляр(Копия, Колонка.Имя, Контекст[Колонка.Имя]);
		КонецЦикла;
	Иначе
		ОписаниеОбъекта = Контекст.Метаданные();
		Для Каждого Реквизит Из ОписаниеОбъекта.СтандартныеРеквизиты Цикл
			ДобавитьСкаляр(Копия, Реквизит.Имя, Контекст[Реквизит.Имя]);
		КонецЦикла;
		Для Каждого Реквизит Из ОписаниеОбъекта.Реквизиты Цикл
			ДобавитьСкаляр(Копия, Реквизит.Имя, Контекст[Реквизит.Имя]);
		КонецЦикла;
	КонецЕсли;
	Возврат Копия;
КонецФункции

Процедура ДобавитьСкаляр(Копия, Имя, Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Дата") Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево") Или Значение = Неопределено Тогда
		Копия.Вставить(Имя, Значение);
	КонецЕсли;
КонецПроцедуры

// Безопасный режим ограничивает внешние операции, но НЕ является песочницей базы.
// Глобальный контекст 1С остается доступен: алгоритмы задает только доверенный администратор.
// Параметр Контекст здесь содержит исключительно копию скаляров, без объектов/ссылок.
Функция ВыполнитьАлгоритм(Знач ТекстАлгоритма, Знач Контекст)
	Результат = Неопределено;
	УстановитьБезопасныйРежим(Истина);
	// Платформа снимает только локальное включение при выходе из этой функции,
	// в том числе по исключению. Внешний безопасный режим остается неизменным.
	Выполнить(ТекстАлгоритма);
	Возврат Результат;
КонецФункции

#КонецОбласти
