#Область ПрограммныйИнтерфейс

// Вызывается из ПриЗаписи внутри транзакции объекта. Получатели и контекст уже
// отобраны СКД. Здесь сохраняется снимок, сетевых вызовов нет.
Процедура ПоставитьПриЗаписи(Источник, Рассылка, Бот, Получатели, Контекст) Экспорт
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Очередь при записи должна формироваться в транзакции объекта.";
	КонецЕсли;
	// Подписка на запись - доверенный серверный путь, не ручная отправка оператора.
	// RLS чата не должен срывать запись заявки или обновление уже ожидающего уведомления.
	// Модуль не разрешает вызов сервера; данные очереди вызывающему клиенту не возвращаются.
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ПоставитьПриЗаписиСлужебно(Источник, Рассылка, Бот, Получатели, Контекст);
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ПоставитьПриЗаписиСлужебно(Источник, Рассылка, Бот, Получатели, Контекст, Подготовка = Неопределено)
	Если Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ТранзакцияАктивна() Тогда
		ВызватьИсключение "Очередь при записи должна формироваться в транзакции объекта.";
	КонецЕсли;
	Если Контекст.Количество() > 1 Тогда
		ВызватьИсключение "Контекст рассылки при записи должен возвращать не более одной строки.";
	КонецЕсли;
	ИдентификаторИсточника = Источник.Ссылка.Метаданные().ПолноеИмя() + ":"
		+ Строка(Источник.Ссылка.УникальныйИдентификатор());
	Группа = ХешКлюча(ИдентификаторИсточника + ":" + Строка(Рассылка.УникальныйИдентификатор())
		+ ":" + Строка(Бот.УникальныйИдентификатор()));
	ЗаблокироватьГруппу(Группа);
	Набор = РегистрыСведений.бит_омни_ОчередьСообщенийMAX.СоздатьНаборЗаписей();
	Набор.Отбор.Группа.Установить(Группа);
	Набор.Прочитать();
	Таблица = Набор.Выгрузить();
	Таблица.Индексы.Добавить("Ключ");
	АктуальныеКлючи = Новый Соответствие;
	Момент = ТекущаяДатаСеанса();
	Настройка = Рассылка.ПолучитьОбъект();
	ИсточникДопустим = бит_ДопустимИсточникУведомления(Источник, Рассылка);
	ВерсияСобытия = бит_ВерсияСобытияИсточника(Источник);
	Если Контекст.Количество() = 1 И ИсточникДопустим Тогда
		Если Подготовка = Неопределено Тогда
			Снимки = бит_омни_ИнтеграцияСMAX.ПодготовитьСообщенияДляОчереди(
				Настройка.Шаблон, Получатели, Бот, Контекст[0]);
		Иначе
			Снимки = Подготовка.Снимки;
		КонецЕсли;
		Если Настройка.ДатыСобытия.Количество() = 0 Тогда
			ДобавитьСнимки(Таблица, АктуальныеКлючи, Группа, ИдентификаторИсточника,
				Бот, Рассылка, "IMMEDIATE", Момент, Снимки, Момент, ВерсияСобытия);
		Иначе
			Для Каждого Правило Из Настройка.ДатыСобытия Цикл
				Если Подготовка = Неопределено Тогда
					ДатаОтправки = бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст[0]);
				Иначе
					ДатаОтправки = Подготовка.Даты.Получить(Правило.ИдентификаторСтроки);
				КонецЕсли;
				Если ДатаОтправки <> Неопределено Тогда
					ДобавитьСнимки(Таблица, АктуальныеКлючи, Группа, ИдентификаторИсточника,
						Бот, Рассылка, Правило.ИдентификаторСтроки, ДатаОтправки, Снимки, Момент, ВерсияСобытия);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Для Каждого СтрокаОчереди Из Таблица Цикл
		// Любой устаревший снимок, включая IMMEDIATE, запрещён к отправке.
		Если СтрокаОчереди.Состояние = "Ожидает"
			И АктуальныеКлючи.Получить(СтрокаОчереди.Ключ) = Неопределено Тогда
			СтрокаОчереди.Состояние = "Отменено";
			СтрокаОчереди.Обновлено = Момент;
			СтрокаОчереди.ОписаниеОшибки = "Условие, дата, правило или получатель изменились при записи объекта.";
		КонецЕсли;
	КонецЦикла;
	Набор.Загрузить(Таблица);
	Набор.Записать();
КонецПроцедуры

// Снимки/даты уже рассчитаны вне транзакции. Под блокировкой только применение.
Процедура бит_ПрименитьПодготовку(Источник, Рассылка, Бот, Подготовка) Экспорт
	ПоставитьПриЗаписиСлужебно(Источник, Рассылка, Бот, Новый Массив, Подготовка.Контекст, Подготовка);
КонецПроцедуры

// Периодический производитель вызывает внутри транзакции фиксации запуска.
// У каждого запуска свой ключ; даты событий к этому режиму не применяются.
Процедура ПоставитьПериодическуюРассылку(Бот, Рассылка, МоментЗапуска, Снимки) Экспорт
	Если НЕ ТранзакцияАктивна() Тогда
		ВызватьИсключение "Периодическая очередь должна формироваться в транзакции запуска.";
	КонецЕсли;
	ИдентификаторИсточника = "SCHEDULE:" + Строка(Рассылка.УникальныйИдентификатор())
		+ ":" + Формат(МоментЗапуска, "ДФ=yyyyMMddHHmmss");
	Группа = ХешКлюча(ИдентификаторИсточника + ":" + Строка(Бот.УникальныйИдентификатор()));
	ЗаблокироватьГруппу(Группа);
	Набор = РегистрыСведений.бит_омни_ОчередьСообщенийMAX.СоздатьНаборЗаписей();
	Набор.Отбор.Группа.Установить(Группа);
	Набор.Прочитать();
	Таблица = Набор.Выгрузить();
	Таблица.Индексы.Добавить("Ключ");
	ДобавитьСнимки(Таблица, Новый Соответствие, Группа, ИдентификаторИсточника,
		Бот, Рассылка, "SCHEDULE", МоментЗапуска, Снимки, МоментЗапуска);
	Набор.Загрузить(Таблица);
	Набор.Записать();
КонецПроцедуры

// Отдельное регламентное задание. Не вызывается из входящего long polling.
// До 100 сообщений за запуск. Нет автоматических повторов сетевой отправки.
Процедура ВыполнитьОтправку() Экспорт
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Обработчик очереди нельзя запускать внутри транзакции.";
	КонецЕсли;
	бит_ПодготовкаУведомленийMAX.ВыполнитьПодготовку();
	Запрос = Новый Запрос("ВЫБРАТЬ Боты.Ссылка КАК Бот
	|ИЗ Справочник.бит_омни_Боты КАК Боты
	|ГДЕ Боты.Использовать И НЕ Боты.ПометкаУдаления
	| И Боты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)");
	Для Каждого СтрокаБота Из Запрос.Выполнить().Выгрузить() Цикл
		Попытка
			бит_омни_НапоминанияMAX.ВыполнитьНапоминания(СтрокаБота.Бот);
		Исключение
			ЗаписьЖурналаРегистрации("МАКС.Очередь.Расписание", УровеньЖурналаРегистрации.Ошибка,
				,, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 100 Очередь.Группа КАК Группа, Очередь.Ключ КАК Ключ
	|ИЗ РегистрСведений.бит_омни_ОчередьСообщенийMAX КАК Очередь
	| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_АктивныеРассылки КАК Активные
	| ПО Активные.Бот = Очередь.Бот И Активные.Рассылка = Очередь.Рассылка
	| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПодготовкаРассылокMAX КАК Намерения
	| ПО Намерения.Источник = Очередь.Источник И Намерения.Рассылка = Очередь.Рассылка И Намерения.Бот = Очередь.Бот
	|ГДЕ (Очередь.Состояние = ""Ожидает"" И Очередь.ДатаОтправки <= &Момент
	| И Очередь.Бот.Использовать И НЕ Очередь.Бот.ПометкаУдаления
	| И НЕ Очередь.Рассылка.ПометкаУдаления
	| И (Намерения.Состояние ЕСТЬ NULL ИЛИ Намерения.Состояние = ""Готово"")
	| И НЕ Активные.Рассылка ЕСТЬ NULL)
	| ИЛИ (Очередь.Состояние = ""ВРаботе"" И Очередь.АрендаДо <= &Момент)
	|УПОРЯДОЧИТЬ ПО Очередь.ДатаОтправки, Очередь.Группа, Очередь.Ключ";
	Запрос.УстановитьПараметр("Момент", ТекущаяДатаСеанса());
	Для Каждого Кандидат Из Запрос.Выполнить().Выгрузить() Цикл
		Попытка
			// Адресные чтения здесь необходимы для атомарного захвата каждой строки
			// конкурирующими заданиями. Сетевой вызов выполняется вне транзакции.
			Сообщение = ЗахватитьСообщение(Кандидат.Группа, Кандидат.Ключ);
			Если Сообщение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				ПричинаОтказа = бит_ПроверитьАктуальностьСобытия(Сообщение);
				Если ПустаяСтрока(ПричинаОтказа) Тогда
					Результат = бит_омни_ИнтеграцияСMAX.ОтправитьПодготовленноеСообщение(
						Сообщение.Бот, Сообщение.Контакт, Сообщение.ТелоJSON, Сообщение.АдресатJSON);
				Иначе
					Результат = Новый Структура("Состояние,ИдентификаторСообщения,ОписаниеОшибки",
						"Ошибка", "", ПричинаОтказа);
				КонецЕсли;
			Исключение
				Результат = Новый Структура("Состояние,ИдентификаторСообщения,ОписаниеОшибки",
					"Неопределено", "", "Сбой отправки: результат неизвестен. Проверьте историю MAX.");
			КонецПопытки;
			ЗавершитьОтправку(Кандидат.Группа, Кандидат.Ключ, Сообщение.Попытка, Результат);
		Исключение
			ЗаписьЖурналаРегистрации("МАКС.Очередь.Ошибка", УровеньЖурналаРегистрации.Ошибка,
				,, "Ключ: " + Кандидат.Ключ + ". " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	//+бит_Сафаров ШИ 17.09.2026
	// Доставляет в том числе сохранённое намерение о долге после сбоя между commit и HTTP.
	Попытка
		бит_омни_НадежныйОбменMAX.ОтправитьОжидающие();
	Исключение
		ЗаписьЖурналаРегистрации("МАКС.Очередь.Outbox", УровеньЖурналаРегистрации.Ошибка,
			,, "Этап отправки сохранённых сообщений: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	//-бит_Сафаров ШИ 17.09.2026
КонецПроцедуры

// Атомарный захват также доступен серверным проверкам без отправки в сеть.
// Возвращает менеджер записи со снимком либо Неопределено.
Функция ЗахватитьСообщение(Группа, Ключ) Экспорт
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Захват должен фиксироваться отдельной транзакцией до отправки.";
	КонецЕсли;
	Результат = Неопределено;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьГруппу(Группа);
		Запись = ПрочитатьЗапись(Группа, Ключ);
		Если Запись.Выбран() Тогда
			Если Запись.Состояние = "ВРаботе" И Запись.АрендаДо <= ТекущаяДатаСеанса() Тогда
				Запись.Состояние = "Неопределено";
				Запись.ОписаниеОшибки = "Истек срок захвата. Доставка неизвестна; автоповтор запрещен.";
				Запись.Обновлено = ТекущаяДатаСеанса();
				Запись.Записать();
			ИначеЕсли Запись.Состояние = "Ожидает" И Запись.ДатаОтправки <= ТекущаяДатаСеанса()
				И РассылкаАктивна(Запись.Бот, Запись.Рассылка)
				И Не бит_ПодготовкаНеЗавершена(Запись) Тогда
				Запись.Состояние = "ВРаботе";
				Запись.Попытка = Строка(Новый УникальныйИдентификатор);
				Запись.Попыток = Запись.Попыток + 1;
				Запись.АрендаДо = ТекущаяДатаСеанса() + 300;
				Запись.Обновлено = ТекущаяДатаСеанса();
				Запись.Записать();
				Результат = Запись;
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Результат: Состояние, ИдентификаторСообщения, ОписаниеОшибки.
// Записывается только для UUID захватившей попытки, включая поздний ответ.
Процедура ЗавершитьОтправку(Группа, Ключ, ПопыткаДоставки, Результат) Экспорт
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Результат отправки фиксируется отдельной транзакцией.";
	КонецЕсли;
	Если Результат.Состояние <> "Отправлено" И Результат.Состояние <> "Ошибка"
		И Результат.Состояние <> "Неопределено" Тогда
		ВызватьИсключение "Недопустимый результат доставки.";
	КонецЕсли;
	//+бит_Сафаров ШИ 17.09.2026
	КлючДолга = "";
	//-бит_Сафаров ШИ 17.09.2026
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьГруппу(Группа);
		Запись = ПрочитатьЗапись(Группа, Ключ);
		Если Запись.Выбран() И Запись.Попытка = ПопыткаДоставки
			И (Запись.Состояние = "ВРаботе" Или Запись.Состояние = "Неопределено") Тогда
			Запись.Состояние = Результат.Состояние;
			Запись.ИдентификаторСообщения = Лев(Результат.ИдентификаторСообщения, 150);
			Запись.ОписаниеОшибки = Лев(Результат.ОписаниеОшибки, 1000);
			Запись.Обновлено = ТекущаяДатаСеанса();
			Запись.АрендаДо = Дата(1, 1, 1);
			Запись.Записать();
			//+бит_Сафаров ШИ 17.09.2026
			Если Результат.Состояние = "Отправлено"
				И Запись.Рассылка.Шаблон.ИдентификаторСтандартногоШаблона = "MAX_APPOINTMENT_CREATED" Тогда
				Попытка
					КлючДолга = бит_ПоставитьСообщениеОДолгеMAX(Запись);
				Исключение
					ЗаписьЖурналаРегистрации("МАКС.Очередь.Долг", УровеньЖурналаРегистрации.Ошибка,
						,, "Этап подготовки долга: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЕсли;
			//-бит_Сафаров ШИ 17.09.2026
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	//+бит_Сафаров ШИ 17.09.2026
	Если Не ПустаяСтрока(КлючДолга) Тогда
		Попытка
			бит_омни_НадежныйОбменMAX.ОтправитьПоКлючу(КлючДолга);
		Исключение
			ЗаписьЖурналаРегистрации("МАКС.Очередь.Долг", УровеньЖурналаРегистрации.Ошибка,
				,, "Этап отправки долга: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	//-бит_Сафаров ШИ 17.09.2026
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция бит_ПоставитьСообщениеОДолгеMAX(Запись)
	//+бит_Сафаров ШИ 17.09.2026
	Пациент = Запись.Контакт.Получатель;
	Если ТипЗнч(Пациент) <> Тип("СправочникСсылка.Клиенты") Или Не ЗначениеЗаполнено(Пациент) Тогда
		Возврат "";
	КонецЕсли;
	Результат = бит_омни_ИнтеграцияСMAX.ОтправитьТекстовоеСообщение(
		"[бит_ДолгПослеЗаписиMAX]", Запись.Контакт, Запись.Бот);
	Принято = Ложь;
	Успешно = Ложь;
	Результат.Свойство("accepted", Принято);
	Результат.Свойство("success", Успешно);
	Если Не Принято И Не Успешно Тогда
		ВызватьИсключение "Сообщение о долге не принято к отправке MAX.";
	КонецЕсли;
	Возврат Результат.ИдентификаторПопытки;
	//-бит_Сафаров ШИ 17.09.2026
КонецФункции

Процедура ДобавитьСнимки(Таблица, АктуальныеКлючи, Группа, Источник,
	Бот, Рассылка, Правило, ДатаОтправки, Снимки, Момент, ВерсияСобытия = "")
	Для Каждого Снимок Из Снимки Цикл
		// Текст не входит в идентичность события: его изменение обновляет только
		// ожидающее сообщение, но не порождает повтор уже отправленного/ошибочного.
		ЧастьДаты = ?(Правило = "IMMEDIATE", "IMMEDIATE", Формат(ДатаОтправки, "ДФ=yyyyMMddHHmmss"));
		Ключ = ХешКлюча(Группа + ":" + Строка(Снимок.Контакт.УникальныйИдентификатор())
			+ ":" + Правило + ":" + ЧастьДаты);
		АктуальныеКлючи.Вставить(Ключ, Истина);
		СтрокаОчереди = Таблица.Найти(Ключ, "Ключ");
		Если СтрокаОчереди = Неопределено Тогда
			// Старое событие не рассылается задним числом при первой записи.
			// Уже созданная просроченная очередь при этом остается к отправке.
			Если ДатаОтправки < Момент И Правило <> "IMMEDIATE" Тогда
				Продолжить;
			КонецЕсли;
			СтрокаОчереди = Таблица.Добавить();
			СтрокаОчереди.Группа = Группа;
			СтрокаОчереди.Ключ = Ключ;
			СтрокаОчереди.Создано = Момент;
			СтрокаОчереди.Состояние = "Ожидает";
			СтрокаОчереди.ДатаОтправки = ДатаОтправки;
		ИначеЕсли СтрокаОчереди.Состояние = "Отменено" И СтрокаОчереди.Попыток = 0
			И ДатаОтправки >= Момент Тогда
			СтрокаОчереди.Состояние = "Ожидает";
		КонецЕсли;
		Если СтрокаОчереди.Состояние <> "Ожидает" Тогда
			Продолжить;
		КонецЕсли;
		СтрокаОчереди.Бот = Бот;
		СтрокаОчереди.Рассылка = Рассылка;
		СтрокаОчереди.Контакт = Снимок.Контакт;
		СтрокаОчереди.Источник = Источник;
		СтрокаОчереди.Правило = Правило;
		СтрокаОчереди.ТелоJSON = Снимок.ТелоJSON;
		СтрокаОчереди.АдресатJSON = Снимок.АдресатJSON;
		Если Не ПустаяСтрока(ВерсияСобытия) Тогда
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(СтрокаОчереди.АдресатJSON);
			Адресат = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
			Адресат.Вставить("ВерсияСобытияИсточника", ВерсияСобытия);
			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписатьJSON(ЗаписьJSON, Адресат);
			СтрокаОчереди.АдресатJSON = ЗаписьJSON.Закрыть();
		КонецЕсли;
		СтрокаОчереди.Обновлено = Момент;
		СтрокаОчереди.ОписаниеОшибки = "";
	КонецЦикла;
КонецПроцедуры

// Источник хранится в ключе только как имя метаданных и UUID, не как BSL.
Функция бит_СсылкаИсточника(Идентификатор)
	Части = СтрРазделить(Идентификатор, ":", Ложь);
	Если Части.Количество() <> 2 Или Лев(Части[0], 9) <> "Документ."
		И Лев(Части[0], 11) <> "Справочник." Тогда Возврат Неопределено; КонецЕсли;
	Мета = Метаданные.НайтиПоПолномуИмени(Части[0]);
	Если Мета = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	UUID = Новый УникальныйИдентификатор(Части[1]);
	Если Лев(Части[0], 9) = "Документ." Тогда
		Возврат Документы[Мета.Имя].ПолучитьСсылку(UUID);
	КонецЕсли;
	Возврат Справочники[Мета.Имя].ПолучитьСсылку(UUID);
КонецФункции

Функция бит_ДопустимИсточникУведомления(Источник, Рассылка)
	Если Источник = Неопределено Или Источник.ПометкаУдаления Тогда Возврат Ложь; КонецЕсли;
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.Заявка") Тогда
		//+бит_Сафаров ШИ 17.09.2026
		ИдентификаторШаблона = Рассылка.Шаблон.ИдентификаторСтандартногоШаблона;
		Если ИдентификаторШаблона = "MAX_APPOINTMENT_CANCELLED" Тогда
			Возврат Источник.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена
				Или Источник.Состояние.ТипСостояния = Перечисления.ТипыСостоянийЗаявок.Отменена;
		КонецЕсли;
		//-бит_Сафаров ШИ 17.09.2026
		Если Источник.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена
			Или Источник.Состояние.ТипСостояния = Перечисления.ТипыСостоянийЗаявок.Отменена Тогда Возврат Ложь; КонецЕсли;
		// Ограничения до приёма относятся только к штатному напоминанию/созданию.
		// Пользовательская рассылка после события определяется своей СКД и датой.
		//+бит_Сафаров ШИ 17.09.2026
		//БЫЛО: ИдентификаторШаблона = Рассылка.Шаблон.ИдентификаторСтандартногоШаблона;
		//СТАЛО: идентификатор получен перед проверкой отмены.
		//-бит_Сафаров ШИ 17.09.2026
		Если ИдентификаторШаблона <> "MAX_APPOINTMENT_CREATED"
			И ИдентификаторШаблона <> "MAX_APPOINTMENT_REMINDER"
			И ИдентификаторШаблона <> "MAX_APPOINTMENT_REMINDER_24H"
			И ИдентификаторШаблона <> "MAX_APPOINTMENT_REMINDER_2H" Тогда Возврат Истина; КонецЕсли;
		Если Источник.ДатаНачала <= ТекущаяДатаСеанса() Тогда Возврат Ложь; КонецЕсли;
		РабочиеСостояния = УправлениеЗаявками.СостоянияЗаявкиДоПриходаКлиента();
		ПризнакПереноса = РегистрыСведений.бит_омни_ЗначенияНастроек.ЗначениеКонстанты("ПризнакПереносаЗаявкиMAX");
		Если РабочиеСостояния.Найти(Источник.Состояние) = Неопределено
			И Источник.Состояние <> ПризнакПереноса Тогда Возврат Ложь; КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция бит_ВерсияСобытияИсточника(Источник)
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.Заявка") Тогда
		Возврат Формат(Источник.ДатаНачала, "ДФ=yyyyMMddHHmmss") + ":"
			+ Строка(Источник.Клиент.УникальныйИдентификатор()) + ":"
			+ Строка(Источник.Сотрудник.УникальныйИдентификатор());
	КонецЕсли;
	Возврат "";
КонецФункции

Функция бит_ПодготовкаНеЗавершена(Сообщение)
	Если Сообщение.Правило = "SCHEDULE" Тогда Возврат Ложь; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Намерения.Источник КАК Источник
	|ИЗ РегистрСведений.бит_ПодготовкаРассылокMAX КАК Намерения
	|ГДЕ Намерения.Источник = &Источник И Намерения.Рассылка = &Рассылка
	| И Намерения.Бот = &Бот И Намерения.Состояние <> ""Готово""");
	Запрос.УстановитьПараметр("Источник", Сообщение.Источник);
	Запрос.УстановитьПараметр("Рассылка", Сообщение.Рассылка);
	Запрос.УстановитьПараметр("Бот", Сообщение.Бот);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Дополнительный fail-closed барьер перед HTTP: отменённая заявка и старый
// пациент никогда не принимаются только по сохранённой привязке контакта.
Функция бит_ПроверитьАктуальностьСобытия(Сообщение) Экспорт
	Если Сообщение.Правило = "SCHEDULE" Тогда Возврат ""; КонецЕсли;
	Если бит_ПодготовкаНеЗавершена(Сообщение) Тогда Возврат "Источник изменён: требуется подготовка нового снимка."; КонецЕсли;
	Ссылка = бит_СсылкаИсточника(Сообщение.Источник);
	Если Ссылка = Неопределено Тогда Возврат "Некорректный источник уведомления."; КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Не бит_ДопустимИсточникУведомления(Объект, Сообщение.Рассылка) Тогда Возврат "Источник уведомления удалён, отменён или событие завершено."; КонецЕсли;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.Заявка")
		И Объект.Клиент <> Сообщение.Контакт.Получатель Тогда Возврат "Пациент заявки изменён после подготовки сообщения."; КонецЕсли;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.Заявка") Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Сообщение.АдресатJSON);
		Адресат = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Версия = "";
		Если Не Адресат.Свойство("ВерсияСобытияИсточника", Версия)
			Или Версия <> бит_ВерсияСобытияИсточника(Объект) Тогда
			Возврат "Изменились дата/врач заявки либо это старый снимок без версии. Требуется повторная подготовка.";
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция бит_ЕстьОжидающееСобытие(Источник, Рассылка, Бот) Экспорт
	КлючИсточника = Источник.Метаданные().ПолноеИмя() + ":" + Строка(Источник.УникальныйИдентификатор());
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Очередь.Ключ КАК Ключ
	|ИЗ РегистрСведений.бит_омни_ОчередьСообщенийMAX КАК Очередь
	|ГДЕ Очередь.Источник = &Источник И Очередь.Рассылка = &Рассылка И Очередь.Бот = &Бот
	| И Очередь.Состояние = ""Ожидает"" И Очередь.Правило = ""IMMEDIATE""");
	Запрос.УстановитьПараметр("Источник", КлючИсточника);
	Запрос.УстановитьПараметр("Рассылка", Рассылка);
	Запрос.УстановитьПараметр("Бот", Бот);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

// Вызывается callback внутри той же транзакции, что и отмена заявки.
// Новые рассылки не создаются, завершённые/неопределённые попытки не меняются.
Процедура бит_ОтменитьОжидающиеЗаявки(Заявка) Экспорт
	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Отмена уведомлений должна фиксироваться вместе с заявкой."; КонецЕсли;
	Источник = "Документ.Заявка:" + Строка(Заявка.УникальныйИдентификатор());
	Запрос = Новый Запрос("ВЫБРАТЬ Очередь.Группа КАК Группа, Очередь.Ключ КАК Ключ
	|ИЗ РегистрСведений.бит_омни_ОчередьСообщенийMAX КАК Очередь
	|ГДЕ Очередь.Источник = &Источник И Очередь.Состояние = ""Ожидает""
	|УПОРЯДОЧИТЬ ПО Очередь.Группа, Очередь.Ключ");
	Запрос.УстановитьПараметр("Источник", Источник);
	Для Каждого СтрокаОчереди Из Запрос.Выполнить().Выгрузить() Цикл
		ЗаблокироватьГруппу(СтрокаОчереди.Группа);
		Запись = ПрочитатьЗапись(СтрокаОчереди.Группа, СтрокаОчереди.Ключ);
		Если Запись.Выбран() И Запись.Состояние = "Ожидает" Тогда
			Запись.Состояние = "Отменено";
			Запись.ОписаниеОшибки = "Пациент отменил заявку в MAX.";
			Запись.Обновлено = ТекущаяДатаСеанса();
			Запись.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ХешКлюча(Значение)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Значение);
	Возврат НРег(СтрЗаменить(Строка(Хеш.ХешСумма), " ", ""));
КонецФункции

Процедура ЗаблокироватьГруппу(Группа)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ОчередьСообщенийMAX");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Группа", Группа);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ПрочитатьЗапись(Группа, Ключ)
	Запись = РегистрыСведений.бит_омни_ОчередьСообщенийMAX.СоздатьМенеджерЗаписи();
	Запись.Группа = Группа;
	Запись.Ключ = Ключ;
	Запись.Прочитать();
	Возврат Запись;
КонецФункции

Функция РассылкаАктивна(Бот, Рассылка)
	Если НЕ Бот.Использовать Или Бот.ПометкаУдаления Или Рассылка.ПометкаУдаления
		Или Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Активные.Рассылка КАК Рассылка
	|ИЗ РегистрСведений.бит_омни_АктивныеРассылки КАК Активные
	|ГДЕ Активные.Бот = &Бот И Активные.Рассылка = &Рассылка");
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Рассылка", Рассылка);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

#КонецОбласти
