#Область ПрограммныйИнтерфейс

// Производитель периодических рассылок. Отдельный worker вызывает этот метод,
// входящий long polling не участвует. Только подготовка очереди, HTTP здесь нет.
Процедура ВыполнитьНапоминания(Бот) Экспорт
	Если НЕ ЗначениеЗаполнено(Бот) Или НЕ Бот.Использовать Или Бот.ПометкаУдаления
		Или Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда Возврат; КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Периодический производитель должен запускаться вне транзакции.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Активные.Рассылка КАК Рассылка
	|ИЗ РегистрСведений.бит_омни_АктивныеРассылки КАК Активные
	|ГДЕ Активные.Бот = &Бот И НЕ Активные.Рассылка.ПометкаУдаления
	|И Активные.Рассылка.РежимРассылки = &ПоРасписанию";
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("ПоРасписанию", Перечисления.бит_омни_РежимыРассылки.ПоРасписанию);
	Для Каждого СтрокаРассылки Из Запрос.Выполнить().Выгрузить() Цикл
		Попытка
			ПодготовитьПериодическуюРассылку(Бот, СтрокаРассылки.Рассылка);
		Исключение
			ЗаписьЖурналаРегистрации("МАКС.Очередь.ПериодическаяРассылка",
				УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.бит_омни_Рассылки,
				СтрокаРассылки.Рассылка, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьПериодическуюРассылку(Бот, СсылкаРассылки)
	НачатьТранзакцию();
	Попытка
		ПодготовитьПериодическуюРассылкуВТранзакции(Бот, СсылкаРассылки);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура ПодготовитьПериодическуюРассылкуВТранзакции(Бот, СсылкаРассылки)
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.бит_омни_АктивныеРассылки");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Бот", Бот);
		ЭлементБлокировки.УстановитьЗначение("Рассылка", СсылкаРассылки);
		Блокировка.Заблокировать();
		ПоследнийЗапуск = РегистрыСведений.бит_омни_АктивныеРассылки.СоздатьМенеджерЗаписи();
		ПоследнийЗапуск.Бот = Бот;
		ПоследнийЗапуск.Рассылка = СсылкаРассылки;
		ПоследнийЗапуск.Прочитать();
		Рассылка = СсылкаРассылки.ПолучитьОбъект();
		Если НЕ ПоследнийЗапуск.Выбран() Или Рассылка.ПометкаУдаления
			Или Рассылка.РежимРассылки <> Перечисления.бит_омни_РежимыРассылки.ПоРасписанию
			Или НЕ Бот.Использовать Или Бот.ПометкаУдаления Тогда
			Возврат;
		КонецЕсли;
		Расписание = Рассылка.Расписание.Получить();
		Если ТипЗнч(Расписание) <> Тип("РасписаниеРегламентногоЗадания") Тогда
			ВызватьИсключение "Не настроено расписание периодической рассылки MAX.";
		КонецЕсли;
		МоментЗапуска = ТекущаяДатаСеанса();
		Если НЕ Расписание.ТребуетсяВыполнение(МоментЗапуска,
			ПоследнийЗапуск.ДатаНачалаПоследнегоЗапуска, ПоследнийЗапуск.ДатаЗавершенияПоследнегоЗапуска) Тогда
			Возврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Рассылка.Шаблон) Или Рассылка.Шаблон.ПометкаУдаления Тогда
			ВызватьИсключение "Не выбран действующий шаблон периодической рассылки MAX.";
		КонецЕсли;
		Параметры = бит_омни_СхемыКомпоновки.ПараметрыВыполненияСхемы("ТаблицаЗначений");
		Параметры.ПараметрыОтчета.Вставить("Момент", МоментЗапуска);
		Получатели = бит_омни_СхемыКомпоновки.ВыполнитьСхему(Рассылка.СКДПолучатели.Получить(), Параметры);
		Если ТипЗнч(Получатели) <> Тип("ТаблицаЗначений") Тогда
			ВызватьИсключение "СКД получателей должна возвращать таблицу значений.";
		КонецЕсли;
		Если Получатели.Колонки.Найти("Получатель") = Неопределено Тогда
			ВызватьИсключение "В СКД получателей отсутствует колонка Получатель.";
		КонецЕсли;
		КонтекстСКД = Рассылка.СКДКонтекст.Получить();
		Контекст = Новый Структура;
		ЕстьКонтекст = Ложь;
		Если ТипЗнч(КонтекстСКД) = Тип("СхемаКомпоновкиДанных") Или ЗначениеЗаполнено(КонтекстСКД) Тогда
			Контекст = бит_омни_СхемыКомпоновки.ВыполнитьСхему(КонтекстСКД, Параметры);
			Если ТипЗнч(Контекст) <> Тип("ТаблицаЗначений") Тогда
				ВызватьИсключение "СКД контекста должна возвращать таблицу значений.";
			КонецЕсли;
			ЕстьКонтекст = Контекст.Количество() > 0;
			Если Контекст.Количество() > 1 Тогда
				ВызватьИсключение "СКД контекста периодической рассылки MAX должна возвращать не более одной строки.";
			КонецЕсли;
			Если ЕстьКонтекст Тогда Контекст = Контекст[0]; КонецЕсли;
		КонецЕсли;
		Если ЕстьКонтекст И Получатели.Количество() > 0 Тогда
			// Один контекст на запуск, без неявного размножения строк на получателей.
			Снимки = бит_омни_ИнтеграцияСMAX.ПодготовитьСообщенияДляОчереди(
				Рассылка.Шаблон, Получатели.ВыгрузитьКолонку("Получатель"), Бот, Контекст);
			бит_омни_ОчередьСообщенийMAX.ПоставитьПериодическуюРассылку(
				Бот, СсылкаРассылки, МоментЗапуска, Снимки);
		КонецЕсли;
		// Отметка запуска и готовые сообщения фиксируются атомарно.
		ПоследнийЗапуск.ДатаНачалаПоследнегоЗапуска = МоментЗапуска;
		ПоследнийЗапуск.ДатаЗавершенияПоследнегоЗапуска = ТекущаяДатаСеанса();
		ПоследнийЗапуск.Записать();
КонецПроцедуры

#КонецОбласти
