#Область ПрограммныйИнтерфейс

// Вызывается существующим заданием обмена. Только явно активированные рассылки.
// Время - время сеанса задания; часовой пояс должен совпадать с журналом записи.
Процедура ВыполнитьНапоминания(Бот) Экспорт

	Если Не ЗначениеЗаполнено(Бот) Или Не Бот.Использовать Или Бот.ПометкаУдаления
		Или Бот.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX Тогда
		Возврат;
	КонецЕсли;
	ВыполнитьДатыСобытия(Бот);
	Для Каждого Настройка Из АктивныеНапоминания(Бот) Цикл
		Для Каждого Кандидат Из КандидатыНаОтправку(Бот, Настройка.Этап, ТекущаяДатаСеанса()) Цикл
			Попытка
				ОтправитьНапоминание(Бот, Настройка, Кандидат);
			Исключение
				ЗаписьЖурналаРегистрации("МАКС.Напоминания.Ошибка",
					УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.Заявка,
					Кандидат.Заявка, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Чистая функция, также используется регрессионными проверками границ.
Функция ВОкнеНапоминания(ДатаНачала, Этап, Момент) Экспорт

	СекундДоПриема = ДатаНачала - Момент;
	Если Этап = "24H" Тогда
		Порог = 86400;
	ИначеЕсли Этап = "2H" Тогда
		Порог = 7200;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	Возврат Порог > 0 И СекундДоПриема <= Порог И СекундДоПриема > Порог - 900;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АктивныеНапоминания(Бот)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	| Активные.Рассылка.Шаблон КАК Шаблон,
	| ВЫБОР КОГДА Активные.Рассылка.Шаблон.ИдентификаторСтандартногоШаблона = &ЗаСутки
	| ТОГДА ""24H"" ИНАЧЕ ""2H"" КОНЕЦ КАК Этап
	|ИЗ РегистрСведений.бит_омни_АктивныеРассылки КАК Активные
	|ГДЕ Активные.Бот = &Бот
	| И НЕ Активные.Рассылка.ПометкаУдаления
	| И НЕ Активные.Рассылка.Шаблон.ПометкаУдаления
	| И НЕ Активные.Рассылка В
	| (ВЫБРАТЬ Даты.Ссылка КАК Ссылка ИЗ Справочник.бит_омни_Рассылки.ДатыСобытия КАК Даты)
	| И Активные.Рассылка.Шаблон.ИдентификаторСтандартногоШаблона В (&ЗаСутки, &ЗаДваЧаса)";
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("ЗаСутки", "MAX_APPOINTMENT_REMINDER_24H");
	Запрос.УстановитьПараметр("ЗаДваЧаса", "MAX_APPOINTMENT_REMINDER_2H");
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция КандидатыНаОтправку(Бот, Этап, Момент)

	Порог = ?(Этап = "24H", 86400, 7200);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
	| Заявки.Ссылка КАК Заявка, Заявки.ДатаНачала КАК ДатаНачала,
	| Контакты.Ссылка КАК Контакт
	|ИЗ Документ.Заявка КАК Заявки
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_омни_Контакты КАК Контакты
	| ПО Заявки.Клиент = Контакты.Получатель
	| ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_омни_ДоставкаНапоминанийMAX КАК Доставка
	| ПО Доставка.Бот = &Бот И Доставка.Заявка = Заявки.Ссылка
	| И Доставка.ДатаНачала = Заявки.ДатаНачала И Доставка.Этап = &Этап
	|ГДЕ Заявки.ДатаНачала > &НачалоОкна И Заявки.ДатаНачала <= &КонецОкна
	| И НЕ Заявки.ПометкаУдаления
	| И Заявки.Клиент <> ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
	| И НЕ Заявки.Клиент.ПометкаУдаления
	| И Заявки.Состояние В (&Состояния)
	| И Контакты.Бот = &Бот И НЕ Контакты.ПометкаУдаления И НЕ Контакты.Заблокирован
	| И Контакты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
	| И Контакты.Идентификатор > 0
	| И (Доставка.Состояние ЕСТЬ NULL
	| ИЛИ (Доставка.Состояние = ""ВРаботе"" И Доставка.АрендаДо <= &Момент))
	|УПОРЯДОЧИТЬ ПО ДатаНачала, Заявка, Контакт";
	// В УМЦ 2.0 реквизита нет. Фрагмент фиксированный, пользовательский ввод не включается.
	Если Метаданные.Документы.Заявка.Реквизиты.Найти("Групповая") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ Заявки.ПометкаУдаления",
			"И НЕ Заявки.ПометкаУдаления И НЕ Заявки.Групповая");
	КонецЕсли;
	Запрос.УстановитьПараметр("Бот", Бот);
	Запрос.УстановитьПараметр("Этап", Этап);
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("НачалоОкна", Момент + Порог - 900);
	Запрос.УстановитьПараметр("КонецОкна", Момент + Порог);
	Запрос.УстановитьПараметр("Состояния", УправлениеЗаявками.СостоянияЗаявкиДоПриходаКлиента());
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ОтправитьНапоминание(Бот, Настройка, Кандидат)

	Если Не Бот.Использовать Или Бот.ПометкаУдаления
		Или Кандидат.Контакт.Заблокирован
		Или АктивныеНапоминания(Бот).Найти(Настройка.Шаблон, "Шаблон") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Захват фиксируется ДО HTTP. Транзакцию на время сети не удерживаем.
	ПопыткаДоставки = ЗахватитьДоставку(Бот, Кандидат, Настройка.Этап);
	Если ПустаяСтрока(ПопыткаДоставки) Тогда
		Возврат;
	КонецЕсли;
	Состояние = "Неопределено";
	ИдентификаторСообщения = "";
	ОписаниеОшибки = "MAX не подтвердил доставку идентификатором сообщения. Автоповтор отключен.";
	Попытка
		// Повторная проверка после захвата: оператор мог отменить/перенести запись.
		Заявка = Кандидат.Заявка.ПолучитьОбъект();
		Групповая = Ложь;
		Если Метаданные.Документы.Заявка.Реквизиты.Найти("Групповая") <> Неопределено Тогда
			Групповая = Заявка.Групповая;
		КонецЕсли;
		Если Заявка.ПометкаУдаления Или Групповая Или Заявка.ДатаНачала <> Кандидат.ДатаНачала
			Или Заявка.Клиент <> Кандидат.Контакт.Получатель
			Или Заявка.Клиент.ПометкаУдаления Или Кандидат.Контакт.ПометкаУдаления
			Или Кандидат.Контакт.Заблокирован
			Или Кандидат.Контакт.Бот <> Бот
			Или Кандидат.Контакт.Канал <> Перечисления.бит_омни_КаналыСвязи.MAX
			Или Не ВОкнеНапоминания(Заявка.ДатаНачала, Настройка.Этап, ТекущаяДатаСеанса())
			Или УправлениеЗаявками.СостоянияЗаявкиДоПриходаКлиента().Найти(Заявка.Состояние) = Неопределено Тогда
			Состояние = "Пропущено";
			ОписаниеОшибки = "Запись или получатель изменены перед отправкой.";
		Иначе
			Контекст = Новый Структура;
			Контекст.Вставить("appointment_id", Строка(Заявка.Ссылка.УникальныйИдентификатор()));
			Контекст.Вставить("appointment_version", Формат(Заявка.ДатаНачала, "ДФ=yyyyMMddHHmmss"));
			Контекст.Вставить("appointment_date", Формат(Заявка.ДатаНачала, "ДФ=dd.MM.yyyy"));
			Контекст.Вставить("appointment_time", Формат(Заявка.ДатаНачала, "ДФ=HH:mm"));
			Контекст.Вставить("doctor", Строка(Заявка.Сотрудник));
			Контекст.Вставить("address", Строка(Заявка.Филиал));
			Ответ = бит_омни_ИнтеграцияСMAX.ОтправитьСообщение(
				Настройка.Шаблон, Кандидат.Контакт, Бот, Контекст);
			ИдентификаторСообщения = ИдентификаторИзОтвета(Ответ);
			Если Не ПустаяСтрока(ИдентификаторСообщения) Тогда
				Состояние = "Отправлено";
				ОписаниеОшибки = "";
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Таймаут может означать уже доставленное сообщение, не отправляем вслепую снова.
		ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗавершитьДоставку(Бот, Кандидат, Настройка.Этап, ПопыткаДоставки,
		Состояние, ИдентификаторСообщения, ОписаниеОшибки);

КонецПроцедуры

Функция ЗахватитьДоставку(Бот, Кандидат, Этап)

	ПопыткаДоставки = "";
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДоставку(Бот, Кандидат, Этап);
		Запись = ЗаписьДоставки(Бот, Кандидат, Этап);
		Если Запись.Выбран() Тогда
			Если Запись.Состояние = "ВРаботе" И Запись.АрендаДо <= ТекущаяДатаСеанса() Тогда
				Запись.Состояние = "Неопределено";
				Запись.Обновлено = ТекущаяДатаСеанса();
				Запись.ОписаниеОшибки = "Процесс прерван: доставка неизвестна. Нужна ручная сверка истории MAX.";
				Запись.Записать();
			КонецЕсли;
		Иначе
			ПопыткаДоставки = Строка(Новый УникальныйИдентификатор);
			Запись.Состояние = "ВРаботе";
			Запись.Попытка = ПопыткаДоставки;
			Запись.Контакт = Кандидат.Контакт;
			Запись.Обновлено = ТекущаяДатаСеанса();
			Запись.АрендаДо = Запись.Обновлено + 300;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ПопыткаДоставки;

КонецФункции

Процедура ЗавершитьДоставку(Бот, Кандидат, Этап, ПопыткаДоставки,
	Состояние, ИдентификаторСообщения, ОписаниеОшибки)

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьДоставку(Бот, Кандидат, Этап);
		Запись = ЗаписьДоставки(Бот, Кандидат, Этап);
		Если Запись.Выбран() И Запись.Попытка = ПопыткаДоставки Тогда
			Запись.Состояние = Состояние;
			Запись.ИдентификаторСообщения = Лев(ИдентификаторСообщения, 150);
			Запись.ОписаниеОшибки = Лев(ОписаниеОшибки, 500);
			Запись.Обновлено = ТекущаяДатаСеанса();
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Если Состояние = "Неопределено" Тогда
		ЗаписьЖурналаРегистрации("МАКС.Напоминания.ДоставкаНеопределена",
			УровеньЖурналаРегистрации.Предупреждение, Метаданные.Документы.Заявка,
			Кандидат.Заявка, "Автоповтор отключен. Проверьте доставку в истории MAX.");
	КонецЕсли;

КонецПроцедуры

Процедура ЗаблокироватьДоставку(Бот, Кандидат, Этап)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ДоставкаНапоминанийMAX");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Бот", Бот);
	Элемент.УстановитьЗначение("Заявка", Кандидат.Заявка);
	Элемент.УстановитьЗначение("ДатаНачала", Кандидат.ДатаНачала);
	Элемент.УстановитьЗначение("Этап", Этап);
	Блокировка.Заблокировать();

КонецПроцедуры

Функция ЗаписьДоставки(Бот, Кандидат, Этап)

	Запись = РегистрыСведений.бит_омни_ДоставкаНапоминанийMAX.СоздатьМенеджерЗаписи();
	Запись.Бот = Бот;
	Запись.Заявка = Кандидат.Заявка;
	Запись.ДатаНачала = Кандидат.ДатаНачала;
	Запись.Этап = Этап;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		// Прочитать очищает измерения, если запись с заданным ключом еще отсутствует.
		Запись.Бот = Бот;
		Запись.Заявка = Кандидат.Заявка;
		Запись.ДатаНачала = Кандидат.ДатаНачала;
		Запись.Этап = Этап;
	КонецЕсли;
	Возврат Запись;

КонецФункции

// Каждая строка дат является самостоятельным событием. Старые этапы 24H/2H
// сохранены выше для рассылок, которые еще не переведены на табличную часть.
Процедура ВыполнитьДатыСобытия(Бот)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ Активные.Рассылка КАК Рассылка
	|ИЗ РегистрСведений.бит_омни_АктивныеРассылки КАК Активные
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_омни_Рассылки.ДатыСобытия КАК Даты
	| ПО Активные.Рассылка = Даты.Ссылка
	|ГДЕ Активные.Бот = &Бот И Даты.Использовать
	| И НЕ Активные.Рассылка.ПометкаУдаления
	| И НЕ Активные.Рассылка.Шаблон.ПометкаУдаления
	| И Активные.Рассылка.РежимРассылки = ЗНАЧЕНИЕ(Перечисление.бит_омни_РежимыРассылки.ПоРасписанию)";
	Запрос.УстановитьПараметр("Бот", Бот);
	Для Каждого Настройка Из Запрос.Выполнить().Выгрузить() Цикл
		Рассылка = Настройка.Рассылка.ПолучитьОбъект();
		Для Каждого Правило Из Рассылка.ДатыСобытия Цикл
			Если Не Правило.Использовать Тогда Продолжить; КонецЕсли;
			Попытка
				Кандидаты = КандидатыПоДатеСобытия(Бот, Рассылка.Ссылка,
					Правило.ИдентификаторСтроки, ТекущаяДатаСеанса());
				Для Каждого Кандидат Из Кандидаты Цикл
					Попытка
						ОтправитьСобытие(Бот, Рассылка.Ссылка, Правило.ИдентификаторСтроки, Кандидат);
					Исключение
						ЗаписьЖурналаРегистрации("МАКС.ДатыСобытия.ОшибкаОтправки",
							УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.бит_омни_Рассылки,
							Рассылка.Ссылка, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
				КонецЦикла;
			Исключение
				ЗаписьЖурналаРегистрации("МАКС.ДатыСобытия.ОшибкаРасчета",
					УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.бит_омни_Рассылки,
					Рассылка.Ссылка, "Строка " + Строка(Правило.НомерСтроки) + ": "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Только расчет и чтение. Экспорт для диагностики без захвата очереди и отправки.
Функция КандидатыПоДатеСобытия(Бот, СсылкаРассылки, ИдентификаторСтроки, Момент,
	КонкретнаяЗаявка = Неопределено) Экспорт

	Результат = Новый Массив;
	Рассылка = СсылкаРассылки.ПолучитьОбъект();
	Правило = Рассылка.ДатыСобытия.Найти(ИдентификаторСтроки, "ИдентификаторСтроки");
	Если Правило = Неопределено Или Не Правило.Использовать Или Рассылка.ПометкаУдаления
		Или Рассылка.РежимРассылки <> Перечисления.бит_омни_РежимыРассылки.ПоРасписанию Тогда
		Возврат Результат;
	КонецЕсли;
	Источники = ИсточникиСобытия(Рассылка, Правило, Момент, КонкретнаяЗаявка);
	КонтактыБота = КонтактыСобытия(Бот);
	Для Каждого Источник Из Источники Цикл
		Попытка
			Заявка = Источник.Заявка.ПолучитьОбъект();
			Если Не ЗаявкаДопустимаДляСобытия(Заявка) Тогда Продолжить; КонецЕсли;
			Контекст = КонтекстСобытия(Заявка, Источник.Контекст);
			ДатаОтправки = бит_омни_ДатыСобытияРассылок.РассчитатьДату(Правило, Контекст);
			Если Не ВОкнеСобытия(ДатаОтправки, Момент) Тогда Продолжить; КонецЕсли;
			Этап = КлючСобытия(Рассылка, Правило, ДатаОтправки);
			Для Каждого Контакт Из КонтактыБота.НайтиСтроки(Новый Структура("Пациент", Заявка.Клиент)) Цикл
				Кандидат = Новый Структура("Заявка,ДатаНачала,Контакт,ДатаОтправки,Этап,Контекст",
					Заявка.Ссылка, Заявка.ДатаНачала, Контакт.Ссылка, ДатаОтправки, Этап, Контекст);
				// Чтение на кандидата намеренно: актуальная аренда, не устаревший снимок
				// другого параллельного запуска. Контакты прочитаны пакетом до цикла.
				Доставка = ЗаписьДоставки(Бот, Кандидат, Этап);
				Если Доставка.Выбран() И Не (Доставка.Состояние = "ВРаботе"
					И Доставка.АрендаДо <= Момент) Тогда Продолжить; КонецЕсли;
				Результат.Добавить(Кандидат);
				// Лимит ПОСЛЕ расчета даты и дедупликации: старые документы не вытесняют новые.
				Если Результат.Количество() >= 100 Тогда Возврат Результат; КонецЕсли;
			КонецЦикла;
		Исключение
			ЗаписьЖурналаРегистрации("МАКС.ДатыСобытия.ОшибкаКонтекста",
				УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.бит_омни_Рассылки,
				СсылкаРассылки, "Строка " + Строка(Правило.НомерСтроки) + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВОкнеСобытия(ДатаОтправки, Момент) Экспорт

	Возврат ТипЗнч(ДатаОтправки) = Тип("Дата") И ЗначениеЗаполнено(ДатаОтправки)
		И ДатаОтправки <= Момент И Момент - ДатаОтправки < 900;

КонецФункции

Функция ИсточникиСобытия(Рассылка, Правило, Момент, КонкретнаяЗаявка)

	Результат = Новый Массив;
	СКД = Рассылка.СКДКонтекст.Получить();
	Если ТипЗнч(СКД) = Тип("СхемаКомпоновкиДанных") Или ЗначениеЗаполнено(СКД) Тогда
		Параметры = бит_омни_СхемыКомпоновки.ПараметрыВыполненияСхемы("ТаблицаЗначений");
		Параметры.ПараметрыОтчета.Вставить("Момент", Момент);
		Таблица = бит_омни_СхемыКомпоновки.ВыполнитьСхему(СКД, Параметры);
		Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
			ВызватьИсключение "Контекст дат события должен возвращать таблицу значений.";
		КонецЕсли;
		Колонка = ?(Таблица.Колонки.Найти("Заявка") <> Неопределено, "Заявка", "Ссылка");
		Если Таблица.Колонки.Найти(Колонка) = Неопределено Тогда
			ВызватьИсключение "Для рассылки MAX контекст должен содержать колонку Заявка (или Ссылка) типа ДокументСсылка.Заявка.";
		КонецЕсли;
		Для Каждого СтрокаКонтекста Из Таблица Цикл
			Ссылка = СтрокаКонтекста[Колонка];
			Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.Заявка") Или Не ЗначениеЗаполнено(Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			Если КонкретнаяЗаявка <> Неопределено И Ссылка <> КонкретнаяЗаявка Тогда Продолжить; КонецЕсли;
			Контекст = Новый Структура;
			Для Каждого Поле Из Таблица.Колонки Цикл
				Контекст.Вставить(Поле.Имя, СтрокаКонтекста[Поле.Имя]);
			КонецЦикла;
			Результат.Добавить(Новый Структура("Заявка,Контекст", Ссылка, Контекст));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Заявки.Ссылка КАК Заявка ИЗ Документ.Заявка КАК Заявки
	|ГДЕ НЕ Заявки.ПометкаУдаления И Заявки.Состояние <> &Отменена";
	Запрос.УстановитьПараметр("Отменена", Справочники.ВидыСостоянийЗаявок.Отменена);
	Если КонкретнаяЗаявка <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + " И Заявки.Ссылка = &Заявка";
		Запрос.УстановитьПараметр("Заявка", КонкретнаяЗаявка);
	КонецЕсли;
	// В текст запроса попадает исключительно имя, найденное в метаданных, не ввод пользователя.
	Реквизит = Метаданные.Документы.Заявка.Реквизиты.Найти(Правило.РеквизитКонтекста);
	ИмяПоля = "";
	Если Реквизит <> Неопределено И Реквизит.Тип.СодержитТип(Тип("Дата")) Тогда
		ИмяПоля = Реквизит.Имя;
	ИначеЕсли Правило.РеквизитКонтекста = "Дата" Тогда
		ИмяПоля = "Дата";
	КонецЕсли;
	Если Правило.Шаблон <> "Алгоритм" И ПустаяСтрока(ИмяПоля) Тогда
		ВызватьИсключение "Реквизит даты не найден в заявке. Выберите дату объекта или настройте контекст СКД.";
	КонецЕсли;
	Если Правило.Шаблон <> "Алгоритм" И Не ПустаяСтрока(ИмяПоля) Тогда
		Смещение = ?(Правило.Шаблон = "ДоДаты", -Правило.КоличествоЧасов * 3600,
			?(Правило.Шаблон = "ПослеДаты", Правило.КоличествоЧасов * 3600, 0));
		Запрос.Текст = Запрос.Текст + " И Заявки." + ИмяПоля + " > &НачалоОкна И Заявки."
			+ ИмяПоля + " <= &КонецОкна";
		Запрос.УстановитьПараметр("НачалоОкна", Момент - Смещение - 900);
		Запрос.УстановитьПараметр("КонецОкна", Момент - Смещение);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО Заявки.ДатаНачала, Заявки.Ссылка";
	Для Каждого СтрокаЗаявки Из Запрос.Выполнить().Выгрузить() Цикл
		Результат.Добавить(Новый Структура("Заявка,Контекст", СтрокаЗаявки.Заявка, Новый Структура));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КонтекстСобытия(Заявка, ДополнительныйКонтекст)

	Контекст = Новый Структура("Дата", Заявка.Дата);
	Для Каждого Реквизит Из Метаданные.Документы.Заявка.Реквизиты Цикл
		Контекст.Вставить(Реквизит.Имя, Заявка[Реквизит.Имя]);
	КонецЦикла;
	Для Каждого Поле Из ДополнительныйКонтекст Цикл
		Контекст.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	// Служебные параметры кнопок всегда от актуальной заявки, не из текста/СКД.
	Контекст.Вставить("appointment_id", Строка(Заявка.Ссылка.УникальныйИдентификатор()));
	Контекст.Вставить("appointment_version", Формат(Заявка.ДатаНачала, "ДФ=yyyyMMddHHmmss"));
	// Датированные алиасы СКД сохраняют тип Дата для расчета события.
	Если Не Контекст.Свойство("appointment_date") Тогда
		Контекст.Вставить("appointment_date", Формат(Заявка.ДатаНачала, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	Если Не Контекст.Свойство("appointment_time") Тогда
		Контекст.Вставить("appointment_time", Формат(Заявка.ДатаНачала, "ДФ=HH:mm"));
	КонецЕсли;
	Если Не Контекст.Свойство("doctor") Тогда Контекст.Вставить("doctor", Строка(Заявка.Сотрудник)); КонецЕсли;
	Если Не Контекст.Свойство("address") Тогда Контекст.Вставить("address", Строка(Заявка.Филиал)); КонецЕсли;
	Возврат Контекст;

КонецФункции

Функция ЗаявкаДопустимаДляСобытия(Заявка)

	Если Заявка.ПометкаУдаления Или Не ЗначениеЗаполнено(Заявка.Клиент)
		Или Заявка.Клиент.ПометкаУдаления
		Или Заявка.Состояние = Справочники.ВидыСостоянийЗаявок.Отменена Тогда Возврат Ложь; КонецЕсли;
	Если Метаданные.Документы.Заявка.Реквизиты.Найти("Групповая") <> Неопределено Тогда
		Если Заявка.Групповая Тогда Возврат Ложь; КонецЕсли;
	КонецЕсли;
	Возврат Истина;

КонецФункции

Функция КонтактыСобытия(Бот)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Контакты.Ссылка КАК Ссылка, Контакты.Получатель КАК Пациент
	|ИЗ Справочник.бит_омни_Контакты КАК Контакты
	|ГДЕ Контакты.Бот = &Бот
	| И НЕ Контакты.ПометкаУдаления И НЕ Контакты.Заблокирован И Контакты.Идентификатор > 0
	| И Контакты.Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)
	|УПОРЯДОЧИТЬ ПО Контакты.Ссылка";
	Запрос.УстановитьПараметр("Бот", Бот);
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Индексы.Добавить("Пациент");
	Возврат Результат;

КонецФункции

Функция КлючСобытия(Рассылка, Правило, ДатаОтправки)

	// Миграция стандартных правил сохраняет уже записанные отметки доставки.
	Если Правило.Шаблон = "ДоДаты"
		И Правило.РеквизитКонтекста = "ДатаНачала" Тогда
		Идентификатор = Рассылка.Шаблон.ИдентификаторСтандартногоШаблона;
		Если Идентификатор = "MAX_APPOINTMENT_REMINDER_24H" И Правило.КоличествоЧасов = 24
			И Правило.ИдентификаторСтроки = "00000000-0000-0000-0000-000000000024" Тогда Возврат "24H"; КонецЕсли;
		Если Идентификатор = "MAX_APPOINTMENT_REMINDER_2H" И Правило.КоличествоЧасов = 2
			И Правило.ИдентификаторСтроки = "00000000-0000-0000-0000-000000000002" Тогда Возврат "2H"; КонецЕсли;
	КонецЕсли;
	Возврат Строка(Рассылка.Ссылка.УникальныйИдентификатор()) + ":" + Правило.ИдентификаторСтроки
		+ ":" + Формат(ДатаОтправки, "ДФ=yyyyMMddHHmmss");

КонецФункции

Процедура ОтправитьСобытие(Бот, Рассылка, ИдентификаторСтроки, Кандидат)

	Если Не Бот.Использовать Или Бот.ПометкаУдаления Тогда Возврат; КонецЕсли;
	Активность = РегистрыСведений.бит_омни_АктивныеРассылки.СоздатьМенеджерЗаписи();
	Активность.Бот = Бот;
	Активность.Рассылка = Рассылка;
	Активность.Прочитать();
	Если Не Активность.Выбран() Или Рассылка.Шаблон.ПометкаУдаления Тогда Возврат; КонецЕсли;
	// Повторно читаем настройки, дату и связь пациента непосредственно перед захватом.
	Актуальные = КандидатыПоДатеСобытия(Бот, Рассылка, ИдентификаторСтроки,
		ТекущаяДатаСеанса(), Кандидат.Заявка);
	АктуальныйКандидат = Неопределено;
	Для Каждого СтрокаКандидата Из Актуальные Цикл
		Если СтрокаКандидата.Контакт = Кандидат.Контакт И СтрокаКандидата.ДатаНачала = Кандидат.ДатаНачала
			И СтрокаКандидата.Этап = Кандидат.Этап Тогда АктуальныйКандидат = СтрокаКандидата; Прервать; КонецЕсли;
	КонецЦикла;
	Если АктуальныйКандидат = Неопределено Тогда Возврат; КонецЕсли;
	ПопыткаДоставки = ЗахватитьДоставку(Бот, Кандидат, Кандидат.Этап);
	Если ПустаяСтрока(ПопыткаДоставки) Тогда Возврат; КонецЕсли;
	Состояние = "Неопределено";
	ИдентификаторСообщения = "";
	ОписаниеОшибки = "Нет подтвержденного MID. Автоповтор отключен, проверьте историю MAX.";
	Попытка
		Ответ = бит_омни_ИнтеграцияСMAX.ОтправитьСообщение(
			Рассылка.Шаблон, Кандидат.Контакт, Бот, АктуальныйКандидат.Контекст);
		ИдентификаторСообщения = ИдентификаторИзОтвета(Ответ);
		Если Не ПустаяСтрока(ИдентификаторСообщения) Тогда Состояние = "Отправлено"; ОписаниеОшибки = ""; КонецЕсли;
	Исключение
		ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗавершитьДоставку(Бот, Кандидат, Кандидат.Этап, ПопыткаДоставки,
		Состояние, ИдентификаторСообщения, ОписаниеОшибки);

КонецПроцедуры

Функция ИдентификаторИзОтвета(Ответ)

	Успешно = Ложь;
	Отправлено = 0;
	Ошибок = 0;
	Результаты = Неопределено;
	ОтветMAX = Неопределено;
	Сообщение = Неопределено;
	Тело = Неопределено;
	Идентификатор = "";
	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	// VDS возвращает пакет результатов. Напоминание отправляется одному адресату:
	// принимаем только однозначный успешный результат, не MID из ошибочного пакета.
	Если Ответ.Свойство("results") Или Ответ.Свойство("sent") Или Ответ.Свойство("failed") Или Ответ.Свойство("ok") Тогда
		Если Не Ответ.Свойство("ok", Успешно) Или Успешно <> Истина
			Или Не Ответ.Свойство("sent", Отправлено) Или Отправлено <> 1
			Или Не Ответ.Свойство("failed", Ошибок) Или Ошибок <> 0
			Или Не Ответ.Свойство("results", Результаты) Или ТипЗнч(Результаты) <> Тип("Массив") Тогда
			Возврат "";
		КонецЕсли;
		Если Результаты.Количество() <> 1 Тогда
			Возврат "";
		КонецЕсли;
		РезультатОтправки = Результаты[0];
		Если ТипЗнч(РезультатОтправки) <> Тип("Структура") Тогда
			Возврат "";
		КонецЕсли;
		Если Не РезультатОтправки.Свойство("ok", Успешно) Или Успешно <> Истина
			Или Не РезультатОтправки.Свойство("max_response", ОтветMAX)
			Или ТипЗнч(ОтветMAX) <> Тип("Структура") Тогда
			Возврат "";
		КонецЕсли;
		Ответ = ОтветMAX;
	КонецЕсли;
	// Raw MAX: {message:{body:{mid}}}, {body:{mid}} или {mid}.
	Если Ответ.Свойство("message", Сообщение) И ТипЗнч(Сообщение) = Тип("Структура") Тогда
		Ответ = Сообщение;
	КонецЕсли;
	Если Ответ.Свойство("body", Тело) И ТипЗнч(Тело) = Тип("Структура") Тогда
		Ответ = Тело;
	КонецЕсли;
	Если Ответ.Свойство("mid", Идентификатор) И ТипЗнч(Идентификатор) = Тип("Строка") Тогда
		Возврат Идентификатор;
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти
