
#Область ПрограммныйИнтерфейс

// Переносит активную переписку выбранного диалога в архив.
// Вызывающая сторона обязана открыть транзакцию: состояние диалога и архив
// должны фиксироваться как одна операция.
//
// Параметры:
//  Контакт - СправочникСсылка.бит_омни_Контакты - контакт MAX.
//  Бот - СправочникСсылка.бит_омни_Боты - бот текущего диалога.
//  Архивировал - СправочникСсылка.Пользователи - пользователь, закрывший диалог.
//
// Возвращаемое значение:
//  Число - количество перенесенных сообщений.
Функция АрхивироватьДиалог(Контакт, Бот, Архивировал) Экспорт

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Архивация диалога должна выполняться внутри транзакции.";
	КонецЕсли;

	ДанныеКонтакта = бит_омни_ОтделенияMAXСервер.ПроверитьДоступККонтакту(Контакт, Бот);
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Количество = АрхивироватьДиалогПривилегированно(Контакт, ДанныеКонтакта, Архивировал);
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Количество;

КонецФункции

Функция бит_ВосстановитьДиалог(ИдентификаторАрхива) Экспорт

	//+бит_Сафаров ШИ 17.09.2026
	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Восстановление архива должно выполняться внутри транзакции.";
	КонецЕсли;
	Если ТипЗнч(ИдентификаторАрхива) <> Тип("Строка")
		Или СтрДлина(ИдентификаторАрхива) <> 36 Тогда
		ВызватьИсключение "Не выбран архивный диалог.";
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.бит_омни_АрхивЧатовMAX");
	ЭлементБлокировки.УстановитьЗначение("ИдентификаторАрхива", ИдентификаторАрхива);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

	НаборАрхива = РегистрыСведений.бит_омни_АрхивЧатовMAX.СоздатьНаборЗаписей();
	НаборАрхива.Отбор.ИдентификаторАрхива.Установить(ИдентификаторАрхива);
	НаборАрхива.Прочитать();
	Если НаборАрхива.Количество() = 0 Тогда
		ВызватьИсключение "Архивный диалог уже восстановлен или удалён.";
	КонецЕсли;

	ПервоеСообщение = НаборАрхива[0];
	ДанныеКонтакта = бит_омни_ОтделенияMAXСервер.ПроверитьДоступККонтакту(
		ПервоеСообщение.Контакт, ПервоеСообщение.Бот);
	Если ДанныеКонтакта.Отделение <> ПервоеСообщение.Отделение
		Или ДанныеКонтакта.Пациент <> ПервоеСообщение.Пациент Тогда
		ВызватьИсключение "Контакт уже переназначен. Архив оставлен без изменений.";
	КонецЕсли;

	Контакты = Новый Массив;
	Для Каждого Сообщение Из НаборАрхива Цикл
		Если Сообщение.Бот <> ПервоеСообщение.Бот
			Или Сообщение.Отделение <> ПервоеСообщение.Отделение
			Или Сообщение.Пациент <> ПервоеСообщение.Пациент Тогда
			ВызватьИсключение "Архивный диалог содержит несовместимые записи.";
		КонецЕсли;
		Если Контакты.Найти(Сообщение.Контакт) = Неопределено Тогда
			ДанныеКонтакта = бит_омни_ОтделенияMAXСервер.ПроверитьДоступККонтакту(
				Сообщение.Контакт, Сообщение.Бот);
			Если ДанныеКонтакта.Отделение <> Сообщение.Отделение
				Или ДанныеКонтакта.Пациент <> Сообщение.Пациент Тогда
				ВызватьИсключение "Один из контактов переназначен.";
			КонецЕсли;
			Контакты.Добавить(Сообщение.Контакт);
		КонецЕсли;
	КонецЦикла;

	ЗаблокироватьИсториюДиалога(Контакты, ПервоеСообщение.Бот);
	Количество = 0;
	Для Каждого Сообщение Из НаборАрхива Цикл
		ЗаписьИстории = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьМенеджерЗаписи();
		ЗаписьИстории.Период = Сообщение.Период;
		ЗаписьИстории.ИдентификаторСообщения = Сообщение.ИдентификаторСообщения;
		ЗаписьИстории.Контакт = Сообщение.Контакт;
		ЗаписьИстории.Бот = Сообщение.Бот;
		ЗаписьИстории.Входящее = Сообщение.Входящее;
		ЗаписьИстории.Прочитать();
		Если ЗаписьИстории.Выбран() Тогда
			Продолжить;
		КонецЕсли;
		//+бит_Сафаров ШИ 21.09.2026
		// РегистрСведений.СоздатьМенеджерЗаписи() сбрасывает все поля объекта,
		// включая измерения, если Прочитать() не нашла существующую запись -
		// их нужно установить заново перед записью новой строки. У регистра
		// бит_омни_ИсторияЧатовMAX также нет измерения/ресурса "Пациент":
		// запись в него вызывала отказ при восстановлении диалога из архива.
		ЗаписьИстории.Период = Сообщение.Период;
		ЗаписьИстории.ИдентификаторСообщения = Сообщение.ИдентификаторСообщения;
		ЗаписьИстории.Контакт = Сообщение.Контакт;
		ЗаписьИстории.Бот = Сообщение.Бот;
		ЗаписьИстории.Входящее = Сообщение.Входящее;
		ЗаписьИстории.Текст = Сообщение.Текст;
		//-бит_Сафаров ШИ 21.09.2026
		ЗаписьИстории.ВидСообщения = Сообщение.ВидСообщения;
		ЗаписьИстории.Автор = Сообщение.Автор;
		ЗаписьИстории.Прочитано = Сообщение.Прочитано;
		ЗаписьИстории.Статус = Сообщение.Статус;
		ЗаписьИстории.ОписаниеОшибки = Сообщение.ОписаниеОшибки;
		ЗаписьИстории.ДанныеВложений = Сообщение.ДанныеВложений;
		ЗаписьИстории.ВидОтправителя = Сообщение.ВидОтправителя;
		ЗаписьИстории.Пользователь = Сообщение.Пользователь;
		ЗаписьИстории.Записать();
		Количество = Количество + 1;
	КонецЦикла;

	Состояние = РегистрыСведений.бит_омни_СостоянияДиалоговMAX.СоздатьМенеджерЗаписи();
	ПациентДляСостояния = ?(ЗначениеЗаполнено(ПервоеСообщение.Пациент),
		ПервоеСообщение.Пациент, ПервоеСообщение.Контакт);
	Состояние.Пациент = ПациентДляСостояния;
	Состояние.Бот = ПервоеСообщение.Бот;
	Состояние.Отделение = ПервоеСообщение.Отделение;
	Состояние.Прочитать();
	//+бит_Сафаров ШИ 21.09.2026
	// Как и в блоке записи истории выше: Прочитать() без найденной записи
	// сбрасывает измерения, установленные до неё - переустанавливаем их
	// перед записью, иначе новая запись состояния уходит с пустыми
	// измерениями и Записать() отказывает.
	Состояние.Пациент = ПациентДляСостояния;
	Состояние.Бот = ПервоеСообщение.Бот;
	Состояние.Отделение = ПервоеСообщение.Отделение;
	//-бит_Сафаров ШИ 21.09.2026
	Состояние.Состояние = Перечисления.бит_омни_СостоянияДиалоговMAX.Новый;
	Состояние.Ответственный = Справочники.Пользователи.ПустаяСсылка();
	Состояние.ДатаИзменения = ТекущаяДатаСеанса();
	Состояние.Записать();

	НаборАрхива.Очистить();
	НаборАрхива.Записать();
	Возврат Количество;
	//-бит_Сафаров ШИ 17.09.2026

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Доступ к конкретному диалогу проверен до повышения прав. Привилегированный
// режим нужен только для переноса истории в служебный регистр архива.
Функция АрхивироватьДиалогПривилегированно(Контакт, ДанныеКонтакта, Архивировал)

	КонтактыДиалога = КонтактыДиалога(Контакт, ДанныеКонтакта);
	Если КонтактыДиалога.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	ЗаблокироватьИсториюДиалога(КонтактыДиалога, ДанныеКонтакта.Бот);
	ИдентификаторАрхива = Строка(Новый УникальныйИдентификатор);
	ДатаАрхивации = ТекущаяДатаСеанса();
	НаборАрхива = РегистрыСведений.бит_омни_АрхивЧатовMAX.СоздатьНаборЗаписей();
	НаборАрхива.Отбор.ИдентификаторАрхива.Установить(ИдентификаторАрхива);
	НаборыИстории = Новый Массив;
	Количество = 0;

	Для Каждого ТекущийКонтакт Из КонтактыДиалога Цикл
		НаборИстории = РегистрыСведений.бит_омни_ИсторияЧатовMAX.СоздатьНаборЗаписей();
		НаборИстории.Отбор.Контакт.Установить(ТекущийКонтакт);
		НаборИстории.Отбор.Бот.Установить(ДанныеКонтакта.Бот);
		НаборИстории.Прочитать();
		НаборыИстории.Добавить(НаборИстории);

		Для Каждого Сообщение Из НаборИстории Цикл
			ЗаписьАрхива = НаборАрхива.Добавить();
			ЗаписьАрхива.Период = Сообщение.Период;
			ЗаписьАрхива.ИдентификаторАрхива = ИдентификаторАрхива;
			ЗаписьАрхива.ИдентификаторСообщения = Сообщение.ИдентификаторСообщения;
			ЗаписьАрхива.Контакт = Сообщение.Контакт;
			ЗаписьАрхива.Бот = Сообщение.Бот;
			ЗаписьАрхива.Входящее = Сообщение.Входящее;
			ЗаписьАрхива.Отделение = ДанныеКонтакта.Отделение;
			ЗаписьАрхива.Пациент = ДанныеКонтакта.Пациент;
			ЗаписьАрхива.Текст = Сообщение.Текст;
			ЗаписьАрхива.ВидСообщения = Сообщение.ВидСообщения;
			ЗаписьАрхива.Автор = Сообщение.Автор;
			ЗаписьАрхива.Прочитано = Сообщение.Прочитано;
			ЗаписьАрхива.Статус = Сообщение.Статус;
			ЗаписьАрхива.ОписаниеОшибки = Сообщение.ОписаниеОшибки;
			ЗаписьАрхива.ДанныеВложений = Сообщение.ДанныеВложений;
			ЗаписьАрхива.ВидОтправителя = Сообщение.ВидОтправителя;
			ЗаписьАрхива.Пользователь = Сообщение.Пользователь;
			ЗаписьАрхива.ДатаАрхивации = ДатаАрхивации;
			ЗаписьАрхива.Архивировал = Архивировал;
			Количество = Количество + 1;
		КонецЦикла;
	КонецЦикла;

	Если Количество = 0 Тогда
		Возврат 0;
	КонецЕсли;

	// Сначала записываем архив, затем очищаем активную историю в той же транзакции.
	НаборАрхива.Записать();
	Для Каждого НаборИстории Из НаборыИстории Цикл
		НаборИстории.Очистить();
		НаборИстории.Записать();
	КонецЦикла;

	Возврат Количество;

КонецФункции

Функция КонтактыДиалога(Контакт, ДанныеКонтакта)

	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ДанныеКонтакта.Пациент) Тогда
		Запрос.Текст = "ВЫБРАТЬ
			| Контакты.Ссылка КАК Контакт
			|ИЗ Справочник.бит_омни_Контакты КАК Контакты
			|ГДЕ Контакты.Бот = &Бот
			| И Контакты.ОтделениеMAX = &Отделение
			| И Контакты.Получатель = &Пациент
			| И НЕ Контакты.ПометкаУдаления";
		Запрос.УстановитьПараметр("Пациент", ДанныеКонтакта.Пациент);
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
			| Контакты.Ссылка КАК Контакт
			|ИЗ Справочник.бит_омни_Контакты КАК Контакты
			|ГДЕ Контакты.Бот = &Бот
			| И Контакты.ОтделениеMAX = &Отделение
			| И Контакты.Ссылка = &Контакт
			| И НЕ Контакты.ПометкаУдаления";
		Запрос.УстановитьПараметр("Контакт", Контакт);
	КонецЕсли;
	Запрос.УстановитьПараметр("Бот", ДанныеКонтакта.Бот);
	Запрос.УстановитьПараметр("Отделение", ДанныеКонтакта.Отделение);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Контакт);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ЗаблокироватьИсториюДиалога(Контакты, Бот)

	Для Каждого Контакт Из Контакты Цикл
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.бит_омни_ИсторияЧатовMAX");
		ЭлементБлокировки.УстановитьЗначение("Контакт", Контакт);
		ЭлементБлокировки.УстановитьЗначение("Бот", Бот);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
