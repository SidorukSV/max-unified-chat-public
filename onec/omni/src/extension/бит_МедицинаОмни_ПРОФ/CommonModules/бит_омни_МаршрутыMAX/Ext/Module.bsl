#Область ПрограммныйИнтерфейс

// Данные считываются при формировании нового сообщения, без сохранения в шаблоне.
// Параметры:
//  Шаблон - СправочникСсылка.бит_омни_ШаблоныСообщений, СправочникОбъект.бит_омни_ШаблоныСообщений - шаблон.
//  Контекст - Структура, СтрокаТаблицыЗначений - контекст записи на приём.
// Возвращаемое значение:
//  Структура - Адрес (Строка), Кнопки (Массив рядов кнопок MAX).
Функция ДанныеМаршрута(Шаблон, Контекст) Экспорт

	Результат = Новый Структура("Адрес,Кнопки", "", Новый Массив);
	Если Не ЭтоШаблонМаршрута(Шаблон.ИдентификаторСтандартногоШаблона) Тогда
		Возврат Результат;
	КонецЕсли;
	Филиал = ФилиалИзКонтекста(Контекст);
	Если Не ЗначениеЗаполнено(Филиал) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Адрес = АдресФилиала(Филиал);
	Ссылки = Новый Структура;
	Для Каждого Сервис Из СервисыМаршрутов() Цикл
		Вид = бит_омни_ОбщегоНазначенияПолныеПрава.ЗначениеКонстанты(Сервис.Настройка);
		Ссылки.Вставить(Сервис.Ключ, СсылкаФилиала(Филиал, Вид));
	КонецЦикла;
	Результат.Кнопки = КнопкиМаршрутов(Ссылки);
	Возврат Результат;

КонецФункции

Функция ЭтоШаблонМаршрута(Идентификатор) Экспорт

	Возврат Идентификатор = "MAX_APPOINTMENT_CREATED"
		Или Идентификатор = "MAX_APPOINTMENT_REMINDER_24H"
		Или Идентификатор = "MAX_APPOINTMENT_REMINDER_2H";

КонецФункции

Функция ФилиалИзКонтекста(Контекст) Экспорт

	Для Каждого ИмяПоля Из СтрРазделить("ФилиалПосле,Филиал,address", ",") Цикл
		Значение = Неопределено;
		Если ТипЗнч(Контекст) = Тип("Структура") Тогда
			Контекст.Свойство(ИмяПоля, Значение);
		ИначеЕсли ТипЗнч(Контекст) = Тип("СтрокаТаблицыЗначений") Тогда
			Если Контекст.Владелец().Колонки.Найти(ИмяПоля) <> Неопределено Тогда
				Значение = Контекст[ИмяПоля];
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.Филиалы") И ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.Филиалы.ПустаяСсылка();

КонецФункции

Функция СервисыМаршрутов() Экспорт

	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Ключ,Заголовок,Настройка",
		"Яндекс", "Яндекс", "ВидКонтактнойИнформацииМаршрутЯндексMAX"));
	Результат.Добавить(Новый Структура("Ключ,Заголовок,Настройка",
		"ДваГИС", "2ГИС", "ВидКонтактнойИнформацииМаршрут2ГИСMAX"));
	Результат.Добавить(Новый Структура("Ключ,Заголовок,Настройка",
		"AppleMaps", "Apple Maps", "ВидКонтактнойИнформацииМаршрутAppleMapsMAX"));
	Возврат Результат;

КонецФункции

// Чистая функция: пустые и некорректные ссылки не создают неработающие кнопки.
// Параметры:
//  Ссылки - Структура - необязательные поля Яндекс, ДваГИС, AppleMaps со строками URL.
// Возвращаемое значение:
//  Массив - ряды кнопок, по одной кнопке в ряду.
Функция КнопкиМаршрутов(Ссылки) Экспорт

	Результат = Новый Массив;
	Для Каждого Сервис Из СервисыМаршрутов() Цикл
		Адрес = Неопределено;
		Если Не Ссылки.Свойство(Сервис.Ключ, Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Адрес = ДопустимаяСсылкаМаршрута(Адрес);
		Если ПустаяСтрока(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Ряд = Новый Массив;
		Ряд.Добавить(Новый Структура("type,text,url", "link", Сервис.Заголовок, Адрес));
		Результат.Добавить(Ряд);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДопустимаяСсылкаМаршрута(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда Возврат ""; КонецЕсли;
	Адрес = СокрЛП(Значение);
	Если СтрДлина(Адрес) > 2048 Тогда Возврат ""; КонецЕсли;
	Если НРег(Лев(Адрес, 8)) = "https://" Тогда
		НачалоУзла = 9;
	ИначеЕсли НРег(Лев(Адрес, 7)) = "http://" Тогда
		НачалоУзла = 8;
	Иначе
		Возврат "";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Адрес) Цикл
		Если КодСимвола(Адрес, Индекс) <= 32 Тогда Возврат ""; КонецЕсли;
	КонецЦикла;
	Остаток = Сред(Адрес, НачалоУзла);
	Если ПустаяСтрока(Остаток) Или СтрНайти("/?#", Лев(Остаток, 1)) > 0 Тогда Возврат ""; КонецЕсли;
	Части = СтрРазделить(Остаток, "/?#", Ложь);
	Если Части.Количество() = 0 Или СтрНайти(Части[0], "@") > 0 Тогда Возврат ""; КонецЕсли;
	Возврат Адрес;

КонецФункции

Функция АдресДляФормата(Знач Адрес, Формат) Экспорт

	Если НРег(Формат) = "html" Тогда
		Адрес = СтрЗаменить(Адрес, "&", "&amp;");
		Адрес = СтрЗаменить(Адрес, "<", "&lt;");
		Адрес = СтрЗаменить(Адрес, ">", "&gt;");
	КонецЕсли;
	Возврат Адрес;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СсылкаФилиала(Филиал, Вид)

	Если ТипЗнч(Вид) <> Тип("СправочникСсылка.ВидыКонтактнойИнформации")
		Или Не ЗначениеЗаполнено(Вид) Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	| Контакты.Представление КАК Представление
	|ИЗ РегистрСведений.КонтактнаяИнформация КАК Контакты
	|ГДЕ Контакты.Объект = &Филиал И Контакты.Вид = &Вид
	| И Контакты.Представление <> """"
	|УПОРЯДОЧИТЬ ПО Контакты.ЗначениеПоУмолчанию УБЫВ, Контакты.Представление";
	Запрос.УстановитьПараметр("Филиал", Филиал);
	Запрос.УстановитьПараметр("Вид", Вид);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда Возврат Выборка.Представление; КонецЕсли;
	Возврат "";

КонецФункции

Функция АдресФилиала(Филиал)

	Адрес = СсылкаФилиала(Филиал, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	Если Не ПустаяСтрока(Адрес) Тогда Возврат Адрес; КонецЕсли;
	// Филиал не подменяется адресом другой клиники, если его адрес ещё не заполнен.
	Возврат Строка(Филиал);

КонецФункции

#КонецОбласти
