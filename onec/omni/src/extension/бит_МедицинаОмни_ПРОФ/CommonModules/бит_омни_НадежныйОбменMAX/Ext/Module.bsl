#Область ПрограммныйИнтерфейс

// Истина разрешает ACK: событие обработано либо сохранено в карантине.
// Попытка фиксируется отдельно; бизнес-изменения, outbox и Обработано - одним commit.
// Произвольные административные обработчики должны пользоваться транспортом расширения:
// внешние побочные эффекты стороннего BSL не могут быть откатаны транзакцией 1С.
Функция ОбработатьВходящее(Обновление, Бот) Экспорт

	//+бит_Сафаров ШИ 17.09.2026
	НачалоОбработки = ТекущаяДатаСеанса();
	//-бит_Сафаров ШИ 17.09.2026
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Inbox MAX требует самостоятельной транзакции."; КонецЕсли;
	Ключ = КлючСобытия(Обновление);
	Захват = НачатьПопыткуВходящего(Бот, Ключ, ВJSON(Обновление));
	Если Захват.Готово Тогда Возврат Истина; КонецЕсли;
	Если Не Захват.Захвачено Тогда Возврат Ложь; КонецЕсли;
	Готово = Ложь;
	Ошибка = Неопределено;
	НачатьТранзакцию();
	Попытка
		Запись = ВходящаяЗаписьПодБлокировкой(Бот, Ключ);
		Если Запись.Состояние = "Обрабатывается" И Запись.Попыток = Захват.НомерПопытки Тогда
			бит_омни_ИнтеграцияСMAX.ОбработатьОбновление(Обновление, Бот);
			Запись.Состояние = "Обработано";
			Запись.АрендаДо = Дата(1, 1, 1);
			Запись.ОписаниеОшибки = "";
			Запись.ДатаИзменения = ТекущаяДатаСеанса();
			Запись.Записать();
			Готово = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	Если Ошибка <> Неопределено Тогда
		//+бит_Сафаров ШИ 17.09.2026
		ЗаписьЖурналаРегистрации("ОМНИ.MAX.Timing.Inbox", УровеньЖурналаРегистрации.Ошибка,
			,, "Этап обработки в 1С, секунд: " + Строка(ТекущаяДатаСеанса() - НачалоОбработки));
		//-бит_Сафаров ШИ 17.09.2026
		Возврат ЗарегистрироватьОшибкуВходящего(Бот, Ключ, Захват.НомерПопытки, Ошибка);
	КонецЕсли;
	//+бит_Сафаров ШИ 17.09.2026
	ЗаписьЖурналаРегистрации("ОМНИ.MAX.Timing.Inbox", УровеньЖурналаРегистрации.Информация,
		,, "Этап обработки в 1С, секунд: " + Строка(ТекущаяДатаСеанса() - НачалоОбработки));
	//-бит_Сафаров ШИ 17.09.2026
	Возврат Готово;

КонецФункции

// Локальный повтор нужен в том числе после ручного возврата из карантина:
// соответствующая квитанция VDS уже могла быть подтверждена. Payload не теряется.
Процедура ОбработатьЛокальныеПовторы() Экспорт
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Повтор inbox MAX внутри транзакции запрещен."; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 10 Бот, ДанныеJSON ИЗ РегистрСведений.бит_омни_ВходящиеСобытияMAX
	|ГДЕ ((Состояние = &Ошибка И ДатаИзменения <= &Граница)
	| ИЛИ (Состояние = &Обрабатывается И АрендаДо <= &Сейчас))
	| И Бот.Использовать И НЕ Бот.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО ДатаИзменения");
	Запрос.УстановитьПараметр("Ошибка", "Ошибка");
	Запрос.УстановитьПараметр("Обрабатывается", "Обрабатывается");
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - 120);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ОбработатьВходящее(ИзJSON(Выборка.ДанныеJSON), Выборка.Бот);
		Исключение
			ЗаписьЖурналаРегистрации("ОМНИ.MAX.Inbox.Recovery", УровеньЖурналаРегистрации.Ошибка, , ,
				"Не выполнен локальный повтор входящего события; данные сохранены в inbox MAX.");
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Снимок без токенов авторизации. В транзакции входящего события это только намерение,
// а не утверждение о доставке. UUID сохраняется и не меняется при разрешенном повторе.
Функция ПоставитьИсходящее(Бот, Контакт, Вид, Тело, Адресат = Неопределено,
	ВидОтправителя = Неопределено, Пользователь = Неопределено) Экспорт

	Если Не ТранзакцияАктивна() Тогда ВызватьИсключение "Намерение MAX записывается внутри транзакции."; КонецЕсли;
	Если Вид <> "message" И Вид <> "callback" Тогда ВызватьИсключение "Неизвестный вид намерения MAX."; КонецЕсли;
	Запись = РегистрыСведений.бит_омни_ИсходящиеНамеренияMAX.СоздатьМенеджерЗаписи();
	Запись.Ключ = Строка(Новый УникальныйИдентификатор);
	Запись.Бот = Бот;
	Запись.Контакт = Контакт;
	Запись.Вид = Вид;
	Запись.ТелоJSON = ВJSON(Тело);
	Запись.АдресатJSON = ?(Адресат = Неопределено, "", ВJSON(Адресат));
	Запись.ДатаСоздания = ТекущаяДатаСеанса();
	Запись.СледующаяПопытка = Запись.ДатаСоздания;
	Запись.Состояние = "Ожидает";
	Запись.ВидОтправителя = ?(ВидОтправителя = Неопределено,
		Перечисления.бит_омни_ВидыОтправителейMAX.Бот, ВидОтправителя);
	Запись.Пользователь = ?(Пользователь = Неопределено, Справочники.Пользователи.ПустаяСсылка(), Пользователь);
	Запись.Записать();
	Возврат Новый Структура("success,accepted,delivery_status,message,ИдентификаторПопытки",
		Ложь, Истина, "queued", "Сообщение поставлено в очередь отправки.", Запись.Ключ);

КонецФункции

// Только вне транзакции. Неопределенный итог никогда не разрешает автоповтор.
Процедура ОтправитьОжидающие(Лимит = 10) Экспорт

	Если ТранзакцияАктивна() Тогда ВызватьИсключение "Отправка outbox MAX внутри транзакции запрещена."; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 50 Ключ ИЗ РегистрСведений.бит_омни_ИсходящиеНамеренияMAX
	|ГДЕ Состояние = &Ожидает И СледующаяПопытка <= &Сейчас
	| И Бот.Использовать И НЕ Бот.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО ДатаСоздания, Ключ");
	Запрос.УстановитьПараметр("Ожидает", "Ожидает");
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Обработано = 0;
	Начало = ТекущаяДатаСеанса();
	Пока Выборка.Следующий() И Обработано < Лимит И ТекущаяДатаСеанса() - Начало < 20 Цикл
		Обработано = Обработано + 1;
		Попытка
			Намерение = ЗахватитьИсходящее(Выборка.Ключ);
			Если Намерение = Неопределено Тогда Продолжить; КонецЕсли;
			Результат = бит_омни_ИнтеграцияСMAX.бит_ОтправитьНамерениеMAX(Намерение);
			ЗафиксироватьИтогИсходящего(Намерение, Результат);
		Исключение
			// Захваченная строка уже Неопределено. Ни падение процесса, ни ошибка
			// сохранения результата не возвращает ее в очередь без проверки MAX.
			ЗаписьЖурналаРегистрации("ОМНИ.MAX.Outbox", УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось завершить попытку " + Выборка.Ключ + ". Проверьте регистр исходящих намерений MAX.");
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Результат конкретной попытки для оператора; не запрос «последней» истории.
Функция ОтправитьПоКлючу(Ключ) Экспорт
	Если ТранзакцияАктивна() Тогда ВызватьИсключение "HTTP MAX внутри транзакции запрещен."; КонецЕсли;
	//+бит_Сафаров ШИ 17.09.2026
	НачалоОтправки = ТекущаяДатаСеанса();
	//-бит_Сафаров ШИ 17.09.2026
	Намерение = ЗахватитьИсходящее(Ключ);
	Если Намерение = Неопределено Тогда
		Возврат Новый Структура("success,accepted,delivery_status,message,ИдентификаторПопытки",
			Ложь, Ложь, "unknown", "Попытка уже захвачена. Проверьте историю до повтора.", Ключ);
	КонецЕсли;
	Результат = бит_омни_ИнтеграцияСMAX.бит_ОтправитьНамерениеMAX(Намерение);
	//+бит_Сафаров ШИ 17.09.2026
	ЗаписьЖурналаРегистрации("ОМНИ.MAX.Timing.Send", УровеньЖурналаРегистрации.Информация,
		,, "Этап отправки из 1С в MAX, секунд: " + Строка(ТекущаяДатаСеанса() - НачалоОтправки)
		+ "; состояние: " + Результат.Состояние);
	//-бит_Сафаров ШИ 17.09.2026
	Попытка
		ЗафиксироватьИтогИсходящего(Намерение, Результат);
	Исключение
		// Не подменяем полученный успех ошибкой сохранения: повтор доставит дубликат.
		Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + " Не удалось сохранить итог попытки; не повторяйте без проверки MAX.";
	КонецПопытки;
	Возврат Новый Структура("success,accepted,delivery_status,message,ИдентификаторПопытки",
		Результат.Состояние = "Отправлено", Ложь,
		?(Результат.Состояние = "Отправлено", "sent", ?(Результат.Состояние = "Ошибка", "not_sent", "unknown")),
		Результат.ОписаниеОшибки, Ключ);
КонецФункции

// Общая блокировка идентичности сериализует первые обращения. Существующие дубли
// отвергаются, а не выбираются произвольно; сопоставление сохраняется атомарно с контактом.
Функция ПолучитьИлиСоздатьКонтакт(Идентификатор, Бот, Наименование) Экспорт

	Если ТипЗнч(Идентификатор) <> Тип("Число") Или Идентификатор <= 0
		Или Идентификатор <> Цел(Идентификатор) Или Идентификатор > 999999999999999 Тогда
		ВызватьИсключение "Некорректный идентификатор пользователя MAX.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ИдентичностиКонтактовMAX");
		Элемент.УстановитьЗначение("Бот", Бот);
		Элемент.УстановитьЗначение("Идентификатор", Идентификатор);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.бит_омни_Контакты
		|ГДЕ Бот = &Бот И Идентификатор = &Идентификатор И НЕ ПометкаУдаления
		| И Канал = ЗНАЧЕНИЕ(Перечисление.бит_омни_КаналыСвязи.MAX)");
		Запрос.УстановитьПараметр("Бот", Бот);
		Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
		Контакты = Запрос.Выполнить().Выгрузить();
		Если Контакты.Количество() > 1 Тогда ВызватьИсключение "Обнаружены дубли контакта MAX. Требуется администратор."; КонецЕсли;
		Если Контакты.Количество() = 1 Тогда
			Контакт = Контакты[0].Ссылка;
			БлокировкаКонтакта = Новый БлокировкаДанных;
			Элемент = БлокировкаКонтакта.Добавить("Справочник.бит_омни_Контакты");
			Элемент.УстановитьЗначение("Ссылка", Контакт);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаКонтакта.Заблокировать();
		Иначе
			Объект = Справочники.бит_омни_Контакты.СоздатьЭлемент();
			Объект.Наименование = Лев(Наименование, 25);
			Объект.Идентификатор = Идентификатор;
			Объект.Бот = Бот;
			Объект.Канал = Перечисления.бит_омни_КаналыСвязи.MAX;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.ДополнительныеСвойства.Вставить("НеРегистрироватьДляОбмена", Истина);
			Объект.Записать();
			Контакт = Объект.Ссылка;
		КонецЕсли;
		Запись = РегистрыСведений.бит_омни_ИдентичностиКонтактовMAX.СоздатьМенеджерЗаписи();
		Запись.Бот = Бот;
		Запись.Идентификатор = Идентификатор;
		Запись.Контакт = Контакт;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Контакт;

КонецФункции

Функция ВJSON(Данные) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

// Ручной повтор только сохраненного карантина, после устранения причины.
// История выполненных событий не сбрасывается. Outbox с неизвестной доставкой не трогаем.
Функция ПовторитьКарантин(Бот, Ключ, Причина) Экспорт
	Если Не РольДоступна("ПолныеПрава") Тогда ВызватьИсключение "Повтор карантина доступен только пользователю с полными правами."; КонецЕсли;
	Если ТранзакцияАктивна() Или ПустаяСтрока(СокрЛП(Причина)) Тогда
		ВызватьИсключение "Укажите причину ручного повтора вне транзакции.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Запись = ВходящаяЗаписьПодБлокировкой(Бот, Ключ);
		Если Запись.Состояние <> "Карантин" Тогда ВызватьИсключение "Событие не находится в карантине."; КонецЕсли;
		Данные = ИзJSON(Запись.ДанныеJSON);
		Запись.Состояние = "Ошибка";
		Запись.Попыток = 0;
		Запись.АрендаДо = Дата(1, 1, 1);
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.ОписаниеОшибки = "Ручной повтор: " + Лев(Причина, 950);
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ЗаписьЖурналаРегистрации("ОМНИ.MAX.Inbox.Replay", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Ручной повтор события " + Ключ + ": " + Лев(Причина, 500));
	Возврат ОбработатьВходящее(Данные, Бот);
КонецФункции

Функция ИзJSON(СтрокаJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НачатьПопыткуВходящего(Бот, Ключ, ДанныеJSON)
	Результат = Новый Структура("Готово,Захвачено,НомерПопытки", Ложь, Ложь, 0);
	НачатьТранзакцию();
	Попытка
		Запись = ВходящаяЗаписьПодБлокировкой(Бот, Ключ);
		Если Запись.Состояние = "Обработано" Или Запись.Состояние = "Карантин" Тогда
			Результат.Готово = Истина;
		ИначеЕсли Запись.Состояние <> "Обрабатывается" Или Запись.АрендаДо <= ТекущаяДатаСеанса() Тогда
			Запись.ДанныеJSON = ДанныеJSON;
			Запись.ДатаИзменения = ТекущаяДатаСеанса();
			Если Запись.Попыток >= 5 Тогда
				Запись.Состояние = "Карантин";
				Запись.ОписаниеОшибки = "Исчерпаны попытки, включая аварийно прерванные. Требуется ручной разбор.";
				Результат.Готово = Истина;
			Иначе
				Запись.Состояние = "Обрабатывается";
				Запись.Попыток = Запись.Попыток + 1;
				Запись.АрендаДо = ТекущаяДатаСеанса() + 180;
				Результат.Захвачено = Истина;
				Результат.НомерПопытки = Запись.Попыток;
			КонецЕсли;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ЗарегистрироватьОшибкуВходящего(Бот, Ключ, НомерПопытки, Ошибка)
	// Запись диагностики - отдельная исправная транзакция после rollback бизнес-действий.
	НачатьТранзакцию();
	Попытка
		Запись = ВходящаяЗаписьПодБлокировкой(Бот, Ключ);
		Если Запись.Попыток = НомерПопытки И Запись.Состояние = "Обрабатывается" Тогда
			Запись.Состояние = ?(НомерПопытки >= 5, "Карантин", "Ошибка");
			Запись.ОписаниеОшибки = Лев(КраткоеПредставлениеОшибки(Ошибка), 1000);
			Запись.АрендаДо = Дата(1, 1, 1);
			Запись.ДатаИзменения = ТекущаяДатаСеанса();
			Запись.Записать();
		КонецЕсли;
		Карантин = Запись.Состояние = "Карантин";
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ЗаписьЖурналаРегистрации("ОМНИ.MAX.Inbox", УровеньЖурналаРегистрации.Ошибка, , ,
		СтрШаблон("Событие %1, попытка %2, карантин %3. Подробности в регистре входящих событий MAX.",
		Ключ, НомерПопытки, Карантин));
	Возврат Карантин;
КонецФункции


Функция КлючСобытия(Обновление)
	ТипСобытия = Свойство(Обновление, "update_type", "");
	Если ТипСобытия = "message_created" Тогда
		Сообщение = Свойство(Обновление, "message");
		Ключ = Строка(Свойство(Свойство(Сообщение, "sender"), "user_id", "")) + ":"
			+ Строка(Свойство(Свойство(Сообщение, "body"), "mid", ""));
	ИначеЕсли ТипСобытия = "message_callback" Тогда
		Ключ = Строка(Свойство(Свойство(Обновление, "callback"), "callback_id", ""));
	ИначеЕсли ТипСобытия = "bot_started" Или ТипСобытия = "bot_stopped" Тогда
		Ключ = Строка(Свойство(Свойство(Обновление, "user"), "user_id", "")) + ":"
			+ Строка(Свойство(Обновление, "timestamp", ""));
	Иначе
		Ключ = ВJSON(Обновление);
	КонецЕсли;
	Если ПустаяСтрока(Ключ) Или Ключ = ":" Или Прав(Ключ, 1) = ":" Тогда Ключ = ВJSON(Обновление); КонецЕсли;
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(ТипСобытия + ":" + Ключ, КодировкаТекста.UTF8, Ложь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Функция Свойство(Данные, Имя, ПоУмолчанию = Неопределено)
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Значение) Тогда Возврат Значение; КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ВходящаяЗаписьПодБлокировкой(Бот, Ключ)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ВходящиеСобытияMAX");
	Элемент.УстановитьЗначение("Бот", Бот);
	Элемент.УстановитьЗначение("КлючСобытия", Ключ);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запись = РегистрыСведений.бит_омни_ВходящиеСобытияMAX.СоздатьМенеджерЗаписи();
	Запись.Бот = Бот;
	Запись.КлючСобытия = Ключ;
	Запись.Прочитать();
	Запись.Бот = Бот;
	Запись.КлючСобытия = Ключ;
	Возврат Запись;
КонецФункции

Функция ИсходящаяЗаписьПодБлокировкой(Ключ)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.бит_омни_ИсходящиеНамеренияMAX");
	Элемент.УстановитьЗначение("Ключ", Ключ);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запись = РегистрыСведений.бит_омни_ИсходящиеНамеренияMAX.СоздатьМенеджерЗаписи();
	Запись.Ключ = Ключ;
	Запись.Прочитать();
	Возврат Запись;
КонецФункции

Функция ЗахватитьИсходящее(Ключ)
	Намерение = Неопределено;
	НачатьТранзакцию();
	Попытка
		Запись = ИсходящаяЗаписьПодБлокировкой(Ключ);
		Если Запись.Выбран() И Запись.Состояние = "Ожидает"
			И Запись.СледующаяПопытка <= ТекущаяДатаСеанса() Тогда
			Запись.Состояние = "Неопределено";
			Запись.Попыток = Запись.Попыток + 1;
			Запись.ДатаПопытки = ТекущаяДатаСеанса();
			Запись.ОписаниеОшибки = "Попытка зафиксирована до HTTP. Итог еще не сохранен; автоматический повтор запрещен.";
			Запись.Записать();
			Намерение = Запись;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Намерение;
КонецФункции

Процедура ЗафиксироватьИтогИсходящего(Намерение, Результат)
	НачатьТранзакцию();
	Попытка
		Запись = ИсходящаяЗаписьПодБлокировкой(Намерение.Ключ);
		Если Запись.Выбран() И Запись.Попыток = Намерение.Попыток И Запись.Состояние = "Неопределено" Тогда
			Запись.Состояние = Результат.Состояние;
			Запись.ИдентификаторMAX = Лев(Результат.ИдентификаторСообщения, 150);
			Запись.ОписаниеОшибки = Лев(Результат.ОписаниеОшибки, 1000);
			Если Результат.Состояние = "Ошибка" И Запись.Попыток < 5
				И Запись.ВидОтправителя <> Перечисления.бит_омни_ВидыОтправителейMAX.Оператор Тогда
				Запись.Состояние = "Ожидает";
				Запись.СледующаяПопытка = ТекущаяДатаСеанса() + 60 * Запись.Попыток;
			КонецЕсли;
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
