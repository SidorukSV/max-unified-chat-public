# Обязательные
ONEC_API_KEY=replace_with_strong_random_service_key
MAX_BOT_TOKEN=replace_with_max_bot_token
MAX_WEBHOOK_SECRET=replace_with_max_webhook_secret
MAX_WEBHOOK_URL=https://chat.example.com/api/v1/max/webhook

# Production
NODE_ENV=production
PORT=3000
REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=5000
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_REQUEST_TIMEOUT_MS=25000
ONEC_POLL_DEFAULT_LIMIT=50
ONEC_POLL_MAX_LIMIT=100
REDIS_INCOMING_QUEUE_KEY=max:incoming
REDIS_INCOMING_DEAD_LETTER_QUEUE_KEY=max:incoming:dead

# Публичный HTTPS-домен backend/API
CORS_ALLOWED_ORIGINS=https://chat.example.com

# Опционально
BACKEND_LOG_FILE=/app/logs/backend.log
BACKEND_LOG_LEVEL=info
