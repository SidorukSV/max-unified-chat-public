# Обязательные
JWT_SECRET=replace_with_strong_random_secret

# Production
NODE_ENV=production
PORT=3000
REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=5000
MAX_INIT_DATA_MAX_AGE_SECONDS=300
MAX_BOT_TOKEN=replace_with_max_bot_token
MAX_WEBHOOK_URL=https://chat.example.com/api/v1/max/webhook
MAX_WEBHOOK_SECRET=replace_with_max_webhook_secret
MAX_WEBHOOK_FORWARD_TIMEOUT_MS=25000
ONEC_CONFIG_FILE=/app/onec-config.yml

# Публичный HTTPS-домен backend/API
CORS_ALLOWED_ORIGINS=https://chat.example.com

REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=true

# Опционально
BACKEND_LOG_FILE=/app/logs/backend.log
BACKEND_LOG_LEVEL=info
LOGS_INTERNAL_API_KEY=
LOGS_RATE_LIMIT_PER_MINUTE=30
DEV_TOTP_SECRET=
DEV_TOTP_PERIOD_SECONDS=30
DEV_TOTP_WINDOW=1
